diff --git a/tests/unit/test_quest3d_control.cpp b/tests/unit/test_quest3d_control.cpp
new file mode 100644
index 0000000..0fca4e5
--- /dev/null
+++ b/tests/unit/test_quest3d_control.cpp
@@ -0,0 +1,218 @@
+/** @file tests/unit/test_quest3d_control.cpp
+ * @brief Real command lifecycle tests without a server, model or OS input.
+ */
+#include "src/quest3d_control.h"
+#include "tests/tests_common.h"
+
+namespace {
+  using json = nlohmann::json;
+  constexpr std::uint64_t now = 10000000000ULL;
+
+  /** @brief Deterministic publisher state and captured inert mailbox writes. */
+  class Quest3DControl: public ::testing::Test {
+  protected:
+    quest3d::control_mailbox mailbox {""};
+    json state {{"session_id", std::string(32, 'a')}, {"running", true}, {"revision", 0}, {"eye_width", 1280}, {"eye_height", 720}, {"updated_monotonic_ns", now}, {"requested_mode", "2d"}, {"effective_mode", "2d"}, {"disparity", 12}, {"applied_request", nullptr}, {"rejected_request", nullptr}, {"stream_epoch", UINT64_MAX}};
+    json command {{"version", 1}, {"session_id", std::string(32, 'a')}, {"request_id", std::string(32, 'b')}, {"seq", 1}, {"expected_revision", 0}, {"mode", "3d"}, {"disparity", 12}};
+    std::vector<json> writes;
+
+    quest3d::control_reply send(std::uint64_t clock = now) {
+      return mailbox.process(command.dump(), state, clock, [&](const auto &value) {
+        writes.push_back(value);
+        return true;
+      });
+    }
+
+    quest3d::control_reply get(std::uint64_t clock = now) {
+      return mailbox.process(std::nullopt, state, clock, {});
+    }
+  };
+}  // namespace
+
+TEST_F(Quest3DControl, PublisherAcknowledgementIsNotInferredFromSubmission) {
+  EXPECT_EQ(send().code, 202);
+  ASSERT_EQ(writes.size(), 1);
+  EXPECT_EQ(writes[0]["expected_revision"], 0);
+  EXPECT_EQ(writes[0].size(), 5);
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  state["revision"] = 1;
+  state["seen_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  state["applied_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "applied");
+  EXPECT_EQ(send().code, 200);
+  EXPECT_EQ(writes.size(), 1);
+}
+
+TEST_F(Quest3DControl, DuplicateConflictRevisionAndSequenceAreRejected) {
+  ASSERT_EQ(send().code, 202);
+  EXPECT_EQ(send().body["duplicate"], true);
+  command["disparity"] = 13;
+  EXPECT_EQ(send().body["error"], "request_id_conflict");
+  command["request_id"] = std::string(32, 'c');
+  command["seq"] = 2;
+  EXPECT_EQ(send().body["error"], "command_pending");
+  state["applied_request"] = std::string(32, 'b');
+  state["revision"] = 1;
+  EXPECT_EQ(send().body["error"], "revision_conflict");
+  command["expected_revision"] = 1;
+  command["seq"] = 1;
+  EXPECT_EQ(send().body["error"], "stale_sequence");
+  command["seq"] = 2;
+  EXPECT_EQ(send().code, 202);
+  EXPECT_EQ(writes.size(), 2);
+}
+
+TEST_F(Quest3DControl, ZeroStrengthAcknowledgesOriginalPixelsOnlyAfterPublication) {
+  command["disparity"] = 0;
+  ASSERT_EQ(send().code, 202);
+  state["requested_mode"] = "3d";
+  state["effective_mode"] = "2d";
+  state["disparity"] = 0;
+  state["revision"] = 1;
+  state["seen_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  state["applied_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "applied");
+}
+
+TEST_F(Quest3DControl, ZeroStrengthDoesNotRequireAvailableAI) {
+  command["disparity"] = 0;
+  state["ai_error"] = "unavailable";
+  ASSERT_EQ(send().code, 202);
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  state["applied_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "applied");
+}
+
+TEST_F(Quest3DControl, ZeroStrengthSupersedesPendingStereoWithoutClaimingItsCompletion) {
+  const auto previous = command;
+  ASSERT_EQ(send().code, 202);
+  command["request_id"] = std::string(32, 'c');
+  command["seq"] = 2;
+  command["disparity"] = 0;
+  ASSERT_EQ(send().code, 202);
+  EXPECT_EQ(writes.size(), 2);
+  EXPECT_EQ(mailbox.process(previous.dump(), state, now, {}).body["outcome"], "superseded");
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+}
+
+TEST_F(Quest3DControl, RejectsMalformedAndUnsupportedCommandsWithoutWrites) {
+  for (const auto &field : {"stop", "paused", "seek_seconds", "path", "cmd"}) {
+    auto bad = command;
+    bad[field] = true;
+    EXPECT_EQ(mailbox.process(bad.dump(), state, now, [&](const auto &) {
+                       ADD_FAILURE();
+                       return true;
+                     })
+                .code,
+              400);
+  }
+  for (const auto &field : {"version", "seq", "expected_revision"}) {
+    auto bad = command;
+    bad[field] = 0.5;
+    EXPECT_EQ(mailbox.process(bad.dump(), state, now, {}).code, 400);
+  }
+  command["disparity"] = true;
+  EXPECT_EQ(send().code, 400);
+  command["disparity"] = 1000;
+  EXPECT_EQ(send().code, 400);
+  EXPECT_EQ(mailbox.process(std::string(4097, ' '), state, now, {}).code, 413);
+  EXPECT_EQ(mailbox.process("{", state, now, {}).code, 400);
+  EXPECT_TRUE(writes.empty());
+}
+
+TEST_F(Quest3DControl, StaleSessionHeartbeatAndInvalidStatusCannotPublish) {
+  command["session_id"] = std::string(32, 'd');
+  EXPECT_EQ(send().body["error"], "stale_session");
+  command["session_id"] = state["session_id"];
+  EXPECT_EQ(send(now + 2000000001ULL).body["error"], "publisher_stale");
+  EXPECT_EQ(send(now - 1).body["error"], "publisher_stale");
+  state["running"] = false;
+  EXPECT_EQ(send().code, 503);
+  state["running"] = true;
+  state["eye_width"] = 0;
+  EXPECT_EQ(send().code, 503);
+  EXPECT_TRUE(writes.empty());
+}
+
+TEST_F(Quest3DControl, OverwrittenRequestTimesOutWithoutClaimingApplied) {
+  ASSERT_EQ(send().code, 202);
+  state["seen_request"] = std::string(32, 'd');
+  state["updated_monotonic_ns"] = now + 5000000001ULL;
+  EXPECT_EQ(get(now + 5000000001ULL).body["last_request"]["outcome"], "unknown_timeout");
+  EXPECT_EQ(send(now + 5000000001ULL).body["outcome"], "unknown_timeout");
+  EXPECT_EQ(writes.size(), 1);
+}
+
+TEST_F(Quest3DControl, RejectionAndRestartHaveExplicitOutcomes) {
+  ASSERT_EQ(send().code, 202);
+  state["rejected_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "rejected");
+  state["session_id"] = std::string(32, 'e');
+  EXPECT_EQ(get().body["last_seq"], 0);
+  EXPECT_TRUE(get().body["last_request"].is_null());
+  EXPECT_EQ(send().body["error"], "stale_session");
+}
+
+TEST_F(Quest3DControl, AiFailureUnblocksFallbackWithoutLeakingErrorPath) {
+  ASSERT_EQ(send().code, 202);
+  state["ai_error"] = "private model path";
+  state["revision"] = 1;
+  EXPECT_EQ(get().body["last_request"]["outcome"], "ai_unavailable");
+  EXPECT_EQ(get().body["ai_failed"], true);
+  EXPECT_FALSE(get().body.contains("ai_error"));
+  command["request_id"] = std::string(32, 'c');
+  command["seq"] = 2;
+  command["expected_revision"] = 1;
+  command["mode"] = "2d";
+  EXPECT_EQ(send().code, 202);
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+}
+
+TEST_F(Quest3DControl, ProjectsOnlyProductStatusAndPreservesUint64Identity) {
+  state["media"] = {{"path", "private-file"}};
+  state["error"] = "private filesystem failure";
+  const auto reply = get();
+  EXPECT_EQ(reply.code, 200);
+  EXPECT_FALSE(reply.body.contains("media"));
+  EXPECT_FALSE(reply.body.contains("error"));
+  EXPECT_EQ(reply.body["stream_epoch"], "18446744073709551615");
+  EXPECT_EQ(reply.body["input_enabled"], false);
+}
+
+TEST_F(Quest3DControl, MailboxWriteFailureDoesNotConsumeSequence) {
+  EXPECT_EQ(mailbox.process(command.dump(), state, now, [](const auto &) {
+                     return false;
+                   })
+              .body["error"],
+            "mailbox_busy");
+  EXPECT_EQ(get().body["last_seq"], 0);
+  EXPECT_EQ(send().code, 202);
+}
+
+TEST_F(Quest3DControl, TwoDCanSupersedeColdAiButStillNeedsPublisherAcknowledgement) {
+  ASSERT_EQ(send().code, 202);
+  const auto old = command;
+  state["seen_request"] = command["request_id"];
+  state["revision"] = 1;
+  command["request_id"] = std::string(32, 'c');
+  command["seq"] = 2;
+  command["mode"] = "2d";
+  EXPECT_EQ(send().body["error"], "revision_conflict");
+  command["expected_revision"] = 1;
+  EXPECT_EQ(mailbox.process(command.dump(), state, now, [](const auto &) {
+                     return false;
+                   })
+              .code,
+            503);
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  ASSERT_EQ(send().code, 202);
+  EXPECT_EQ(writes.size(), 2);
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  EXPECT_EQ(mailbox.process(old.dump(), state, now, {}).body["outcome"], "superseded");
+  state["applied_request"] = old["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "pending");
+  state["applied_request"] = command["request_id"];
+  EXPECT_EQ(get().body["last_request"]["outcome"], "applied");
+}
