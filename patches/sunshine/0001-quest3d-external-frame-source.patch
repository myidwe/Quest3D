+namespace quest3d_test {
+  struct pointer_fixture {
+    const std::string owner = "fixture-paired-certificate", epoch = "0123456789abcdef0123456789abcdef";
+    const std::string initial_control = std::string(32, 'a');
+    quest3d::capture_registry registry;
+    quest3d::frame_ledger ledger {owner, epoch};
+    quest3d::frame_header h {};
+    quest3d::source_identity source {};
+    quest3d::frame_clock::time_point now {std::chrono::seconds(10)};
+    std::uint64_t qpc = 10000000000ULL;
+    std::filesystem::path directory;
+    quest3d::object_names names;
+    HANDLE mapping = nullptr, mutex = nullptr;
+    unsigned char *view = nullptr;
