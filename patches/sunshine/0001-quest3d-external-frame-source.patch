+/** @file tests/unit/platform/windows/test_quest3d_pointer_sink.cpp
+ * @brief Explicit own-window Win32 adapter probe; never run by ordinary regressions.
+ */
+#ifdef _WIN32
+  #include "quest3d_pointer_fixture.h"
+  #include "tests/tests_common.h"
+
+  #include <cstdlib>
+
+namespace {
+  struct sink_observation {
+    unsigned left_down = 0, left_up = 0, right_down = 0, right_up = 0, moves = 0;
+  };
+
+  LRESULT CALLBACK pointer_fixture_proc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+    auto *seen = reinterpret_cast<sink_observation *>(GetWindowLongPtrW(window, GWLP_USERDATA));
+    if (message == WM_NCCREATE) {
+      seen = static_cast<sink_observation *>(reinterpret_cast<CREATESTRUCTW *>(lparam)->lpCreateParams);
+      SetWindowLongPtrW(window, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(seen));
+    }
+    if (seen) {
+      if (message == WM_LBUTTONDOWN) {
+        ++seen->left_down;
+      }
+      if (message == WM_LBUTTONUP) {
+        ++seen->left_up;
+      }
+      if (message == WM_RBUTTONDOWN) {
+        ++seen->right_down;
+      }
+      if (message == WM_RBUTTONUP) {
+        ++seen->right_up;
+      }
+      if (message == WM_MOUSEMOVE) {
+        ++seen->moves;
+      }
+    }
+    return DefWindowProcW(window, message, wparam, lparam);
+  }
+
+  void pump_fixture() {
+    const auto until = GetTickCount64() + 80;
+    while (GetTickCount64() < until) {
+      MSG message;
+      while (PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE)) {
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+      }
+      Sleep(1);
+    }
+  }
+}  // namespace
