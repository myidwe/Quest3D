+TEST(Quest3DFrameLedger, BoundedCapacityExactTtlAndClockRegression) {
+  quest3d::capture_registry registry;
+  auto source = registry.publish(header());
+  quest3d::frame_ledger ledger(owner, epoch);
+  for (std::uint64_t index = 0; index < 257; ++index) {
+    ASSERT_TRUE(ledger.record_sent(quest3d::encoded_identity {source, index, now}, index, true, now));
+  }
+  EXPECT_EQ(ledger.size(), 256U);
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 0, source, now));
+  EXPECT_TRUE(ledger.lookup(owner, epoch, 256, source, now + std::chrono::seconds(2)));
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 256, source, now - std::chrono::nanoseconds(1)));
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 256, source, now + std::chrono::seconds(2) + std::chrono::nanoseconds(1)));
+  EXPECT_EQ(ledger.size(), 0U);
+}
