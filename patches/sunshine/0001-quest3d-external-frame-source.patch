diff --git a/src/platform/windows/quest3d_frame.cpp b/src/platform/windows/quest3d_frame.cpp
new file mode 100644
index 0000000..4b3abdd
--- /dev/null
+++ b/src/platform/windows/quest3d_frame.cpp
@@ -0,0 +1,230 @@
+/**
+ * @file src/platform/windows/quest3d_frame.cpp
+ * @brief Safe Windows shared-memory reads for the Quest3D source provider.
+ */
+#include "quest3d_frame.h"
+
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#include <utility>
+
+namespace quest3d {
+  object_names protocol_names(std::uint32_t protocol, const std::wstring &prefix) {
+    if (protocol != 2 && protocol != 3) {
+      throw std::invalid_argument("Quest3D protocol must be 2 or 3");
+    }
+    const auto suffix = L".v" + std::to_wstring(protocol);
+    return {prefix + suffix, prefix + L".Mutex" + suffix, prefix + L".Ready" + suffix, prefix + L".Producer" + suffix, protocol};
+  }
+
+  /** @brief Check writer ownership without keeping its object alive across restart. */
+  bool writer_alive(const object_names &names) {
+    auto handle = OpenMutexW(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, names.producer.c_str());
+    if (!handle) {
+      return false;
+    }
+    const auto result = WaitForSingleObject(handle, 0);
+    if (result == WAIT_OBJECT_0 || result == WAIT_ABANDONED) {
+      ReleaseMutex(handle);
+    }
+    CloseHandle(handle);
+    return result == WAIT_TIMEOUT;
+  }
+
+  bool full_sbs_profile(const frame_header &header, std::uint64_t now_ns) {
+    return valid_header(header) && (header.flags & 1U) != 0 && (header.height % 2) == 0 && header.frame_id != 0 &&
+           header.publish_qpc_ns <= now_ns && now_ns - header.publish_qpc_ns <= 2000000000ULL;
+  }
+
+  std::uint64_t qpc_nanoseconds() {
+    LARGE_INTEGER counter {}, frequency {};
+    if (!QueryPerformanceCounter(&counter) || !QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0) {
+      return 0;
+    }
+    const auto seconds = counter.QuadPart / frequency.QuadPart;
+    const auto remainder = counter.QuadPart % frequency.QuadPart;
+    return static_cast<std::uint64_t>(seconds) * 1000000000ULL +
+           static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1000000000.0L / frequency.QuadPart);
+  }
+
+  frame_reader::frame_reader(object_names names):
+      names_(std::move(names)) {
+    if (names_.protocol != 2 && names_.protocol != 3) {
+      throw std::invalid_argument("Unsupported Quest3D protocol");
+    }
+  }
+
+  void frame_reader::select_protocol(std::uint32_t protocol) {
+    close();
+    names_ = protocol_names(protocol);
+  }
+
+  frame_reader::~frame_reader() {
+    close();
+  }
+
+  void frame_reader::close() {
+    if (view_) {
+      UnmapViewOfFile(view_);
+      view_ = nullptr;
+    }
+    for (auto *handle : {&ready_, &mutex_, &mapping_}) {
+      if (*handle) {
+        CloseHandle(*handle);
+        *handle = nullptr;
+      }
+    }
+    has_frame_ = false;
+  }
+
+  bool frame_reader::open() {
+    if (view_) {
+      return true;
+    }
+    mapping_ = OpenFileMappingW(FILE_MAP_READ, FALSE, names_.mapping.c_str());
+    mutex_ = OpenMutexW(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, names_.mutex.c_str());
+    if (!mapping_ || !mutex_) {
+      close();
+      return false;
+    }
+    view_ = static_cast<const std::uint8_t *>(MapViewOfFile(mapping_, FILE_MAP_READ, 0, 0, mapping_capacity + (names_.protocol == 3 ? 64 : 0)));
+    if (!view_) {
+      close();
+      return false;
+    }
+    ready_ = OpenEventW(SYNCHRONIZE, FALSE, names_.ready.c_str());
+    return true;
+  }
+
+  read_result frame_reader::read(frame &output, DWORD wait_ms) {
+    return read_impl(output, wait_ms, true);
+  }
+
+  read_result frame_reader::read_metadata(frame_header &output, DWORD wait_ms) {
+    frame temporary;
+    const auto result = read_impl(temporary, wait_ms, false);
+    if (result == read_result::fresh) {
+      output = temporary.header;
+    }
+    return result;
+  }
+
+  bool frame_reader::with_metadata(const std::function<bool(const frame_header &, const source_identity &)> &callback, DWORD wait_ms) {
+    if (!open()) {
+      return false;
+    }
+    const auto locked = WaitForSingleObject(mutex_, std::min<DWORD>(wait_ms, 5));
+    if (locked == WAIT_ABANDONED) {
+      frame_header abandoned {};
+      std::memcpy(&abandoned, view_, sizeof(abandoned));
+      tainted_id_ = abandoned.frame_id;
+      tainted_epoch_ = abandoned.stream_epoch;
+      guarded_tainted_ = true;
+      ReleaseMutex(mutex_);
+      return false;
+    }
+    if (locked != WAIT_OBJECT_0) {
+      return false;
+    }
+
+    struct unlock {
+      HANDLE mutex;
+
+      ~unlock() {
+        ReleaseMutex(mutex);
+      }
+    } release {mutex_};
+
+    frame_header header {};
+    source_identity source {};
+    std::memcpy(&header, view_, sizeof(header));
+    if (names_.protocol == 3) {
+      std::memcpy(&source, view_ + 128, sizeof(source));
+    }
+    if (header.version != names_.protocol || !valid_header(header) || !valid_source_identity(header, source) ||
+        names_.protocol != 3 || !writer_alive(names_)) {
+      return false;
+    }
+    if (guarded_tainted_ && header.frame_id == tainted_id_ && header.stream_epoch == tainted_epoch_) {
+      return false;
+    }
+    guarded_tainted_ = false;
+    return callback(header, source);
+  }
+
+  read_result frame_reader::read_impl(frame &output, DWORD wait_ms, bool copy_pixels) {
+    if (!open()) {
+      return read_result::unavailable;
+    }
+    const auto started = GetTickCount64();
+    bool waited_for_event = false;
+    while (true) {
+      const auto elapsed = GetTickCount64() - started;
+      const DWORD remaining = elapsed >= wait_ms ? 0 : wait_ms - static_cast<DWORD>(elapsed);
+      const auto locked = WaitForSingleObject(mutex_, remaining);
+      if (locked == WAIT_TIMEOUT) {
+        return read_result::busy;
+      }
+      if (locked == WAIT_ABANDONED) {
+        frame_header abandoned {};
+        std::memcpy(&abandoned, view_, sizeof(abandoned));
+        last_id_ = abandoned.frame_id;
+        last_epoch_ = abandoned.stream_epoch;
+        has_frame_ = true;
+        ReleaseMutex(mutex_);
+        // A process died during publication. Do not trust a possibly torn frame.
+        // Keep its identity rejected until a later publication replaces it.
+        return read_result::invalid;
+      }
+      if (locked != WAIT_OBJECT_0) {
+        close();
+        return read_result::unavailable;
+      }
+      frame_header header {};
+      std::memcpy(&header, view_, sizeof(header));
+      source_identity source {};
+      if (names_.protocol == 3) {
+        std::memcpy(&source, view_ + 128, sizeof(source));
+      }
+      if (header.version != names_.protocol || !valid_header(header) || !valid_source_identity(header, source)) {
+        ReleaseMutex(mutex_);
+        return read_result::invalid;
+      }
+      if (names_.protocol == 3 && !writer_alive(names_)) {
+        ReleaseMutex(mutex_);
+        close();
+        return read_result::invalid;
+      }
+      if (has_frame_ && header.stream_epoch == last_epoch_ && header.frame_id < last_id_) {
+        ReleaseMutex(mutex_);
+        return read_result::invalid;
+      }
+      if (has_frame_ && header.frame_id == last_id_ && header.stream_epoch == last_epoch_) {
+        ReleaseMutex(mutex_);
+        if (!waited_for_event && remaining > 0 && ready_) {
+          waited_for_event = true;
+          WaitForSingleObject(ready_, remaining);
+          continue;
+        }
+        return read_result::unchanged;
+      }
+      if (copy_pixels) {
+        try {
+          output.pixels.resize(header.payload_bytes);
+        } catch (...) {
+          ReleaseMutex(mutex_);
+          throw;
+        }
+        std::memcpy(output.pixels.data(), view_ + header.header_bytes, header.payload_bytes);
+      }
+      output.header = header;
+      output.source = source;
+      ReleaseMutex(mutex_);
+      last_id_ = header.frame_id;
+      last_epoch_ = header.stream_epoch;
+      has_frame_ = true;
+      return read_result::fresh;
+    }
+  }
+}  // namespace quest3d
diff --git a/src/platform/windows/quest3d_frame.h b/src/platform/windows/quest3d_frame.h
new file mode 100644
index 0000000..d586d5e
--- /dev/null
+++ b/src/platform/windows/quest3d_frame.h
@@ -0,0 +1,101 @@
+/**
+ * @file src/platform/windows/quest3d_frame.h
+ * @brief Bounded, latest-frame Windows shared-memory input for Quest3D.
+ */
+#pragma once
+
+#include "../../quest3d_frame_metadata.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+#ifndef NOMINMAX
+  #define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace quest3d {
+  /** @brief Owned snapshot; its pixels are never read from shared memory after unlocking. */
+  struct frame {
+    frame_header header {};  ///< Validated metadata for these pixels.
+    source_identity source {};  ///< v3 source identity copied under the same payload mutex.
+    std::vector<std::uint8_t> pixels;  ///< BGRA bytes copied while holding the producer mutex.
+  };
+
+  /** @brief Identifiers shared by a publisher and one or more consumers. */
+  struct object_names {
+    std::wstring mapping = L"Local\\Quest3D.Frame.v2";  ///< Named file mapping.
+    std::wstring mutex = L"Local\\Quest3D.Frame.Mutex.v2";  ///< Guards header and payload together.
+    std::wstring ready = L"Local\\Quest3D.Frame.Ready.v2";  ///< Optional auto-reset readiness hint.
+    std::wstring producer = L"Local\\Quest3D.Frame.Producer.v2";  ///< v3 requires a living writer; no persistent consumer handle.
+    std::uint32_t protocol = 2;  ///< Explicit protocol selection, never auto-detected.
+  };
+
+  /** @brief Select exactly one protocol namespace, optionally with an isolated test prefix. */
+  object_names protocol_names(std::uint32_t protocol, const std::wstring &prefix = L"Local\\Quest3D.Frame");
+
+  /** @brief Result without conflating producer absence, busy state, and malformed data. */
+  enum class read_result {
+    fresh,  ///< A new complete frame was copied.
+    unchanged,  ///< Last accepted frame is still current.
+    unavailable,  ///< Producer objects do not yet exist.
+    busy,  ///< Bounded mutex wait expired.
+    invalid,  ///< Metadata or abandoned write was rejected.
+  };
+
+  /** @brief Allow only a recent, bounded Full-SBS source as a stream profile. */
+  bool full_sbs_profile(const frame_header &header, std::uint64_t now_ns);
+
+  /**
+   * @brief Read the monotonic Windows performance counter in protocol nanoseconds.
+   * @return QPC time in nanoseconds, or zero if QPC is unavailable.
+   */
+  std::uint64_t qpc_nanoseconds();
+
+  /** @brief RAII consumer of the writer-owned shared frame mapping. */
+  class frame_reader {
+  public:
+    /** @brief Initialize an unconnected reader. @param names Protocol object names. */
+    explicit frame_reader(object_names names = {});
+    /** @brief Close mapped memory and kernel handles. */
+    ~frame_reader();
+    frame_reader(const frame_reader &) = delete;
+    frame_reader &operator=(const frame_reader &) = delete;
+
+    /**
+     * @brief Copy at most the latest frame with a bounded wait; never creates producer objects.
+     * @param output Storage for the complete snapshot.
+     * @param wait_ms Maximum combined event/mutex wait in milliseconds.
+     * @return Explicit freshness or failure state.
+     */
+    read_result read(frame &output, DWORD wait_ms);
+    /** @brief Read validated metadata without copying the BGRA payload. */
+    read_result read_metadata(frame_header &output, DWORD wait_ms);
+    /** @brief Hold the producer's frame mutex through a bounded validated-metadata callback; never copy pixels. */
+    bool with_metadata(const std::function<bool(const frame_header &, const source_identity &)> &callback, DWORD wait_ms = 5);
+    /** @brief Disconnect so a later read can open a replacement publisher. */
+    void close();
+    /** @brief Reset to an explicitly selected product protocol before capture initialization. */
+    void select_protocol(std::uint32_t protocol);
+
+  private:
+    /** @brief Shared bounded acquisition; only capture readers copy payload bytes. */
+    read_result read_impl(frame &output, DWORD wait_ms, bool copy_pixels);
+    /** @brief Open existing objects. @return True when map and mutex are ready. */
+    bool open();
+    object_names names_;  ///< Object names for this reader.
+    HANDLE mapping_ = nullptr;  ///< Read-only mapping handle.
+    HANDLE mutex_ = nullptr;  ///< Shared publication mutex.
+    HANDLE ready_ = nullptr;  ///< Optional event handle.
+    const std::uint8_t *view_ = nullptr;  ///< Read-only mapping view.
+    bool guarded_tainted_ = false;  ///< Abandoned publication stays refused until its identity changes.
+    std::uint64_t tainted_id_ = 0, tainted_epoch_ = 0;
+    bool has_frame_ = false;  ///< Whether an identity has been consumed.
+    std::uint64_t last_id_ = 0;  ///< Last accepted frame identity.
+    std::uint64_t last_epoch_ = 0;  ///< Last accepted stream epoch.
+  };
+}  // namespace quest3d
diff --git a/src/platform/windows/quest3d_input.cpp b/src/platform/windows/quest3d_input.cpp
new file mode 100644
index 0000000..c8d8079
--- /dev/null
+++ b/src/platform/windows/quest3d_input.cpp
@@ -0,0 +1,99 @@
+/** @file src/platform/windows/quest3d_input.cpp
+ * @brief Testable stereo/source coordinate conversion and publication guard.
+ */
+#include "quest3d_input.h"
+
+#include <algorithm>
+#include <cmath>
+#include <mutex>
+#include <tuple>
+
+namespace quest3d {
+  namespace {
+    std::mutex geometry_mutex;  ///< Protects the last uploaded frame metadata.
+    std::optional<frame_header> geometry;  ///< Last uploaded frame metadata.
+
+    /** @brief Compare target fields. @param h Snapshot header. @return Geometry identity. */
+    auto geometry_key(const frame_header &h) {
+      return std::tuple {h.stream_epoch, h.geometry_generation, h.width, h.height, h.flags & 11U, h.source_left, h.source_top, h.source_width, h.source_height, h.content_left, h.content_top, h.content_width, h.content_height};
+    }
+
+    /** @brief Normalize a pixel center. @param pixel Desktop-relative pixel. @param dimension Axis size. @return 16-bit absolute coordinate. */
+    std::int32_t normalize(std::int64_t pixel, std::int32_t dimension) {
+      return static_cast<std::int32_t>(std::clamp(std::floor((pixel + 0.5) * 65536.0 / dimension), 0.0, 65535.0));
+    }
+  }  // namespace
+
+  std::optional<absolute_point> map_absolute(const frame_header &h, double u, double v, input_space space, const desktop_rect &desktop) {
+    if (!valid_header(h) || !std::isfinite(u) || !std::isfinite(v) || u < 0 || u > 1 || v < 0 || v > 1 ||
+        desktop.width <= 0 || desktop.height <= 0 || h.content_width == 0 || h.content_height == 0) {
+      return {};
+    }
+    const double eye_width = (h.flags & 1U) ? h.width / 2 : h.width;
+    double x = u * eye_width;
+    const double y = v * h.height;
+    if (space == input_space::combined_canvas_uv && (h.flags & 1U)) {
+      x = u == 1.0 ? eye_width : std::fmod(u * h.width, eye_width);
+    }
+    if (x < h.content_left || x > static_cast<double>(h.content_left) + h.content_width ||
+        y < h.content_top || y > static_cast<double>(h.content_top) + h.content_height) {
+      return {};
+    }
+    const auto px = static_cast<std::int64_t>(h.source_left) + std::llround((x - h.content_left) / h.content_width * (h.source_width - 1));
+    const auto py = static_cast<std::int64_t>(h.source_top) + std::llround((y - h.content_top) / h.content_height * (h.source_height - 1));
+    const auto rx = px - desktop.left;
+    const auto ry = py - desktop.top;
+    if (rx < 0 || ry < 0 || rx >= desktop.width || ry >= desktop.height || px < INT32_MIN || px > INT32_MAX || py < INT32_MIN || py > INT32_MAX) {
+      return {};
+    }
+    return absolute_point {static_cast<std::int32_t>(px), static_cast<std::int32_t>(py), normalize(rx, desktop.width), normalize(ry, desktop.height)};
+  }
+
+  frame_metadata_ptr publish_input_geometry(const frame_header &header, const source_identity &source) {
+    std::lock_guard lock(geometry_mutex);
+    geometry = valid_header(header) && valid_source_identity(header, source) ? std::optional {header} : std::nullopt;
+    return uploaded_frames.publish(header, source);
+  }
+
+  std::optional<frame_header> input_geometry() {
+    std::lock_guard lock(geometry_mutex);
+    return geometry;
+  }
+
+  void clear_input_geometry() {
+    std::lock_guard lock(geometry_mutex);
+    geometry.reset();
+    uploaded_frames.clear();
+  }
+
+  guard_result input_guard::observe(const std::optional<frame_header> &header, std::uint64_t now_ns) {
+    const bool changed = header && (!previous_ || geometry_key(*header) != geometry_key(*previous_));
+    const bool regression = header && previous_ && header->stream_epoch == previous_->stream_epoch && header->geometry_generation < previous_->geometry_generation;
+    const bool allowed = header && valid_header(*header) && (header->flags & 8U) &&
+                         (!(header->flags & 1U) || (header->flags & 2U)) && !regression &&
+                         now_ns >= header->publish_qpc_ns && now_ns - header->publish_qpc_ns <= 500000000ULL;
+    const bool release = changed || (allowed_ && !allowed);
+    if (release || !allowed) {
+      positioned_ = false;
+    }
+    if (header && !regression) {
+      previous_ = header;
+    }
+    allowed_ = allowed;
+    return {allowed, release};
+  }
+
+  void input_guard::position(bool valid) {
+    positioned_ = allowed_ && valid;
+  }
+
+  bool input_guard::positioned() const {
+    return positioned_;
+  }
+
+  void input_guard::reset() {
+    previous_.reset();
+    allowed_ = false;
+    positioned_ = false;
+  }
+}  // namespace quest3d
diff --git a/src/platform/windows/quest3d_input.h b/src/platform/windows/quest3d_input.h
new file mode 100644
index 0000000..3e1ec9b
--- /dev/null
+++ b/src/platform/windows/quest3d_input.h
@@ -0,0 +1,67 @@
+/** @file src/platform/windows/quest3d_input.h
+ * @brief Physical-pixel input geometry and fail-closed policy for Quest3D streams.
+ */
+#pragma once
+#include "quest3d_frame.h"
+
+#include <optional>
+
+namespace quest3d {
+  /** @brief Distinguishes a logical one-eye pointer from a point in the packed stereo image. */
+  enum class input_space {
+    logical_eye_uv,
+    combined_canvas_uv
+  };
+
+  /** @brief Win32 virtual desktop rectangle in physical pixels. */
+  struct desktop_rect {
+    std::int32_t left, top, width, height;  ///< Physical desktop origin and dimensions.
+  };
+
+  /** @brief Result ready for Win32 SendInput with MOUSEEVENTF_VIRTUALDESK. */
+  struct absolute_point {
+    std::int32_t physical_x, physical_y;  ///< Target physical pixel.
+    std::int32_t normalized_x, normalized_y;  ///< Pixel-center coordinates in [0,65535].
+  };
+
+  /**
+   * @brief Map a pointer through eye-local padding and the original physical source rectangle.
+   * @param header Validated source metadata.
+   * @param u Horizontal normalized coordinate in the explicit input space.
+   * @param v Vertical normalized coordinate.
+   * @param space Meaning of u/v; never inferred from SBS flags alone.
+   * @param desktop Physical virtual desktop including negative monitor origins.
+   * @return Physical/SendInput point, or empty for padding, invalid coordinates, or off-desktop sources.
+   */
+  std::optional<absolute_point> map_absolute(const frame_header &header, double u, double v, input_space space, const desktop_rect &desktop);
+  /** @brief Store metadata only after the corresponding frame reached a GPU snapshot. @param header Snapshot metadata. */
+  frame_metadata_ptr publish_input_geometry(const frame_header &header, const source_identity &source = {});
+  /** @brief Read the last GPU snapshot metadata without copying pixels. @return Last metadata, if any. */
+  std::optional<frame_header> input_geometry();
+  /** @brief Clear geometry when an external source is invalidated. */
+  void clear_input_geometry();
+
+  /** @brief Result of reevaluating a stream's input permission. */
+  struct guard_result {
+    bool allowed;  ///< Geometry is currently suitable for opt-in 2D control.
+    bool release_held;  ///< The caller must release tracked buttons and keys now.
+  };
+
+  /** @brief Host-side safety state; does not claim client generation acknowledgement. */
+  class input_guard {
+  public:
+    /** @brief Reevaluate metadata and liveness. @param header Current snapshot. @param now_ns QPC now. @return Permission/reset result. */
+    guard_result observe(const std::optional<frame_header> &header, std::uint64_t now_ns);
+    /** @brief Require a valid absolute position before buttons/keys. @param valid Whether pointer is inside content. */
+    void position(bool valid);
+    /** @brief Forget a disconnected/resumed connection's position and geometry. */
+    void reset();
+    /** @brief Whether a valid position is bound to the current geometry. @return Current position validity. */
+    bool positioned() const;
+
+  private:
+    std::optional<frame_header> previous_;  ///< Last accepted geometry identity.
+    bool allowed_ = false;  ///< Previous permission state.
+    bool positioned_ = false;  ///< Current geometry has a valid pointer position.
+  };
+}  // namespace quest3d
diff --git a/src/platform/windows/quest3d_instance.cpp b/src/platform/windows/quest3d_instance.cpp
new file mode 100644
index 0000000..f5a637a
--- /dev/null
+++ b/src/platform/windows/quest3d_instance.cpp
@@ -0,0 +1,45 @@
+/**
+ * @file src/platform/windows/quest3d_instance.cpp
+ * @brief Cross-runtime Quest3D singleton without PID files or port reuse assumptions.
+ */
+#include "quest3d_instance.h"
+
+namespace quest3d {
+  std::wstring instance_guard::name(std::uint16_t port) {
+    return L"Global\\Quest3D.Sunshine.Port." + std::to_wstring(port);
+  }
+
+  bool instance_guard::acquire(std::uint16_t port) {
+    if (mutex_ || port == 0) {
+      error_ = ERROR_INVALID_PARAMETER;
+      return false;
+    }
+    // Mutex creation in Global does not require the file-mapping privilege.
+    // Access denial or an incompatible existing object fails closed.
+    auto handle = CreateMutexW(nullptr, FALSE, name(port).c_str());
+    if (!handle) {
+      error_ = GetLastError();
+      return false;
+    }
+    const auto result = WaitForSingleObject(handle, 0);
+    if (result == WAIT_OBJECT_0 || result == WAIT_ABANDONED) {
+      mutex_ = handle;
+      error_ = ERROR_SUCCESS;
+      return true;
+    }
+    error_ = result == WAIT_TIMEOUT ? ERROR_ALREADY_EXISTS : GetLastError();
+    CloseHandle(handle);
+    return false;
+  }
+
+  DWORD instance_guard::error() const {
+    return error_;
+  }
+
+  instance_guard::~instance_guard() {
+    if (mutex_) {
+      ReleaseMutex(mutex_);
+      CloseHandle(mutex_);
+    }
+  }
+}  // namespace quest3d
