+/**
+ * @file tests/integration/test_quest3d_pipeline.cpp
+ * @brief Opt-in real publisher to D3D11/NVENC validation without networking or input.
+ */
+#ifdef _WIN32
+  #include "src/config.h"
+  #include "src/nvenc/nvenc_encoder.h"
+  #include "src/platform/windows/display_quest3d.h"
+  #include "src/platform/windows/quest3d_frame.h"
+  #include "src/video.h"
+  #include "tests/tests_common.h"
+
+  #include <cstdlib>
+  #include <filesystem>
+  #include <fstream>
+
+namespace video {
+  std::unique_ptr<encode_session_t> make_encode_session(platf::display_t *, const encoder_t &, const config_t &, int, int, std::unique_ptr<platf::encode_device_t>);
+  int encode(int64_t, encode_session_t &, safe::mail_raw_t::queue_t<packet_t> &, void *, std::optional<std::chrono::steady_clock::time_point>);
+}  // namespace video
+
+namespace platf::dxgi {
+  /** @brief Compile the existing encoder conversion shaders. @return Zero on success. */
+  int init();
+}  // namespace platf::dxgi
+
+/**
+ * @brief Encode actual producer frames through the production SourceProvider in both SDR codecs.
+ * @details QUEST3D_PIPELINE_OUTPUT opts into GPU execution and supplies an existing output directory.
+ * No server, audio endpoint, input injector, or NVIDIA profile manager is started.
+ */
+TEST(Quest3DExternalSource, RealPublisherToNvenc) {
+  const auto output_path = std::getenv("QUEST3D_PIPELINE_OUTPUT");
+  if (!output_path || !*output_path) {
+    GTEST_SKIP() << "Set QUEST3D_PIPELINE_OUTPUT while the real frame producer is running";
+  }
+  ASSERT_TRUE(std::filesystem::is_directory(output_path));
+  const auto requested_protocol = std::getenv("QUEST3D_PIPELINE_PROTOCOL");
+  const int protocol = requested_protocol && std::string(requested_protocol)=="3" ? 3 : 2;
+  ASSERT_TRUE(!requested_protocol || std::string(requested_protocol)=="2" || std::string(requested_protocol)=="3");
+  const auto previous_protocol=config::sunshine.quest3d_protocol;
+  auto restore_protocol=util::fail_guard([&] { config::sunshine.quest3d_protocol=previous_protocol; });
+  config::sunshine.quest3d_protocol=protocol;
+  quest3d::frame_reader metadata_reader(quest3d::protocol_names(protocol));
+  quest3d::frame source;
+  ASSERT_EQ(metadata_reader.read(source, 1000), quest3d::read_result::fresh);
+  ASSERT_EQ(platf::dxgi::init(), 0);
+
+  const auto previous_capture = config::video.capture;
+  auto restore_capture = util::fail_guard([&]() {
+    config::video.capture = previous_capture;
+  });
+  config::video.capture = "quest3d";
+  for (const auto codec : {0, 1}) {
+    video::config_t client {};
+    client.width = static_cast<int>(source.header.width);
+    client.height = static_cast<int>(source.header.height);
+    client.framerate = 30;
+    client.bitrate = 20000;
+    client.slicesPerFrame = 1;
+    client.numRefFrames = 1;
+    client.encoderCscMode = 2;
+    client.videoFormat = codec;
+
+    auto display = std::dynamic_pointer_cast<platf::dxgi::display_quest3d_vram_t>(platf::display(platf::mem_type_e::dxgi, "", client));
+    ASSERT_TRUE(display);
+    ASSERT_EQ(display->width, client.width);
+    ASSERT_EQ(display->height, client.height);
+    auto encoder = display->make_nvenc_encode_device(platf::pix_fmt_e::nv12);
+    ASSERT_TRUE(encoder);
+    encoder->colorspace = {video::colorspace_e::rec709, false, 8};
+    auto encode_session = video::make_encode_session(display.get(), video::nvenc, client, client.width, client.height, std::move(encoder));
+    ASSERT_TRUE(encode_session);
+    auto mailbox = std::make_shared<safe::mail_raw_t>();
+    auto packets = mailbox->queue<video::packet_t>("quest3d_pipeline_test");
+    const std::string owner = "inert-pipeline-test", epoch(32, 'a');
+    quest3d::frame_ledger ledger(owner, epoch);
+    {
+      auto dummy = display->alloc_img();
+      ASSERT_TRUE(dummy);
+      ASSERT_EQ(display->dummy_img(dummy.get()), 0);
+      ASSERT_FALSE(dummy->quest3d_metadata);
+      ASSERT_EQ(encode_session->convert(*dummy), 0);
+      encode_session->request_idr_frame();
+      ASSERT_EQ(video::encode(0, *encode_session, packets, nullptr, {}), 0);
+      auto dummy_packet = packets->pop(std::chrono::milliseconds(100));
+      ASSERT_TRUE(dummy_packet);
+      ASSERT_FALSE(dummy_packet->quest3d_identity);
+    }
+
+    const auto basename = codec == 0 ? "quest3d-h264" : "quest3d-hevc";
+    const auto directory = std::filesystem::path(output_path);
+    std::ofstream bitstream(directory / (std::string(basename) + (codec == 0 ? ".h264" : ".hevc")), std::ios::binary);
+    std::ofstream metrics(directory / (std::string(basename) + ".csv"));
+    ASSERT_TRUE(bitstream);
+    ASSERT_TRUE(metrics);
+    metrics << "index,source_age_ms,snapshot_wait_copy_upload_ms,convert_ms,encode_ms,bytes,publisher_frame_id,publisher_epoch,geometry_generation,host_geometry_revision,flags\n";
+    auto pooled = display->alloc_img();
+    ASSERT_TRUE(pooled);
+    const auto pull = [&](std::shared_ptr<platf::img_t> &out) {
+      out = pooled;
+      return true;
+    };
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(15);
+    std::uint64_t index = 1;
+    while (index <= 24 && std::chrono::steady_clock::now() < deadline) {
+      std::shared_ptr<platf::img_t> image;
+      const auto started = std::chrono::steady_clock::now();
+      const auto status = display->snapshot(pull, image, std::chrono::milliseconds(200), false);
+      if (status == platf::capture_e::timeout) {
+        continue;
+      }
+      ASSERT_EQ(status, platf::capture_e::ok);
+      ASSERT_TRUE(image);
+      ASSERT_TRUE(image->frame_timestamp);
+      const auto uploaded = std::chrono::steady_clock::now();
+      ASSERT_TRUE(image->quest3d_metadata);
+      const auto image_identity = image->quest3d_metadata;
+      ASSERT_TRUE(quest3d::valid_source_identity(image_identity->header,image_identity->source));
+      ASSERT_EQ(image_identity->header.version,protocol);
+      ASSERT_EQ(image_identity->source,source.source);
+      ASSERT_EQ(encode_session->convert(*image), 0);
+      // Reusing the image's metadata slot cannot alter an already converted surface.
+      image->quest3d_metadata.reset();
+      const auto converted = std::chrono::steady_clock::now();
+      if (index == 1) {
+        encode_session->request_idr_frame();
+      }
+      ASSERT_EQ(video::encode(index, *encode_session, packets, nullptr, image->frame_timestamp), 0);
+      auto packet = packets->pop(std::chrono::milliseconds(100));
+      encode_session->request_normal_frame();
+      const auto encoded = std::chrono::steady_clock::now();
+      ASSERT_TRUE(packet);
+      ASSERT_GT(packet->data_size(), 0U);
+      ASSERT_EQ(packet->frame_index(), index);
+      ASSERT_TRUE(packet->quest3d_identity);
+      ASSERT_EQ(packet->quest3d_identity->source, image_identity);
+      ASSERT_EQ(packet->quest3d_identity->index, index);
+      // The ledger commit is a send-success policy injection, not network/HMD proof.
+      ASSERT_TRUE(ledger.record_sent(packet->quest3d_identity, index, true, encoded));
+      ASSERT_TRUE(ledger.lookup(owner, epoch, static_cast<std::uint32_t>(index), image_identity, encoded));
+      if (index == 1) {
+        ASSERT_TRUE(packet->is_idr());
+      }
+      bitstream.write(reinterpret_cast<const char *>(packet->data()), static_cast<std::streamsize>(packet->data_size()));
+      ASSERT_TRUE(bitstream);
+      const auto ms = [](auto duration) {
+        return std::chrono::duration<double, std::milli>(duration).count();
+      };
+      metrics << index << ',' << ms(encoded - *image->frame_timestamp) << ',' << ms(uploaded - started) << ','
+              << ms(converted - uploaded) << ',' << ms(encoded - converted) << ',' << packet->data_size() << ','
+              << image_identity->header.frame_id << ',' << image_identity->header.stream_epoch << ','
+              << image_identity->header.geometry_generation << ',' << image_identity->geometry_revision << ',' << image_identity->header.flags << '\n';
+      image->quest3d_metadata = image_identity;
+      ASSERT_EQ(display->release_snapshot(), platf::capture_e::ok);
+      ++index;
+    }
+    ASSERT_EQ(index, 25U) << "Producer did not supply 24 distinct valid frames within 15 seconds";
+    const auto last_pixels = pooled->quest3d_metadata;
+    pooled->quest3d_metadata.reset();
+    ASSERT_EQ(video::encode(index, *encode_session, packets, nullptr, {}), 0);
+    auto repeated_packet = packets->pop(std::chrono::milliseconds(100));
+    ASSERT_TRUE(repeated_packet);
+    ASSERT_TRUE(repeated_packet->quest3d_identity);
+    ASSERT_EQ(repeated_packet->quest3d_identity->source, last_pixels);
+  }
+}
+#endif
