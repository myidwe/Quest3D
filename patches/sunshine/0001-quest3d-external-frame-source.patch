+    std::vector<std::vector<INPUT>> calls;
+    quest3d::pointer_insert insert;
+    std::unique_ptr<quest3d::pointer_endpoint> endpoint;
+    nlohmann::json status, receipt;
+    std::uint32_t index = 1;
+    DPI_AWARENESS_CONTEXT previous_context = nullptr;
+
+    pointer_fixture(bool actual_adapter = false) {
+      static std::atomic<unsigned> serial = 0;
+      previous_context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+      const auto suffix = std::to_wstring(GetCurrentProcessId()) + L"." + std::to_wstring(++serial);
+      names = quest3d::protocol_names(3, L"Local\\Quest3D.Pointer.Fixture." + suffix);
+      directory = std::filesystem::temp_directory_path() / (L"Quest3D.Pointer.Fixture." + suffix);
+      std::filesystem::create_directories(directory);
+      mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, static_cast<DWORD>(quest3d::mapping_capacity + 64), names.mapping.c_str());
+      mutex = CreateMutexW(nullptr, FALSE, names.mutex.c_str());
+      if (!mapping || !mutex) {
+        throw std::runtime_error("fixture mapping");
+      }
+      view = static_cast<unsigned char *>(MapViewOfFile(mapping, FILE_MAP_WRITE, 0, 0, quest3d::mapping_capacity + 64));
+      if (!view) {
+        throw std::runtime_error("fixture view");
+      }
+      std::promise<bool> ready;
+      auto future = ready.get_future();
+      writer = std::thread([this, &ready] {
+        auto owner_mutex = CreateMutexW(nullptr, TRUE, names.producer.c_str());
+        ready.set_value(owner_mutex != nullptr);
+        while (!quit) {
+          Sleep(1);
+        }
+        if (owner_mutex) {
+          if (!abandon) {
+            ReleaseMutex(owner_mutex);
+          }
+          CloseHandle(owner_mutex);
+        }
+      });
+      if (!future.get()) {
+        throw std::runtime_error("fixture owner");
+      }
+      auto monitor = MonitorFromPoint(POINT {100, 100}, MONITOR_DEFAULTTOPRIMARY);
+      MONITORINFO info {sizeof(MONITORINFO)};
+      if (!GetMonitorInfoW(monitor, &info)) {
+        throw std::runtime_error("fixture monitor");
+      }
+      source.kind = quest3d::source_kind::monitor;
+      source.selection_id = 9007199254740993ULL;
+      source.native_handle = reinterpret_cast<std::uintptr_t>(monitor);
+      source.parent_left = info.rcMonitor.left;
+      source.parent_top = info.rcMonitor.top;
+      source.parent_width = info.rcMonitor.right - info.rcMonitor.left;
+      source.parent_height = info.rcMonitor.bottom - info.rcMonitor.top;
+      h.magic = {'Q', '3', 'D', 'F', 'R', 'M', '3', '\0'};
+      h.version = 3;
+      h.header_bytes = 192;
+      h.width = 2560;
+      h.height = 720;
+      h.stride = 10240;
+      h.format = 1;
+      h.payload_bytes = h.stride * h.height;
+      h.flags = 11;
+      h.frame_id = 1;
+      h.stream_epoch = 9007199254740995ULL;
+      h.geometry_generation = 1;
+      h.source_left = source.parent_left;
+      h.source_top = source.parent_top;
+      h.source_width = source.parent_width;
+      h.source_height = source.parent_height;
+      h.content_width = 1280;
+      h.content_height = 720;
+      h.capture_qpc_ns = h.publish_qpc_ns = qpc;
+      status = {{"running", true}, {"input_opt_in", true}, {"input_enabled", true}, {"requested_mode", "2d"}, {"effective_mode", "2d"}, {"stream_epoch", h.stream_epoch}, {"updated_monotonic_ns", qpc}, {"applied_request", initial_control}};
+      quest3d::pointer_control_mutation([&] {
