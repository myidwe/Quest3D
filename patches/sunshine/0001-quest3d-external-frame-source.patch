+
+    void write_raw() {
+      if (WaitForSingleObject(mutex, 100) != WAIT_OBJECT_0) {
+        throw std::runtime_error("fixture mutex");
+      }
+      std::memcpy(view, &h, 128);
+      std::memcpy(view + 128, &source, 64);
+      ReleaseMutex(mutex);
+    }
+
+    void publish() {
+      write_raw();
+      auto metadata = registry.publish(h, source);
+      if (!metadata || !ledger.record_sent(quest3d::encoded_identity {metadata, index, now}, index, true, now)) {
+        throw std::runtime_error("fixture ledger");
+      }
+      receipt = endpoint->get(owner, epoch, index, qpc, now).body;
+    }
+
+    nlohmann::json request(std::uint32_t seq = 1) {
+      nlohmann::json result = {{"version", 1}, {"transport_epoch", epoch}, {"frame_index", index}, {"request_id", quest3d::pointer_request_id(epoch, seq)}, {"input_seq", seq}, {"operation", "click"}, {"button", "left"}, {"u", .5}, {"v", .5}, {"encoded_eye", 0}, {"dry_run", false}, {"decoder_epoch", "1"}, {"lease_serial", "2"}, {"submission_cycle", "3"}, {"panel_generation", "4"}, {"mapping_generation", "5"}, {"pixel_latch_age_us", 1000}, {"submission_age_us", 500}};
+      for (const auto *key : {"frame_geometry_token", "source_id", "source_generation", "geometry_revision", "layout_id"}) {
+        result[key] = receipt.at(key);
+      }
+      return result;
+    }
+
+    quest3d::control_reply post(const nlohmann::json &value, quest3d::pointer_endpoint::refresh_clock clock = {}) {
+      return endpoint->post(owner, value.dump(), quest3d::pointer_desktop(), qpc, now, clock);
+    }
+  };
+}  // namespace quest3d_test
diff --git a/tests/unit/platform/windows/test_quest3d_input.cpp b/tests/unit/platform/windows/test_quest3d_input.cpp
new file mode 100644
index 0000000..d46b17f
--- /dev/null
+++ b/tests/unit/platform/windows/test_quest3d_input.cpp
@@ -0,0 +1,191 @@
+/** @file tests/unit/platform/windows/test_quest3d_input.cpp
+ * @brief Dispatch/lifecycle regressions with fake devices and an intercepted pointer.
+ */
+#ifdef _WIN32
+  #include "src/config.h"
+  #include "src/input.h"
+  #include "src/platform/virtualhid_input.h"
+  #include "src/platform/windows/quest3d_input.h"
+  #include "tests/tests_common.h"
+
+  #include <cstring>
+extern "C" {
+  #include <moonlight-common-c/src/Input.h>
+}
+
+namespace {
+  /** @brief Encode a native protocol structure without any network traffic. */
+  template<class T>
+  std::vector<std::uint8_t> bytes(T packet, std::uint32_t magic) {
+    packet.header.size = util::endian::big<std::uint32_t>(sizeof(T) - sizeof(packet.header.size));
+    packet.header.magic = util::endian::little(magic);
+    std::vector<std::uint8_t> result(sizeof(T));
+    std::memcpy(result.data(), &packet, sizeof(T));
+    return result;
+  }
+
+  /** @brief All emissions remain in memory; no Win32 mouse/keyboard event can be injected. */
+  class Quest3DInputDispatch: public ::testing::Test {
+  protected:
+    void SetUp() override {
+      previous_input = config::input;
+      previous_capture = config::video.capture;
+      config::video.capture = "quest3d";
+      config::input.mouse = config::input.keyboard = true;
+      config::input.key_repeat_delay = std::chrono::milliseconds(0);
+      config::input.keybindings.clear();
+      auto platform = platf::input();
+      ASSERT_TRUE(platform);
+      auto &backend = platf::virtualhid::get_input_context(platform);
+      backend = platf::virtualhid::input_context_t {lvh::BackendKind::fake};
+      context = &backend;
+      input::testing::set_platform_input(std::move(platform));
+      input::testing::reset_keyboard_state();
+      input::testing::set_keyboard_sink([&](const auto &event) {
+        keys.push_back(event);
+      });
+      input::testing::set_quest3d_pointer_sink([&](int x, int y, int, int) {
+        points.emplace_back(x, y);
+      });
+      mailbox = std::make_shared<safe::mail_raw_t>();
+      stream = input::alloc(mailbox, "quest3d-input-regression");
+      mailbox->event<input::touch_port_t>(mail::touch_port)->raise(input::touch_port_t {{0, 0, 2560, 720}, 2560, 1440, 0, 0, 1, 1, 0, 0});
+      h.magic = {'Q', '3', 'D', 'F', 'R', 'M', '2', '\0'};
+      h.version = 2;
+      h.header_bytes = 128;
+      h.width = 2560;
+      h.height = 720;
+      h.stride = h.width * 4;
+      h.format = 1;
+      h.frame_id = 1;
+      h.stream_epoch = 1;
+      h.geometry_generation = 1;
+      h.capture_qpc_ns = h.publish_qpc_ns = quest3d::qpc_nanoseconds();
+      h.payload_bytes = h.stride * h.height;
+      h.flags = 11;
+      h.source_left = 100;
+      h.source_top = 50;
+      h.source_width = 1000;
+      h.source_height = 600;
+      h.content_width = 1280;
+      h.content_height = 720;
+      quest3d::publish_input_geometry(h);
+    }
+
+    void TearDown() override {
+      if (stream) {
+        input::testing::reset_input_now(stream);
+      }
+      input::testing::set_keyboard_sink({});
+      input::testing::set_quest3d_pointer_sink({});
+      input::testing::reset_keyboard_state();
+      stream.reset();
+      mailbox.reset();
+      input::testing::set_platform_input({});
+      quest3d::clear_input_geometry();
+      config::input = previous_input;
+      config::video.capture = previous_capture;
+    }
+
+    void move(int x = 500, int y = 500) {
+      NV_ABS_MOUSE_MOVE_PACKET packet {};
+      packet.x = util::endian::big<short>(x);
+      packet.y = util::endian::big<short>(y);
+      packet.width = packet.height = util::endian::big<short>(1000);
+      input::testing::dispatch_packet_now(stream, bytes(packet, MOUSE_MOVE_ABS_MAGIC));
+    }
+
+    void key(std::uint16_t vk = 0x41) {
+      NV_KEYBOARD_PACKET packet {};
+      packet.keyCode = static_cast<short>(vk);
+      input::testing::dispatch_packet_now(stream, bytes(packet, KEY_DOWN_EVENT_MAGIC));
+    }
+
+    void button() {
+      NV_MOUSE_BUTTON_PACKET packet {};
+      packet.button = 1;
+      input::testing::dispatch_packet_now(stream, bytes(packet, MOUSE_BUTTON_DOWN_EVENT_MAGIC_GEN5));
+    }
+
+    config::input_t previous_input;
+    std::string previous_capture;
+    platf::virtualhid::input_context_t *context = nullptr;
+    safe::mail_t mailbox;
+    std::shared_ptr<input::input_t> stream;
+    quest3d::frame_header h {};
+    std::vector<input::testing::keyboard_event_t> keys;
+    std::vector<std::pair<int, int>> points;
+  };
+}  // namespace
+
+TEST_F(Quest3DInputDispatch, DefaultAndStereoInputAreBlocked) {
+  h.flags = 3;
+  quest3d::publish_input_geometry(h);
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+  h.flags = 9;
+  quest3d::publish_input_geometry(h);
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+}
+
+// The former opt-in untagged route is deliberately closed. Coordinate math is
+// covered by frame_bridge_test and the immutable-ticket pointer tests instead.
+TEST_F(Quest3DInputDispatch, InputEnabledCannotReopenUntaggedRoute) {
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+}
+
+TEST_F(Quest3DInputDispatch, ChangedSourceDoesNotReplayUntaggedClicks) {
+  move();
+  button();
+  h.geometry_generation++;
+  h.source_left += 20;
+  quest3d::publish_input_geometry(h);
+  input::testing::quest3d_watchdog_now(stream);
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+}
+
+TEST_F(Quest3DInputDispatch, ResumedSourceDoesNotReopenLegacyInput) {
+  input::testing::reset_input_now(stream);
+  stream = input::alloc(mailbox, "quest3d-input-regression");
+  mailbox->event<input::touch_port_t>(mail::touch_port)->raise(input::touch_port_t {{0, 0, 2560, 720}, 2560, 1440, 0, 0, 1, 1, 0, 0});
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+}
+
+TEST_F(Quest3DInputDispatch, MonoCannotBypassFrameIdentityRequirement) {
+  h.width = 1280;
+  h.stride = h.width * 4;
+  h.payload_bytes = h.stride * h.height;
+  h.flags = 8;
+  quest3d::publish_input_geometry(h);
+  move();
+  key();
+  button();
+  EXPECT_TRUE(points.empty());
+  EXPECT_TRUE(keys.empty());
+  EXPECT_EQ(context->mouse->submit_count(), 0U);
+}
+#endif
diff --git a/tests/unit/platform/windows/test_quest3d_pointer.cpp b/tests/unit/platform/windows/test_quest3d_pointer.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/platform/windows/test_quest3d_pointer.cpp
@@ -0,0 +1,349 @@
+/** @file tests/unit/platform/windows/test_quest3d_pointer.cpp
+ * @brief Actual immutable-ledger pointer reducer tests; observer records without OS events.
+ */
+#ifdef _WIN32
+  #include <winsock2.h>
+
+  #include "src/rtsp.h"
+  #include "src/stream.h"
+  #include "src/platform/windows/quest3d_pointer.h"
+  #include "tests/tests_common.h"
+
+  #include <thread>
+
+namespace {
+  /** @brief Build real validated metadata, encode identity, completed sends and endpoint. */
+  class Quest3DPointer: public ::testing::Test {
+  protected:
+    const std::string owner = "exact-paired-certificate";
+    const std::string epoch = "0123456789abcdef0123456789abcdef";
+    quest3d::capture_registry registry;
+    quest3d::frame_ledger ledger {owner, epoch};
+    std::vector<quest3d::pointer_action> observed;
+    quest3d::pointer_endpoint endpoint {owner, epoch, ledger, registry, [&](const auto &action) {
+                                          observed.push_back(action);
+                                        }};
+    quest3d::frame_header h {};
+    quest3d::desktop_rect desktop {-1920, -1080, 5760, 3240};
+    const quest3d::frame_clock::time_point now {std::chrono::seconds(10)};
+    const std::uint64_t qpc = 10000000000;
+    nlohmann::json receipt;
+
+    void SetUp() override {
+      h.magic = {'Q', '3', 'D', 'F', 'R', 'M', '2', '\0'};
+      h.version = 2;
+      h.header_bytes = 128;
+      h.width = 2560;
+      h.height = 720;
+      h.stride = 10240;
+      h.format = 1;
+      h.payload_bytes = h.stride * h.height;
+      h.flags = 3;
+      h.frame_id = 9007199254740993ULL;
+      h.stream_epoch = 9007199254740995ULL;
+      h.geometry_generation = 9007199254740997ULL;
+      h.capture_qpc_ns = h.publish_qpc_ns = qpc;
+      h.source_left = -1800;
+      h.source_top = -800;
+      h.source_width = 1001;
+      h.source_height = 601;
+      h.content_left = 100;
+      h.content_top = 60;
+      h.content_width = 1080;
+      h.content_height = 600;
+      send(5);
+      auto reply = endpoint.get(owner, epoch, 5, qpc, now);
+      ASSERT_EQ(reply.code, 200);
+      receipt = reply.body;
+    }
+
+    void send(std::uint64_t index, const quest3d::source_identity &identity = {}) {
+      auto source = registry.publish(h, identity);
+      ASSERT_TRUE(source);
+      EXPECT_TRUE(ledger.record_sent(quest3d::encoded_identity {source, index, now}, index, true, now));
+    }
+
+    nlohmann::json request(std::uint32_t sequence = 1) {
+      nlohmann::json out = {{"version", 1}, {"transport_epoch", epoch}, {"frame_index", 5}, {"request_id", std::string(31, 'a') + char('0' + sequence)}, {"input_seq", sequence}, {"operation", "click"}, {"button", "left"}, {"u", .5}, {"v", .5}, {"encoded_eye", 0}, {"dry_run", true}, {"decoder_epoch", "1"}, {"lease_serial", "2"}, {"submission_cycle", "3"}, {"panel_generation", "4"}, {"mapping_generation", "5"}, {"pixel_latch_age_us", 1000}, {"submission_age_us", 500}};
+      for (const auto *key : {"frame_geometry_token", "source_id", "source_generation", "geometry_revision", "layout_id"}) {
+        out[key] = receipt[key];
+      }
+      out["frame_index"] = receipt["frame_index"];
+      return out;
+    }
+
+    quest3d::control_reply post(const nlohmann::json &value) {
+      return endpoint.post(owner, value.dump(), desktop, qpc, now);
+    }
+  };
+}  // namespace
+
+TEST_F(Quest3DPointer, ActualSentIdentityRoundTripsWithoutUint64PrecisionLoss) {
+  EXPECT_EQ(receipt["publisher_frame_id"], "9007199254740993");
+  EXPECT_EQ(receipt["publisher_epoch"], "9007199254740995");
+  EXPECT_EQ(receipt["source_generation"], "9007199254740997");
+  EXPECT_EQ(receipt["source_kind"], "unspecified_v2");
+  EXPECT_EQ(receipt["host_remaining_ttl_ms"], 500);
+  auto result = post(request());
+  ASSERT_EQ(result.code, 200);
+  ASSERT_EQ(observed.size(), 1U);
+  EXPECT_EQ(observed[0].point.physical_x, -1300);
+  EXPECT_EQ(observed[0].point.physical_y, -500);
+  EXPECT_EQ(result.body["outcome"], "validated_dry_run");
+  EXPECT_EQ(result.body["applied"], false);
+  EXPECT_EQ(result.body["input_enabled"], false);
+}
+
+TEST_F(Quest3DPointer, BothEyesUseTheSameOriginalSourceAndPreserveAtomicAction) {
+  auto first = request();
+  EXPECT_EQ(post(first).code, 200);
+  auto second = request(2);
+  second["encoded_eye"] = 1;
+  second["button"] = "right";
+  EXPECT_EQ(post(second).code, 200);
+  ASSERT_EQ(observed.size(), 2U);
+  EXPECT_EQ(observed[0].point.physical_x, observed[1].point.physical_x);
+  EXPECT_TRUE(observed[0].click);
+  EXPECT_FALSE(observed[0].right);
+  EXPECT_TRUE(observed[1].right);
+}
+
+TEST_F(Quest3DPointer, NoOsInputEvenWhenRequestAndPublisherAskForIt) {
+  h.flags = 11;
+  send(6);
+  receipt = endpoint.get(owner, epoch, 6, qpc, now).body;
+  auto action = request();
+  action["frame_index"] = 6;
+  action["dry_run"] = false;
+  EXPECT_EQ(post(action).code, 423);
+  EXPECT_TRUE(observed.empty());
+  static_assert(!quest3d::pointer_endpoint::default_os_input_enabled);
+}
+
+TEST_F(Quest3DPointer, UnknownOwnerTransportIndexAndTicketFailClosed) {
+  EXPECT_EQ(endpoint.get("different", epoch, 5, qpc, now).code, 403);
+  EXPECT_EQ(endpoint.get(owner, std::string(32, 'c'), 5, qpc, now).code, 403);
+  EXPECT_EQ(endpoint.get(owner, epoch, 4, qpc, now).code, 410);
+  auto action = request();
+  action["frame_geometry_token"] = std::string(32, 'f');
+  EXPECT_EQ(post(action).code, 410);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, OldFrameCannotBorrowNewSourceOrModeRoundTrip) {
+  h.source_left += 10;
+  h.geometry_generation++;
+  send(6);
+  EXPECT_EQ(post(request()).code, 410);
+  EXPECT_TRUE(observed.empty());
+  h.source_left -= 10;
+  h.geometry_generation--;
+  send(7);
+  EXPECT_EQ(post(request(2)).code, 410);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, TamperedSourceLayoutAndGenerationNeverMap) {
+  std::uint32_t seq = 0;
+  for (const auto *field : {"source_id", "layout_id", "source_generation", "geometry_revision"}) {
+    auto action = request(++seq);
+    action[field] = std::string_view(field).ends_with("id") ? std::string(32, 'e') : "123";
+    EXPECT_EQ(post(action).code, 409) << field;
+  }
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, WarpedFramesReturnIdentityButRefusePointer) {
+  h.flags = 1;
+  send(6);
+  auto result = endpoint.get(owner, epoch, 6, qpc, now);
+  ASSERT_EQ(result.code, 200);
+  EXPECT_EQ(result.body["mode"], "3d");
+  receipt = result.body;
+  auto action = request();
+  action["frame_index"] = 6;
+  EXPECT_EQ(post(action).code, 409);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, LetterboxOutsideDesktopAndInvalidNumbersAreNotClamped) {
+  auto action = request();
+  action["u"] = 0;
+  EXPECT_EQ(post(action).code, 422);
+  action = request(2);
+  action["u"] = -.001;
+  EXPECT_EQ(post(action).code, 400);
+  action = request(3);
+  action["v"] = 1.001;
+  EXPECT_EQ(post(action).code, 400);
+  desktop = {0, 0, 1920, 1080};
+  EXPECT_EQ(post(request(4)).code, 422);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, HostExpiryIsRecomputedAndClientAgesCannotExtendIt) {
+  auto action = request();
+  action["pixel_latch_age_us"] = 0;
+  action["submission_age_us"] = 0;
+  EXPECT_EQ(endpoint.post(owner, action.dump(), desktop, qpc, now + std::chrono::milliseconds(501)).code, 410);
+  EXPECT_EQ(endpoint.get(owner, epoch, 5, qpc, now + std::chrono::milliseconds(501)).code, 410);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, StaleOrFuturePublisherAndStoppedLedgerRefuse) {
+  EXPECT_EQ(endpoint.get(owner, epoch, 5, qpc + 500000001, now).code, 403);
+  EXPECT_EQ(endpoint.get(owner, epoch, 5, qpc - 1, now).code, 403);
+  ledger.stop();
+  EXPECT_EQ(post(request()).code, 410);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, DuplicateIsAnIdenticalResultNotAnotherAction) {
+  auto action = request();
+  auto result = post(action);
+  ASSERT_EQ(result.code, 200);
+  EXPECT_EQ(post(action).body, result.body);
+  EXPECT_EQ(observed.size(), 1U);
+  action["u"] = .6;
+  EXPECT_EQ(post(action).code, 409);
+  EXPECT_EQ(observed.size(), 1U);
+  action = request(2);
+  action["input_seq"] = 1;
+  EXPECT_EQ(post(action).code, 409);
+  EXPECT_EQ(observed.size(), 1U);
+}
+
+TEST_F(Quest3DPointer, StopAndUint32WrapRequireNewTransport) {
+  auto action = request();
+  action["input_seq"] = UINT32_MAX;
+  EXPECT_EQ(post(action).code, 200);
+  EXPECT_EQ(post(request(2)).code, 409);
+  endpoint.stop();
+  EXPECT_EQ(post(action).code, 403);
+  EXPECT_EQ(endpoint.get(owner, epoch, 5, qpc, now).code, 403);
+  EXPECT_EQ(observed.size(), 1U);
+}
+
+TEST_F(Quest3DPointer, MalformedBoundedSchemaAndDuplicateKeysRefuse) {
+  EXPECT_EQ(endpoint.post(owner, std::string(4097, ' '), desktop, qpc, now).code, 413);
+  auto action = request();
+  auto text = action.dump();
+  text.insert(1, "\"u\":0.25,");
+  EXPECT_EQ(endpoint.post(owner, text, desktop, qpc, now).code, 400);
+  for (const auto *key : {"operation", "dry_run", "source_id", "decoder_epoch"}) {
+    action = request();
+    action.erase(key);
+    EXPECT_EQ(post(action).code, 400);
+  }
+  action = request();
+  action["decoder_epoch"] = 9007199254740993ULL;
+  EXPECT_EQ(post(action).code, 400);
+  action = request();
+  action["u"] = true;
+  EXPECT_EQ(post(action).code, 400);
+  action = request();
+  action["submission_age_us"] = 250001;
+  EXPECT_EQ(post(action).code, 400);
+  action = request();
+  action["command"] = "not-executable";
+  EXPECT_EQ(post(action).code, 400);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, CurrentGeometryChangesCannotRelabelTheReceipt) {
+  std::thread writer([&] {
+    auto other = h;
+    for (int i = 0; i < 1000; ++i) {
+      other.geometry_generation++;
+      other.source_left++;
+      registry.publish(other);
+    }
+  });
+  writer.join();
+  EXPECT_EQ(post(request()).code, 410);
+  EXPECT_TRUE(observed.empty());
+  EXPECT_EQ(receipt["source_rect"]["left"], -1800);
+}
+
+TEST_F(Quest3DPointer, Uint32HighBitAndMaximumAreAcceptedWithoutSignedConversion) {
+  for (auto index : {0x80000000U, 0xffffffffU}) {
+    send(index);
+    auto result = endpoint.get(owner, epoch, index, qpc, now);
+    ASSERT_EQ(result.code, 200);
+    EXPECT_EQ(result.body["frame_index"], index);
+  }
+}
+
+TEST_F(Quest3DPointer, ExpiredReplayHistoryCannotDuplicateAnAction) {
+  auto action = request();
+  EXPECT_EQ(post(action).code, 200);
+  h.publish_qpc_ns = qpc + 3000000000ULL;
+  registry.publish(h);
+  EXPECT_EQ(endpoint.post(owner, action.dump(), desktop, h.publish_qpc_ns, now + std::chrono::seconds(3)).code, 409);
+  EXPECT_EQ(observed.size(), 1U);
+}
+
+TEST_F(Quest3DPointer, LockWaitCannotReuseFreshEntryTime) {
+  auto result = endpoint.get(owner, epoch, 5, qpc, now, [&] {
+    return quest3d::pointer_endpoint::clock_sample {qpc + 501000000, now + std::chrono::milliseconds(501)};
+  });
+  EXPECT_EQ(result.code, 403);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, ExpirationDuringFinalDispatchPreventsObserver) {
+  unsigned reads = 0;
+  auto result = endpoint.post(owner, request().dump(), desktop, qpc, now, [&] {
+    const auto age = ++reads == 1 ? 0 : 501;
+    return quest3d::pointer_endpoint::clock_sample {qpc + age * 1000000ULL, now + std::chrono::milliseconds(age)};
+  });
+  EXPECT_EQ(reads, 2U);
+  EXPECT_EQ(result.code, 410);
+  EXPECT_TRUE(observed.empty());
+}
+
+TEST_F(Quest3DPointer, ActualSessionStopTransitionSerializesFinalPointerDispatch) {
+  EXPECT_TRUE(stream::session::test_pointer_stop_barrier());
+}
+
+TEST_F(Quest3DPointer, V3SelectionLifetimeCannotBeBorrowedFromLatestSource) {
+  h.version=3; h.header_bytes=192; h.magic[6]='3';
+  quest3d::source_identity source;
+  source.kind=quest3d::source_kind::monitor; source.native_handle=UINT64_MAX; source.selection_id=9007199254740993ULL;
+  source.parent_left=h.source_left; source.parent_top=h.source_top; source.parent_width=h.source_width; source.parent_height=h.source_height;
+  send(6,source);
