@@ -0,0 +1,41 @@
+/**
+ * @file src/platform/windows/display_quest3d.h
+ * @brief Quest3D offscreen BGRA source feeding Sunshine's existing D3D11 encoders.
+ */
+#pragma once
+
+#include "display.h"
+#include "quest3d_frame.h"
+
+namespace platf::dxgi {
+  /** @brief CPU bridge source; uploads each complete frame once without desktop recapture. */
+  class display_quest3d_vram_t: public display_vram_t {
+  public:
+    /**
+     * @brief Select the physical GPU and obtain the writer's initial frame size.
+     * @param config Client stream configuration.
+     * @param display_name Physical display used only to select the GPU.
+     * @return Zero on success, negative on unavailable/invalid source.
+     */
+    int init(const ::video::config_t &config, const std::string &display_name);
+    /**
+     * @brief Upload a fresh shared-memory frame into a pooled encoder texture.
+     * @param pull_free_image_cb Image pool callback.
+     * @param img_out Resulting GPU image.
+     * @param timeout Maximum source wait.
+     * @param cursor_visible Ignored because cursor composition belongs to the producer.
+     * @return Status distinguishing new data, stale data, and resolution reinitialization.
+     */
+    capture_e snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool cursor_visible) override;
+    /** @brief Release snapshot ownership. @return Always successful; no desktop frame is held. */
+    capture_e release_snapshot() override;
+    /** @brief Report BGRA source transfer characteristics. @return False; protocol v2 is SDR. */
+    bool is_hdr() override;
+
+  private:
+    quest3d::frame_reader reader_;  ///< Writer-owned CPU frame consumer.
+    quest3d::frame pending_;  ///< Reusable owned BGRA storage.
+    bool initial_pending_ = false;  ///< Initial metadata read includes a usable first frame.
+    std::uint64_t accepted_frames_ = 0;  ///< Number of published GPU snapshots.
+  };
+}  // namespace platf::dxgi
