+TEST(Quest3DFrameLedger, StopAndWrapCannotInterleaveValidatedDispatch) {
+  quest3d::capture_registry registry;
+  auto source = registry.publish(header());
+  quest3d::frame_ledger ledger(owner, epoch);
+  ASSERT_TRUE(ledger.record_sent(quest3d::encoded_identity {source, 1, now}, 1, true, now));
+  std::promise<void> entered, release, attempted;
+  auto release_future = release.get_future();
+  auto callback = std::async(std::launch::async, [&] {
+    return ledger.with_lookup(owner, epoch, 1, source, now, [&](const auto &) {
+      entered.set_value();
+      release_future.wait();
+      return true;
+    });
+  });
+  entered.get_future().wait();
+  auto stop = std::async(std::launch::async, [&] {
+    attempted.set_value();
+    ledger.stop();
+  });
+  attempted.get_future().wait();
+  EXPECT_EQ(stop.wait_for(std::chrono::milliseconds(10)), std::future_status::timeout);
+  release.set_value();
+  EXPECT_TRUE(callback.get());
+  stop.get();
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 1, source, now));
+}
