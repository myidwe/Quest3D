+TEST(Quest3DPointerRuntime, RepeatedMovesDoNotBlockAtomicStatusReplacement) {
+  pointer_fixture f;
+  std::atomic<bool> stop = false;
+  std::atomic<unsigned> writes = 0, errors = 0, retries = 0, last_error = 0;
+  const auto base = f.status;
+  std::promise<void> ready;
+  auto started = ready.get_future();
+  std::thread writer([&] {
+    bool first = true;
+    while (!stop) {
+      const auto pending = f.directory / "status.pending";
+      auto state = base;
+      state["updated_monotonic_ns"] = quest3d::qpc_nanoseconds();
+      {
+        std::ofstream file(pending, std::ios::binary | std::ios::trunc);
+        file << state.dump();
+      }
+      const auto retry_deadline = quest3d::frame_clock::now() + std::chrono::milliseconds(50);
+      for (;;) {
+        if (MoveFileExW(pending.c_str(), (f.directory / "status.json").c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+          ++writes;
+          break;
+        }
+        const auto error = GetLastError();
+        last_error = error;
+        if ((error != ERROR_ACCESS_DENIED && error != ERROR_SHARING_VIOLATION && error != ERROR_LOCK_VIOLATION) || quest3d::frame_clock::now() >= retry_deadline) {
+          ++errors;
+          break;
+        }
+        ++retries;
+        Sleep(1);
+      }
+      if (first) {
+        ready.set_value();
+        first = false;
+      }
+      const auto deadline = quest3d::frame_clock::now() + std::chrono::milliseconds(250);
+      while (!stop && quest3d::frame_clock::now() < deadline) {
+        Sleep(1);
+      }
+    }
+  });
+  started.wait();
+  const auto began = quest3d::frame_clock::now();
+  for (unsigned sequence = 1; sequence <= 80; ++sequence) {
+    f.qpc = quest3d::qpc_nanoseconds();
+    f.now = quest3d::frame_clock::now();
+    f.h.capture_qpc_ns = f.h.publish_qpc_ns = f.qpc;
+    ++f.h.frame_id;
+    ++f.index;
+    f.publish();
+    auto request = f.request(sequence);
+    request["operation"] = "move";
+    request.erase("button");
+    const auto result = f.post(request, [] {
+      return quest3d::pointer_endpoint::clock_sample {quest3d::qpc_nanoseconds(), quest3d::frame_clock::now()};
+    });
+    EXPECT_EQ(result.code, 200);
+    EXPECT_EQ(result.body["applied"], true);
+    std::this_thread::sleep_until(began + std::chrono::milliseconds(sequence * 50));
+  }
+  stop = true;
+  writer.join();
+  std::filesystem::remove(f.directory / "status.pending");
+  RecordProperty("recorded_moves", f.calls.size());
+  RecordProperty("status_replacements", writes.load());
+  RecordProperty("status_write_failures", errors.load());
+  RecordProperty("status_replace_retries", retries.load());
+  RecordProperty("last_replace_error", last_error.load());
+  RecordProperty("elapsed_ms", std::chrono::duration_cast<std::chrono::milliseconds>(quest3d::frame_clock::now() - began).count());
+  EXPECT_GT(writes.load(), 10U);
+  EXPECT_EQ(errors.load(), 0U);
+  EXPECT_EQ(f.calls.size(), 80U);
+}
