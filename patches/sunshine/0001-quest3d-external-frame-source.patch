+TEST(Quest3DFrameLedger, ModeRoundTripAndSourceReplacementRejectOldObservation) {
+  quest3d::capture_registry registry;
+  auto h = header();
+  auto original = registry.publish(h);
+  quest3d::frame_ledger ledger(owner, epoch);
+  EXPECT_TRUE(ledger.record_sent(quest3d::encoded_identity {original, 1, now}, 1, true, now));
+  h.flags = 1;
+  registry.publish(h);
+  h.flags = 3;
+  auto returned = registry.publish(h);
+  EXPECT_NE(original->geometry_revision, returned->geometry_revision);
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 1, returned, now));
+  h.stream_epoch++;
+  auto replacement = registry.publish(h);
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 1, replacement, now));
+  registry.clear();
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 1, registry.current(), now));
+}
