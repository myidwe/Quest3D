+/** @file tests/unit/test_quest3d_frame_ledger.cpp
+ * @brief Immutable image/encoder/send metadata and stale observation regression.
+ */
+#include "src/platform/common.h"
+#include "src/quest3d_frame_ledger.h"
+#include "src/video.h"
+#include "tests/tests_common.h"
+
+#include <future>
+#include <thread>
+
+namespace {
+  quest3d::frame_header header() {
+    quest3d::frame_header h {};
+    h.magic = {'Q', '3', 'D', 'F', 'R', 'M', '2', '\0'};
+    h.version = 2;
+    h.header_bytes = 128;
+    h.width = 2560;
+    h.height = 720;
+    h.stride = 10240;
+    h.payload_bytes = h.stride * h.height;
+    h.format = 1;
+    h.frame_id = 1;
+    h.stream_epoch = 7;
+    h.geometry_generation = 3;
+    h.flags = 3;
+    h.source_width = 1920;
+    h.source_height = 1080;
+    h.content_width = 1280;
+    h.content_height = 720;
+    return h;
+  }
+
+  const std::string owner = "paired-certificate-A";
+  const std::string epoch = "0123456789abcdef0123456789abcdef";
+  const auto now = quest3d::frame_clock::time_point(std::chrono::seconds(10));
+}  // namespace
+
+TEST(Quest3DFrameLedger, RejectsInvalidMetadataAndPreservesWireLayout) {
+  quest3d::capture_registry registry;
+  auto h = header();
+  ASSERT_TRUE(registry.publish(h));
+  h.reserved[3] = 1;
+  EXPECT_FALSE(registry.publish(h));
+  EXPECT_FALSE(registry.current());
+  EXPECT_EQ(sizeof(quest3d::frame_header), 128U);
+}
+
+TEST(Quest3DFrameLedger, PoolReuseRepeatAndDummyDoNotRelabelConvertedPixels) {
+  quest3d::capture_registry registry;
+  platf::img_t pooled;
+  auto h = header();
+  pooled.quest3d_metadata = registry.publish(h);
+  quest3d::converted_frame encoder;
+  encoder.converted(pooled.quest3d_metadata, true);
+  h.frame_id = 2;
+  h.geometry_generation++;
+  pooled.quest3d_metadata.reset();
+  pooled.quest3d_metadata = registry.publish(h);
+  auto repeat = encoder.encoded(19, 19, true, now);
+  ASSERT_TRUE(repeat);
+  EXPECT_EQ(repeat->source->header.frame_id, 1U);
+  EXPECT_EQ(repeat->source->header.geometry_generation, 3U);
+  encoder.converted(pooled.quest3d_metadata, true);
+  EXPECT_EQ(encoder.encoded(20, 20, true, now)->source->header.frame_id, 2U);
+  pooled.quest3d_metadata.reset();  // production dummy_img and snapshot reuse clear first
+  encoder.converted(pooled.quest3d_metadata, true);
+  EXPECT_FALSE(encoder.encoded(21, 21, true, now));
+}
+
+TEST(Quest3DFrameLedger, FailedConversionAndUnknownNvencOutputCannotClaimMetadata) {
+  quest3d::capture_registry registry;
+  quest3d::converted_frame encoder;
+  auto source = registry.publish(header());
+  encoder.converted(source, true);
+  EXPECT_FALSE(encoder.encoded(9, 8, true, now));
+  EXPECT_FALSE(encoder.encoded(9, 9, false, now));
+  ASSERT_TRUE(encoder.encoded(9, 9, true, now));
+  encoder.converted(source, false);
+  EXPECT_FALSE(encoder.encoded(10, 10, true, now));
+}
