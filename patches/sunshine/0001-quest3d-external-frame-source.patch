+
+    void reset_endpoint(bool enabled = true) {
+      endpoint = std::make_unique<quest3d::pointer_endpoint>(owner, epoch, ledger, registry, std::function<void(const quest3d::pointer_action &)> {}, quest3d::pointer_runtime_options {enabled, directory, names, insert});
+    }
+
+    void write_status() {
