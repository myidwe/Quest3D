+TEST(Quest3DPointerSink, DISABLED_ExactOwnWindowAtomicClicks) {
+  if (!std::getenv("QUEST3D_OWN_WINDOW_POINTER_PROBE")) {
+    GTEST_SKIP() << "Requires explicit isolated fixture opt-in";
+  }
+  const auto previous_context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+  const auto previous_foreground = GetForegroundWindow();
+  POINT previous_cursor {};
+  ASSERT_TRUE(GetCursorPos(&previous_cursor));
+  const auto instance = GetModuleHandleW(nullptr);
+  const wchar_t *name = L"Quest3DPointerOwnWindowProbe";
+  WNDCLASSW cls {};
+  cls.lpfnWndProc = pointer_fixture_proc;
+  cls.hInstance = instance;
+  cls.lpszClassName = name;
+  ASSERT_TRUE(RegisterClassW(&cls));
+  sink_observation seen;
+  HWND window = CreateWindowExW(WS_EX_TOPMOST, name, L"Quest3D isolated pointer test", WS_POPUP | WS_VISIBLE, 60, 60, 256, 160, nullptr, nullptr, instance, &seen);
+  ASSERT_TRUE(window);
+
+  struct cleanup {
+    HWND window, previous;
+    POINT cursor, target;
+    HINSTANCE instance;
+    const wchar_t *name;
+    DPI_AWARENESS_CONTEXT context;
+
+    ~cleanup() {
+      POINT actual {};
+      if (GetCursorPos(&actual) && std::abs(actual.x - target.x) <= 2 && std::abs(actual.y - target.y) <= 2) {
+        SetCursorPos(cursor.x, cursor.y);
+      }
+      const bool own_foreground = GetForegroundWindow() == window;
+      DestroyWindow(window);
+      UnregisterClassW(name, instance);
+      if (own_foreground && IsWindow(previous)) {
+        SetForegroundWindow(previous);
+      }
+      if (context) {
+        SetThreadDpiAwarenessContext(context);
+      }
+    }
+  } restore {window, previous_foreground, previous_cursor, {188, 140}, instance, name, previous_context};
+
+  SetForegroundWindow(window);
+  pump_fixture();
+  DWORD pid = 0;
+  GetWindowThreadProcessId(window, &pid);
+  ASSERT_EQ(pid, GetCurrentProcessId());
+  if (GetForegroundWindow() != window || WindowFromPoint(restore.target) != window) {
+    GTEST_SKIP() << "Fixture did not exclusively own target";
+  }
+  for (int key : {VK_LBUTTON, VK_RBUTTON, VK_MBUTTON, VK_XBUTTON1, VK_XBUTTON2}) {
+    if (GetAsyncKeyState(key) & 0x8000) {
+      GTEST_SKIP() << "A user pointer button is held";
+    }
+  }
+  RECT bounds {};
+  ASSERT_TRUE(GetWindowRect(window, &bounds));
+  FILETIME birth {}, exited {}, kernel {}, user {};
+  ASSERT_TRUE(GetProcessTimes(GetCurrentProcess(), &birth, &exited, &kernel, &user));
+  quest3d::source_identity identity;
+  identity.kind = quest3d::source_kind::window;
+  identity.selection_id = 1;
+  identity.process_id = GetCurrentProcessId();
+  identity.native_handle = reinterpret_cast<std::uintptr_t>(window);
+  identity.creation_filetime = (static_cast<std::uint64_t>(birth.dwHighDateTime) << 32) | birth.dwLowDateTime;
+  identity.parent_left = bounds.left;
+  identity.parent_top = bounds.top;
+  identity.parent_width = bounds.right - bounds.left;
+  identity.parent_height = bounds.bottom - bounds.top;
+  ASSERT_TRUE(quest3d::source_live_matches(identity));
+  ++identity.creation_filetime;
+  EXPECT_FALSE(quest3d::source_live_matches(identity));
+  --identity.creation_filetime;
+  ++identity.parent_width;
+  EXPECT_FALSE(quest3d::source_live_matches(identity));
+  quest3d_test::pointer_fixture f(true);
+  unsigned sequence = 0;
+  for (int operation : {0, 1, 2}) {
+    ASSERT_EQ(GetForegroundWindow(), window);
+    ASSERT_EQ(WindowFromPoint(restore.target), window);
+    f.qpc = quest3d::qpc_nanoseconds();
+    f.now = quest3d::frame_clock::now();
+    f.h.capture_qpc_ns = f.h.publish_qpc_ns = f.qpc;
+    f.status["updated_monotonic_ns"] = f.qpc;
+    f.write_status();
+    ++f.h.frame_id;
+    ++f.index;
+    f.publish();
+    ASSERT_EQ(f.receipt["input_enabled"], true);
+    auto request = f.request(++sequence);
+    request["u"] = double(restore.target.x - f.h.source_left) / (f.h.source_width - 1);
+    request["v"] = double(restore.target.y - f.h.source_top) / (f.h.source_height - 1);
+    if (operation == 0) {
+      request["operation"] = "move";
+      request.erase("button");
+    } else {
+      request["button"] = operation == 1 ? "left" : "right";
+    }
+    const auto reply = f.post(request, [] {
+      return quest3d::pointer_endpoint::clock_sample {quest3d::qpc_nanoseconds(), quest3d::frame_clock::now()};
+    });
+    ASSERT_EQ(reply.code, 200) << reply.body.dump();
+    ASSERT_EQ(reply.body["applied"], true);
+    ASSERT_EQ(reply.body["ack_scope"], "win32_input_inserted");
+    ASSERT_EQ(reply.body["physical_point"]["x"], restore.target.x);
+    ASSERT_EQ(reply.body["physical_point"]["y"], restore.target.y);
+    const auto replay = f.post(request);
+    ASSERT_EQ(replay.body, reply.body);
+    pump_fixture();
+  }
+  EXPECT_EQ(seen.left_down, 1U);
+  EXPECT_EQ(seen.left_up, 1U);
+  EXPECT_EQ(seen.right_down, 1U);
+  EXPECT_EQ(seen.right_up, 1U);
+  EXPECT_GT(seen.moves, 0U);
+  EXPECT_EQ(GetAsyncKeyState(VK_LBUTTON) & 0x8000, 0);
+  EXPECT_EQ(GetAsyncKeyState(VK_RBUTTON) & 0x8000, 0);
+  static_assert(!quest3d::pointer_endpoint::default_os_input_enabled);
+}
+
+TEST(Quest3DPointerSink, DISABLED_ReadOnlyOwnWindowSourceLifetime) {
+  if (!std::getenv("QUEST3D_OWN_WINDOW_POINTER_PROBE")) {
+    GTEST_SKIP() << "Requires explicit isolated fixture opt-in";
+  }
+  const auto previous_context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+  const auto instance = GetModuleHandleW(nullptr);
+  const wchar_t *name = L"Quest3DSourceIdentityOwnWindowProbe";
+  WNDCLASSW cls {};
+  cls.lpfnWndProc = DefWindowProcW;
+  cls.hInstance = instance;
+  cls.lpszClassName = name;
+  ASSERT_TRUE(RegisterClassW(&cls));
+  HWND window = CreateWindowExW(WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW, name, L"Quest3D source identity fixture", WS_POPUP | WS_VISIBLE, 80, 80, 192, 128, nullptr, nullptr, instance, nullptr);
+  ASSERT_TRUE(window);
+
+  struct cleanup {
+    HWND window;
+    HINSTANCE instance;
+    const wchar_t *name;
+    DPI_AWARENESS_CONTEXT context;
+
+    ~cleanup() {
+      if (IsWindow(window)) {
+        DestroyWindow(window);
+      }
+      UnregisterClassW(name, instance);
+      if (context) {
+        SetThreadDpiAwarenessContext(context);
+      }
+    }
+  } restore {window, instance, name, previous_context};
+
+  pump_fixture();
+  RECT rect {};
+  ASSERT_TRUE(GetWindowRect(window, &rect));
+  FILETIME birth {}, exited {}, kernel {}, user {};
+  ASSERT_TRUE(GetProcessTimes(GetCurrentProcess(), &birth, &exited, &kernel, &user));
+  quest3d::source_identity source;
+  source.kind = quest3d::source_kind::window;
+  source.selection_id = 1;
+  source.process_id = GetCurrentProcessId();
+  source.native_handle = reinterpret_cast<std::uintptr_t>(window);
+  source.creation_filetime = (static_cast<std::uint64_t>(birth.dwHighDateTime) << 32) | birth.dwLowDateTime;
+  source.parent_left = rect.left;
+  source.parent_top = rect.top;
+  source.parent_width = rect.right - rect.left;
+  source.parent_height = rect.bottom - rect.top;
+  ASSERT_TRUE(quest3d::source_live_matches(source));
+  auto wrong = source;
+  ++wrong.creation_filetime;
+  EXPECT_FALSE(quest3d::source_live_matches(wrong));
+  wrong = source;
+  ++wrong.process_id;
+  EXPECT_FALSE(quest3d::source_live_matches(wrong));
+  ASSERT_TRUE(SetWindowPos(window, nullptr, rect.left + 16, rect.top + 9, 0, 0, SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOZORDER));
+  pump_fixture();
+  EXPECT_FALSE(quest3d::source_live_matches(source));
+  source.parent_left += 16;
+  source.parent_top += 9;
+  EXPECT_TRUE(quest3d::source_live_matches(source));
+  ShowWindow(window, SW_HIDE);
+  EXPECT_FALSE(quest3d::source_live_matches(source));
+  ASSERT_TRUE(DestroyWindow(window));
+  EXPECT_FALSE(quest3d::source_live_matches(source));
+  static_assert(!quest3d::pointer_endpoint::default_os_input_enabled);
+}
+#endif
