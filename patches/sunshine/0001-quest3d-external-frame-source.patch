   }
 
+  capture_e display_vram_t::upload_bgra(platf::img_t *img_base, const std::uint8_t *pixels, std::uint32_t row_pitch) {
+    auto img = static_cast<img_d3d_t *>(img_base);
+    if (complete_img(img_base, false) != 0) {
+      return capture_e::error;
