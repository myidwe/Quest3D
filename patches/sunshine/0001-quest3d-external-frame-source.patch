+/** @file src/platform/windows/quest3d_pointer.cpp
+ * @brief Pointer receipts, source validation, replay protection and locally opted-in Win32 adapter.
+ */
+#include "quest3d_pointer.h"
+
+#include "../../crypto.h"
+
+#include <charconv>
+#include <cmath>
+#include <dwmapi.h>
+#include <set>
+
+namespace quest3d {
+  namespace {
+    struct control_fence {
+      std::mutex mutex;
+      std::uint64_t revision = 0, capture_floor = 0;
+      std::string pending;
+      bool exhausted = false;
+    };
+
+    control_fence fence;
+    using json = nlohmann::json;  ///< JSON wire representation.
+
+    /** @brief Encode bytes as lowercase hex without locale effects. */
+    template<class Bytes>
+    std::string hex(const Bytes &bytes, std::size_t count) {
+      constexpr char alphabet[] = "0123456789abcdef";
+      std::string out;
+      for (std::size_t i = 0; i < count; ++i) {
+        const auto value = static_cast<unsigned char>(bytes[i]);
+        out += alphabet[value >> 4];
+        out += alphabet[value & 15];
+      }
+      return out;
+    }
+
+    /** @brief Hash only immutable source/layout fields; not a substitute for the random receipt. */
+    std::string identifier(const json &value) {
+      return hex(crypto::hash(value.dump()), 16);
+    }
+
+    /** @brief Uniform fail-closed protocol error. */
+    control_reply failure(int status, const char *error) {
+      return {status, {{"version", 1}, {"error", error}, {"applied", false}, {"input_enabled", false}}};
+    }
+
+    /** @brief Reject negative, fractional, boolean and oversized small integers. */
+    bool integer(const json &value, std::uint64_t maximum) {
+      return value.is_number_integer() && (value.is_number_unsigned() || value.get<std::int64_t>() >= 0) && value.get<std::uint64_t>() <= maximum;
+    }
+
+    /** @brief Canonical positive decimal strings preserve Godot JSON's uint64 precision. */
+    bool decimal(const json &value, bool allow_zero = false) {
+      if (!value.is_string()) {
+        return false;
+      }
+      const auto &text = value.get_ref<const std::string &>();
+      if (text.empty() || text.size() > 20 || (text.size() > 1 && text[0] == '0')) {
+        return false;
+      }
+      std::uint64_t parsed = 0;
+      const auto result = std::from_chars(text.data(), text.data() + text.size(), parsed);
+      return result.ec == std::errc {} && result.ptr == text.data() + text.size() && (allow_zero || parsed > 0);
+    }
+
+    /** @brief Accept only opaque lowercase nonzero 128-bit identities. */
+    bool opaque(const json &value) {
+      return value.is_string() && valid_transport_epoch(value.get<std::string>()) && value != std::string(32, '0');
+    }
+
+    /** @brief Parse exact action schema, rejecting duplicate keys and unsupported fields. */
+    json parse(const std::string &body) {
+      if (body.empty() || body.size() > 4096) {
+        throw std::invalid_argument("body size");
+      }
+      bool duplicate = false;
+      std::set<std::string> keys;
+      auto request = json::parse(body, [&](int, json::parse_event_t event, json &value) {
+        if (event == json::parse_event_t::key && !keys.insert(value.get<std::string>()).second) {
+          duplicate = true;
+        }
+        return true;
+      });
+      const std::set<std::string> required {"version", "transport_epoch", "frame_index", "frame_geometry_token", "source_id", "source_generation", "geometry_revision", "layout_id", "request_id", "input_seq", "operation", "u", "v", "encoded_eye", "decoder_epoch", "lease_serial", "submission_cycle", "panel_generation", "mapping_generation", "pixel_latch_age_us", "submission_age_us", "dry_run"};
+      if (duplicate || !request.is_object()) {
+        throw std::invalid_argument("object");
+      }
+      for (const auto &key : required) {
+        if (!request.contains(key)) {
+          throw std::invalid_argument("missing field");
+        }
+      }
+      for (auto it = request.begin(); it != request.end(); ++it) {
+        if (!required.contains(it.key()) && it.key() != "button") {
+          throw std::invalid_argument("extra field");
+        }
+      }
+      if (!integer(request["version"], 1) || request["version"] != 1 || !integer(request["frame_index"], UINT32_MAX) ||
+          !integer(request["input_seq"], UINT32_MAX) || request["input_seq"] == 0 || !integer(request["encoded_eye"], 1) ||
+          !integer(request["pixel_latch_age_us"], 500000) || !integer(request["submission_age_us"], 250000) || !request["dry_run"].is_boolean()) {
+        throw std::invalid_argument("integer");
+      }
+      for (const auto *key : {"transport_epoch", "frame_geometry_token", "source_id", "layout_id", "request_id"}) {
+        if (!opaque(request[key])) {
+          throw std::invalid_argument("identifier");
+        }
+      }
+      for (const auto *key : {"source_generation", "geometry_revision", "decoder_epoch", "lease_serial", "submission_cycle", "panel_generation", "mapping_generation"}) {
+        if (!decimal(request[key], std::string_view(key) == "source_generation")) {
+          throw std::invalid_argument("decimal");
+        }
+      }
+      for (const auto *key : {"u", "v"}) {
+        if (!request[key].is_number() || !std::isfinite(request[key].get<double>()) || request[key].get<double>() < 0 || request[key].get<double>() > 1) {
+          throw std::invalid_argument("uv");
+        }
+      }
+      if ((request["operation"] != "move" && request["operation"] != "click") ||
+          (request["operation"] == "move" && request.contains("button")) ||
+          (request["operation"] == "click" && (!request.contains("button") || (request["button"] != "left" && request["button"] != "right")))) {
+        throw std::invalid_argument("operation");
+      }
+      return request;
+    }
+  }  // namespace
+
+  pointer_endpoint::pointer_endpoint(std::string owner, std::string epoch, frame_ledger &ledger, capture_registry &registry, std::function<void(const pointer_action &)> observer, pointer_runtime_options options):
+      options_(std::move(options)),
+      live_reader_(options_.names),
+      owner_(std::move(owner)),
+      epoch_(std::move(epoch)),
+      ledger_(ledger),
+      registry_(registry),
+      observer_(std::move(observer)) {}
+
+  std::string pointer_request_id(const std::string &epoch, std::uint32_t sequence) {
+    return hex(crypto::hash(epoch + ":" + std::to_string(sequence)), 16);
+  }
+
+  control_reply pointer_control_mutation(const std::function<control_reply()> &mutation, const std::function<std::uint64_t()> &clock) {
+    std::lock_guard lock(fence.mutex);
+    auto result = mutation();
+    if (result.code == 202 && !result.body.value("duplicate", true)) {
+      if (fence.revision == UINT64_MAX) {
+        fence.exhausted = true;
+      } else {
+        ++fence.revision;
+      }
+      fence.pending = result.body.at("request_id").get<std::string>();
+      fence.capture_floor = clock ? clock() : qpc_nanoseconds();
+    }
+    return result;
+  }
+
+  bool pointer_endpoint::runtime_ready(const frame_header &header, std::uint64_t now_ns, const refresh_clock &refresh) const {
+    if (!options_.enabled || input_fault_ || fence.exhausted || options_.names.protocol != 3 ||
+        header.version != 3 || !header.frame_id || !header.stream_epoch || (header.flags & 11U) != 11U || !options_.control_directory.is_absolute() ||
+        !header.capture_qpc_ns || header.capture_qpc_ns < fence.capture_floor || now_ns < header.capture_qpc_ns || now_ns - header.capture_qpc_ns > 500000000ULL) {
+      return false;
+    }
+    const auto path = options_.control_directory / "status.json";
+    auto file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) {
+      return false;
+    }
+    std::string bytes(65537, '\0');
+    DWORD count = 0;
+    const bool read = GetFileType(file) == FILE_TYPE_DISK && ReadFile(file, bytes.data(), static_cast<DWORD>(bytes.size()), &count, nullptr);
+    CloseHandle(file);
+    if (!read || count == 0 || count > 65536) {
+      return false;
+    }
+    bytes.resize(count);
+    try {
+      const auto state = json::parse(bytes);
+      if (!state.is_object() || !state.value("running", false) || !state.value("input_opt_in", false) || !state.value("input_enabled", false) ||
+          state.value("requested_mode", "") != "2d" || state.value("effective_mode", "") != "2d" ||
+          !state.at("stream_epoch").is_number_unsigned() || state.at("stream_epoch").get<std::uint64_t>() != header.stream_epoch ||
+          !state.at("updated_monotonic_ns").is_number_unsigned() ||
+          (!fence.pending.empty() && state.value("applied_request", json {}) != fence.pending)) {
+        return false;
+      }
+      for (const auto *key : {"error"}) {
+        if (state.contains(key) && !state[key].is_null()) {
+          return false;
+        }
+      }
+      const auto updated = state.at("updated_monotonic_ns").get<std::uint64_t>();
+      // Atomic replacement can publish a heartbeat after the request-entry clock.
+      if (refresh) {
+        now_ns = refresh().first;
+      }
+      return updated <= now_ns && now_ns - updated <= 500000000ULL;
+    } catch (const json::exception &) {
+      return false;
+    }
+  }
+
+  void pointer_endpoint::prune(frame_clock::time_point now) {
+    std::erase_if(tickets_, [&](const auto &value) {
+      return now >= value.frame.sent_at && now - value.frame.sent_at > input_lifetime;
+    });
+    std::erase_if(history_, [&](const auto &value) {
+      return now >= value.at && now - value.at > frame_ledger::retention;
+    });
+  }
+
+  bool pointer_endpoint::authorized(const std::string &owner, const frame_metadata_ptr &current, std::uint64_t now_ns) const {
+    return active_ && owner == owner_ && current && now_ns >= current->header.publish_qpc_ns && now_ns - current->header.publish_qpc_ns <= 500000000ULL;
+  }
+
+  control_reply pointer_endpoint::get(const std::string &owner, const std::string &epoch, std::uint32_t index, std::uint64_t now_qpc_ns, frame_clock::time_point now, refresh_clock refresh) {
+    std::lock_guard lock(mutex_);
+    std::lock_guard control_lock(fence.mutex);
+    if (refresh) {
+      std::tie(now_qpc_ns, now) = refresh();
+    }
+    prune(now);
+    const auto current = registry_.current();
+    if (!authorized(owner, current, now_qpc_ns) || epoch != epoch_) {
+      return failure(403, "inactive_owner_or_source");
+    }
+    const auto frame = ledger_.lookup(owner, epoch, index, current, now);
+    if (!frame || now - frame->sent_at > input_lifetime) {
+      return failure(410, "frame_expired_or_geometry_changed");
+    }
+    auto found = std::find_if(tickets_.begin(), tickets_.end(), [&](const auto &value) {
+      return value.frame.encoded.index == index;
+    });
+    const auto &h = frame->encoded.source->header;
+    const auto &source = frame->encoded.source->source;
+    if (found == tickets_.end()) {
+      if (tickets_.size() == 64) {
+        tickets_.pop_front();
+      }
+      const auto source_id = h.version == 2 ? identifier(json::array({owner_, epoch_, std::to_string(h.stream_epoch), std::to_string(h.geometry_generation)})) :
+                                              identifier(json::array({owner_, epoch_, std::to_string(h.stream_epoch), source_kind_name(source.kind), std::to_string(source.selection_id), std::to_string(source.native_handle), source.process_id, std::to_string(source.creation_filetime)}));
+      const auto layout_id = identifier(json::array({source_id, std::to_string(frame->encoded.source->geometry_revision), h.width, h.height, h.flags & 11U, h.source_left, h.source_top, h.source_width, h.source_height, h.content_left, h.content_top, h.content_width, h.content_height}));
+      tickets_.push_back({*frame, fence.revision, hex(crypto::rand(16), 16), source_id, layout_id});
+      found = std::prev(tickets_.end());
+    }
+    bool enabled = false;
+    if (source.kind == source_kind::monitor && found->control_revision == fence.revision && runtime_ready(h, now_qpc_ns, refresh)) {
+      enabled = registry_.with_current(frame->encoded.source, [&](const auto &latest) {
+        return ledger_.with_lookup(owner, epoch, index, latest, now, [&](const auto &sent) {
+          return live_reader_.with_metadata([&](const auto &raw, const auto &identity) {
+            if (refresh) {
+              std::tie(now_qpc_ns, now) = refresh();
+            }
+            return geometry_identity(raw) == geometry_identity(h) && identity == source && raw.frame_id >= h.frame_id && raw.capture_qpc_ns >= h.capture_qpc_ns && raw.publish_qpc_ns >= h.publish_qpc_ns &&
+                   raw.publish_qpc_ns <= now_qpc_ns && now_qpc_ns - raw.publish_qpc_ns <= 500000000ULL &&
+                   h.capture_qpc_ns <= now_qpc_ns && now_qpc_ns - h.capture_qpc_ns <= 500000000ULL &&
+                   now >= sent.sent_at && now - sent.sent_at <= input_lifetime && source_live_matches(source);
+          });
+        });
+      });
+    }
+    if (refresh) {
+      std::tie(now_qpc_ns, now) = refresh();
+    }
+    if (now < frame->sent_at || now - frame->sent_at > input_lifetime || !authorized(owner, current, now_qpc_ns)) {
+      return failure(410, "frame_expired_during_lookup");
+    }
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(input_lifetime - (now - frame->sent_at)).count();
+    return {200, {{"version", 1}, {"transport_epoch", epoch_}, {"frame_index", index}, {"frame_geometry_token", found->token}, {"source_id", found->source_id}, {"source_name", h.version == 2 ? "Bridge v2 source" : source_kind_name(source.kind)}, {"source_kind", source_kind_name(source.kind)}, {"source_generation", std::to_string(h.geometry_generation)}, {"geometry_revision", std::to_string(frame->encoded.source->geometry_revision)}, {"publisher_epoch", std::to_string(h.stream_epoch)}, {"publisher_frame_id", std::to_string(h.frame_id)}, {"layout_id", found->layout_id}, {"layout", (h.flags & 1U) ? "full_sbs" : "mono"}, {"mode", (!(h.flags & 1U) || (h.flags & 2U)) ? "2d" : "3d"}, {"source_rect", {{"left", h.source_left}, {"top", h.source_top}, {"width", h.source_width}, {"height", h.source_height}}}, {"content_rect", {{"left", h.content_left}, {"top", h.content_top}, {"width", h.content_width}, {"height", h.content_height}}}, {"eye_size", {{"width", (h.flags & 1U) ? h.width / 2 : h.width}, {"height", h.height}}}, {"flags", h.flags}, {"host_remaining_ttl_ms", remaining}, {"last_input_seq", last_seq_}, {"input_enabled", enabled}, {"os_input_supported", h.version == 3 && source.kind == source_kind::monitor}}};
+  }
+
+  control_reply pointer_endpoint::post(const std::string &owner, const std::string &body, const desktop_rect &desktop, std::uint64_t now_qpc_ns, frame_clock::time_point now, refresh_clock refresh) {
+    if (body.size() > 4096) {
+      return failure(413, "request_too_large");
+    }
+    json request;
+    try {
+      request = parse(body);
+    } catch (const std::exception &) {
+      return failure(400, "invalid_pointer_request");
+    }
+    std::lock_guard lock(mutex_);
+    std::lock_guard control_lock(fence.mutex);
+    if (refresh) {
+      std::tie(now_qpc_ns, now) = refresh();
+    }
+    prune(now);
+    const auto current = registry_.current();
+    if (!active_ || owner != owner_ || request["transport_epoch"] != epoch_) {
+      return failure(403, "inactive_owner_or_source");
+    }
+    for (const auto &previous : history_) {
+      if (previous.request["request_id"] == request["request_id"]) {
+        return previous.request == request ? previous.reply : failure(409, "request_id_payload_changed");
+      }
+    }
+    if (!authorized(owner, current, now_qpc_ns)) {
+      return failure(403, "inactive_owner_or_source");
+    }
+    const auto sequence = request["input_seq"].get<std::uint32_t>();
+    if (sequence <= last_seq_) {
+      return failure(409, "input_sequence_regressed");
+    }
+    last_seq_ = sequence;
+    auto finish = [&](control_reply reply) {
+      reply.body["request_id"] = request["request_id"];
+      reply.body["input_seq"] = sequence;
+      if (history_.size() == 64) {
+        history_.pop_front();
+      }
+      history_.push_back({request, reply, now});
+      return reply;
+    };
+    const bool actual = !request["dry_run"].get<bool>();
+    if (actual && !options_.enabled) {
+      return finish(failure(423, "runtime_os_input_disabled"));
+    }
+    if (actual && request["request_id"] != pointer_request_id(epoch_, sequence)) {
+      return finish(failure(400, "request_id_not_bound_to_sequence"));
+    }
+    const auto index = request["frame_index"].get<std::uint32_t>();
+    auto found = std::find_if(tickets_.begin(), tickets_.end(), [&](const auto &value) {
+      return value.frame.encoded.index == index && request["frame_geometry_token"] == value.token;
+    });
+    if (found == tickets_.end()) {
+      return finish(failure(410, "unknown_or_expired_frame_ticket"));
+    }
+    const auto frame = ledger_.lookup(owner, epoch_, index, current, now);
+    if (!frame || now - frame->sent_at > input_lifetime || frame->encoded.source != found->frame.encoded.source) {
+      return finish(failure(410, "frame_expired_or_geometry_changed"));
+    }
+    const auto &h = frame->encoded.source->header;
+    const auto &source = frame->encoded.source->source;
+    if (request["source_id"] != found->source_id || request["layout_id"] != found->layout_id || request["source_generation"] != std::to_string(h.geometry_generation) || request["geometry_revision"] != std::to_string(frame->encoded.source->geometry_revision)) {
+      return finish(failure(409, "frame_identity_changed"));
+    }
+    if ((h.flags & 1U) && !(h.flags & 2U)) {
+      return finish(failure(409, "warped_3d_frame"));
+    }
+    if (h.version == 3 && source.kind != source_kind::monitor && source.kind != source_kind::window) {
+      return finish(failure(409, "file_source_has_no_os_coordinates"));
+    }
+    if (!(h.flags & 1U) && request["encoded_eye"] != 0) {
+      return finish(failure(400, "invalid_encoded_eye"));
+    }
+    auto point = map_absolute(h, request["u"].get<double>(), request["v"].get<double>(), input_space::logical_eye_uv, desktop);
+    if (!point) {
+      return finish(failure(422, "outside_source_content_or_desktop"));
+    }
+    pointer_send_result inserted;
+    if (actual && (found->control_revision != fence.revision || source.kind != source_kind::monitor || !runtime_ready(h, now_qpc_ns, refresh))) {
+      return finish(failure(423, "actual_input_gate_closed"));
+    }
+    // Lock order: session lifetime -> endpoint -> control fence -> registry ->
+    // ledger -> producer frame mutex. Final clocks are sampled inside every
+    // blocking boundary; stop/wrap/control/publish cannot relabel this dispatch.
+    const bool still_current = registry_.with_current(frame->encoded.source, [&](const auto &latest) {
+      return ledger_.with_lookup(owner, epoch_, index, latest, now, [&](const auto &sent) {
+        auto dispatch = [&]() {
+          if (h.version == 3 && !source_live_matches(source)) {
+            return false;
+          }
+          if (refresh) {
+            std::tie(now_qpc_ns, now) = refresh();
+          }
+          if (!authorized(owner, latest, now_qpc_ns) || now < sent.sent_at || now - sent.sent_at > input_lifetime) {
+            return false;
+          }
+          if (actual) {
+            if (now_qpc_ns < h.capture_qpc_ns || now_qpc_ns - h.capture_qpc_ns > 500000000ULL) {
+              return false;
+            }
+            point = map_absolute(h, request["u"].get<double>(), request["v"].get<double>(), input_space::logical_eye_uv, pointer_desktop());
+            if (!point) {
+              return false;
+            }
+            // Never introduce down/up into an already held physical button.
+            for (int key : {VK_LBUTTON, VK_RBUTTON, VK_MBUTTON, VK_XBUTTON1, VK_XBUTTON2}) {
+              if (!options_.insert && (GetAsyncKeyState(key) & 0x8000)) {
+                return false;
+              }
+            }
+          }
+          const pointer_action action {*point, request["operation"] == "click", request.value("button", "left") == "right"};
+          if (actual) {
+            if (refresh) {
+              std::tie(now_qpc_ns, now) = refresh();
+            }
+            if (!authorized(owner, latest, now_qpc_ns) || now_qpc_ns < h.capture_qpc_ns || now_qpc_ns - h.capture_qpc_ns > 500000000ULL || now < sent.sent_at || now - sent.sent_at > input_lifetime) {
+              return false;
+            }
+            inserted = send_pointer_atomic(action, options_.insert);
+            if (inserted.inserted != inserted.expected || inserted.button_state_unknown) {
+              input_fault_ = true;
+            }
+          } else if (observer_) {
+            observer_(action);
+          }
+          return true;
+        };
+        if (!actual) {
+          return dispatch();
+        }
+        return live_reader_.with_metadata([&](const auto &raw, const auto &identity) {
+          if (geometry_identity(raw) != geometry_identity(h) || identity != source || raw.frame_id < h.frame_id || raw.capture_qpc_ns < h.capture_qpc_ns || raw.publish_qpc_ns < h.publish_qpc_ns) {
+            return false;
+          }
+          if (refresh) {
+            std::tie(now_qpc_ns, now) = refresh();
+          }
+          if (raw.publish_qpc_ns > now_qpc_ns || now_qpc_ns - raw.publish_qpc_ns > 500000000ULL ||
+              raw.capture_qpc_ns > now_qpc_ns || now_qpc_ns - raw.capture_qpc_ns > 500000000ULL) {
+            return false;
+          }
+          return dispatch();
+        });
+      });
+    });
+    if (!still_current) {
+      return finish(failure(410, "geometry_changed_before_validation"));
+    }
+    if (actual) {
+      return finish({200, {{"version", 1}, {"outcome", inserted ? "applied" : inserted.inserted ? "partial" :
+                                                                                                  "not_applied"},
+                           {"applied", static_cast<bool>(inserted)},
+                           {"input_enabled", !input_fault_},
+                           {"ack_scope", "win32_input_inserted"},
+                           {"events_expected", inserted.expected},
+                           {"events_inserted", inserted.inserted},
+                           {"win32_error", inserted.error},
+                           {"release_attempted", inserted.release_attempted},
+                           {"release_inserted", inserted.release_inserted},
+                           {"button_state_unknown", inserted.button_state_unknown},
+                           {"retry_allowed", false},
+                           {"physical_point", {{"x", point->physical_x}, {"y", point->physical_y}}}}});
+    }
+    return finish({200, {{"version", 1}, {"outcome", "validated_dry_run"}, {"applied", false}, {"input_enabled", false}, {"source_kind", source_kind_name(source.kind)}, {"physical_point", {{"x", point->physical_x}, {"y", point->physical_y}}}, {"normalized_point", {{"x", point->normalized_x}, {"y", point->normalized_y}}}}});
+  }
+
+  void pointer_endpoint::stop() {
+    std::lock_guard lock(mutex_);
+    active_ = false;
+    tickets_.clear();
+    history_.clear();
+  }
+
+  desktop_rect pointer_desktop() {
+    return {GetSystemMetrics(SM_XVIRTUALSCREEN), GetSystemMetrics(SM_YVIRTUALSCREEN), GetSystemMetrics(SM_CXVIRTUALSCREEN), GetSystemMetrics(SM_CYVIRTUALSCREEN)};
+  }
+
+  bool source_live_matches(const source_identity &source) {
+    RECT bounds {};
+    if (source.kind == source_kind::monitor) {
+      MONITORINFO info {sizeof(MONITORINFO)};
+      if (!GetMonitorInfoW(reinterpret_cast<HMONITOR>(static_cast<std::uintptr_t>(source.native_handle)), &info)) {
+        return false;
+      }
+      bounds = info.rcMonitor;
+    } else if (source.kind == source_kind::window) {
+      const auto window = reinterpret_cast<HWND>(static_cast<std::uintptr_t>(source.native_handle));
+      DWORD pid = 0;
+      if (!IsWindow(window) || !IsWindowVisible(window) || IsIconic(window) ||
+          !GetWindowThreadProcessId(window, &pid) || pid != source.process_id) {
+        return false;
+      }
+      auto process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+      if (!process) {
+        return false;
+      }
+      FILETIME creation {}, exit {}, kernel {}, user {};
+      const bool known = GetProcessTimes(process, &creation, &exit, &kernel, &user);
+      CloseHandle(process);
+      const auto birth = (static_cast<std::uint64_t>(creation.dwHighDateTime) << 32) | creation.dwLowDateTime;
+      if (!known || birth != source.creation_filetime ||
+          FAILED(DwmGetWindowAttribute(window, DWMWA_EXTENDED_FRAME_BOUNDS, &bounds, sizeof(bounds)))) {
+        return false;
+      }
+      DWORD cloaked = 0;
+      if (FAILED(DwmGetWindowAttribute(window, DWMWA_CLOAKED, &cloaked, sizeof(cloaked))) || cloaked) {
+        return false;
+      }
+    } else {
+      return false;
+    }
+    return bounds.left == source.parent_left && bounds.top == source.parent_top &&
+           static_cast<std::int64_t>(bounds.right) - bounds.left == source.parent_width &&
+           static_cast<std::int64_t>(bounds.bottom) - bounds.top == source.parent_height;
+  }
+
+  pointer_send_result send_pointer_atomic(const pointer_action &action, const pointer_insert &insert) {
+    pointer_send_result result;
+    if (action.point.normalized_x < 0 || action.point.normalized_x > 65535 || action.point.normalized_y < 0 || action.point.normalized_y > 65535) {
+      return result;
+    }
+    INPUT inputs[3] {};
+    for (auto &input : inputs) {
+      input.type = INPUT_MOUSE;
+    }
+    inputs[0].mi.dx = action.point.normalized_x;
+    inputs[0].mi.dy = action.point.normalized_y;
+    inputs[0].mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK;
+    inputs[1].mi.dwFlags = action.right ? MOUSEEVENTF_RIGHTDOWN : MOUSEEVENTF_LEFTDOWN;
+    inputs[2].mi.dwFlags = action.right ? MOUSEEVENTF_RIGHTUP : MOUSEEVENTF_LEFTUP;
+    const auto send = [&](UINT count, LPINPUT values) {
+      return insert ? insert(count, values, sizeof(INPUT)) : SendInput(count, values, sizeof(INPUT));
+    };
+    result.expected = action.click ? 3U : 1U;
+    SetLastError(ERROR_SUCCESS);
+    result.inserted = send(result.expected, inputs);
+    result.error = GetLastError();
+    if (action.click && result.inserted == 2) {
+      result.release_attempted = true;
+      result.release_inserted = send(1, &inputs[2]);
+      result.button_state_unknown = result.release_inserted != 1;
+    }
+    if (result.inserted > result.expected) {
+      result.button_state_unknown = true;
+    }
+    return result;
+  }
+}  // namespace quest3d
diff --git a/src/platform/windows/quest3d_pointer.h b/src/platform/windows/quest3d_pointer.h
new file mode 100644
--- /dev/null
+++ b/src/platform/windows/quest3d_pointer.h
@@ -0,0 +1,106 @@
+/** @file src/platform/windows/quest3d_pointer.h
+ * @brief Authenticated immutable-frame pointer validation; explicit local v3 monitor input opt-in.
+ */
+#pragma once
+#include "../../quest3d_control.h"
+#include "../../quest3d_frame_ledger.h"
+#include "quest3d_frame.h"
+#include "quest3d_input.h"
+
+#include <functional>
+
+namespace quest3d {
+  /** @brief One validated coordinate and atomic action, without held-button state. */
+  struct pointer_action {
+    absolute_point point;  ///< Exact immutable source coordinate, normalized for Win32.
+    bool click;  ///< A single move/down/up batch; false is move only.
+    bool right;  ///< Right button if click is true.
+  };
+
+  /** @brief Exact Win32 insertion result; never an application or headset acknowledgement. */
+  struct pointer_send_result {
+    UINT expected = 0, inserted = 0;
+    DWORD error = 0;
+    bool release_attempted = false;
+    UINT release_inserted = 0;
+    bool button_state_unknown = false;
+
+    explicit operator bool() const {
+      return expected > 0 && inserted == expected && !button_state_unknown;
+    }
+  };
+
+  using pointer_insert = std::function<UINT(UINT, LPINPUT, int)>;  ///< Internal deterministic adapter seam; never supplied by a remote request.
+
+  /** @brief Locally selected runtime policy. All callers default to diagnostic-only. */
+  struct pointer_runtime_options {
+    bool enabled = false;
+    std::filesystem::path control_directory;
+    object_names names = protocol_names(3);
+    pointer_insert insert;  ///< Empty selects actual Win32 SendInput; tests can record precise partial results.
+  };
+
+  /** @brief Serialize successful source/mode control mutation with final pointer dispatch and revoke old tickets. */
+  control_reply pointer_control_mutation(const std::function<control_reply()> &mutation, const std::function<std::uint64_t()> &clock = {});
+  /** @brief Bind a real request ID permanently to its nonce and uint32 sequence. */
+  std::string pointer_request_id(const std::string &epoch, std::uint32_t sequence);
+
+  /** @brief Bounded per-owner pointer protocol; observer is diagnostic and never an OS sink. */
+  class pointer_endpoint {
+  public:
+    using clock_sample = std::pair<std::uint64_t, frame_clock::time_point>;  ///< QPC and steady time observed together.
+    using refresh_clock = std::function<clock_sample()>;  ///< Fresh time after blocking locks.
+    static constexpr auto input_lifetime = std::chrono::milliseconds(500);  ///< Exact sent-frame age, independent of ledger retention.
+    static constexpr bool default_os_input_enabled = false;  ///< Requires an explicit local runtime opt-in.
+
+    /** @brief Bind the endpoint to one authenticated transport and its ledger. */
+    pointer_endpoint(std::string owner, std::string epoch, frame_ledger &ledger, capture_registry &registry, std::function<void(const pointer_action &)> observer = {}, pointer_runtime_options options = {});
+    /** @brief Exact immutable frame lookup; current state is only a rejection guard. */
+    control_reply get(const std::string &owner, const std::string &epoch, std::uint32_t index, std::uint64_t now_qpc_ns, frame_clock::time_point now, refresh_clock refresh = {});
+    /** @brief Validate one bounded action; actual Win32 insertion requires the local opt-in and every source gate. */
+    control_reply post(const std::string &owner, const std::string &body, const desktop_rect &desktop, std::uint64_t now_qpc_ns, frame_clock::time_point now, refresh_clock refresh = {});
+    /** @brief Permanently revoke tickets and replay history on transport stop. */
+    void stop();
+
+  private:
+    /** @brief Metadata ticket; identity fields are generated from this frame alone. */
+    struct ticket {
+      sent_frame frame;  ///< Exact completed-send observation.
+      std::uint64_t control_revision = 0;  ///< Revoked immediately on admitted mode/source mutation.
+      std::string token, source_id, layout_id;  ///< Opaque receipt and immutable source/layout identities.
+    };
+
+    /** @brief Cached terminal result; duplicates cannot execute another action. */
+    struct history {
+      nlohmann::json request;  ///< Canonical parsed request.
+      control_reply reply;  ///< Original validation result.
+      frame_clock::time_point at;  ///< Bounded history lifetime.
+    };
+
+    /** @brief Prune expired bounded state. */
+    void prune(frame_clock::time_point now);
+    /** @brief Reject inactive owner, future or stale source publication. */
+    bool authorized(const std::string &owner, const frame_metadata_ptr &current, std::uint64_t now_ns) const;
+    /** @brief Read bounded local status, requiring successful current 2D publication and control acknowledgement. */
+    bool runtime_ready(const frame_header &header, std::uint64_t now_ns, const refresh_clock &refresh = {}) const;
+    pointer_runtime_options options_;
+    frame_reader live_reader_;
+    bool input_fault_ = false;  ///< Partial insertion disables further actual input for this transport.
+    std::mutex mutex_;  ///< Serializes requests and stop.
+    const std::string owner_, epoch_;  ///< Actual paired certificate and negotiated transport nonce.
+    frame_ledger &ledger_;  ///< Owned by the same stream, outlives this endpoint.
+    capture_registry &registry_;  ///< Authoritative uploaded source; never relabels old pixels.
+    std::function<void(const pointer_action &)> observer_;  ///< Test/diagnostic observer, not runtime input.
+    std::deque<ticket> tickets_;  ///< Maximum 64 outstanding receipts, each at most 500ms old.
+    std::deque<history> history_;  ///< Maximum 64 replay results, retained at most two seconds.
+    std::uint32_t last_seq_ = 0;  ///< Monotonic input sequence; wrap requires a new transport.
+    bool active_ = true;  ///< False after disconnect.
+  };
+
+  /** @brief Read Windows virtual-desktop bounds without changing DPI or display settings. */
+  desktop_rect pointer_desktop();
+  /** @brief Read-only v3 HWND/process or HMONITOR/bounds identity check; not permission to inject input. */
+  bool source_live_matches(const source_identity &source);
+  /** @brief Insert one bounded batch and report exact partial counts; never retry a complete click. */
+  pointer_send_result send_pointer_atomic(const pointer_action &action, const pointer_insert &insert = {});
+}  // namespace quest3d
diff --git a/src/quest3d_control.cpp b/src/quest3d_control.cpp
new file mode 100644
index 0000000..c813324
--- /dev/null
+++ b/src/quest3d_control.cpp
@@ -0,0 +1,222 @@
+/** @file src/quest3d_control.cpp
+ * @brief Local-only JSON mailbox behind the existing paired HTTPS transport.
+ */
+#include "quest3d_control.h"
+
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#ifdef _WIN32
+  #include <Windows.h>
+#endif
+
+namespace quest3d {
+  namespace {
+    using json = nlohmann::json;
+    constexpr std::size_t request_limit = 4096;
+    constexpr std::size_t status_limit = 65536;
+    constexpr std::uint64_t status_max_age = 2000000000ULL;
+    constexpr std::uint64_t command_timeout = 5000000000ULL;
+
+    /** @brief Validate an identifier without accepting paths or embedded data. */
+    bool hex_id(const json &value) {
+      if (!value.is_string()) {
+        return false;
+      }
+      const auto &text = value.get_ref<const std::string &>();
+      return text.size() == 32 && std::ranges::all_of(text, [](char c) {
+               return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+             });
+    }
+
+    /** @brief JSON numbers must be integers in the uint32 domain, not booleans. */
+    bool uint32_value(const json &value) {
+      return value.is_number_integer() && !value.is_number_float() && value >= 0 && value <= UINT32_MAX;
+    }
+
+    /** @brief Stable machine-readable errors contain no file paths. */
+    control_reply error(int code, const char *name) {
+      return {code, {{"version", 1}, {"error", name}}};
+    }
+  }  // namespace
+
+  control_mailbox::control_mailbox(std::filesystem::path directory):
+      directory_(std::move(directory)) {}
+
+  nlohmann::json control_mailbox::read_status() const {
+    if (!directory_.is_absolute()) {
+      return {};
+    }
+    std::ifstream stream(directory_ / "status.json", std::ios::binary);
+    if (!stream) {
+      return {};
+    }
+    std::string bytes(status_limit + 1, '\0');
+    stream.read(bytes.data(), bytes.size());
+    const auto count = stream.gcount();
+    if (count <= 0 || static_cast<std::size_t>(count) > status_limit) {
+      return {};
+    }
+    bytes.resize(static_cast<std::size_t>(count));
+    return nlohmann::json::parse(bytes, nullptr, false);
+  }
+
+  bool control_mailbox::write_request(const nlohmann::json &request) const {
+    if (!directory_.is_absolute()) {
+      return false;
+    }
+    // Identifiers have already been validated. The caller cannot choose either path.
+    const auto temporary = directory_ / ("quest3d-" + request.at("request_id").get<std::string>() + ".tmp");
+    const auto destination = directory_ / "request.json";
+    const auto bytes = request.dump();
+    if (bytes.size() > request_limit) {
+      return false;
+    }
+    {
+      std::ofstream stream(temporary, std::ios::binary | std::ios::trunc);
+      stream.write(bytes.data(), bytes.size());
+      stream.flush();
+      if (!stream) {
+        return false;
+      }
+    }
+#ifdef _WIN32
+    const bool success = MoveFileExW(temporary.c_str(), destination.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    std::error_code ec;
+    std::filesystem::rename(temporary, destination, ec);
+    const bool success = !ec;
+#endif
+    if (!success) {
+      std::error_code ignored;
+      std::filesystem::remove(temporary, ignored);
+    }
+    return success;
+  }
+
+  control_reply control_mailbox::get(std::uint64_t now_ns) {
+    return process(std::nullopt, read_status(), now_ns, {});
+  }
+
+  control_reply control_mailbox::post(const std::string &body, std::uint64_t now_ns) {
+    if (body.size() > request_limit) {
+      return error(413, "request_too_large");
+    }
+    return process(body, read_status(), now_ns, [this](const auto &request) {
+      return write_request(request);
+    });
+  }
+
+  control_reply control_mailbox::process(const std::optional<std::string> &request, const nlohmann::json &status, std::uint64_t now_ns, const std::function<bool(const nlohmann::json &)> &publish) {
+    std::lock_guard lock(mutex_);
+    try {
+      if (!status.is_object() || !status.contains("session_id") || !hex_id(status["session_id"]) ||
+          !status.value("running", false) || !status.contains("updated_monotonic_ns") ||
+          !status["updated_monotonic_ns"].is_number_unsigned() || !uint32_value(status.at("revision")) ||
+          !uint32_value(status.at("eye_width")) || status.at("eye_width") < 1 || status.at("eye_width") > 4096) {
+        return error(503, "publisher_unavailable");
+      }
+      const auto updated = status["updated_monotonic_ns"].get<std::uint64_t>();
+      if (now_ns < updated || now_ns - updated > status_max_age) {
+        return error(503, "publisher_stale");
+      }
+      const auto session = status["session_id"].get<std::string>();
+      if (session_ != session) {
+        session_ = session;
+        last_seq_ = 0;
+        history_.clear();
+      }
+      for (auto &item : history_) {
+        if (item.outcome != "pending") {
+          continue;
+        }
+        const auto &id = item.request.at("request_id");
+        if (status.value("applied_request", json {}) == id) {
+          item.outcome = "applied";
+        } else if (status.value("rejected_request", json {}) == id) {
+          item.outcome = "rejected";
+        } else if (item.request["mode"] == "3d" && item.request["disparity"].get<double>() > 0 && status.contains("ai_error") && !status["ai_error"].is_null()) {
+          item.outcome = "ai_unavailable";
+        } else if (now_ns < item.submitted_ns || now_ns - item.submitted_ns > command_timeout) {
+          item.outcome = "unknown_timeout";
+        }
+      }
+      json output {{"version", 1}, {"session_id", session_}, {"revision", status["revision"]}, {"last_seq", last_seq_}};
+      for (const auto *field : {"requested_mode", "effective_mode", "disparity", "eye_width", "eye_height", "seen_request", "applied_request", "rejected_request", "ai_ready", "fallback_reason"}) {
+        if (status.contains(field)) {
+          output[field] = status[field];
+        }
+      }
+      if (status.contains("stream_epoch") && status["stream_epoch"].is_number_unsigned()) {
+        output["stream_epoch"] = std::to_string(status["stream_epoch"].get<std::uint64_t>());
+      }
+      output["publisher_age_ms"] = (now_ns - updated) / 1000000.0;
+      output["input_enabled"] = false;
+      output["ai_failed"] = status.contains("ai_error") && !status["ai_error"].is_null();
+      output["last_request"] = history_.empty() ? json {} : json {{"request_id", history_.back().request["request_id"]}, {"outcome", history_.back().outcome}};
+      if (!request) {
+        return {200, std::move(output)};
+      }
+      if (request->size() > request_limit) {
+        return error(413, "request_too_large");
+      }
+      const auto body = json::parse(*request, nullptr, false);
+      const std::vector<std::string> allowed {"version", "session_id", "request_id", "seq", "expected_revision", "mode", "disparity"};
+      if (!body.is_object() || body.size() != allowed.size() || std::ranges::any_of(allowed, [&](const auto &key) {
+            return !body.contains(key);
+          }) ||
+          !uint32_value(body["version"]) || body["version"] != 1 || !hex_id(body["session_id"]) || !hex_id(body["request_id"]) || !uint32_value(body["seq"]) || !uint32_value(body["expected_revision"]) || (body["mode"] != "2d" && body["mode"] != "3d") || !body["disparity"].is_number()) {
+        return error(400, "invalid_command");
+      }
+      const double disparity = body["disparity"].get<double>();
+      if (!std::isfinite(disparity) || disparity < 0 || disparity > status["eye_width"].get<double>() * .04) {
+        return error(400, "invalid_disparity");
+      }
+      // Zero stereo strength has original 2D pixels and needs no AI result.
+      const bool original_pixels = body["mode"] == "2d" || disparity == 0;
+      if (body["session_id"] != session_) {
+        return error(409, "stale_session");
+      }
+      for (const auto &item : history_) {
+        if (item.request["request_id"] == body["request_id"]) {
+          if (item.request != body) {
+            return error(409, "request_id_conflict");
+          }
+          return {item.outcome == "pending" ? 202 : 200, {{"version", 1}, {"request_id", body["request_id"]}, {"outcome", item.outcome}, {"duplicate", true}}};
+        }
+      }
+      if (body["expected_revision"] != status["revision"]) {
+        return error(409, "revision_conflict");
+      }
+      if (body["seq"].get<std::uint32_t>() <= last_seq_) {
+        return error(409, "stale_sequence");
+      }
+      if (!original_pixels && std::ranges::any_of(history_, [](const auto &item) {
+            return item.outcome == "pending";
+          })) {
+        return error(409, "command_pending");
+      }
+      json local {{"session_id", session_}, {"request_id", body["request_id"]}, {"mode", body["mode"]}, {"disparity", disparity}, {"expected_revision", body["expected_revision"]}};
+      if (!publish || !publish(local)) {
+        return error(503, "mailbox_busy");
+      }
+      // Original pixels are the escape path while AI is warming up. Never
+      // claim the old request was applied, and preserve it if the write failed.
+      if (original_pixels) {
+        for (auto &item : history_) {
+          if (item.outcome == "pending") {
+            item.outcome = "superseded";
+          }
+        }
+      }
+      last_seq_ = body["seq"].get<std::uint32_t>();
+      history_.push_back({body, now_ns, "pending"});
+      if (history_.size() > 64) {
+        history_.pop_front();
+      }
+      return {202, {{"version", 1}, {"request_id", body["request_id"]}, {"outcome", "pending"}, {"duplicate", false}}};
+    } catch (const nlohmann::json::exception &) {
+      return error(503, "publisher_status_invalid");
+    }
+  }
+}  // namespace quest3d
diff --git a/src/quest3d_control.h b/src/quest3d_control.h
new file mode 100644
index 0000000..9715d70
--- /dev/null
+++ b/src/quest3d_control.h
@@ -0,0 +1,51 @@
+/** @file src/quest3d_control.h
+ * @brief Bounded inert command bridge for paired Quest clients.
+ */
+#pragma once
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <functional>
+#include <mutex>
+#include <nlohmann/json.hpp>
+#include <optional>
+#include <string>
+
+namespace quest3d {
+  /** @brief HTTP-independent result; no secrets or local paths are exposed. */
+  struct control_reply {
+    int code;
+    nlohmann::json body;
+  };
+
+  /** @brief Validates commands and waits for a real publisher acknowledgement. */
+  class control_mailbox {
+  public:
+    /** @brief Set the trusted local mailbox directory. @param directory Configured absolute path. */
+    explicit control_mailbox(std::filesystem::path directory);
+    /** @brief Read projected live state. @param now_ns Current host QPC nanoseconds. */
+    control_reply get(std::uint64_t now_ns);
+    /** @brief Submit a bounded command. @param body Raw JSON. @param now_ns Current QPC nanoseconds. */
+    control_reply post(const std::string &body, std::uint64_t now_ns);
+    /** @brief Core protocol entry for deterministic tests and file transport. */
+    control_reply process(const std::optional<std::string> &request, const nlohmann::json &status, std::uint64_t now_ns, const std::function<bool(const nlohmann::json &)> &publish);
+
+  private:
+    /** @brief Read a bounded status snapshot. */
+    nlohmann::json read_status() const;
+    /** @brief Atomically replace the one inert command file. */
+    bool write_request(const nlohmann::json &request) const;
+    std::filesystem::path directory_;
+    std::mutex mutex_;
+    std::string session_;
+    std::uint32_t last_seq_ = 0;
+
+    struct pending_t {
+      nlohmann::json request;
+      std::uint64_t submitted_ns;
+      std::string outcome;
+    };
+
+    std::deque<pending_t> history_;
+  };
+}  // namespace quest3d
diff --git a/src/quest3d_frame_ledger.h b/src/quest3d_frame_ledger.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_frame_ledger.h
@@ -0,0 +1,147 @@
+/** @file src/quest3d_frame_ledger.h
+ * @brief Bounded source identity carried through successful conversion, NVENC and send.
+ */
+#pragma once
+#include "quest3d_frame_metadata.h"
+
+#include <chrono>
+#include <deque>
+#include <limits>
+#include <optional>
+#include <string>
+
+namespace quest3d {
+  using frame_clock = std::chrono::steady_clock;  ///< Clock for host encode/send retention, separate from bridge QPC fields.
+
+  /** @brief Identity of the exact NVENC input that produced this output index. */
+  struct encoded_identity {
+    frame_metadata_ptr source;  ///< Exact converted source pixels' immutable metadata.
+    std::uint64_t index;  ///< Full internal NVENC input/output index.
+    frame_clock::time_point encoded_at;  ///< Time encoded output became available.
+  };
+
+  /** @brief Track the last successful conversion, including repeated encoder surfaces. */
+  class converted_frame {
+  public:
+    /** @brief Retain only a successfully converted surface identity. @param image Source metadata, empty for dummy. @param succeeded Conversion result. */
+    void converted(const frame_metadata_ptr &image, bool succeeded) {
+      source_ = succeeded ? image : nullptr;
+    }
+
+    /** @brief Bind synchronous NVENC output only to an exact input index. @param input Submitted index. @param output Returned index. @param nonempty Whether output bytes exist. @param now Encode completion time. @return Exact identity or empty. */
+    std::optional<encoded_identity> encoded(std::uint64_t input, std::uint64_t output, bool nonempty, frame_clock::time_point now) const {
+      if (!source_ || !nonempty || input != output) {
+        return {};
+      }
+      return encoded_identity {source_, output, now};
+    }
+
+  private:
+    frame_metadata_ptr source_;  ///< Last successfully converted encoder surface identity.
+  };
+
+  /** @brief True only for a negotiated 128-bit lowercase hexadecimal epoch. */
+  inline bool valid_transport_epoch(const std::string &epoch) {
+    return epoch.size() == 32 && std::all_of(epoch.begin(), epoch.end(), [](char c) {
+             return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+           });
+  }
+
+  /** @brief Metadata for one completely submitted GameStream video frame. */
+  struct sent_frame {
+    encoded_identity encoded;  ///< Immutable source and exact encode index.
+    frame_clock::time_point sent_at;  ///< Time every packet send API succeeded.
+  };
+
+  /** @brief One authenticated transport's bounded ledger, never an input authorization. */
+  class frame_ledger {
+  public:
+    static constexpr std::size_t capacity = 256;  ///< Hard bound on retained metadata entries.
+    static constexpr auto retention = std::chrono::seconds(2);  ///< Retention limit, not an input age authorization.
+
+    /** @brief Bind one authenticated stream lifetime. @param owner Canonical paired certificate. @param epoch Negotiated random lowercase nonce. */
+    frame_ledger(std::string owner, std::string epoch):
+        owner_(std::move(owner)),
+        epoch_(std::move(epoch)) {
+      active_ = !owner_.empty() && valid_transport_epoch(epoch_);
+    }
+
+    /** @brief Record only after all packet send calls succeeded; wrap fails closed until reconnect. */
+    bool record_sent(const std::optional<encoded_identity> &identity, std::uint64_t packet_index, bool complete, frame_clock::time_point now) {
+      std::lock_guard lock(mutex_);
+      prune(now);
+      if (!active_) {
+        return false;
+      }
+      if (packet_index > std::numeric_limits<std::uint32_t>::max() || (last_index_ && packet_index <= *last_index_)) {
+        active_ = false;
+        frames_.clear();
+        return false;
+      }
+      last_index_ = packet_index;
+      if (!complete || !identity || !identity->source || identity->index != packet_index || now < identity->encoded_at) {
+        return false;
+      }
+      frames_.push_back(sent_frame {*identity, now});
+      while (frames_.size() > capacity) {
+        frames_.pop_front();
+      }
+      return true;
+    }
+
+    /** @brief Exact owner/nonce/index/current-geometry lookup; caller must separately authorize any input. */
+    std::optional<sent_frame> lookup(const std::string &owner, const std::string &epoch, std::uint32_t index, const frame_metadata_ptr &current, frame_clock::time_point now) {
+      std::optional<sent_frame> result;
+      with_lookup(owner, epoch, index, current, now, [&](const sent_frame &value) {
+        result = value;
+        return true;
+      });
+      return result;
+    }
+
+    /** @brief Keep stop/wrap and the exact entry stable until bounded dispatch finishes. */
+    template<class Function>
+    bool with_lookup(const std::string &owner, const std::string &epoch, std::uint32_t index, const frame_metadata_ptr &current, frame_clock::time_point now, Function &&function) {
+      std::lock_guard lock(mutex_);
+      prune(now);
+      if (!active_ || owner != owner_ || epoch != epoch_ || !current) {
+        return false;
+      }
+      for (const auto &frame : frames_) {
+        const auto &source = frame.encoded.source;
+        if (frame.encoded.index == index && source->geometry_revision == current->geometry_revision &&
+            geometry_identity(source->header) == geometry_identity(current->header) && source->source == current->source && now >= frame.sent_at) {
+          return function(frame);
+        }
+      }
+      return false;
+    }
+
+    /** @brief Disconnect clears every old observation and cannot be resumed with this nonce. */
+    void stop() {
+      std::lock_guard lock(mutex_);
+      active_ = false;
+      frames_.clear();
+    }
+
+    /** @brief Read the retained entry count for diagnostics. @return Bounded entry count. */
+    std::size_t size() const {
+      std::lock_guard lock(mutex_);
+      return frames_.size();
+    }
+
+  private:
+    /** @brief Remove expired observations before record/lookup. @param now Current monotonic time. */
+    void prune(frame_clock::time_point now) {
+      while (!frames_.empty() && now >= frames_.front().sent_at && now - frames_.front().sent_at > retention) {
+        frames_.pop_front();
+      }
+    }
+
+    mutable std::mutex mutex_;  ///< Synchronizes send, lookup and disconnect.
+    const std::string owner_, epoch_;  ///< Immutable authenticated owner and transport identity.
+    std::deque<sent_frame> frames_;  ///< Bounded send-order metadata entries.
+    std::optional<std::uint64_t> last_index_;  ///< Detects wire wrap, repeated and regressed output indices.
+    bool active_ = false;  ///< False after invalid nonce, stop or index ambiguity.
+  };
+}  // namespace quest3d
diff --git a/src/quest3d_frame_metadata.h b/src/quest3d_frame_metadata.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_frame_metadata.h
@@ -0,0 +1,171 @@
+/** @file src/quest3d_frame_metadata.h
+ * @brief Platform-independent immutable copies of validated bridge v2 geometry.
+ */
+#pragma once
+#include "quest3d_source_identity.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <tuple>
+
+namespace quest3d {
+  constexpr std::size_t mapping_capacity = 128 + 4096ULL * 2160 * 4;  ///< Protocol v2 allocation limit.
+
+  /** @brief Little-endian wire layout; do not add compiler-dependent fields. */
+  struct frame_header {
+    std::array<char, 8> magic;  ///< Q3DFRM2 followed by NUL.
+    std::uint32_t version;  ///< Protocol version, currently two.
+    std::uint32_t header_bytes;  ///< Header size, currently 128.
+    std::uint32_t width;  ///< Encoded canvas width in pixels.
+    std::uint32_t height;  ///< Encoded canvas height in pixels.
+    std::uint32_t stride;  ///< Contiguous BGRA row bytes.
+    std::uint32_t format;  ///< One means unsigned BGRA8.
+    std::uint64_t frame_id;  ///< Producer frame number within stream epoch.
+    std::uint64_t capture_qpc_ns;  ///< Capture QPC converted to nanoseconds.
+    std::uint64_t publish_qpc_ns;  ///< Publication QPC converted to nanoseconds.
+    std::uint64_t geometry_generation;  ///< Source geometry generation.
+    std::uint32_t payload_bytes;  ///< Byte length after this header.
+    std::uint32_t flags;  ///< Full-SBS, duplicated 2D, receive-time, and InputEnabled flags.
+    std::int32_t source_left;  ///< Source physical-pixel origin x.
+    std::int32_t source_top;  ///< Source physical-pixel origin y.
+    std::uint32_t source_width;  ///< Source physical-pixel width.
+    std::uint32_t source_height;  ///< Source physical-pixel height.
+    std::uint64_t stream_epoch;  ///< Changes after producer/timeline restart.
+    std::uint32_t content_left;  ///< Eye-local content origin x, excluding padding.
+    std::uint32_t content_top;  ///< Eye-local content origin y, excluding padding.
+    std::uint32_t content_width;  ///< Eye-local content width, excluding padding.
+    std::uint32_t content_height;  ///< Eye-local content height, excluding padding.
+    std::array<std::uint8_t, 16> reserved;  ///< Reserved, zero on publication.
+  };
+
+  static_assert(sizeof(frame_header) == 128);
+  static_assert(offsetof(frame_header, frame_id) == 32);
+  static_assert(offsetof(frame_header, payload_bytes) == 64);
+  static_assert(offsetof(frame_header, stream_epoch) == 88);
+  static_assert(offsetof(frame_header, content_left) == 96);
+  static_assert(offsetof(frame_header, reserved) == 112);
+
+  /** @brief Explicit v3 wire object; never reinterpret the v2 reserved bytes. */
+  struct source_frame_header {
+    frame_header prefix;  ///< Unchanged 128-byte layout with v3 magic/version/header length.
+    source_identity source;  ///< Separate validated 64-byte source lifetime.
+  };
+
+  static_assert(sizeof(source_frame_header) == 192);
+  static_assert(offsetof(source_frame_header, source) == 128);
+
+  /** @brief Validate the complete bounded bridge v2 wire header before trusting any field. @param h Candidate header. @return Whether it is supported. */
+  inline bool valid_header(const frame_header &h) {
+    constexpr std::array<char, 8> v2 {'Q', '3', 'D', 'F', 'R', 'M', '2', '\0'};
+    constexpr std::array<char, 8> v3 {'Q', '3', 'D', 'F', 'R', 'M', '3', '\0'};
+    const bool supported = (h.version == 2 && h.magic == v2 && h.header_bytes == 128) ||
+                           (h.version == 3 && h.magic == v3 && h.header_bytes == 192);
+    if (!supported || h.format != 1) {
+      return false;
+    }
+    if (h.width == 0 || h.height == 0 || h.width > 4096 || h.height > 2160 || h.stride != h.width * 4) {
+      return false;
+    }
+    const auto bytes = static_cast<std::uint64_t>(h.stride) * h.height;
+    if (bytes != h.payload_bytes || bytes > mapping_capacity - sizeof(frame_header)) {
+      return false;
+    }
+    if ((h.flags & ~15U) != 0 || ((h.flags & 1U) != 0 && (h.width % 2) != 0) || ((h.flags & 2U) != 0 && (h.flags & 1U) == 0)) {
+      return false;
+    }
+    const auto eye_width = (h.flags & 1U) ? h.width / 2 : h.width;
+    const bool unspecified = h.content_left == 0 && h.content_top == 0 && h.content_width == 0 && h.content_height == 0;
+    const bool bounded = h.content_width > 0 && h.content_height > 0 && h.content_left < eye_width && h.content_top < h.height &&
+                         h.content_width <= eye_width - h.content_left && h.content_height <= h.height - h.content_top;
+    if ((!bounded && !(unspecified && (h.flags & 8U) == 0)) ||
+        std::any_of(h.reserved.begin(), h.reserved.end(), [](auto value) {
+          return value != 0;
+        })) {
+      return false;
+    }
+    return h.source_width > 0 && h.source_height > 0 && h.capture_qpc_ns <= h.publish_qpc_ns;
+  }
+
+  /** @brief Fields that change the meaning or permission of a physical target. */
+  inline auto geometry_identity(const frame_header &h) {
+    return std::tuple {h.stream_epoch, h.geometry_generation, h.width, h.height, h.flags & 11U, h.source_left, h.source_top, h.source_width, h.source_height, h.content_left, h.content_top, h.content_width, h.content_height};
+  }
+  class capture_registry;
+
+  /** @brief Immutable validated header bound to exactly one uploaded image. */
+  class frame_metadata {
+  public:
+    const frame_header header;  ///< Exact validated header associated with the uploaded pixels.
+    const source_identity source;  ///< v3 source lifetime, or all-zero display-only v2 identity.
+    const std::uint64_t geometry_revision;  ///< Host revision preserving source/mode round-trip invalidation.
+
+  private:
+    friend class capture_registry;
+
+    /** @brief Construct only after validation by the registry. @param value Valid header. @param revision Host geometry revision. */
+    frame_metadata(const frame_header &value, const source_identity &identity, std::uint64_t revision):
+        header(value),
+        source(identity),
+        geometry_revision(revision) {}
+  };
+
+  using frame_metadata_ptr = std::shared_ptr<const frame_metadata>;  ///< Immutable source ownership shared through encoding and send.
+
+  /** @brief Preserve mode round-trip invalidation without changing bridge v2. */
+  class capture_registry {
+  public:
+    /** @brief Publish a copied header with stable or newly advanced geometry revision. @param h Uploaded image header. @return Validated immutable metadata, or empty. */
+    frame_metadata_ptr publish(const frame_header &h, const source_identity &source = {}) {
+      std::lock_guard lock(mutex_);
+      if (!valid_header(h) || !valid_source_identity(h, source)) {
+        current_.reset();
+        return {};
+      }
+      if (!current_ || geometry_identity(current_->header) != geometry_identity(h) || current_->source != source) {
+        if (++revision_ == 0) {
+          exhausted_ = true;
+        }
+      }
+      if (exhausted_) {
+        return {};
+      }
+      current_ = frame_metadata_ptr(new frame_metadata(h, source, revision_));
+      return current_;
+    }
+
+    /** @brief Take one immutable current geometry snapshot. @return Last published metadata, if present. */
+    frame_metadata_ptr current() const {
+      std::lock_guard lock(mutex_);
+      return current_;
+    }
+
+    /** @brief Execute one bounded validation/dispatch while source identity cannot change. */
+    template<class Function>
+    bool with_current(const frame_metadata_ptr &expected, Function &&function) const {
+      std::lock_guard lock(mutex_);
+      if (!expected || !current_ || expected->geometry_revision != current_->geometry_revision ||
+          geometry_identity(expected->header) != geometry_identity(current_->header) || expected->source != current_->source) {
+        return false;
+      }
+      return function(current_);
+    }
+
+    /** @brief Invalidate current geometry; the next publication receives a new revision. */
+    void clear() {
+      std::lock_guard lock(mutex_);
+      current_.reset();
+    }
+
+  private:
+    mutable std::mutex mutex_;  ///< Guards snapshot and revision as one transaction.
+    frame_metadata_ptr current_;  ///< Last successful uploaded source metadata.
+    std::uint64_t revision_ = 0;  ///< Monotonic host geometry revision.
+    bool exhausted_ = false;  ///< Fail closed after revision overflow.
+  };
+
+  inline capture_registry uploaded_frames;  ///< Process-local authoritative uploaded source state.
+}  // namespace quest3d
diff --git a/src/quest3d_source_identity.h b/src/quest3d_source_identity.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_source_identity.h
@@ -0,0 +1,99 @@
+/** @file src/quest3d_source_identity.h
+ * @brief Explicit bridge v3 immutable source lifetime, following the unchanged 128-byte prefix.
+ */
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <tuple>
+
+namespace quest3d {
+  /** @brief Wire kinds; zero belongs only to legacy v2's absent identity. */
+  enum class source_kind : std::uint32_t {
+    unspecified_v2 = 0,
+    monitor = 1,
+    window = 2,
+    video = 3,
+    photo = 4
+  };
+
+  /** @brief Exactly the final 64 wire bytes of protocol v3. */
+  struct source_identity {
+    source_kind kind {};  ///< Explicit monitor/window/video/photo kind.
+    std::uint32_t process_id = 0;  ///< HWND owner's process, otherwise zero.
+    std::uint64_t selection_id = 0;  ///< Nonzero capture-selection lifetime identity.
+    std::uint64_t native_handle = 0;  ///< HMONITOR or HWND, otherwise zero.
+    std::uint64_t creation_filetime = 0;  ///< Window process birth, otherwise zero.
+    std::int32_t parent_left = 0, parent_top = 0;  ///< Full captured parent physical origin.
+    std::uint32_t parent_width = 0, parent_height = 0;  ///< Full captured parent extent.
+    std::array<std::uint8_t, 16> reserved {};  ///< Must remain zero.
+    bool operator==(const source_identity &) const = default;
+  };
+
+  static_assert(sizeof(source_identity) == 64);
+  static_assert(offsetof(source_identity, selection_id) == 8);
+  static_assert(offsetof(source_identity, native_handle) == 16);
+  static_assert(offsetof(source_identity, creation_filetime) == 24);
+  static_assert(offsetof(source_identity, parent_left) == 32);
+  static_assert(offsetof(source_identity, reserved) == 48);
+
+  /** @brief A displayable v3 source must identify its parent and contain the actual crop. */
+  template<class Header>
+  bool valid_source_identity(const Header &h, const source_identity &s) {
+    if (h.version == 2) {
+      return s == source_identity {};
+    }
+    if (h.version != 3 || !s.selection_id || !s.parent_width || !s.parent_height) {
+      return false;
+    }
+    for (auto byte : s.reserved) {
+      if (byte) {
+        return false;
+      }
+    }
+    const auto right = static_cast<std::int64_t>(s.parent_left) + s.parent_width;
+    const auto bottom = static_cast<std::int64_t>(s.parent_top) + s.parent_height;
+    if (h.source_left < s.parent_left || h.source_top < s.parent_top ||
+        static_cast<std::int64_t>(h.source_left) + h.source_width > right ||
+        static_cast<std::int64_t>(h.source_top) + h.source_height > bottom) {
+      return false;
+    }
+    switch (s.kind) {
+      case source_kind::monitor:
+        if (!s.native_handle || s.process_id || s.creation_filetime) {
+          return false;
+        }
+        break;
+      case source_kind::window:
+        if (!s.native_handle || !s.process_id || !s.creation_filetime) {
+          return false;
+        }
+        break;
+      case source_kind::video:
+      case source_kind::photo:
+        if (s.native_handle || s.process_id || s.creation_filetime || s.parent_left || s.parent_top || (h.flags & 8U)) {
+          return false;
+        }
+        break;
+      default:
+        return false;
+    }
+    return !(h.flags & 8U) || (h.flags & 3U) == 3U;
+  }
+
+  /** @brief Public descriptive kind; never expose a local file path or window title. */
+  inline const char *source_kind_name(source_kind kind) {
+    switch (kind) {
+      case source_kind::monitor:
+        return "monitor";
+      case source_kind::window:
+        return "window";
+      case source_kind::video:
+        return "video";
+      case source_kind::photo:
+        return "photo";
+      default:
+        return "unspecified_v2";
+    }
+  }
+}  // namespace quest3d
