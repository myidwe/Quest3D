+/**
+ * @file src/platform/windows/quest3d_instance.h
+ * @brief Process lifetime ownership of a Quest3D server base port.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <windows.h>
+
+namespace quest3d {
+  /** @brief Own a machine-wide port mutex until normal or forced process exit. */
+  class instance_guard {
+  public:
+    instance_guard() = default;  ///< Create an inert guard for non-Quest capture paths.
+    ~instance_guard();  ///< Release ownership on the acquiring main thread.
+    instance_guard(const instance_guard &) = delete;
+    instance_guard &operator=(const instance_guard &) = delete;
+
+    /** @brief Try once without waiting. @param port Configured server base port. */
+    bool acquire(std::uint16_t port);
+    /** @brief Win32 error; ERROR_ALREADY_EXISTS means another server owns the port. */
+    DWORD error() const;
+    /** @brief Stable name shared by runtime versions and Windows sessions. */
+    static std::wstring name(std::uint16_t port);
+
+  private:
+    HANDLE mutex_ = nullptr;  ///< Owning kernel handle, never inherited by child processes.
+    DWORD error_ = ERROR_SUCCESS;  ///< Acquisition diagnostic.
+  };
+}  // namespace quest3d
