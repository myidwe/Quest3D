new file mode 100644
index 0000000..89f1bfc
--- /dev/null
+++ b/src/platform/windows/display_quest3d.cpp
@@ -0,0 +1,92 @@
+/**
+ * @file src/platform/windows/display_quest3d.cpp
+ * @brief Upload offscreen Quest3D frames to Sunshine's ordinary NVENC input path.
+ */
+#include "display_quest3d.h"
+
+#include "quest3d_input.h"
+#include "src/config.h"
+#include "src/logging.h"
+#include "src/video.h"
+
+#include <algorithm>
+
+namespace platf::dxgi {
+  int display_quest3d_vram_t::init(const ::video::config_t &config, const std::string &display_name) {
+    reader_.select_protocol(::config::sunshine.quest3d_protocol);
+    quest3d::clear_input_geometry();
+    if (display_base_t::init(config, display_name)) {
+      return -1;
+    }
+    if (reader_.read(pending_, 100) != quest3d::read_result::fresh) {
+      BOOST_LOG(error) << "[Quest3D] Start the frame publisher before the host; no valid BGRA frame is available";
+      return -1;
+    }
+    const auto &h = pending_.header;
+    width = width_before_rotation = static_cast<int>(h.width);
+    height = height_before_rotation = static_cast<int>(h.height);
+    display_rotation = DXGI_MODE_ROTATION_IDENTITY;
+    capture_format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    initial_pending_ = true;
+    BOOST_LOG(info) << "[Quest3D] Shared BGRA source " << width << 'x' << height
+                    << " epoch=" << h.stream_epoch << "; CPU upload bridge; no output-window capture";
+    return 0;
+  }
+
+  capture_e display_quest3d_vram_t::snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool /*cursor_visible*/) {
+    if (initial_pending_) {
+      initial_pending_ = false;
+      // Encoder setup can take many frame intervals; prefer the latest publication.
+      if (reader_.read(pending_, 0) == quest3d::read_result::invalid) {
+        quest3d::clear_input_geometry();
+        return capture_e::timeout;
+      }
+    } else {
+      const auto result = reader_.read(pending_, static_cast<DWORD>(std::clamp<std::int64_t>(timeout.count(), 0, 200)));
+      if (result == quest3d::read_result::invalid) {
+        quest3d::clear_input_geometry();
+        BOOST_LOG(warning) << "[Quest3D] Rejected incomplete or invalid shared frame";
+        return capture_e::timeout;
+      }
+      if (result != quest3d::read_result::fresh) {
+        if (result == quest3d::read_result::unavailable) {
+          quest3d::clear_input_geometry();
+        }
+        return capture_e::timeout;
+      }
+    }
+    const auto &h = pending_.header;
+    if (h.width != static_cast<std::uint32_t>(width) || h.height != static_cast<std::uint32_t>(height)) {
+      quest3d::clear_input_geometry();
+      BOOST_LOG(info) << "[Quest3D] Source size changed; reinitializing " << h.width << 'x' << h.height;
+      return capture_e::reinit;
+    }
+    if (!pull_free_image_cb(img_out)) {
+      return capture_e::interrupted;
+    }
+    img_out->quest3d_metadata.reset();
+    const auto upload_status = upload_bgra(img_out.get(), pending_.pixels.data(), h.stride);
+    if (upload_status != capture_e::ok) {
+      img_out.reset();
+      return upload_status;
+    }
+    const auto now_qpc = quest3d::qpc_nanoseconds();
+    const auto age_ns = now_qpc >= h.capture_qpc_ns ? now_qpc - h.capture_qpc_ns : 0;
+    img_out->frame_timestamp = std::chrono::steady_clock::now() - std::chrono::nanoseconds(age_ns);
+    img_out->quest3d_metadata = quest3d::publish_input_geometry(h, pending_.source);
+    if ((accepted_frames_++ % 120) == 0) {
+      BOOST_LOG(info) << "[Quest3D] frame=" << h.frame_id << " epoch=" << h.stream_epoch
+                      << " geometry=" << h.geometry_generation << " source_age_ms=" << age_ns / 1000000.0
+                      << " bytes=" << h.payload_bytes << " flags=" << h.flags;
+    }
+    return capture_e::ok;
+  }
+
+  capture_e display_quest3d_vram_t::release_snapshot() {
+    return capture_e::ok;
+  }
+
+  bool display_quest3d_vram_t::is_hdr() {
+    return false;
+  }
+}  // namespace platf::dxgi
