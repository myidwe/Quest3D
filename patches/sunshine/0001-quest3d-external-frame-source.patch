+TEST(Quest3DFrameLedger, PacketOwnsItsConvertedSnapshotDuringConcurrentGeometryChange) {
+  quest3d::capture_registry registry;
+  auto h = header();
+  auto original = registry.publish(h);
+  quest3d::converted_frame encoder;
+  encoder.converted(original, true);
+  video::packet_raw_generic packet(std::vector<std::uint8_t> {1, 2, 3}, 42, false);
+  packet.quest3d_identity = encoder.encoded(42, 42, true, now);
+  std::thread capture([&] {
+    for (int i = 0; i < 1000; ++i) {
+      h.frame_id++;
+      h.geometry_generation++;
+      registry.publish(h);
+    }
+  });
+  quest3d::frame_ledger ledger(owner, epoch);
+  EXPECT_TRUE(ledger.record_sent(packet.quest3d_identity, packet.frame_index(), true, now));
+  capture.join();
+  ASSERT_TRUE(packet.quest3d_identity);
+  EXPECT_EQ(packet.quest3d_identity->source->header.frame_id, 1U);
+  EXPECT_EQ(packet.quest3d_identity->source->header.geometry_generation, 3U);
+  EXPECT_FALSE(ledger.lookup(owner, epoch, 42, registry.current(), now));
+  EXPECT_TRUE(ledger.lookup(owner, epoch, 42, original, now));  // historical snapshot only, not current input permission
+}
