+/** @file src/audio_route.h
+ * @brief Ownership rules for restoring Windows role-specific default endpoints.
+ */
+#pragma once
+#include <array>
+#include <cstddef>
+#include <stdexcept>
+#include <string>
+
+namespace audio {
+  /** @brief Original and applied target for one Windows audio role. */
+  struct role_route_t {
+    std::string original;  ///< Endpoint selected before this session.
+    std::string target;  ///< Endpoint requested by this session.
+    bool applied = false;  ///< This process successfully changed this role.
+    std::string outcome;  ///< Terminal restoration result, preserved across crash recovery.
+  };
+
+  /** @brief Value-only restoration state; actual COM calls remain in the platform backend. */
+  class role_route_guard_t {
+  public:
+    /** @brief Prepare before any mutation or journal write. @param originals Current IDs for each of three roles. @param target Requested endpoint ID. */
+    void prepare(const std::array<std::string, 3> &originals, const std::string &target) {
+      if (active() || target.empty()) {
+        throw std::invalid_argument("Cannot replace an owned or invalid audio route");
+      }
+      for (const auto &original : originals) {
+        if (original.empty()) {
+          throw std::invalid_argument("Cannot restore an unknown original audio role");
+        }
+      }
+      for (std::size_t role = 0; role < routes_.size(); ++role) {
+        routes_[role] = {originals[role], target, false, {}};
+      }
+    }
+
+    /** @brief Mark only a successful COM change. @param role Role index 0..2. */
+    void applied(std::size_t role) {
+      auto &route = routes_.at(role);
+      route.applied = route.original != route.target;
+      route.outcome.clear();
+    }
+
+    /** @brief Whether this session still owns the current selection. @param role Role index. @param current Current endpoint ID. @return True when restoration is permitted. */
+    bool owns(std::size_t role, const std::string &current) const {
+      const auto &route = routes_.at(role);
+      return route.applied && route.target == current;
+    }
+
+    /** @brief Forget restored or externally changed ownership.
+     * @param role Role index. @param outcome Terminal state persisted for crash recovery.
+     */
+    void relinquish(std::size_t role, const std::string &outcome = "restored") {
+      routes_.at(role).applied = false;
+      routes_.at(role).outcome = outcome;
+    }
+
+    /** @brief Guard Windows console/multimedia policy coupling before restoration.
+     * @param role Role being restored. @param peer_current Other coupled role's current ID.
+     * @return False if changing this role could overwrite a different or relinquished peer selection.
+     */
+    bool coupled_restore_safe(std::size_t role, const std::string &peer_current) const {
+      const auto &current = routes_.at(role);
+      if (role == 2) {
+        return true;
+      }
+      const auto &peer = routes_.at(1 - role);
+      return current.original == peer.original && !peer_current.empty() &&
+             (peer_current == peer.original || (peer.outcome.empty() && peer_current == peer.target));
+    }
+
+    /** @brief Determine whether any successful mutation remains owned. @return Any applied role. */
+    bool active() const {
+      for (const auto &route : routes_) {
+        if (route.applied) {
+          return true;
+        }
+      }
+      return false;
+    }
+
+    /** @brief Read the planned/original route for journaling. @param role Role index. @return Role state. */
+    const role_route_t &route(std::size_t role) const {
+      return routes_.at(role);
+    }
+
+  private:
+    std::array<role_route_t, 3> routes_;  ///< Independent state for console, multimedia and communications.
+  };
+}  // namespace audio
diff --git a/src/platform/windows/audio_route_journal.h b/src/platform/windows/audio_route_journal.h
new file mode 100644
--- /dev/null
+++ b/src/platform/windows/audio_route_journal.h
@@ -0,0 +1,189 @@
+/** @file src/platform/windows/audio_route_journal.h
+ * @brief Durable, exclusive recovery record written before default endpoint changes.
+ */
+#pragma once
+
+#include "src/audio_route.h"
+
+#include <boost/property_tree/json_parser.hpp>
+#include <boost/property_tree/ptree.hpp>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <windows.h>
+
+namespace platf::audio {
+  /** @brief Own one journal path until the platform controller is destroyed. */
+  class route_journal_t {
+  public:
+    /** @brief Start with no file lock or route ownership. */
+    route_journal_t() = default;
+    route_journal_t(const route_journal_t &) = delete;
+    route_journal_t &operator=(const route_journal_t &) = delete;
+
+    /** @brief Release the sidecar lock; the recovery JSON remains on disk. */
+    ~route_journal_t() {
+      if (lock_ != INVALID_HANDLE_VALUE) {
+        CloseHandle(lock_);
+      }
+    }
+
+    /** @brief Lock an absolute existing-directory path, refusing unresolved records.
+     * @param path Absolute recovery JSON path supplied by the product launcher.
+     * @return False if locked, invalid, unreadable or recovery remains pending.
+     */
+    bool open(const std::filesystem::path &path) {
+      std::error_code error;
+      if (lock_ != INVALID_HANDLE_VALUE || !path.is_absolute() ||
+          path.filename().empty() || !std::filesystem::is_directory(path.parent_path(), error)) {
+        return false;
+      }
+      auto sidecar = path;
+      sidecar += L".lock";
+      lock_ = CreateFileW(sidecar.c_str(), GENERIC_READ | GENERIC_WRITE | DELETE, FILE_SHARE_READ, nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, nullptr);
+      if (lock_ == INVALID_HANDLE_VALUE) {
+        return false;
+      }
+      bool valid = false;
+      try {
+        if (!std::filesystem::exists(path)) {
+          valid = true;
+        } else if (std::filesystem::file_size(path) <= 65536) {
+          std::ifstream input(path);
+          boost::property_tree::ptree previous;
+          boost::property_tree::read_json(input, previous);
+          valid = previous.get<int>("schema") == 1 && previous.get<std::string>("phase") == "restored";
+        }
+      } catch (...) {
+        valid = false;
+      }
+      if (!valid) {
+        CloseHandle(lock_);
+        lock_ = INVALID_HANDLE_VALUE;
+        return false;
+      }
+      path_ = path;
+      return true;
+    }
+
+    /** @brief Atomically flush a complete record; never change audio when this fails.
+     * @param state Per-role originals and planned targets.
+     * @param phase planned, active, restore_pending or restored.
+     * @return True only after the replacement record has been committed.
+     */
+    bool write(const ::audio::role_route_guard_t &state, const std::string &phase) const {
+      if (lock_ == INVALID_HANDLE_VALUE) {
+        return false;
+      }
+      if (phase != "planned" && phase != "active" && phase != "restore_pending" && phase != "restored") {
+        return false;
+      }
+      if ((phase == "planned" || phase == "restored") && state.active()) {
+        return false;
+      }
+      if (!watchdog_armed_ && state.active()) {
+        return false;
+      }
+      try {
+        FILETIME created {}, exited {}, kernel {}, user {};
+        if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user)) {
+          return false;
+        }
+        const auto created_ticks = (static_cast<std::uint64_t>(created.dwHighDateTime) << 32) | created.dwLowDateTime;
+        std::ostringstream output;
+        output << "{\"schema\":1,\"owner_pid\":" << GetCurrentProcessId()
+               << ",\"owner_creation_filetime\":\"" << created_ticks << "\",\"phase\":" << quote(phase)
+               << ",\"watchdog_armed\":" << (watchdog_armed_ ? "true" : "false")
+               << ",\"format_changes\":false,\"mute_changes\":false,\"volume_changes\":false,\"roles\":[";
+        for (std::size_t index = 0; index < 3; ++index) {
+          if (index) {
+            output << ',';
+          }
+          const auto &role = state.route(index);
+          output << "{\"role\":" << index << ",\"original\":" << quote(role.original)
+                 << ",\"target\":" << quote(role.target) << ",\"applied\":" << (role.applied ? "true" : "false");
+          if (!role.outcome.empty()) {
+            output << ",\"recovery_status\":" << quote(role.outcome);
+          }
+          output << '}';
+        }
+        output << "]}\n";
+        const auto bytes = output.str();
+        auto temporary = path_;
+        temporary += L"." + std::to_wstring(GetCurrentProcessId()) + L".tmp";
+        const auto file = CreateFileW(temporary.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file == INVALID_HANDLE_VALUE) {
+          return false;
+        }
+        DWORD written = 0;
+        const bool flushed = WriteFile(file, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr) &&
+                             written == bytes.size() && FlushFileBuffers(file);
+        CloseHandle(file);
+        bool committed = false;
+        if (flushed) {
+          const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(50);
+          for (unsigned attempt = 0; attempt <= 10; ++attempt) {
+            if (MoveFileExW(temporary.c_str(), path_.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+              committed = true;
+              break;
+            }
+            const auto error = GetLastError();
+            if (attempt == 10 || std::chrono::steady_clock::now() >= deadline ||
+                (error != ERROR_SHARING_VIOLATION && error != ERROR_ACCESS_DENIED && error != ERROR_LOCK_VIOLATION)) {
+              break;
+            }
+            Sleep(1);
+          }
+        }
+        if (!committed) {
+          DeleteFileW(temporary.c_str());
+        }
+        return committed;
+      } catch (...) {
+        return false;
+      }
+    }
+
+    /** @brief Whether a usable record is locked by this controller. @return Open state. */
+    bool is_open() const {
+      return lock_ != INVALID_HANDLE_VALUE;
+    }
+
+    /** @brief Commit readiness in the next planned write before the first COM call. */
+    void arm_watchdog() {
+      watchdog_armed_ = true;
+    }
+
+    /** @brief A new route must independently commit a fresh unarmed plan. */
+    void disarm_watchdog() {
+      watchdog_armed_ = false;
+    }
+
+  private:
+    /** @brief Escape UTF-8 text for a JSON string without altering scalar types.
+     * @param value Text from an endpoint ID or internal phase. @return Quoted JSON value.
+     */
+    static std::string quote(const std::string &value) {
+      std::ostringstream output;
+      output << '"';
+      for (const unsigned char character : value) {
+        if (character == '"' || character == '\\') {
+          output << '\\' << character;
+        } else if (character < 32) {
+          output << "\\u" << std::hex << std::setw(4) << std::setfill('0') << static_cast<unsigned>(character);
+        } else {
+          output << character;
+        }
+      }
+      output << '"';
+      return output.str();
+    }
+
+    std::filesystem::path path_;  ///< Explicit product runtime JSON path.
+    HANDLE lock_ = INVALID_HANDLE_VALUE;  ///< Exclusive sidecar deleted automatically on process death.
+    bool watchdog_armed_ = false;  ///< False records prove no new native route COM call was allowed.
+  };
+}  // namespace platf::audio
diff --git a/src/platform/windows/audio_watchdog.h b/src/platform/windows/audio_watchdog.h
new file mode 100644
--- /dev/null
+++ b/src/platform/windows/audio_watchdog.h
@@ -0,0 +1,92 @@
+/** @file src/platform/windows/audio_watchdog.h
+ * @brief Require a live, registered crash-recovery watchdog before audio routing.
+ */
+#pragma once
+#include <algorithm>
+#include <string>
+#include <windows.h>
+
+namespace platf::audio {
+  /** @brief Read-only consumer of the watchdog-owned READY event and lifetime mutex. */
+  class watchdog_gate_t {
+  public:
+    watchdog_gate_t() = default;  ///< No kernel objects are created by the native host.
+    watchdog_gate_t(const watchdog_gate_t &) = delete;
+    watchdog_gate_t &operator=(const watchdog_gate_t &) = delete;
+
+    ~watchdog_gate_t() {
+      close();
+    }  ///< Close handles without owning the watchdog mutex.
+
+    /** @brief Accept only the launcher's random startup token. */
+    static bool valid_token(const std::wstring &token) {
+      return token.size() == 32 && std::all_of(token.begin(), token.end(), [](wchar_t value) {
+               return (value >= L'0' && value <= L'9') || (value >= L'a' && value <= L'f');
+             });
+    }
+
+    /** @brief Wait a bounded duration after the native planned journal is committed. */
+    bool wait_ready(DWORD timeout_ms) {
+      const auto deadline = GetTickCount64() + timeout_ms;
+      do {
+        if (alive()) {
+          return true;
+        }
+        if (GetTickCount64() >= deadline) {
+          return false;
+        }
+        Sleep(1);
+      } while (true);
+    }
+
+    /** @brief READY is insufficient after watchdog exit; its mutex must still be owned. */
+    bool alive() {
+      if (!open() || WaitForSingleObject(ready_, 0) != WAIT_OBJECT_0) {
+        return false;
+      }
+      const auto state = WaitForSingleObject(live_, 0);
+      if (state == WAIT_TIMEOUT) {
+        return true;
+      }
+      if (state == WAIT_OBJECT_0 || state == WAIT_ABANDONED) {
+        ReleaseMutex(live_);
+      }
+      return false;
+    }
+
+  private:
+    /** @brief Open only the unique names supplied through the process environment. */
+    bool open() {
+      if (ready_ && live_) {
+        return true;
+      }
+      wchar_t token[33] {};
+      const auto length = GetEnvironmentVariableW(L"QUEST3D_AUDIO_WATCHDOG_TOKEN", token, 33);
+      if (length != 32 || !valid_token(token)) {
+        return false;
+      }
+      const auto suffix = std::wstring(token);
+      ready_ = OpenEventW(SYNCHRONIZE, FALSE, (L"Local\\Quest3D.Audio.Ready." + suffix).c_str());
+      live_ = OpenMutexW(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, (L"Local\\Quest3D.Audio.Live." + suffix).c_str());
+      if (!ready_ || !live_) {
+        close();
+        return false;
+      }
+      return true;
+    }
+
+    /** @brief Never release an owned watchdog lock: the host only probes it. */
+    void close() {
+      if (ready_) {
+        CloseHandle(ready_);
+      }
+      if (live_) {
+        CloseHandle(live_);
+      }
+      ready_ = live_ = nullptr;
+    }
+
+    HANDLE ready_ = nullptr;  ///< Signaled only after journal owner registration.
+    HANDLE live_ = nullptr;  ///< Remains nonsignaled only while the watchdog owns it.
+  };
+}  // namespace platf::audio
diff --git a/src/quest3d_audio_ring.h b/src/quest3d_audio_ring.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_audio_ring.h
@@ -0,0 +1,283 @@
+/** @file src/quest3d_audio_ring.h
+ * @brief Bounded PCM wire layout and transactional Opus-consumption cursors.
+ */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <map>
+#include <openssl/sha.h>
+#include <optional>
+#include <vector>
+
+namespace quest3d::pcm {
+  constexpr std::uint32_t slot_count = 50;  ///< Maximum buffered original blocks.
+  constexpr std::uint32_t max_samples = 24000;  ///< At most 500ms at 48kHz.
+  constexpr std::uint32_t eof = 1, producer_closed = 2, consumer_stopped = 4;  ///< Header flags.
+
+  /** @brief Exact 256-byte little-endian channel state; all access holds the named mutex. */
+  struct header {
+    std::array<char, 8> magic;  ///< Exact Q3DAUD1 signature.
+    std::uint32_t version, header_bytes, slots, slot_bytes, rate, channels, format, flags;  ///< Fixed format and state flags.
+    std::uint32_t producer_pid, consumer_pid;  ///< Exact process identifiers.
+    std::uint64_t producer_creation, consumer_creation;  ///< Creation FILETIME paired with each PID.
+    std::array<std::uint8_t, 16> session, channel;  ///< Immutable file and private channel identities.
+    std::uint64_t epoch, generation, head, tail, flush_request, flush_ack;  ///< Media scope and monotonic queue/barrier cursors.
+    std::uint32_t buffered_samples, fault;  ///< Reserved suffix samples and sticky failure.
+    std::uint64_t consumer_heartbeat, producer_heartbeat, encoded_samples, encoded_packets, last_block_id;  ///< Lifetime diagnostics and real encoder totals.
+    std::uint32_t ready;  ///< Native reader has bound original owner identity.
+    std::array<std::uint8_t, 60> reserved;  ///< Must remain zero in v1.
+  };
+
+  /** @brief One original PCM block suffix and its durable cumulative encoder cursor. */
+  struct slot {
+    std::uint64_t block_id, due_ns;  ///< Original block token and QPC deadline.
+    std::int64_t pts_ns;  ///< Original video-relative presentation position.
+    std::uint32_t total, offset, count, consumed, discontinuity, reserved_word;  ///< Original bounds, cumulative encoder cursor and discontinuity.
+    std::uint64_t sequence;  ///< Exact ring sequence, independent of media block id.
+    std::array<std::uint8_t, 32> digest;  ///< SHA256 of immutable metadata and valid samples.
+    std::uint64_t epoch, generation;  ///< Slot scope must match the current header.
+    std::array<std::uint8_t, 24> reserved;  ///< Must remain zero in v1.
+    std::array<float, 960> samples;  ///< Owned stereo suffix, at most 480 sample frames.
+    std::array<std::uint8_t, 128> padding;  ///< Must remain zero in v1.
+  };
+
+  /** @brief Entire fixed-size mapping; no pointers or user-controlled allocation sizes. */
+  struct memory {
+    header state;  ///< Shared channel state.
+    std::array<slot, slot_count> data;  ///< Bounded original PCM blocks.
+  };
+
+  static_assert(sizeof(header) == 256 && sizeof(slot) == 4096 && sizeof(memory) == 205056);
+  static_assert(offsetof(header, encoded_samples) == 168 && offsetof(slot, samples) == 128);
+
+  /** @brief Observable native state, separate from UDP or Quest playback. */
+  enum class result {
+    waiting,
+    encoded,
+    flushed,
+    scope_changed,
+    drained,
+    closed,
+    failed
+  };
+
+  /** @brief Validate zeros required by protocol v1. @param bytes Reserved field. */
+  template<class T>
+  bool zero(const T &bytes) {
+    return std::ranges::all_of(bytes, [](auto value) {
+      return value == 0;
+    });
+  }
+
+  /** @brief Hash immutable metadata and the owned PCM suffix, excluding mutable consumption. */
+  inline std::array<std::uint8_t, 32> digest(const slot &value) {
+    std::vector<unsigned char> input(56 + value.count * 2 * sizeof(float));
+    std::memcpy(input.data(), &value, 36);
+    std::memcpy(input.data() + 36, &value.discontinuity, 4);
+    std::memcpy(input.data() + 40, &value.epoch, 16);
+    std::memcpy(input.data() + 56, value.samples.data(), value.count * 2 * sizeof(float));
+    std::array<std::uint8_t, 32> output;
+    SHA256(input.data(), input.size(), output.data());
+    return output;
+  }
+
+  /** @brief Validate static fields, queue bounds, per-slot digest and finite stereo samples. */
+  inline bool valid(const memory &mapped) {
+    const auto &h = mapped.state;
+    if (h.magic != std::array<char, 8> {'Q', '3', 'D', 'A', 'U', 'D', '1', 0} || h.version != 1 || h.header_bytes != 256 ||
+        h.slots != slot_count || h.slot_bytes != 4096 || h.rate != 48000 || h.channels != 2 || h.format != 1 ||
+        (h.flags & ~7U) || !h.producer_pid || !h.producer_creation || zero(h.session) || zero(h.channel) ||
+        h.head > h.tail || h.tail - h.head > slot_count || h.tail > INT64_MAX || h.epoch > INT64_MAX || h.generation > INT64_MAX ||
+        h.flush_ack > h.flush_request || h.buffered_samples > max_samples || h.ready > 1 || !zero(h.reserved)) {
+      return false;
+    }
+    std::uint32_t total = 0;
+    std::optional<std::uint64_t> previous;
+    for (auto sequence = h.head; sequence < h.tail; ++sequence) {
+      const auto &s = mapped.data[sequence % slot_count];
+      if (s.sequence != sequence || s.block_id > INT64_MAX || !s.total || s.total > 480 || s.offset >= s.total ||
+          s.count != s.total - s.offset || s.consumed < s.offset || s.consumed > s.total || s.discontinuity > 5 ||
+          s.epoch != h.epoch || s.generation != h.generation ||
+          s.reserved_word || !zero(s.reserved) || !zero(s.padding) || s.due_ns > INT64_MAX ||
+          (previous && s.block_id <= *previous) ||
+          !std::all_of(s.samples.begin(), s.samples.begin() + s.count * 2, [](float v) {
+            return std::isfinite(v);
+          }) ||
+          !std::all_of(s.samples.begin() + s.count * 2, s.samples.end(), [](float v) {
+            return v == 0;
+          }) ||
+          digest(s) != s.digest) {
+        return false;
+      }
+      previous = s.block_id;
+      total += s.count;
+    }
+    return total == h.buffered_samples;
+  }
+
+  /** @brief Convert a sample cursor to exact rounded nanoseconds without floating overflow. */
+  inline std::uint64_t sample_ns(std::uint64_t samples) {
+    return (samples * 1000000000ULL + 24000) / 48000;
+  }
+
+  /** @brief A serialized pull/encode transaction; successful callbacks commit durable cursors. */
+  class ring {
+  public:
+    /** @brief Bind a validated-size memory region. @param mapped Shared ring, externally locked. */
+    explicit ring(memory &mapped):
+        mapped_(mapped) {}
+
+    /** @brief Return only the epoch/generation accepted by a real step, not an unvalidated header. */
+    std::optional<std::pair<std::uint64_t, std::uint64_t>> accepted_scope() const {
+      return scope_;
+    }
+
+    /**
+     * @brief Encode at most one 5ms/10ms packet; never ACK a copy, wait or failed encode.
+     * @param now_ns Host QPC nanoseconds.
+     * @param frame_samples Negotiated Opus frame size, 240 or 480 per channel.
+     * @param encode Synchronous encoder/handoff callback; false is terminal and is not retried.
+     * @param stop_packets Stops old-scope native packet sending before flush acknowledgement.
+     */
+    result step(std::uint64_t now_ns, unsigned frame_samples, const std::function<bool(const std::vector<float> &)> &encode, const std::function<void()> &stop_packets) {
+      auto &h = mapped_.state;
+      h.consumer_heartbeat = now_ns;
+      if (!valid(mapped_) || (frame_samples != 240 && frame_samples != 480)) {
+        h.fault = 1;
+      }
+      // Even a sticky error can stop packet handoff and return final known cursors.
+      if (h.flush_request != h.flush_ack) {
+        stop_packets();
+        h.flags |= consumer_stopped;
+        h.flush_ack = h.flush_request;
+        next_due_.reset();
+        return result::flushed;
+      }
+      if (h.fault) {
+        stop_packets();
+        return result::failed;
+      }
+      if (h.flags & producer_closed) {
+        stop_packets();
+        h.flags |= consumer_stopped;
+        return result::closed;
+      }
+      if (h.flags & consumer_stopped) {
+        return result::waiting;
+      }
+      if (!scope_ || *scope_ != std::pair {h.epoch, h.generation}) {
+        if (scope_ && std::pair {h.epoch, h.generation} < *scope_) {
+          h.fault = 1;
+          stop_packets();
+          return result::failed;
+        }
+        stop_packets();
+        scope_ = {h.epoch, h.generation};
+        next_due_.reset();
+        observed_.clear();
+        highest_block_.reset();
+        observed_head_ = observed_tail_ = 0;
+        return result::scope_changed;
+      }
+      if (!observe()) {
+        h.fault = 1;
+        stop_packets();
+        return result::failed;
+      }
+      std::vector<float> pcm(frame_samples * 2, 0.0f);
+      std::vector<std::pair<slot *, std::uint32_t>> cursors;
+      unsigned filled = 0;
+      std::optional<std::uint64_t> due;
+      for (auto sequence = h.head; sequence < h.tail && filled < frame_samples; ++sequence) {
+        auto &s = mapped_.data[sequence % slot_count];
+        if (s.consumed == s.total) {
+          continue;
+        }
+        const auto start_ns = s.due_ns + sample_ns(s.consumed);
+        if (!due) {
+          due = start_ns;
+          if (now_ns < *due) {
+            return result::waiting;
+          }
+          if (now_ns - *due > 250000000ULL) {
+            h.fault = 5;
+            return result::failed;
+          }
+          if (next_due_ && (*due > *next_due_ + 2 || *next_due_ > *due + 2)) {
+            h.fault = 4;
+            return result::failed;
+          }
+        }
+        const auto expected = *due + sample_ns(filled);
+        if (s.discontinuity >= 3 || start_ns > expected + 2 || expected > start_ns + 2) {
+          h.fault = 4;
+          return result::failed;
+        }
+        const auto count = std::min<unsigned>(s.total - s.consumed, frame_samples - filled);
+        std::copy_n(s.samples.begin() + (s.consumed - s.offset) * 2, count * 2, pcm.begin() + filled * 2);
+        cursors.emplace_back(&s, s.consumed + count);
+        filled += count;
+      }
+      if (!filled) {
+        return (h.flags & eof) ? result::drained : result::waiting;
+      }
+      if (filled < frame_samples && !(h.flags & eof)) {
+        return result::waiting;
+      }
+      if (!encode(pcm)) {
+        h.fault = 6;
+        stop_packets();
+        return result::failed;
+      }
+      for (auto [s, cursor] : cursors) {
+        s->consumed = cursor;
+      }
+      h.encoded_samples += filled;
+      ++h.encoded_packets;
+      next_due_ = *due + sample_ns(frame_samples);
+      return result::encoded;
+    }
+
+  private:
+    /** @brief Reject rewritten observed payloads, duplicate blocks and same-scope cursor rewinds. */
+    bool observe() {
+      const auto &h = mapped_.state;
+      if (h.head < observed_head_ || h.tail < observed_tail_) {
+        return false;
+      }
+      while (!observed_.empty() && observed_.begin()->first < h.head) {
+        observed_.erase(observed_.begin());
+      }
+      for (auto sequence = h.head; sequence < h.tail; ++sequence) {
+        const auto &s = mapped_.data[sequence % slot_count];
+        const auto identity = std::pair {s.block_id, s.digest};
+        if (const auto previous = observed_.find(sequence); previous != observed_.end()) {
+          if (previous->second != identity) {
+            return false;
+          }
+        } else {
+          if (highest_block_ && s.block_id <= *highest_block_) {
+            return false;
+          }
+          highest_block_ = s.block_id;
+          observed_[sequence] = identity;
+        }
+      }
+      observed_head_ = h.head;
+      observed_tail_ = h.tail;
+      return true;
+    }
+
+    memory &mapped_;  ///< Externally mutex-protected ring.
+    std::optional<std::pair<std::uint64_t, std::uint64_t>> scope_;  ///< Encoder scope; change resets all partial state.
+    std::optional<std::uint64_t> next_due_;  ///< Expected next original PCM timestamp.
+    std::map<std::uint64_t, std::pair<std::uint64_t, std::array<std::uint8_t, 32>>> observed_;  ///< At most 50 immutable slot identities.
+    std::optional<std::uint64_t> highest_block_;  ///< Prevents a reaped token from being offered again.
+    std::uint64_t observed_head_ = 0, observed_tail_ = 0;  ///< Same-scope ring sequences cannot reverse.
+  };
+}  // namespace quest3d::pcm
diff --git a/src/quest3d_audio_packet.h b/src/quest3d_audio_packet.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_audio_packet.h
@@ -0,0 +1,34 @@
+/** @file src/quest3d_audio_packet.h
+ * @brief Serializes native file-audio packet sends with a local flush barrier.
+ */
+#pragma once
+#include <cstdint>
+#include <mutex>
+
+namespace quest3d::pcm {
+  /** @brief Skip the remainder of an old four-data-shard FEC group after a PCM scope change. */
+  constexpr std::uint16_t next_fec_sequence(std::uint16_t sequence) {
+    return static_cast<std::uint16_t>((static_cast<unsigned>(sequence) + 3U) & ~3U);
+  }
+
+  /** @brief One epoch/generation's encoded packet permission, never Quest playback ACK. */
+  struct packet_scope {
+    std::mutex mutex;  ///< Held across actual send and by flush invalidation.
+    bool active = true;  ///< False prevents queued old-scope packets from sending.
+
+    /** @brief Acquire the actual send/FEC gate, or return an unlocked guard for a retired packet. */
+    std::unique_lock<std::mutex> acquire_send() {
+      std::unique_lock lock(mutex);
+      if (!active) {
+        lock.unlock();
+      }
+      return lock;
+    }
+
+    /** @brief Wait for current send to finish, then deny subsequent old sends. */
+    void stop() {
+      std::lock_guard lock(mutex);
+      active = false;
+    }
+  };
+}  // namespace quest3d::pcm
diff --git a/src/quest3d_file_transport.h b/src/quest3d_file_transport.h
new file mode 100644
--- /dev/null
+++ b/src/quest3d_file_transport.h
@@ -0,0 +1,172 @@
+/** @file src/quest3d_file_transport.h
+ * @brief Internal FilePCM closure from actual reader retirement and session worker joins.
+ */
+#pragma once
+#ifdef _WIN32
+  #include "platform/windows/quest3d_audio_reader.h"
+  #include "quest3d_audio_packet.h"
+
+namespace stream {
+  struct session_t;
+
+  namespace session {
+    /** @brief Actual worker barrier shared by normal session::join and isolated lifecycle tests. */
+    void join_workers(session_t &session);
+  }  // namespace session
+}  // namespace stream
+
+namespace quest3d::pcm {
+  /** @brief Exact owner copied from authenticated launch plus the host's bootstrap PCM channel. */
+  struct file_transport_identity {
+    std::string client_certificate, transport_epoch, channel;  ///< Exact paired PEM, launch nonce and private PCM channel.
+    std::uint32_t launch_session_id, host_pid;  ///< Actual RTSP session and current host process.
+    std::uint64_t host_creation;  ///< Actual host creation FILETIME; PID alone is insufficient.
+  };
+
+  class file_transport;
+
+  /** @brief Read-only completed host scope; neither a JSON assertion nor a Quest playback receipt. */
+  class file_transport_closed {
+  public:
+    /** @brief Return the immutable authenticated transport owner. */
+    const file_transport_identity &transport() const {
+      return transport_;
+    }
+
+    /** @brief Return the sealed actual PCM reader retirement. */
+    const reader_retirement &reader() const {
+      return reader_;
+    }
+
+    /** @brief Count packet scopes closed across this session, including prior generations. */
+    std::uint64_t packet_scopes_closed() const {
+      return packet_scopes_closed_;
+    }
+
+  private:
+    friend class file_transport;
+
+    /** @brief Only the tracker can issue this after all actual lifecycle boundaries complete. */
+    file_transport_closed(file_transport_identity identity, reader_retirement reader, std::uint64_t gates):
+        transport_(std::move(identity)),
+        reader_(std::move(reader)),
+        packet_scopes_closed_(gates) {}
+
+    file_transport_identity transport_;  ///< Original authenticated stream owner.
+    reader_retirement reader_;  ///< Actual private native resource release.
+    std::uint64_t packet_scopes_closed_;  ///< Closed gate lineage, not transmitted or played samples.
+  };
+
+  /** @brief One transport's internal observation, retained independently of stream registry removal. */
+  class file_transport {
+  public:
+    /** @brief Copy the immutable bootstrap binding before any audio worker starts. */
+    explicit file_transport(file_transport_identity identity):
+        identity_(std::move(identity)) {}
+
+    /** @brief Return the channel captured for this launch; running process env changes cannot replace it. */
+    const std::string &channel() const {
+      return identity_.channel;
+    }
+
+    /** @brief Return this launch's immutable video gate; every packet retains it before enqueue. */
+    const std::shared_ptr<packet_scope> &video_gate() const {
+      return video_scope_;
+    }
+
+    /** @brief Replace a packet scope only after its actual send/FEC mutex has been retired. */
+    std::shared_ptr<packet_scope> replace_packet_scope() {
+      std::lock_guard transition(transition_mutex_);
+      auto next = std::make_shared<packet_scope>();
+      std::shared_ptr<packet_scope> previous;
+      {
+        std::lock_guard lock(mutex_);
+        previous = scope_;
+      }
+      if (previous) {
+        previous->stop();
+      }
+      std::lock_guard lock(mutex_);
+      if (reader_ || closure_) {
+        return {};
+      }
+      if (previous) {
+        ++closed_scopes_;
+      }
+      scope_ = next;
+      return next;
+    }
+
+    /** @brief Accept only a sealed resource-release token from this exact actual PCM consumer. */
+    void capture_retired(const reader_retirement &retired) {
+      std::lock_guard transition(transition_mutex_);
+      const auto &h = retired.identity();
+      constexpr char hex[] = "0123456789abcdef";
+      std::string channel;
+      for (const auto byte : h.channel) {
+        channel += hex[byte >> 4];
+        channel += hex[byte & 15];
+      }
+      std::shared_ptr<packet_scope> scope;
+      {
+        std::lock_guard lock(mutex_);
+        scope = scope_;
+      }
+      const bool valid_transport = identity_.transport_epoch.size() == 32 && std::ranges::all_of(identity_.transport_epoch, [](char c) {
+                                     return (c >= 'a' && c <= 'f') || (c >= '0' && c <= '9');
+                                   });
+      if (channel != identity_.channel || !identity_.host_pid || !identity_.host_creation || h.consumer_pid != identity_.host_pid || h.consumer_creation != identity_.host_creation ||
+          identity_.client_certificate.empty() || !valid_transport || !retired.media_scope() || !scope) {
+        return;
+      }
+      {
+        std::lock_guard gate(scope->mutex);
+        if (scope->active) {
+          return;
+        }
+      }
+      std::lock_guard lock(mutex_);
+      if (!reader_) {
+        reader_ = retired;
+        ++closed_scopes_;
+      }
+    }
+
+    /** @brief Observe only a completed host scope; STOPPING/local flush/reader release alone return empty. */
+    std::optional<file_transport_closed> closed() const {
+      std::lock_guard lock(mutex_);
+      return closure_;
+    }
+
+    /** @brief Observe PCM resource retirement only; worker/control completion remains a separate barrier. */
+    bool reader_retired() const {
+      std::lock_guard lock(mutex_);
+      return reader_.has_value();
+    }
+
+  private:
+    friend void stream::session::join_workers(stream::session_t &session);
+
+    /** @brief Called exclusively after the real session video/audio joins and controlEnd wait return. */
+    void workers_joined() {
+      std::lock_guard transition(transition_mutex_);
+      // The global video broadcaster outlives individual capture workers.
+      // Wait for its current UDP/FEC send and deny every queued/late old packet.
+      video_scope_->stop();
+      std::lock_guard lock(mutex_);
+      if (reader_ && !closure_) {
+        closure_ = file_transport_closed {identity_, *reader_, closed_scopes_};
+      }
+    }
+
+    const file_transport_identity identity_;  ///< Fixed owner; no later client-provided binding.
+    std::mutex transition_mutex_;  ///< Serializes gate replacement and retirement without blocking observations.
+    mutable std::mutex mutex_;  ///< Protects observations; never held over a send or worker wait.
+    std::shared_ptr<packet_scope> scope_;  ///< Current scope; every replaced predecessor is already stopped.
+    const std::shared_ptr<packet_scope> video_scope_ = std::make_shared<packet_scope>();  ///< Independent per-transport video send gate.
+    std::uint64_t closed_scopes_ = 0;  ///< Actual stopped predecessor/current gates.
+    std::optional<reader_retirement> reader_;  ///< Actual resource retirement, absent on open/close failure.
+    std::optional<file_transport_closed> closure_;  ///< Issued only by the production worker barrier.
+  };
+}  // namespace quest3d::pcm
+#endif
diff --git a/src/platform/windows/quest3d_audio_reader.h b/src/platform/windows/quest3d_audio_reader.h
new file mode 100644
--- /dev/null
+++ b/src/platform/windows/quest3d_audio_reader.h
@@ -0,0 +1,219 @@
+/** @file src/platform/windows/quest3d_audio_reader.h
+ * @brief Private Windows PCM mapping consumer with exact producer lifetime.
+ */
+#pragma once
+#include "src/quest3d_audio_ring.h"
+
+#include <memory>
+#include <string>
+#include <Windows.h>
+
+namespace quest3d::pcm {
+  class reader;
+
+  /** @brief Immutable proof issued only after an opened native reader releases its owned resources. */
+  class reader_retirement {
+  public:
+    /** @brief Return the original validated file/channel and process lifetimes. */
+    const header &identity() const {
+      return identity_;
+    }
+
+    /** @brief Return the last scope accepted by ring::step; absent means no media scope was entered. */
+    const std::optional<std::pair<std::uint64_t, std::uint64_t>> &media_scope() const {
+      return scope_;
+    }
+
+  private:
+    friend class reader;
+
+    /** @brief Only reader::retire can construct a closure after actual successful resource release. */
+    reader_retirement(header identity, std::optional<std::pair<std::uint64_t, std::uint64_t>> scope):
+        identity_(std::move(identity)),
+        scope_(scope) {}
+
+    header identity_;  ///< Immutable original ownership, never a later JSON assertion.
+    std::optional<std::pair<std::uint64_t, std::uint64_t>> scope_;  ///< Last accepted media scope.
+  };
+
+  /** @brief Exact process creation FILETIME; zero means unavailable. */
+  inline std::uint64_t creation_time(HANDLE process) {
+    FILETIME creation {}, exit {}, kernel {}, user {};
+    if (!GetProcessTimes(process, &creation, &exit, &kernel, &user)) {
+      return 0;
+    }
+    return (std::uint64_t(creation.dwHighDateTime) << 32) | creation.dwLowDateTime;
+  }
+
+  /** @brief One native consumer; opening never creates or trusts a missing producer mapping. */
+  class reader {
+  public:
+    reader() = default;  ///< Create an unopened reader.
+    reader(const reader &) = delete;  ///< Native handle ownership cannot be copied.
+    reader &operator=(const reader &) = delete;  ///< Native handle ownership cannot be assigned.
+
+    /** @brief Close owned handles without changing any Windows audio endpoint. */
+    ~reader() {
+      close_resources();
+    }
+
+    /** @brief Release this thread's actual reader resources; failure or unopened/repeated calls issue no token. */
+    std::optional<reader_retirement> retire() {
+      const bool was_open = opened_;
+      opened_ = false;
+      const auto scope = core_ ? core_->accepted_scope() : std::nullopt;
+      if (!close_resources() || !was_open) {
+        return std::nullopt;
+      }
+      return reader_retirement {identity_, scope};
+    }
+
+    /** @brief Open a random channel and bind its exact original process lifetime. */
+    bool open(const std::string &channel) {
+      if (mutex_ || mapping_ || consumer_ || producer_ || mapped_ || opened_) {
+        return false;
+      }
+      if (channel.size() != 32 || !std::ranges::all_of(channel, [](char c) {
+            return (c >= 'a' && c <= 'f') || (c >= '0' && c <= '9');
+          })) {
+        return false;
+      }
+      const std::wstring prefix = L"Local\\Quest3D.Audio.v1." + std::wstring(channel.begin(), channel.end());
+      mutex_ = OpenMutexW(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, (prefix + L".Mutex").c_str());
+      mapping_ = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, prefix.c_str());
+      if (!mutex_ || !mapping_) {
+        return false;
+      }
+      mapped_ = static_cast<memory *>(MapViewOfFile(mapping_, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(memory)));
+      if (!mapped_) {
+        return false;
+      }
+      SetLastError(0);
+      consumer_ = CreateMutexW(nullptr, TRUE, (prefix + L".Consumer").c_str());
+      if (!consumer_ || GetLastError() == ERROR_ALREADY_EXISTS) {
+        return false;
+      }
+      consumer_owned_ = true;
+      const auto opened_wait = WaitForSingleObject(mutex_, 50);
+      if (opened_wait == WAIT_ABANDONED) {
+        mapped_->state.fault = 7;
+        ReleaseMutex(mutex_);
+        return false;
+      }
+      if (opened_wait != WAIT_OBJECT_0) {
+        return false;
+      }
+      bool success = false;
+      auto &h = mapped_->state;
+      if (valid(*mapped_) && !h.consumer_pid && !h.fault && !(h.flags & (producer_closed | consumer_stopped))) {
+        std::array<std::uint8_t, 16> expected {};
+        for (unsigned i = 0; i < 16; ++i) {
+          expected[i] = static_cast<std::uint8_t>(std::stoi(channel.substr(i * 2, 2), nullptr, 16));
+        }
+        producer_ = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_LIMITED_INFORMATION, FALSE, h.producer_pid);
+        const auto consumer_creation = creation_time(GetCurrentProcess());
+        if (consumer_creation && h.channel == expected && producer_ && creation_time(producer_) == h.producer_creation && WaitForSingleObject(producer_, 0) == WAIT_TIMEOUT) {
+          h.consumer_pid = GetCurrentProcessId();
+          h.consumer_creation = consumer_creation;
+          h.ready = 1;
+          identity_ = h;
+          core_ = std::make_unique<ring>(*mapped_);
+          opened_ = true;
+          success = true;
+        }
+      }
+      ReleaseMutex(mutex_);
+      return success;
+    }
+
+    /** @brief Hold the transaction mutex across the actual encoder callback and cursor commit. */
+    result step(std::uint64_t now_ns, unsigned samples, const std::function<bool(const std::vector<float> &)> &encode, const std::function<void()> &stop_packets) {
+      if (!core_) {
+        return result::failed;
+      }
+      const auto wait = WaitForSingleObject(mutex_, 50);
+      if (wait == WAIT_TIMEOUT) {
+        return result::waiting;
+      }
+      if (wait != WAIT_OBJECT_0 && wait != WAIT_ABANDONED) {
+        return result::failed;
+      }
+      auto &h = mapped_->state;
+      if (wait == WAIT_ABANDONED) {
+        h.fault = 7;
+      }
+      if (WaitForSingleObject(producer_, 0) != WAIT_TIMEOUT && !(h.flags & producer_closed)) {
+        h.fault = 2;
+      }
+      if (h.session != identity_.session || h.channel != identity_.channel || h.producer_pid != identity_.producer_pid ||
+          h.producer_creation != identity_.producer_creation || h.consumer_pid != identity_.consumer_pid ||
+          h.consumer_creation != identity_.consumer_creation) {
+        h.fault = 1;
+      }
+      result outcome = result::failed;
+      try {
+        outcome = core_->step(now_ns, samples, encode, stop_packets);
+      } catch (...) {
+        h.fault = 6;
+        stop_packets();
+      }
+      ReleaseMutex(mutex_);
+      return outcome;
+    }
+
+    /** @brief Stop local packet handoff and atomically leave final encoder cursors intact. */
+    void stop(const std::function<void()> &stop_packets) {
+      if (!core_) {
+        return;
+      }
+      const auto wait = WaitForSingleObject(mutex_, 50);
+      if (wait != WAIT_OBJECT_0 && wait != WAIT_ABANDONED) {
+        stop_packets();
+        return;
+      }
+      stop_packets();
+      mapped_->state.flags |= consumer_stopped;
+      mapped_->state.ready = 0;
+      mapped_->state.flush_ack = mapped_->state.flush_request;
+      ReleaseMutex(mutex_);
+    }
+
+  private:
+    /** @brief Close all owned resources and preserve a failure instead of claiming retirement. */
+    bool close_resources() {
+      bool success = true;
+      core_.reset();
+      if (mapped_) {
+        if (UnmapViewOfFile(mapped_)) {
+          mapped_ = nullptr;
+        } else {
+          success = false;
+        }
+      }
+      if (consumer_ && consumer_owned_) {
+        if (ReleaseMutex(consumer_)) {
+          consumer_owned_ = false;
+        } else {
+          success = false;
+        }
+      }
+      for (auto *handle : {&consumer_, &producer_, &mapping_, &mutex_}) {
+        if (*handle) {
+          if (CloseHandle(*handle)) {
+            *handle = nullptr;
+          } else {
+            success = false;
+          }
+        }
+      }
+      return success;
+    }
+
+    HANDLE mapping_ = nullptr, mutex_ = nullptr, consumer_ = nullptr, producer_ = nullptr;  ///< Owned kernel handles.
+    memory *mapped_ = nullptr;  ///< Exact-sized mapped view.
+    std::unique_ptr<ring> core_;  ///< Scope and expected deadline state.
+    bool consumer_owned_ = false;  ///< Existing mutexes are never released by a duplicate reader.
+    bool opened_ = false;  ///< A successful real open is required to issue retirement evidence.
+    header identity_ {};  ///< Immutable file/channel/process ownership captured at successful open.
+  };
+}  // namespace quest3d::pcm
diff --git a/tests/unit/test_quest3d_audio_ring.cpp b/tests/unit/test_quest3d_audio_ring.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_quest3d_audio_ring.cpp
@@ -0,0 +1,312 @@
+/** @file tests/unit/test_quest3d_audio_ring.cpp
+ * @brief Transaction, malformed PCM and actual Opus encode/decode regression checks.
+ */
+#include "src/quest3d_audio_packet.h"
+#include "src/quest3d_audio_ring.h"
+#include "src/thread_safe.h"
+#include "tests/tests_common.h"
+
+#include <future>
+#include <opus/opus_multistream.h>
+
+namespace {
+  using namespace quest3d::pcm;
+  constexpr std::uint64_t now = 1000000000;
+
+  /** @brief Valid deterministic private ring with one PCM producer. */
+  class QuestAudioRing: public ::testing::Test {
+  protected:
+    memory mapped {};
+    ring reader {mapped};
+    unsigned calls = 0, stops = 0;
+    std::vector<float> last;
+
+    void SetUp() override {
+      auto &h = mapped.state;
+      h.magic = {'Q', '3', 'D', 'A', 'U', 'D', '1', 0};
+      h.version = 1;
+      h.header_bytes = 256;
+      h.slots = 50;
+      h.slot_bytes = 4096;
+      h.rate = 48000;
+      h.channels = 2;
+      h.format = 1;
+      h.producer_pid = 1;
+      h.producer_creation = 1;
+      h.session[0] = 1;
+      h.channel[0] = 2;
+      ASSERT_EQ(step(), result::scope_changed);
+    }
+
+    /** @brief Append a known stereo block. */
+    void add(unsigned count = 480, std::uint64_t due = now, unsigned offset = 0) {
+      auto &h = mapped.state;
+      auto &s = mapped.data[h.tail % slot_count];
+      s = {};
+      s.block_id = h.tail + 1;
+      s.due_ns = due;
+      s.total = count;
+      s.offset = s.consumed = offset;
+      s.count = count - offset;
+      s.sequence = h.tail++;
+      s.epoch = h.epoch;
+      s.generation = h.generation;
+      for (unsigned i = 0; i < s.count; ++i) {
+        s.samples[i * 2] = .2f;
+        s.samples[i * 2 + 1] = -.1f;
+      }
+      s.digest = digest(s);
+      h.buffered_samples += s.count;
+    }
+
+    /** @brief Execute an injected successful encoder without OS audio. */
+    result step(std::uint64_t clock = now, unsigned samples = 240, bool success = true) {
+      return reader.step(clock, samples, [&](const auto &pcm) {
+        ++calls;
+        last = pcm;
+        return success;
+      },
+                         [&] {
+                           ++stops;
+                         });
+    }
+  };
+}  // namespace
+
+TEST_F(QuestAudioRing, ExactWireAndInvalidSamplesFailBeforeEncode) {
+  add();
+  ASSERT_TRUE(valid(mapped));
+  mapped.data[0].samples[3] = std::numeric_limits<float>::quiet_NaN();
+  EXPECT_EQ(step(), result::failed);
+  EXPECT_EQ(calls, 0U);
+  EXPECT_EQ(mapped.data[0].consumed, 0U);
+}
+
+TEST_F(QuestAudioRing, CorruptDigestPaddingAndRingBoundsAreRejected) {
+  add();
+  const auto original = mapped;
+  mapped.data[0].digest[0] ^= 1;
+  EXPECT_FALSE(valid(mapped));
+  mapped = original;
+  mapped.data[0].padding[0] = 1;
+  EXPECT_FALSE(valid(mapped));
+  mapped = original;
+  mapped.state.tail = 51;
+  EXPECT_FALSE(valid(mapped));
+  mapped = original;
+  mapped.state.buffered_samples++;
+  EXPECT_FALSE(valid(mapped));
+}
+
+TEST_F(QuestAudioRing, HeaderOnlyGenerationChangeCannotRelabelOldPcm) {
+  add();
+  mapped.state.generation = 1;
+  EXPECT_EQ(step(), result::failed);
+  EXPECT_EQ(calls, 0U);
+  EXPECT_EQ(mapped.data[0].consumed, 0U);
+}
+
+TEST_F(QuestAudioRing, EmptyNewScopeResetsBeforeFirstPullAndRejectsReversal) {
+  mapped.state.generation = 1;
+  EXPECT_EQ(step(), result::scope_changed);
+  EXPECT_EQ(calls, 0U);
+  add();
+  EXPECT_EQ(step(), result::encoded);
+  mapped.state.head = mapped.state.tail = 0;
+  mapped.state.buffered_samples = 0;
+  mapped.state.generation = 0;
+  EXPECT_EQ(step(), result::failed);
+  EXPECT_EQ(calls, 1U);
+}
+
+TEST_F(QuestAudioRing, DeadlineAndPartialCumulativeCursorAreExact) {
+  add();
+  EXPECT_EQ(step(now - 1), result::waiting);
+  EXPECT_EQ(calls, 0U);
+  EXPECT_EQ(step(), result::encoded);
+  EXPECT_EQ(mapped.data[0].consumed, 240U);
+  EXPECT_EQ(step(now + 4999999), result::waiting);
+  EXPECT_EQ(step(now + 5000000), result::encoded);
+  EXPECT_EQ(mapped.data[0].consumed, 480U);
+  EXPECT_EQ(mapped.state.encoded_samples, 480U);
+  EXPECT_EQ(mapped.state.encoded_packets, 2U);
+}
+
+TEST_F(QuestAudioRing, PreviouslyObservedPartialPayloadCannotBeRewrittenEvenWithNewDigest) {
+  add();
+  ASSERT_EQ(step(), result::encoded);
+  mapped.data[0].samples[600] = .9f;
+  mapped.data[0].digest = digest(mapped.data[0]);
+  EXPECT_EQ(step(now + 5000000), result::failed);
+  EXPECT_EQ(mapped.data[0].consumed, 240U);
+  EXPECT_EQ(calls, 1U);
+}
+
+TEST_F(QuestAudioRing, ReapedOriginalBlockCannotBeAppendedAgainInSameScope) {
+  add();
+  ASSERT_EQ(step(now, 480), result::encoded);
+  mapped.state.head = mapped.state.tail;
+  mapped.state.buffered_samples = 0;
+  add(480, now + 10000000);
+  mapped.data[1].block_id = 1;
+  mapped.data[1].digest = digest(mapped.data[1]);
+  EXPECT_EQ(step(now + 10000000), result::failed);
+  EXPECT_EQ(calls, 1U);
+  EXPECT_EQ(mapped.data[1].consumed, 0U);
+}
+
+TEST_F(QuestAudioRing, FailureIsStickyNeverRetriedAndFlushReturnsKnownCursor) {
+  add();
+  EXPECT_EQ(step(now, 240, false), result::failed);
+  EXPECT_EQ(step(now + 5000000), result::failed);
+  EXPECT_EQ(calls, 1U);
+  EXPECT_EQ(mapped.data[0].consumed, 0U);
+  mapped.state.flush_request = 1;
+  EXPECT_EQ(step(), result::flushed);
+  EXPECT_EQ(mapped.state.flush_ack, 1U);
+  EXPECT_TRUE(mapped.state.flags & consumer_stopped);
+}
+
+TEST_F(QuestAudioRing, FlushPreservesPartialCursorAndNewGenerationResetsPacketState) {
+  add();
+  ASSERT_EQ(step(), result::encoded);
+  mapped.state.flush_request = 1;
+  EXPECT_EQ(step(), result::flushed);
+  EXPECT_EQ(mapped.data[0].consumed, 240U);
+  EXPECT_EQ(step(now + 5000000), result::waiting);
+  mapped.state.generation++;
+  mapped.state.head = mapped.state.tail = 0;
+  mapped.state.buffered_samples = 0;
+  mapped.state.flags = 0;
+  EXPECT_EQ(step(), result::scope_changed);
+  add(480, now + 100000000);
+  EXPECT_EQ(step(now + 100000000), result::encoded);
+}
+
+TEST_F(QuestAudioRing, VariableBlocksCombineAndEofPadsOnlyWithoutClaimingPaddingConsumed) {
+  add(100);
+  add(150, now + sample_ns(100));
+  EXPECT_EQ(step(), result::encoded);
+  EXPECT_EQ(mapped.data[1].consumed, 140U);
+  EXPECT_EQ(step(now + 5000000), result::waiting);
+  mapped.state.flags |= quest3d::pcm::eof;
+  EXPECT_EQ(step(now + 5000000), result::encoded);
+  EXPECT_EQ(mapped.state.encoded_samples, 250U);
+  EXPECT_TRUE(std::all_of(last.begin() + 20, last.end(), [](float v) {
+    return v == 0;
+  }));
+  EXPECT_EQ(step(now + 10000000), result::drained);
+}
+
+TEST_F(QuestAudioRing, GapOverlapAndExcessiveLatenessNeverConsumeSamples) {
+  add(120);
+  add(120, now + 10000000);
+  EXPECT_EQ(step(), result::failed);
+  EXPECT_EQ(mapped.state.encoded_samples, 0U);
+  mapped.state.fault = 0;
+  mapped.data[1].due_ns = now - 1;
+  mapped.data[1].digest = digest(mapped.data[1]);
+  EXPECT_EQ(step(), result::failed);
+  EXPECT_EQ(mapped.state.encoded_samples, 0U);
+  mapped.state.fault = 0;
+  EXPECT_EQ(step(now + 250000001), result::failed);
+}
+
+TEST_F(QuestAudioRing, FiftyUnconfirmedBlocksBackpressureWithoutErasingEncoderCursors) {
+  for (unsigned i = 0; i < 50; ++i) {
+    add(480, now + i * 10000000ULL);
+  }
+  ASSERT_TRUE(valid(mapped));
+  for (unsigned i = 0; i < 100; ++i) {
+    ASSERT_EQ(step(now + i * 5000000ULL), result::encoded);
+  }
+  EXPECT_EQ(mapped.state.buffered_samples, 24000U);
+  EXPECT_EQ(mapped.state.tail - mapped.state.head, 50U);
+  EXPECT_EQ(mapped.state.encoded_samples, 24000U);
+  EXPECT_EQ(mapped.data[0].consumed, 480U);
+}
+
+TEST_F(QuestAudioRing, ActualOpusEncodeDecodePreservesStereoSignalAndCounts) {
+  add();
+  unsigned char channels[] = {0, 1};
+  int error = 0;
+  auto encoder = opus_multistream_encoder_create(48000, 2, 1, 1, channels, OPUS_APPLICATION_RESTRICTED_LOWDELAY, &error);
+  ASSERT_EQ(error, OPUS_OK);
+  auto decoder = opus_multistream_decoder_create(48000, 2, 1, 1, channels, &error);
+  ASSERT_EQ(error, OPUS_OK);
+  opus_multistream_encoder_ctl(encoder, OPUS_SET_BITRATE(512000));
+  opus_multistream_encoder_ctl(encoder, OPUS_SET_VBR(0));
+  std::vector<float> decoded(960);
+  EXPECT_EQ(reader.step(now, 480, [&](const auto &pcm) {
+    std::array<unsigned char, 1400> encoded;
+    const auto bytes = opus_multistream_encode_float(encoder, pcm.data(), 480, encoded.data(), encoded.size());
+    EXPECT_GT(bytes, 0);
+    if (bytes <= 0) {
+      return false;
+    }
+    EXPECT_EQ(opus_multistream_decode_float(decoder, encoded.data(), bytes, decoded.data(), 480, 0), 480);
+    return true;
+  },
+                        [] {
+                        }),
+            result::encoded);
+  EXPECT_EQ(mapped.state.encoded_samples, 480U);
+  double left = 0, right = 0;
+  for (unsigned i = 240; i < 480; ++i) {
+    left += decoded[i * 2];
+    right += decoded[i * 2 + 1];
+  }
+  EXPECT_GT(left, 10);
+  EXPECT_LT(right, -5);
+  opus_multistream_encoder_destroy(encoder);
+  opus_multistream_decoder_destroy(decoder);
+}
+
+TEST(QuestAudioPacketGate, FlushWaitsForCurrentSendAndRejectsQueuedOldPacket) {
+  quest3d::pcm::packet_scope scope;
+  std::promise<void> started, release;
+  auto done = release.get_future();
+  std::jthread sender([&] {
+    std::lock_guard lock(scope.mutex);
+    started.set_value();
+    done.wait();
+  });
+  started.get_future().wait();
+  auto stopped = std::async(std::launch::async, [&] {
+    scope.stop();
+  });
+  EXPECT_EQ(stopped.wait_for(std::chrono::milliseconds(5)), std::future_status::timeout);
+  release.set_value();
+  stopped.get();
+  sender.join();
+  std::lock_guard lock(scope.mutex);
+  EXPECT_FALSE(scope.active);
+}
+
+TEST(QuestAudioPacketGate, NewScopeCannotRegenerateParityUsingAnOldFecGroup) {
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(0), 0);
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(1), 4);
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(3), 4);
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(4), 4);
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(65533), 0);
+  EXPECT_EQ(quest3d::pcm::next_fec_sequence(65535), 0);
+}
+
+TEST(QuestAudioQueue, CapacityIsReservedBeforeIrreversibleEncoding) {
+  safe::queue_t<int> queue(1);
+  unsigned calls = 0;
+  auto produce = [&]() -> std::optional<int> {
+    ++calls;
+    return 7;
+  };
+  EXPECT_TRUE(queue.try_produce(produce));
+  EXPECT_FALSE(queue.try_produce(produce));
+  EXPECT_EQ(calls, 1U);
+  EXPECT_EQ(*queue.pop(), 7);
+  EXPECT_FALSE(queue.try_produce([]() -> std::optional<int> {
+    return {};
+  }));
+  queue.stop();
+  EXPECT_FALSE(queue.try_produce(produce));
+  EXPECT_EQ(calls, 1U);
+}
