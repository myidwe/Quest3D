+/** @file tests/unit/platform/windows/quest3d_pcm_fixture.h
+ * @brief Private real Windows PCM mapping with the test process as its producer.
+ */
+#pragma once
+#include "src/platform/windows/quest3d_audio_reader.h"
+
+#include <atomic>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+
+namespace quest3d_test {
+  /** @brief Own only one isolated PCM channel; never open an endpoint or the live producer. */
+  class pcm_fixture {
+  public:
+    std::string channel;  ///< Unique lowercase hexadecimal channel accepted by the production reader.
+    std::wstring prefix;  ///< Exact private mapping name, also used for Mutex and Consumer objects.
+    HANDLE mapping = nullptr, mutex = nullptr;  ///< Producer-owned handles, kept alive through reader retirement.
+    quest3d::pcm::memory *mapped = nullptr;  ///< Producer view; all reads and writes must use mutate or snapshot.
+
+    /** @brief Create a valid empty channel bound to this process's actual PID and creation time. */
+    pcm_fixture() {
+      static std::atomic<std::uint32_t> serial = 0;
+      const auto birth = quest3d::pcm::creation_time(GetCurrentProcess());
+      if (!birth) {
+        throw std::runtime_error("PCM fixture cannot obtain producer creation time");
+      }
+      std::ostringstream name;
+      name << std::hex << std::setfill('0') << std::setw(16) << birth
+           << std::setw(8) << GetCurrentProcessId() << std::setw(8) << ++serial;
+      channel = name.str();
+      prefix = L"Local\\Quest3D.Audio.v1." + std::wstring(channel.begin(), channel.end());
+      try {
+        SetLastError(0);
+        mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(quest3d::pcm::memory), prefix.c_str());
+        const auto mapping_error = GetLastError();
+        if (!mapping || mapping_error == ERROR_ALREADY_EXISTS) {
+          throw std::runtime_error("PCM fixture mapping creation was not exclusive");
+        }
+        SetLastError(0);
+        mutex = CreateMutexW(nullptr, FALSE, (prefix + L".Mutex").c_str());
+        const auto mutex_error = GetLastError();
+        if (!mutex || mutex_error == ERROR_ALREADY_EXISTS) {
+          throw std::runtime_error("PCM fixture mutex creation was not exclusive");
+        }
+        mapped = static_cast<quest3d::pcm::memory *>(MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(quest3d::pcm::memory)));
+        if (!mapped) {
+          throw std::runtime_error("PCM fixture cannot map producer view");
+        }
+        mutate([&](auto &memory) {
+          memory = {};
+          auto &h = memory.state;
+          h.magic = {'Q', '3', 'D', 'A', 'U', 'D', '1', 0};
+          h.version = 1;
+          h.header_bytes = sizeof(quest3d::pcm::header);
+          h.slots = quest3d::pcm::slot_count;
+          h.slot_bytes = sizeof(quest3d::pcm::slot);
+          h.rate = 48000;
+          h.channels = 2;
+          h.format = 1;
+          h.producer_pid = GetCurrentProcessId();
+          h.producer_creation = birth;
+          for (unsigned i = 0; i < h.channel.size(); ++i) {
+            h.channel[i] = static_cast<std::uint8_t>(std::stoul(channel.substr(i * 2, 2), nullptr, 16));
+          }
+          h.session = h.channel;
+          h.session[0] ^= 0x80;
+          h.epoch = 17;
+          h.generation = 3;
+          if (!quest3d::pcm::valid(memory)) {
+            throw std::runtime_error("PCM fixture initialized an invalid channel");
+          }
+        });
+      } catch (...) {
+        close();
+        throw;
+      }
+    }
+
+    pcm_fixture(const pcm_fixture &) = delete;  ///< Kernel ownership must not be copied.
+    pcm_fixture &operator=(const pcm_fixture &) = delete;  ///< Kernel ownership must not be assigned.
+
+    /** @brief Release only this fixture's producer view and handles. Readers must finish first. */
+    ~pcm_fixture() {
+      close();
+    }
+
+    /**
+     * @brief Run a producer transaction under the actual named mutex, including exceptional paths.
+     * @param change Synchronous action; it must not retain references or call a reader while locked.
+     */
+    void mutate(const std::function<void(quest3d::pcm::memory &)> &change) {
+      const auto wait = WaitForSingleObject(mutex, 5000);
+      if (wait == WAIT_ABANDONED) {
+        ReleaseMutex(mutex);
+        throw std::runtime_error("PCM fixture producer mutex was abandoned");
+      }
+      if (wait != WAIT_OBJECT_0) {
+        throw std::runtime_error("PCM fixture producer mutex acquisition failed");
+      }
+      try {
+        change(*mapped);
+      } catch (...) {
+        ReleaseMutex(mutex);
+        throw;
+      }
+      if (!ReleaseMutex(mutex)) {
+        throw std::runtime_error("PCM fixture producer mutex release failed");
+      }
+    }
+
+    /** @brief Copy the shared header under its transaction mutex. @return Consistent current header. */
+    quest3d::pcm::header snapshot() {
+      quest3d::pcm::header h {};
+      mutate([&](const auto &memory) {
+        h = memory.state;
+      });
+      return h;
+    }
+
+    /**
+     * @brief Publish one real digest-validated stereo block in the current media scope.
+     * @param block_id Monotonically increasing original block token within the scope.
+     * @param due_ns QPC deadline in nanoseconds, used by the actual reader.
+     * @param sample_count Number of stereo sample frames, from 1 through 480.
+     */
+    void append_block(std::uint64_t block_id, std::uint64_t due_ns, unsigned sample_count = 480) {
+      mutate([&](auto &memory) {
+        auto &h = memory.state;
+        if (!sample_count || sample_count > 480 || h.tail - h.head >= quest3d::pcm::slot_count ||
+            (h.tail != h.head && block_id <= memory.data[(h.tail - 1) % quest3d::pcm::slot_count].block_id) || !quest3d::pcm::valid(memory)) {
+          throw std::runtime_error("PCM fixture cannot append this block");
+        }
+        auto &s = memory.data[h.tail % quest3d::pcm::slot_count];
+        s = {};
+        s.block_id = block_id;
+        s.due_ns = due_ns;
+        s.total = s.count = sample_count;
+        s.sequence = h.tail++;
+        s.epoch = h.epoch;
+        s.generation = h.generation;
+        for (unsigned i = 0; i < sample_count; ++i) {
+          s.samples[i * 2] = 0.125f;
+          s.samples[i * 2 + 1] = -0.25f;
+        }
+        s.digest = quest3d::pcm::digest(s);
+        h.buffered_samples += sample_count;
+        if (!quest3d::pcm::valid(memory)) {
+          throw std::runtime_error("PCM fixture appended an invalid block");
+        }
+      });
+    }
+
+    /** @brief Return actual host QPC nanoseconds without overflowing the intermediate product. */
+    static std::uint64_t now_ns() {
+      LARGE_INTEGER counter {}, frequency {};
+      if (!QueryPerformanceCounter(&counter) || !QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0) {
+        throw std::runtime_error("PCM fixture cannot obtain QPC time");
+      }
+      const auto ticks = static_cast<std::uint64_t>(counter.QuadPart);
+      const auto hz = static_cast<std::uint64_t>(frequency.QuadPart);
+      return (ticks / hz) * 1000000000ULL + (ticks % hz) * 1000000000ULL / hz;
+    }
+
+  private:
+    /** @brief Best-effort fixture cleanup, also safe after partial construction. */
+    void close() {
+      if (mapped) {
+        UnmapViewOfFile(mapped);
+        mapped = nullptr;
+      }
+      for (auto *handle : {&mapping, &mutex}) {
+        if (*handle) {
+          CloseHandle(*handle);
+          *handle = nullptr;
+        }
+      }
+    }
+  };
+}  // namespace quest3d_test
