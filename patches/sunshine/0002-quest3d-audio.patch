+        } else {
+          session_route.relinquish(role);
+        }
+      }
+      if (route_journal.is_open() && !route_journal.write(session_route, session_route.active() ? "restore_pending" : "restored")) {
+        BOOST_LOG(error) << "[Quest3D] Cannot update audio restoration journal; verify endpoints before recovery";
+      }
