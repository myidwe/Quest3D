+/** @file src/audio_delay.h
+ * @brief Bounded interleaved PCM delay used by the Quest3D host before Opus.
+ */
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+namespace audio {
+  /** @brief Select delay only for a live stereoscopic pair; mono and duplicated 2D are immediate.
+   * @param live Whether the video publication is fresh. @param flags Bridge Full-SBS bit 0 and duplicated-2D bit 1.
+   * @param configured_ms Calibrated bounded stereo delay. @return Applicable delay in milliseconds.
+   */
+  inline std::uint32_t delay_for_frame(bool live, std::uint32_t flags, std::uint32_t configured_ms) {
+    return live && (flags & 1U) && !(flags & 2U) ? configured_ms : 0U;
+  }
+
+  /** @brief Convert the WASAPI 100ns device period to a bounded wait duration.
+   * @param period_100ns Positive device period. @return Rounded-up milliseconds, bounded to 1..1000.
+   */
+  inline std::uint32_t device_period_ms(std::int64_t period_100ns) {
+    if (period_100ns <= 0 || period_100ns > 10000000) {
+      throw std::invalid_argument("Invalid WASAPI device period");
+    }
+    return static_cast<std::uint32_t>((period_100ns + 9999) / 10000);
+  }
+
+  /** @brief Fixed-capacity PCM delay; configuration changes discard old source audio. */
+  class pcm_delay_t {
+  public:
+    /** @brief Allocate bounded storage. @param rate Samples per second per channel. @param channels Interleaved channels. @param limit_ms Maximum selectable delay. */
+    pcm_delay_t(std::uint32_t rate, std::uint32_t channels, std::uint32_t limit_ms = 500):
+        rate_ {rate},
+        channels_ {channels},
+        limit_ms_ {limit_ms} {
+      if (rate == 0 || rate > 192000 || channels == 0 || channels > 8 || limit_ms > 500) {
+        throw std::invalid_argument("Invalid bounded PCM delay format");
+      }
+      samples_.resize(static_cast<std::size_t>(rate) * limit_ms / 1000 * channels);
+    }
+
+    /** @brief Change delay and flush previous content. @param milliseconds New delay. @param force_reset Reset on source identity change even if delay is unchanged. */
+    void configure(std::uint32_t milliseconds, bool force_reset = false) {
+      if (milliseconds > limit_ms_) {
+        throw std::invalid_argument("PCM delay exceeds the configured bound");
+      }
+      if (milliseconds == delay_ms_ && !force_reset) {
+        return;
+      }
+      delay_ms_ = milliseconds;
+      active_samples_ = static_cast<std::size_t>(rate_) * milliseconds / 1000 * channels_;
+      cursor_ = 0;
+      std::fill(samples_.begin(), samples_.end(), 0.0f);
+    }
+
+    /** @brief Delay one PCM block in place without changing cadence or sample count. @param block Whole interleaved audio frames. */
+    void process(std::vector<float> &block) {
+      if (block.size() % channels_ != 0) {
+        throw std::invalid_argument("PCM block does not contain complete channel frames");
+      }
+      if (active_samples_ == 0) {
+        return;
+      }
+      for (auto &sample : block) {
+        std::swap(sample, samples_[cursor_]);
+        cursor_ = (cursor_ + 1) % active_samples_;
+      }
+    }
+
+    /** @brief Current delay. @return Milliseconds selected. */
+    std::uint32_t delay_ms() const {
+      return delay_ms_;
+    }
+
+    /** @brief Maximum allocated PCM memory. @return Allocated float sample slots. */
+    std::size_t capacity_samples() const {
+      return samples_.size();
+    }
+
+  private:
+    std::uint32_t rate_;  ///< Per-channel sample rate.
+    std::uint32_t channels_;  ///< Interleaved channel count.
+    std::uint32_t limit_ms_;  ///< Hard delay bound.
+    std::uint32_t delay_ms_ = 0;  ///< Current delay.
+    std::size_t active_samples_ = 0;  ///< Circular buffer interval including priming silence.
+    std::size_t cursor_ = 0;  ///< Next delayed sample position.
+    std::vector<float> samples_;  ///< Bounded storage allocated once.
+  };
+}  // namespace audio
