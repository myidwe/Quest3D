+/** @file tests/integration/test_quest3d_audio_pipeline.cpp
+ * @brief Opt-in actual file PCM→production audio capture/Opus→decode, no audio device or network.
+ */
+#ifdef _WIN32
+  #include "src/audio.h"
+  #include "src/config.h"
+  #include "tests/tests_common.h"
+
+  #include <cstdlib>
+  #include <fstream>
+  #include <opus/opus_multistream.h>
+
+/** @brief Exercise the production entry point using a separately created private test producer. */
+TEST(Quest3DFileAudio, RealPublisherThroughProductionOpus) {
+  const auto output = std::getenv("QUEST3D_PCM_OUTPUT");
+  const auto channel = std::getenv("QUEST3D_FILE_AUDIO_CHANNEL");
+  if (!output || !channel) {
+    GTEST_SKIP() << "Private test producer and output path required";
+  }
+  const auto previous_capture = config::video.capture;
+  const auto previous_audio = config::audio.stream;
+  auto restore = util::fail_guard([&] {
+    config::video.capture = previous_capture;
+    config::audio.stream = previous_audio;
+  });
+  config::video.capture = "quest3d";
+  config::audio.stream = true;
+  auto local = std::make_shared<safe::mail_raw_t>();
+  auto shutdown = local->event<bool>(mail::shutdown);
+  auto packets = mail::man->queue<audio::packet_t>(mail::audio_packets);
+  audio::config_t settings {};
+  settings.channels = 2;
+  settings.packetDuration = 5;
+  settings.flags[audio::config_t::HIGH_QUALITY] = true;
+  std::jthread capture([&] {
+    audio::capture(local, settings, nullptr);
+  });
+  auto stop = util::fail_guard([&] {
+    shutdown->raise(true);
+    capture.join();
+  });
+  unsigned char mapping[] = {0, 1};
+  int error = 0;
+  auto decoder = opus_multistream_decoder_create(48000, 2, 1, 1, mapping, &error);
+  ASSERT_EQ(error, OPUS_OK);
+  auto destroy = util::fail_guard([&] {
+    opus_multistream_decoder_destroy(decoder);
+  });
+  std::ofstream decoded_file(output, std::ios::binary);
+  ASSERT_TRUE(decoded_file.good());
+  unsigned count = 0;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (count < 40 && std::chrono::steady_clock::now() < deadline) {
+    auto packet = packets->pop(std::chrono::milliseconds(20));
+    if (!packet) {
+      continue;
+    }
+    ASSERT_TRUE(packet->file_scope);
+    std::array<float, 480> pcm;
+    ASSERT_EQ(opus_multistream_decode_float(decoder, packet->second.begin(), packet->second.size(), pcm.data(), 240, 0), 240);
+    decoded_file.write(reinterpret_cast<const char *>(pcm.data()), pcm.size() * sizeof(float));
+    ++count;
+  }
+  EXPECT_EQ(count, 40U);
+  EXPECT_TRUE(decoded_file.good());
+}
+#endif
