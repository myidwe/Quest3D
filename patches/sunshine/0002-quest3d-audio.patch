+/** @file tests/unit/platform/windows/test_quest3d_reader_retirement.cpp
+ * @brief Real Windows reader lifetime, accepted media scope, and kernel-resource retirement checks.
+ */
+#ifdef _WIN32
+  #include "quest3d_pcm_fixture.h"
+  #include "tests/tests_common.h"
+
+  #include <thread>
+  #include <type_traits>
+
+namespace {
+  using quest3d_test::pcm_fixture;
+  using namespace quest3d::pcm;
+
+  static_assert(!std::is_default_constructible_v<reader_retirement>);
+  static_assert(!std::is_constructible_v<reader_retirement, header, std::optional<std::pair<std::uint64_t, std::uint64_t>>>);
+
+  /** @brief Probe object existence without retaining a handle that would keep Consumer alive. */
+  bool consumer_exists(const pcm_fixture &f) {
+    const auto consumer = OpenMutexW(SYNCHRONIZE, FALSE, (f.prefix + L".Consumer").c_str());
+    if (consumer) {
+      EXPECT_TRUE(CloseHandle(consumer));
+      return true;
+    }
+    EXPECT_EQ(GetLastError(), ERROR_FILE_NOT_FOUND);
+    return false;
+  }
+
+  /** @brief Enter or poll the actual ring without claiming that the PCM was played or transmitted. */
+  result step(reader &consumer, std::uint64_t due_ns = 1000000000) {
+    return consumer.step(due_ns, 480, [](const auto &) {
+      return true;
+    },
+                         [] {
+                         });
+  }
+}  // namespace
+
+TEST(Quest3DReaderRetirement, RealReaderClosesConsumerBeforeProducerOrProcessExit) {
+  pcm_fixture f;
+  const auto producer = f.snapshot();
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  ASSERT_TRUE(consumer_exists(f));
+  ASSERT_EQ(step(consumer), result::scope_changed);
+  const auto opened = f.snapshot();
+  ASSERT_EQ(opened.consumer_pid, GetCurrentProcessId());
+  ASSERT_EQ(opened.consumer_creation, creation_time(GetCurrentProcess()));
+  ASSERT_EQ(opened.ready, 1U);
+  const auto token = consumer.retire();
+  ASSERT_TRUE(token.has_value());
+  EXPECT_FALSE(consumer_exists(f));
+  EXPECT_EQ(WaitForSingleObject(GetCurrentProcess(), 0), WAIT_TIMEOUT);
+  EXPECT_EQ(token->identity().producer_pid, producer.producer_pid);
+  EXPECT_EQ(token->identity().producer_creation, producer.producer_creation);
+  EXPECT_EQ(token->identity().consumer_pid, opened.consumer_pid);
+  EXPECT_EQ(token->identity().consumer_creation, opened.consumer_creation);
+  EXPECT_EQ(token->identity().session, producer.session);
+  EXPECT_EQ(token->identity().channel, producer.channel);
+  ASSERT_TRUE(token->media_scope().has_value());
+  EXPECT_EQ(*token->media_scope(), (std::pair {producer.epoch, producer.generation}));
+  EXPECT_EQ(step(consumer), result::failed);
+  EXPECT_FALSE(consumer.retire().has_value());
+
+  // The producer remains live with its original channel. Retiring cannot authorize a second consumer.
+  reader replacement;
+  EXPECT_FALSE(replacement.open(f.channel));
+  EXPECT_FALSE(replacement.retire().has_value());
+  EXPECT_FALSE(consumer_exists(f));
+  EXPECT_EQ(f.snapshot().consumer_pid, opened.consumer_pid);
+}
+
+TEST(Quest3DReaderRetirement, OpenWithoutAcceptedStepHasNoInventedMediaScope) {
+  pcm_fixture f;
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  f.mutate([](auto &memory) {
+    memory.state.epoch = 999;
+    memory.state.generation = 700;
+  });
+  const auto token = consumer.retire();
+  ASSERT_TRUE(token.has_value());
+  EXPECT_FALSE(token->media_scope().has_value());
+  EXPECT_EQ(token->identity().epoch, 17U);
+  EXPECT_EQ(token->identity().generation, 3U);
+  EXPECT_FALSE(consumer_exists(f));
+}
+
+TEST(Quest3DReaderRetirement, AcceptedScopeChangesOnlyAfterSuccessfulRingValidation) {
+  pcm_fixture f;
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  ASSERT_EQ(step(consumer), result::scope_changed);
+  f.mutate([](auto &memory) {
+    memory.state.epoch = 18;
+    memory.state.generation = 4;
+  });
+  ASSERT_EQ(step(consumer), result::scope_changed);
+  f.mutate([](auto &memory) {
+    memory.state.epoch = 19;
+    memory.state.generation = 5;
+    memory.state.reserved[0] = 1;
+  });
+  ASSERT_EQ(step(consumer), result::failed);
+  const auto token = consumer.retire();
+  ASSERT_TRUE(token.has_value());
+  ASSERT_TRUE(token->media_scope().has_value());
+  EXPECT_EQ(*token->media_scope(), (std::pair<std::uint64_t, std::uint64_t> {18, 4}));
+  EXPECT_EQ(token->identity().epoch, 17U);
+  EXPECT_EQ(token->identity().generation, 3U);
+  EXPECT_FALSE(consumer_exists(f));
+}
+
+TEST(Quest3DReaderRetirement, ImmutableOwnerSurvivesUnacceptedIdentityReplacement) {
+  pcm_fixture f;
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  const auto original = f.snapshot();
+  ASSERT_EQ(step(consumer), result::scope_changed);
+  f.mutate([](auto &memory) {
+    memory.state.channel[0] ^= 1;
+    memory.state.session[0] ^= 1;
+    ++memory.state.producer_creation;
+    ++memory.state.consumer_creation;
+    ++memory.state.epoch;
+  });
+  ASSERT_EQ(step(consumer), result::failed);
+  const auto token = consumer.retire();
+  ASSERT_TRUE(token.has_value());
+  EXPECT_EQ(token->identity().channel, original.channel);
+  EXPECT_EQ(token->identity().session, original.session);
+  EXPECT_EQ(token->identity().producer_creation, original.producer_creation);
+  EXPECT_EQ(token->identity().consumer_creation, original.consumer_creation);
+  ASSERT_TRUE(token->media_scope().has_value());
+  EXPECT_EQ(*token->media_scope(), (std::pair {original.epoch, original.generation}));
+}
+
+TEST(Quest3DReaderRetirement, DuplicateOpenNeverRetiresOrReleasesTheFirstReader) {
+  pcm_fixture f;
+  reader first, duplicate;
+  ASSERT_TRUE(first.open(f.channel));
+  EXPECT_FALSE(first.open(f.channel));
+  EXPECT_FALSE(duplicate.open(f.channel));
+  EXPECT_FALSE(duplicate.retire().has_value());
+  EXPECT_TRUE(consumer_exists(f));
+  EXPECT_EQ(step(first), result::scope_changed);
+  EXPECT_TRUE(first.retire().has_value());
+  EXPECT_FALSE(consumer_exists(f));
+  EXPECT_FALSE(duplicate.retire().has_value());
+}
+
+TEST(Quest3DReaderRetirement, UnopenedAndFailedValidationCannotProduceRetirement) {
+  reader unopened;
+  EXPECT_FALSE(unopened.retire().has_value());
+  EXPECT_FALSE(unopened.open("not-a-private-channel"));
+  EXPECT_FALSE(unopened.retire().has_value());
+  for (unsigned failure = 0; failure < 3; ++failure) {
+    SCOPED_TRACE(failure);
+    pcm_fixture f;
+    f.mutate([&](auto &memory) {
+      if (failure == 0) {
+        ++memory.state.producer_creation;
+      } else if (failure == 1) {
+        memory.state.channel[0] ^= 1;
+      } else {
+        memory.state.magic[0] = 'X';
+      }
+    });
+    reader consumer;
+    EXPECT_FALSE(consumer.open(f.channel));
+    EXPECT_FALSE(consumer.retire().has_value());
+    EXPECT_FALSE(consumer_exists(f));
+    EXPECT_EQ(f.snapshot().consumer_pid, 0U);
+    EXPECT_EQ(f.snapshot().ready, 0U);
+  }
+}
+
+TEST(Quest3DReaderRetirement, ConsumedPcmThenStopPreservesCursorsBeforeHandleRelease) {
+  pcm_fixture f;
+  constexpr std::uint64_t due = 1000000000;
+  f.append_block(61, due);
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  ASSERT_EQ(step(consumer, due), result::scope_changed);
+  unsigned encoded = 0;
+  unsigned stopped = 0;
+  ASSERT_EQ(consumer.step(due, 480, [&](const auto &pcm) {
+    ++encoded;
+    EXPECT_EQ(pcm.size(), 960U);
+    EXPECT_EQ(pcm.front(), 0.125f);
+    EXPECT_EQ(pcm.back(), -0.25f);
+    return true;
+  },
+                          [&] {
+                            ++stopped;
+                          }),
+            result::encoded);
+  EXPECT_EQ(encoded, 1U);
+  EXPECT_EQ(stopped, 0U);
+  f.mutate([](auto &memory) {
+    ++memory.state.flush_request;
+  });
+  consumer.stop([&] {
+    ++stopped;
+  });
+  const auto stopped_state = f.snapshot();
+  EXPECT_EQ(stopped, 1U);
+  EXPECT_EQ(stopped_state.ready, 0U);
+  EXPECT_NE(stopped_state.flags & consumer_stopped, 0U);
+  EXPECT_EQ(stopped_state.flush_ack, stopped_state.flush_request);
+  EXPECT_EQ(stopped_state.encoded_samples, 480U);
+  EXPECT_EQ(stopped_state.encoded_packets, 1U);
+  const auto token = consumer.retire();
+  ASSERT_TRUE(token.has_value());
+  EXPECT_FALSE(consumer_exists(f));
+  const auto retired_state = f.snapshot();
+  EXPECT_EQ(retired_state.encoded_samples, stopped_state.encoded_samples);
+  EXPECT_EQ(retired_state.encoded_packets, stopped_state.encoded_packets);
+  EXPECT_EQ(retired_state.flush_ack, stopped_state.flush_ack);
+}
+
+TEST(Quest3DReaderRetirement, WrongThreadCannotClaimSuccessfulMutexOwnershipRelease) {
+  pcm_fixture f;
+  reader consumer;
+  ASSERT_TRUE(consumer.open(f.channel));
+  ASSERT_EQ(step(consumer), result::scope_changed);
+  std::optional<reader_retirement> token;
+  std::thread other([&] {
+    token = consumer.retire();
+  });
+  other.join();
+  EXPECT_FALSE(token.has_value());
+  EXPECT_FALSE(consumer.retire().has_value());
+  reader replacement;
+  EXPECT_FALSE(replacement.open(f.channel));
+  EXPECT_FALSE(replacement.retire().has_value());
+}
+#endif
diff --git a/tests/unit/platform/windows/test_quest3d_file_transport_identity.cpp b/tests/unit/platform/windows/test_quest3d_file_transport_identity.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/platform/windows/test_quest3d_file_transport_identity.cpp
@@ -0,0 +1,209 @@
+/** @file tests/unit/platform/windows/test_quest3d_file_transport_identity.cpp
+ * @brief Bind actual private-reader retirement to the exact host transport without inventing a worker join.
+ */
+#ifdef _WIN32
+  #include "quest3d_pcm_fixture.h"
+  #include "src/quest3d_file_transport.h"
+  #include "tests/tests_common.h"
+
+  #include <future>
+
+namespace {
+  using namespace quest3d::pcm;
+  using quest3d_test::pcm_fixture;
+
+  /** @brief Build a test transport tuple using the real process lifetime and fixture-owned channel. */
+  file_transport_identity fixture_identity(const pcm_fixture &fixture) {
+    return {
+      "isolated-identity-test-certificate",
+      "1234567890abcdef1234567890abcdef",
+      fixture.channel,
+      52,
+      GetCurrentProcessId(),
+      creation_time(GetCurrentProcess())
+    };
+  }
+
+  /**
+   * @brief Obtain only a real reader token after accepting a scope and stopping the tracker's real gate.
+   * @param fixture Actual Windows mapping whose producer remains alive throughout the check.
+   * @param transport Tracker receiving the real packet gate used by the stop callback.
+   * @return Reader-issued retirement, absent on any failed open, step, or native close.
+   */
+  std::optional<reader_retirement> retire_fixture_reader(pcm_fixture &fixture, file_transport &transport) {
+    reader source;
+    if (!source.open(fixture.channel)) {
+      ADD_FAILURE() << "Fixture's real reader did not open";
+      return std::nullopt;
+    }
+    const auto outcome = source.step(pcm_fixture::now_ns(), 480, [](const auto &) {
+      ADD_FAILURE() << "Empty fixture must enter scope before any encoder callback";
+      return false;
+    },
+                                     [] {
+                                     });
+    if (outcome != result::scope_changed) {
+      ADD_FAILURE() << "Fixture's real reader did not accept its scope";
+      return std::nullopt;
+    }
+    const auto gate = transport.replace_packet_scope();
+    if (!gate) {
+      ADD_FAILURE() << "Fixture transport did not create its real packet gate";
+      return std::nullopt;
+    }
+    source.stop([&] {
+      gate->stop();
+    });
+    auto denied = gate->acquire_send();
+    EXPECT_FALSE(denied.owns_lock());
+    if (denied.owns_lock()) {
+      return std::nullopt;
+    }
+    const auto state = fixture.snapshot();
+    EXPECT_EQ(state.ready, 0U);
+    EXPECT_NE(state.flags & consumer_stopped, 0U);
+    return source.retire();
+  }
+}  // namespace
+
+TEST(Quest3DFileTransportIdentity, ValidTupleAcceptsReaderButDoesNotInventWorkerJoin) {
+  pcm_fixture fixture;
+  file_transport transport(fixture_identity(fixture));
+  EXPECT_FALSE(transport.reader_retired());
+  EXPECT_FALSE(transport.closed().has_value());
+  const auto token = retire_fixture_reader(fixture, transport);
+  ASSERT_TRUE(token.has_value());
+  transport.capture_retired(*token);
+  EXPECT_TRUE(transport.reader_retired());
+  EXPECT_FALSE(transport.closed().has_value());
+  transport.capture_retired(*token);
+  EXPECT_TRUE(transport.reader_retired());
+  EXPECT_FALSE(transport.closed().has_value());
+}
+
+TEST(Quest3DFileTransportIdentity, UnavailableHostCreationCannotBecomeExactLifetimeProof) {
+  pcm_fixture fixture;
+  auto identity = fixture_identity(fixture);
+  identity.host_creation = 0;
+  file_transport transport(identity);
+  const auto token = retire_fixture_reader(fixture, transport);
+  ASSERT_TRUE(token.has_value());
+  ASSERT_NE(token->identity().consumer_creation, 0U);
+  transport.capture_retired(*token);
+  EXPECT_FALSE(transport.reader_retired());
+  EXPECT_FALSE(transport.closed().has_value());
+}
+
+TEST(Quest3DFileTransportIdentity, WrongHostPidBirthOrChannelCannotBorrowActualReaderToken) {
+  for (unsigned mismatch = 0; mismatch < 3; ++mismatch) {
+    SCOPED_TRACE(mismatch);
+    pcm_fixture fixture;
+    auto identity = fixture_identity(fixture);
+    if (mismatch == 0) {
+      identity.host_pid ^= 1;
+    } else if (mismatch == 1) {
+      identity.host_creation ^= 1;
+    } else {
+      identity.channel.back() = identity.channel.back() == '0' ? '1' : '0';
+    }
+    file_transport transport(identity);
+    const auto token = retire_fixture_reader(fixture, transport);
+    ASSERT_TRUE(token.has_value());
+    transport.capture_retired(*token);
+    EXPECT_FALSE(transport.reader_retired());
+    EXPECT_FALSE(transport.closed().has_value());
+  }
+}
+
+TEST(Quest3DFileTransportIdentity, MissingPairedOwnerCannotAcceptResourceRetirement) {
+  pcm_fixture fixture;
+  auto identity = fixture_identity(fixture);
+  identity.client_certificate.clear();
+  file_transport transport(identity);
+  const auto token = retire_fixture_reader(fixture, transport);
+  ASSERT_TRUE(token.has_value());
+  transport.capture_retired(*token);
+  EXPECT_FALSE(transport.reader_retired());
+  EXPECT_FALSE(transport.closed().has_value());
+}
+
+TEST(Quest3DFileTransportIdentity, TransportNonceRequiresExactLowercaseHexadecimalShape) {
+  for (const std::string &malformed : {std::string {}, std::string(31, 'a'), std::string(33, 'a'), std::string(32, 'A'), std::string(32, 'g'), std::string(31, 'a') + " "}) {
+    SCOPED_TRACE(malformed);
+    pcm_fixture fixture;
+    auto identity = fixture_identity(fixture);
+    identity.transport_epoch = malformed;
+    file_transport transport(identity);
+    const auto token = retire_fixture_reader(fixture, transport);
+    ASSERT_TRUE(token.has_value());
+    transport.capture_retired(*token);
+    EXPECT_FALSE(transport.reader_retired());
+    EXPECT_FALSE(transport.closed().has_value());
+  }
+}
+
+TEST(Quest3DFileTransportIdentity, ConcurrentReplacementRetiresEveryPredecessorWithoutBlockingObservation) {
+  using namespace std::chrono_literals;
+  for (unsigned iteration = 0; iteration < 16; ++iteration) {
+    SCOPED_TRACE(iteration);
+    pcm_fixture fixture;
+    file_transport transport(fixture_identity(fixture));
+    const auto original = transport.replace_packet_scope();
+    ASSERT_TRUE(original);
+    auto sending = original->acquire_send();
+    ASSERT_TRUE(sending.owns_lock());
+
+    std::promise<void> first_entered, second_entered;
+    auto first_started = first_entered.get_future();
+    auto second_started = second_entered.get_future();
+    auto first = std::async(std::launch::async, [&] {
+      first_entered.set_value();
+      return transport.replace_packet_scope();
+    });
+    auto second = std::async(std::launch::async, [&] {
+      second_entered.set_value();
+      return transport.replace_packet_scope();
+    });
+
+    // Explicit entry markers establish that both workers have started their
+    // replacement attempt. Only the original real send lock is released below;
+    // a timed wait checks non-completion without guessing a sleep duration.
+    EXPECT_EQ(first_started.wait_for(2s), std::future_status::ready);
+    EXPECT_EQ(second_started.wait_for(2s), std::future_status::ready);
+    EXPECT_EQ(first.wait_for(5ms), std::future_status::timeout);
+    EXPECT_EQ(second.wait_for(5ms), std::future_status::timeout);
+
+    auto observation = std::async(std::launch::async, [&] {
+      return transport.closed().has_value();
+    });
+    const auto observed_while_blocked = observation.wait_for(250ms);
+    EXPECT_EQ(observed_while_blocked, std::future_status::ready);
+    if (observed_while_blocked == std::future_status::ready) {
+      EXPECT_FALSE(observation.get());
+    }
+
+    sending.unlock();
+    ASSERT_EQ(first.wait_for(2s), std::future_status::ready);
+    ASSERT_EQ(second.wait_for(2s), std::future_status::ready);
+    const auto first_gate = first.get();
+    const auto second_gate = second.get();
+    if (observation.valid()) {
+      ASSERT_EQ(observation.wait_for(2s), std::future_status::ready);
+      EXPECT_FALSE(observation.get());
+    }
+    ASSERT_TRUE(first_gate);
+    ASSERT_TRUE(second_gate);
+    ASSERT_NE(first_gate, second_gate);
+    ASSERT_NE(first_gate, original);
+    ASSERT_NE(second_gate, original);
+
+    auto original_send = original->acquire_send();
+    auto first_send = first_gate->acquire_send();
+    auto second_send = second_gate->acquire_send();
+    EXPECT_FALSE(original_send.owns_lock());
+    EXPECT_EQ(unsigned(first_send.owns_lock()) + unsigned(second_send.owns_lock()), 1U);
+    EXPECT_FALSE(transport.reader_retired());
+    EXPECT_FALSE(transport.closed().has_value());
+  }
+}
+#endif
