@@ -0,0 +1,136 @@
+/** @file tests/integration/test_quest3d_file_transport.cpp
+ * @brief Actual private PCM/Opus and production worker-join boundaries without network or device side effects.
+ */
+#ifdef _WIN32
+  #include "src/rtsp.h"
+  #include "src/stream.h"
+  #include "tests/tests_common.h"
+  #include "tests/unit/platform/windows/quest3d_pcm_fixture.h"
+
+  #include <atomic>
+  #include <thread>
+
+/** @brief Each actual join/control boundary must finish before a sealed exact closure can appear. */
+TEST(Quest3DFileTransport, ProductionCaptureGateReaderAndJoinBoundaries) {
+  quest3d_test::pcm_fixture producer;
+  producer.append_block(1, producer.now_ns());
+  const auto result = stream::session::test_file_transport_barrier(producer.channel);
+  EXPECT_TRUE(result.encoded);
+  EXPECT_TRUE(result.before_stop_unconfirmed);
+  EXPECT_TRUE(result.inflight_gate_blocks);
+  EXPECT_TRUE(result.reader_released);
+  EXPECT_TRUE(result.video_join_blocks);
+  EXPECT_TRUE(result.audio_join_blocks);
+  EXPECT_TRUE(result.control_wait_blocks);
+  EXPECT_TRUE(result.video_send_blocks_closure);
+  EXPECT_TRUE(result.other_transport_unblocked);
+  EXPECT_TRUE(result.late_video_send_denied);
+  EXPECT_TRUE(result.closed_after_joins);
+  EXPECT_TRUE(result.identity_matches);
+  EXPECT_TRUE(result.queued_old_send_denied);
+  EXPECT_TRUE(result.retained_after_session_release);
+  const auto final = producer.snapshot();
+  EXPECT_GT(final.encoded_packets, 0U);
+  EXPECT_TRUE(final.flags & quest3d::pcm::consumer_stopped);
+  EXPECT_EQ(final.ready, 0U);
+}
+
+/** @brief Joining workers cannot manufacture a PCM closure after native initialization failed. */
+TEST(Quest3DFileTransport, MissingReaderDoesNotBecomeClosureAfterJoins) {
+  const auto result = stream::session::test_file_transport_barrier("not-a-valid-private-channel", true);
+  EXPECT_TRUE(result.missing_reader_refused);
+  EXPECT_FALSE(result.closed_after_joins);
+}
+
+/** @brief An actual Opus initialization error cannot be converted into a successful host closure. */
+TEST(Quest3DFileTransport, ActualOpusInitializationFailureDoesNotIssueClosure) {
+  quest3d_test::pcm_fixture producer;
+  auto &layout = audio::stream_configs[audio::HIGH_STEREO];
+  const auto previous_rate = layout.sampleRate;
+  auto restore = util::fail_guard([&] {
+    layout.sampleRate = previous_rate;
+  });
+  layout.sampleRate = 123;  // An actual invalid Opus rate; the native constructor must fail.
+  const auto result = stream::session::test_file_transport_barrier(producer.channel, true, true);
+  EXPECT_TRUE(result.missing_reader_refused);
+  EXPECT_FALSE(result.closed_after_joins);
+  const auto final = producer.snapshot();
+  EXPECT_NE(final.flags & quest3d::pcm::consumer_stopped, 0U);
+  EXPECT_EQ(final.ready, 0U);
+  EXPECT_EQ(final.encoded_packets, 0U);
+}
+
+/** @brief Queued packet owns encoder replacement bytes and retains the original gate across later enqueue. */
+TEST(Quest3DFileTransport, VideoPacketOwnsReplacementBytesAndOriginalGate) {
+  auto mail = std::make_shared<safe::mail_raw_t>();
+  auto packets = mail->queue<video::packet_t>("private-video-ownership");
+  auto gate = std::make_shared<quest3d::pcm::packet_scope>();
+  {
+    std::string old_bytes(300, 'a'), new_bytes(500, 'b');
+    std::vector<video::packet_raw_t::replace_t> replacements;
+    replacements.emplace_back(old_bytes, new_bytes);
+    auto packet = std::make_unique<video::packet_raw_generic>(std::vector<std::uint8_t> {1}, 1, true);
+    packet->replacements = &replacements;
+    video::publish_packet(std::move(packet), packets, nullptr, gate);
+    old_bytes.assign(300, 'x');
+    new_bytes.assign(500, 'y');
+  }
+  auto packet = packets->pop(std::chrono::milliseconds(10));
+  ASSERT_TRUE(packet);
+  ASSERT_EQ(packet->file_transport_gate, gate);
+  ASSERT_EQ(packet->replacements->size(), 1U);
+  EXPECT_EQ(packet->replacements->at(0).old, std::string(300, 'a'));
+  EXPECT_EQ(packet->replacements->at(0)._new, std::string(500, 'b'));
+  gate->stop();
+  EXPECT_FALSE(packet->file_transport_gate->acquire_send().owns_lock());
+  // A different stream's packet can still acquire its own gate.
+  auto other = std::make_shared<quest3d::pcm::packet_scope>();
+  EXPECT_TRUE(other->acquire_send().owns_lock());
+}
+
+/** @brief Production teardown cannot detach a FilePCM encoder that still owns resources. */
+TEST(Quest3DFileTransport, FileEncoderDestructionBlocksActualTeardownReturn) {
+  struct blocked_encoder final: video::encode_session_t {
+    std::atomic_bool &entered, &release;  ///< Explicit test-owned native destruction barriers.
+
+    blocked_encoder(std::atomic_bool &entered, std::atomic_bool &release):
+        entered(entered),
+        release(release) {}
+
+    ~blocked_encoder() override {
+      entered = true;
+      while (!release) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      }
+    }
+
+    int convert(platf::img_t &) override {
+      return 0;
+    }
+
+    void request_idr_frame() override {}
+
+    void request_normal_frame() override {}
+
+    void invalidate_ref_frames(int64_t, int64_t) override {}
+  };
+
+  std::atomic_bool entered = false, release = false, completed = false;
+  std::unique_ptr<video::encode_session_t> encoder = std::make_unique<blocked_encoder>(entered, release);
+  auto gate = std::make_shared<quest3d::pcm::packet_scope>();
+  std::jthread worker([&] {
+    video::retire_encode_session(encoder, true, gate);
+    completed = true;
+  });
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  while (!entered && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  const bool blocked = entered && !completed;
+  release = true;
+  worker.join();
+  EXPECT_TRUE(blocked);
+  EXPECT_TRUE(completed);
+  EXPECT_FALSE(encoder);
+}
+#endif
