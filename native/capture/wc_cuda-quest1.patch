+#[derive(Default)]
+struct LeaseState {
+    owner: Option<u64>,
+    skipped: u64,
+}
+
+impl LeaseState {
+    fn writer_available(&mut self) -> bool {
+        if self.owner.is_some() {
+            self.skipped += 1;
+            false
+        } else {
+            true
+        }
+    }
+
+    fn acquire(&mut self, frame_id: u64) -> bool {
+        if self.owner.is_some() {
+            return false;
+        }
+        self.owner = Some(frame_id);
+        true
+    }
+
+    fn release(&mut self, frame_id: u64) -> bool {
+        if self.owner != Some(frame_id) {
+            return false;
+        }
+        self.owner = None;
+        true
+    }
+}
+
+#[derive(Default)]
+struct SlotData {
+    frame: Option<WcGpuFrame>,
+    frame_id: u64,
+    lease: LeaseState,
+}
