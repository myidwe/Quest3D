+    #[test]
+    fn consumer_lease_excludes_writer_until_matching_release() {
+        let mut lease = LeaseState::default();
+        assert!(lease.writer_available());
+        assert!(lease.acquire(41));
+        assert!(!lease.writer_available());
+        assert!(!lease.acquire(42));
+        assert!(!lease.release(40));
+        assert!(!lease.writer_available());
+        assert_eq!(lease.skipped, 2);
+        assert!(lease.release(41));
+        assert!(!lease.release(41));
+        assert!(lease.writer_available());
