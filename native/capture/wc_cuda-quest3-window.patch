+impl WcCapture {
+    fn request_stop_inner(&self) {
+        self.should_stop.store(true, Ordering::SeqCst);
+        let identity_lost = match verify_window_identity(self.window_hwnd, self.window_identity.as_ref()) {
+            Err(error @ WcCudaError::WindowIdentityLost(_)) => Some(error.to_string()),
+            _ => None,
+        };
+        let should_quit = self.shared_slot.data.lock().request_stop(identity_lost);
+        self.shared_slot.condvar.notify_all();
+        if !should_quit {
+            return;
+        }
+        if let Some(tid) = *self.thread_id.lock() {
+            unsafe {
+                let _ = PostThreadMessageW(tid, WM_QUIT, WPARAM(0), LPARAM(0));
+            }
+        }
+    }
+
+    fn stop_inner(&self) {
+        self.request_stop_inner();
+        let handle = self.thread_handle.lock().take();
+        if let Some(h) = handle {
+            if h.thread().id() != thread::current().id() {
+                if h.join().is_err() {
+                    *self.shutdown_error.lock() = Some("Native capture thread panicked during shutdown".into());
+                }
+            }
+        }
+        let mut data = self.shared_slot.data.lock();
+        data.frame = None;
+        // A consumer can still be finishing CUDA work while stop() runs. Keep
+        // its lease until its explicit release, so restart cannot reuse data.
+        self.shared_slot.condvar.notify_all();
+    }
+
+}
