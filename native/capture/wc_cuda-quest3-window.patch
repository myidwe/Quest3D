+struct WinRTThread;
+impl Drop for WinRTThread {
+    fn drop(&mut self) {
+        unsafe { RoUninitialize(); }
+    }
+}
+
+struct DispatcherThread {
+    controller: windows::System::DispatcherQueueController,
+    error: Arc<Mutex<Option<String>>>,
+}
+
+impl DispatcherThread {
+    fn shutdown(&self) -> Result<(), WcCudaError> {
+        let action = self.controller.ShutdownQueueAsync()?;
+        let mut message = MSG::default();
+        while action.Status()?.0 == 0 {
+            unsafe {
+                while PeekMessageW(&mut message, None, 0, 0, PM_REMOVE).as_bool() {
+                    if message.message != WM_QUIT {
+                        let _ = TranslateMessage(&message);
+                        DispatchMessageW(&message);
+                    }
+                }
+            }
+            thread::sleep(Duration::from_millis(1));
+        }
+        action.GetResults()?;
+        Ok(())
+    }
+}
+
+impl Drop for DispatcherThread {
+    fn drop(&mut self) {
+        if let Err(error) = self.shutdown() {
+            *self.error.lock() = Some(format!("Dispatcher shutdown failed: {error}"));
+        }
+    }
+}
+
+fn query_window_identity(raw: isize) -> Result<WindowIdentity, WcCudaError> {
+    let hwnd = HWND(raw as *mut std::ffi::c_void);
+    unsafe {
+        if raw <= 0 || !IsWindow(Some(hwnd)).as_bool() || GetAncestor(hwnd, GA_ROOT) != hwnd {
+            return Err(WcCudaError::WindowIdentityLost("Selected top-level HWND no longer exists".into()));
+        }
+        let mut pid = 0;
+        let tid = GetWindowThreadProcessId(hwnd, Some(&mut pid));
+        let process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid)?;
+        let mut created = FILETIME::default();
+        let mut exited = FILETIME::default();
+        let mut kernel = FILETIME::default();
+        let mut user = FILETIME::default();
+        let result = GetProcessTimes(process, &mut created, &mut exited, &mut kernel, &mut user);
+        let _ = CloseHandle(process);
+        result?;
+        let mut class = [0u16; 256];
+        let class_length = GetClassNameW(hwnd, &mut class);
+        let mut second_pid = 0;
+        if class_length <= 0 || GetWindowThreadProcessId(hwnd, Some(&mut second_pid)) != tid || second_pid != pid {
+            return Err(WcCudaError::WindowIdentityLost("HWND identity changed during native query".into()));
+        }
+        Ok((pid, ((created.dwHighDateTime as u64) << 32) | created.dwLowDateTime as u64,
+            tid, String::from_utf16_lossy(&class[..class_length as usize])))
+    }
+}
+
+fn verify_window_identity(raw: Option<isize>, expected: Option<&WindowIdentity>) -> Result<(), WcCudaError> {
+    if let Some(hwnd) = raw {
+        if Some(&query_window_identity(hwnd)?) != expected {
+            return Err(WcCudaError::WindowIdentityLost("Selected HWND process/lifetime identity does not match".into()));
+        }
+    }
+    Ok(())
+}
+
+fn valid_content_size(width: i32, height: i32, texture_width: u32, texture_height: u32) -> bool {
+    width > 0 && height > 0 && width as u32 <= texture_width && height as u32 <= texture_height
+}
 
