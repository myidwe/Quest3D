+static RUNTIME_SHUTDOWN: AtomicBool = AtomicBool::new(false);
+
+struct MtaLease(usize);
+impl Drop for MtaLease {
+    fn drop(&mut self) {
+        // windows-rs retains activation factories for the loaded extension.
+        // Module, capture workers and returned frames share this one MTA usage.
+        RUNTIME_SHUTDOWN.store(true, Ordering::SeqCst);
+        let _ = unsafe { CoDecrementMTAUsage(CO_MTA_USAGE_COOKIE(self.0 as _)) };
+    }
+}
