 use windows_capture::window::Window;
+
+fn parse_color_format(name: &str) -> PyResult<ColorFormat> {
+    match name {
+        "bgra8" => Ok(ColorFormat::Bgra8),
+        "rgba16f" => Ok(ColorFormat::Rgba16F),
+        _ => Err(pyo3::exceptions::PyValueError::new_err(
+            "color_format must be bgra8 or rgba16f",
+        )),
+    }
+}
+
+fn color_layout(format: i32) -> Result<(&'static str, u32), WcCudaError> {
+    match format {
+        87 => Ok(("bgra8", 4)),
+        10 => Ok(("rgba16f", 8)),
+        _ => Err(WcCudaError::Capture(format!("Unexpected DXGI format: {format}"))),
+    }
+}
 
