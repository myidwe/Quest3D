+func _config_is_missing(err: Error, path: String) -> bool:
+	# A corrupt or inaccessible profile must never become a fresh-install profile.
+	return err == ERR_FILE_NOT_FOUND and not FileAccess.file_exists(path)
+
+func _apply_new_quest3_host_defaults() -> void:
+	if not main.PC_SBS_BUILD or not main.device_is_quest3:
+		return
+	main.settings.host.stream_fps = QUEST3_PC_STREAM_FPS
+	if main.ui_controller:
+		main.ui_controller.update_option_btn(main._ui_fps_btn, "%d" % main.settings.host.stream_fps)
+
+func _apply_new_quest3_app_defaults() -> void:
+	if not main.PC_SBS_BUILD or not main.device_is_quest3:
+		return
+	# Full-SBS 4096x1152 exceeds this client's H.264 width guard. Keep the
+	# first connection usable without copying another headset's private state.
+	main.settings.codec_preference = 1
+	main.settings.quick_start_enabled = true
+	if main.settings_controller.get_sharpen_choices().has(main.SHARPEN_RUNTIME_NORMAL):
+		main.settings.sharpen_mode = main.SHARPEN_RUNTIME_NORMAL
+	# The first manual Pair can start directly, before any host-state lookup.
+	# A later saved host section still restores its explicit FPS unchanged.
+	_apply_new_quest3_host_defaults()
+	main._log("[STATE] New Quest 3 PC defaults: HEVC, 72 FPS, Quick Start")
+
