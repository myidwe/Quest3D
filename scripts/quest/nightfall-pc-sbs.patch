@@ -5,6 +5,8 @@ func _init():
 	_test_restart_preserves_intent()
 	_test_reconnect_and_failure()
 	_test_manual_disconnect()
+	_test_pairing_has_separate_deadline()
+	_test_retired_timeout_and_settle()
 	print("All session_lifecycle tests passed")
 	quit()
 
@@ -63,3 +65,34 @@ func _streaming_lifecycle() -> SessionLifecycle:
 	lifecycle.begin_connect()
 	lifecycle.stream_started()
 	return lifecycle
+
+func _test_pairing_has_separate_deadline() -> void:
+	var lifecycle := SessionLifecycle.new()
+	var old_connect := lifecycle.arm_connect_timeout()
+	var pair := lifecycle.begin_pairing()
+	assert(lifecycle.phase == SessionLifecycle.Phase.PAIRING)
+	assert(not lifecycle.connect_current(old_connect), "Old ten-second connect timeout cannot cancel PIN entry")
+	assert(not lifecycle.connect_timeout_pending)
+	assert(lifecycle.pairing_current(pair))
+	var remaining := lifecycle.pairing_deadline_ms - Time.get_ticks_msec()
+	assert(remaining > 290000 and remaining <= 300000, "Human PIN entry has five minutes")
+	var stream := lifecycle.arm_connect_timeout()
+	assert(not lifecycle.pairing_current(pair), "PIN timeout cannot cancel subsequent stream connection")
+	assert(lifecycle.connect_current(stream))
+	lifecycle.stream_started()
+	assert(not lifecycle.connect_current(stream), "Successful stream clears its own timeout")
+
+func _test_retired_timeout_and_settle() -> void:
+	var lifecycle := SessionLifecycle.new()
+	var first := lifecycle.begin_pairing()
+	lifecycle.show_server_selection()
+	var second := lifecycle.begin_pairing()
+	assert(not lifecycle.pairing_current(first), "Cancelled success cannot launch after the 1.5-second settle await")
+	assert(lifecycle.pairing_current(second))
+	var old_connect := lifecycle.arm_connect_timeout()
+	lifecycle.fail()
+	var next_connect := lifecycle.arm_connect_timeout()
+	assert(not lifecycle.connect_current(old_connect), "Old timer/launch reply cannot terminate or launch a new connect")
+	assert(lifecycle.connect_current(next_connect))
+	lifecycle.request_disconnect()
+	assert(not lifecycle.connect_current(next_connect), "Disconnect immediately retires an in-flight launch before cleanup")
