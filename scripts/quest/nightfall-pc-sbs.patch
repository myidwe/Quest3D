+	var catalog: Dictionary = await main.app_selection.refresh(host_id, main.stream_backend, main.get_tree())
+	if generation != _app_query_generation or host_id != main.current_host_id or main.session_lifecycle.connect_timeout_pending or main.is_streaming:
