diff --git a/addons/nightfall-stream/src/audio/audio_cleanup.h b/addons/nightfall-stream/src/audio/audio_cleanup.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/audio/audio_cleanup.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace godot { class AudioRenderer; }
+namespace nightfall {
+class MiniaudioBackend;
+
+// Internal identity only. A transport coordinator must bind this to its own
+// process/session/reset identity; these counters are not network credentials.
+struct AudioLifetime {
+    uint64_t instance = 0;
+    uint64_t generation = 0;
+    bool valid() const { return instance != 0 && generation != 0; }
+    bool operator==(const AudioLifetime &other) const {
+        return instance == other.instance && generation == other.generation;
+    }
+    bool operator!=(const AudioLifetime &other) const { return !(*this == other); }
+};
+
+inline uint64_t next_audio_instance() {
+    static std::atomic<uint64_t> sequence{1};
+    return sequence.fetch_add(1, std::memory_order_relaxed);
+}
+
+enum class AudioCleanupState { no_lifetime, scope_mismatch, pending_callbacks, resources_released };
+enum class AudioInitStage { not_attempted, invalid_parameters, opus_failed, device_init_failed, device_start_failed, ready };
+
+struct BackendCleanupFacts {
+    AudioLifetime lifetime;
+    AudioCleanupState state = AudioCleanupState::no_lifetime;
+    AudioInitStage init_stage = AudioInitStage::not_attempted;
+    int init_error = 0;
+    bool had_device = false;
+    bool had_ring = false;
+    bool device_stop_attempted = false;
+    int first_stop_error = 0;
+    int final_stop_result = 0;
+    bool device_uninit_returned = false;
+    bool device_storage_deleted = false;
+    bool pcm_ring_deleted = false;
+    uint64_t callbacks_after_uninit = 0;
+    uint64_t callbacks_started = 0;
+    uint64_t callbacks_finished = 0;
+    bool resources_released() const { return state == AudioCleanupState::resources_released; }
+    bool clean_active_shutdown() const {
+        return resources_released() && init_stage == AudioInitStage::ready &&
+            device_stop_attempted && first_stop_error == 0 && final_stop_result == 0 &&
+            device_uninit_returned && device_storage_deleted && pcm_ring_deleted && callbacks_after_uninit == 0;
+    }
+};
+
+class BackendCleanupCompletion {
+    BackendCleanupFacts facts_;
+    explicit BackendCleanupCompletion(const BackendCleanupFacts &facts) : facts_(facts) {}
+    friend class MiniaudioBackend;
+public:
+    BackendCleanupCompletion() = default; // Empty means no completion evidence.
+    const BackendCleanupFacts &facts() const { return facts_; }
+    bool resources_released() const { return facts_.resources_released(); }
+    bool clean_active_shutdown() const { return facts_.clean_active_shutdown(); }
+};
+
+struct AudioCleanupFacts {
+    AudioLifetime lifetime;
+    AudioCleanupState state = AudioCleanupState::no_lifetime;
+    AudioInitStage init_stage = AudioInitStage::not_attempted;
+    int init_error = 0;
+    bool backend_created = false;
+    BackendCleanupCompletion backend;
+    bool backend_storage_deleted = false;
+    bool opus_destroy_returned = false;
+    bool opus_decoder_absent = false;
+    bool decoded_pcm_cleared = false;
+    bool compressed_opus_cleared = false;
+    bool resources_released() const { return state == AudioCleanupState::resources_released; }
+    bool clean_active_shutdown() const {
+        return resources_released() && init_stage == AudioInitStage::ready &&
+            backend_created && backend.clean_active_shutdown() && backend_storage_deleted &&
+            opus_destroy_returned && opus_decoder_absent && decoded_pcm_cleared && compressed_opus_cleared;
+    }
+};
+
+class AudioCleanupCompletion {
+    AudioCleanupFacts facts_;
+    explicit AudioCleanupCompletion(const AudioCleanupFacts &facts) : facts_(facts) {}
+    friend class godot::AudioRenderer;
+public:
+    AudioCleanupCompletion() = default;
+    const AudioCleanupFacts &facts() const { return facts_; }
+    bool resources_released() const { return facts_.resources_released(); }
+    bool clean_active_shutdown() const { return facts_.clean_active_shutdown(); }
+};
+
+} // namespace nightfall
diff --git a/addons/nightfall-stream/src/audio/audio_startup.h b/addons/nightfall-stream/src/audio/audio_startup.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/audio/audio_startup.h
@@ -0,0 +1,130 @@
+#pragma once
+
+#include "audio_cleanup.h"
+#include <memory>
+
+namespace nightfall {
+
+// Local component identity, not a transport credential or FilePCM commit.
+struct AudioStartupIdentity {
+    AudioLifetime lifetime;
+    uint64_t attempt = 0;
+    bool operator==(const AudioStartupIdentity &other) const {
+        return lifetime == other.lifetime && attempt == other.attempt;
+    }
+    bool operator!=(const AudioStartupIdentity &other) const { return !(*this == other); }
+};
+
+enum class AudioStartupState {
+    unavailable, initializing, not_started, starting, awaiting_callback, ready,
+    paused, replaced, closed, failed, disconnected
+};
+
+struct BackendStartupFacts {
+    AudioStartupIdentity identity;
+    AudioStartupState state = AudioStartupState::unavailable;
+    int first_error = 0;
+    bool start_returned_success = false;
+    uint64_t callbacks_entered_after_start = 0;
+    uint64_t callbacks_returned_after_start = 0;
+};
+
+class BackendStartupSnapshot {
+    BackendStartupFacts facts_;
+    explicit BackendStartupSnapshot(BackendStartupFacts facts) : facts_(facts) {}
+    friend class BackendStartupWatch;
+public:
+    BackendStartupSnapshot() = default;
+    const BackendStartupFacts &facts() const { return facts_; }
+    bool ready() const {
+        return facts_.state == AudioStartupState::ready && facts_.first_error == 0 &&
+            facts_.start_returned_success && facts_.callbacks_returned_after_start > 0;
+    }
+};
+
+class BackendStartupWatch {
+    const AudioStartupIdentity identity_;
+    std::atomic<AudioStartupState> state_;
+    std::atomic<int> first_error_{0};
+    std::atomic<bool> start_success_{false};
+    std::atomic<uint64_t> callbacks_entered_{0}, callbacks_returned_{0};
+    explicit BackendStartupWatch(AudioStartupIdentity identity, AudioStartupState state)
+        : identity_(identity), state_(state) {}
+    friend class MiniaudioBackend;
+    static bool failure(AudioStartupState state) {
+        return state == AudioStartupState::failed || state == AudioStartupState::disconnected;
+    }
+    void revoke(AudioStartupState next, int error = 0) {
+        if (error != 0) { int empty = 0; first_error_.compare_exchange_strong(empty, error); }
+        auto state = state_.load(std::memory_order_acquire);
+        while (!failure(state)) {
+            // A failure may strengthen an earlier revocation; ordinary late
+            // pause/close notifications never erase an existing terminal fact.
+            if ((state == AudioStartupState::paused || state == AudioStartupState::closed ||
+                 state == AudioStartupState::replaced) && !failure(next)) return;
+            if (state_.compare_exchange_weak(state, next, std::memory_order_acq_rel)) return;
+        }
+    }
+public:
+    AudioStartupIdentity identity() const { return identity_; }
+    BackendStartupSnapshot snapshot() const {
+        BackendStartupFacts facts;
+        facts.identity = identity_;
+        facts.start_returned_success = start_success_.load(std::memory_order_acquire);
+        facts.callbacks_entered_after_start = callbacks_entered_.load(std::memory_order_acquire);
+        facts.callbacks_returned_after_start = callbacks_returned_.load(std::memory_order_acquire);
+        facts.first_error = first_error_.load(std::memory_order_acquire);
+        facts.state = state_.load(std::memory_order_acquire);
+        return BackendStartupSnapshot(facts);
+    }
+};
+
+class AudioStartupSnapshot {
+    AudioStartupIdentity identity_;
+    AudioStartupState state_ = AudioStartupState::unavailable;
+    int first_error_ = 0;
+    BackendStartupSnapshot backend_;
+    AudioStartupSnapshot(AudioStartupIdentity identity, AudioStartupState state, int error,
+                         BackendStartupSnapshot backend)
+        : identity_(identity), state_(state), first_error_(error), backend_(backend) {}
+    friend class AudioStartupWatch;
+public:
+    AudioStartupSnapshot() = default;
+    AudioStartupIdentity identity() const { return identity_; }
+    AudioStartupState state() const { return state_; }
+    int first_error() const { return first_error_; }
+    const BackendStartupSnapshot &backend() const { return backend_; }
+    bool ready() const { return state_ == AudioStartupState::ready && first_error_ == 0 && backend_.ready(); }
+};
+
+class AudioStartupWatch {
+    const AudioStartupIdentity identity_;
+    const std::shared_ptr<const BackendStartupWatch> backend_;
+    std::atomic<AudioStartupState> state_;
+    std::atomic<int> first_error_{0};
+    AudioStartupWatch(AudioStartupIdentity identity, AudioStartupState state,
+                      std::shared_ptr<const BackendStartupWatch> backend = {}, int error = 0)
+        : identity_(identity), backend_(std::move(backend)), state_(state), first_error_(error) {}
+    friend class godot::AudioRenderer;
+    void revoke(AudioStartupState next, int error = 0) {
+        if (error != 0) { int empty = 0; first_error_.compare_exchange_strong(empty, error); }
+        auto state = state_.load(std::memory_order_acquire);
+        while (state != AudioStartupState::failed && state != AudioStartupState::disconnected) {
+            if ((state == AudioStartupState::paused || state == AudioStartupState::closed ||
+                 state == AudioStartupState::replaced) && next != AudioStartupState::failed) return;
+            if (state_.compare_exchange_weak(state, next, std::memory_order_acq_rel)) return;
+        }
+    }
+public:
+    AudioStartupIdentity identity() const { return identity_; }
+    AudioStartupSnapshot snapshot() const {
+        auto backend = backend_ ? backend_->snapshot() : BackendStartupSnapshot();
+        auto state = state_.load(std::memory_order_acquire);
+        const int local_error = first_error_.load(std::memory_order_acquire);
+        const int error = local_error ? local_error : backend.facts().first_error;
+        if (state == AudioStartupState::awaiting_callback) state = backend.facts().state;
+        return AudioStartupSnapshot(identity_, state, error, backend);
+    }
+};
+
+} // namespace nightfall
diff --git a/addons/nightfall-stream/src/config/pairing_protocol.h b/addons/nightfall-stream/src/config/pairing_protocol.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/config/pairing_protocol.h
@@ -0,0 +1,78 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace nightfall {
+// Pair callbacks execute on Godot's main thread. Retired HTTP replies must not
+// mutate the next attempt's salt, certificate, or stage.
+struct PairingAttempt {
+    uint64_t generation = 0;
+    void retire() { ++generation; }
+    bool accepts(uint64_t ticket, int step, int expected_step, bool active) const {
+        return active && ticket == generation && step == expected_step;
+    }
+};
+
+struct PairingStatus {
+    bool valid = false;
+    int code = 0;
+    std::string message;
+};
+
+// Read only the first root start tag, never an inner node or certificate text.
+// Sunshine carries application status in XML attributes even when HTTP is 200.
+inline PairingStatus pairing_status(std::string_view xml) {
+    PairingStatus result;
+    if (xml.size() > 1024 * 1024) return result;
+    size_t p = 0;
+    const auto space = [](char c) { return c == ' ' || c == '\r' || c == '\n' || c == '\t'; };
+    const auto skip = [&]() { while (p < xml.size() && space(xml[p])) ++p; };
+    if (xml.substr(0, 3) == "\xef\xbb\xbf") p = 3;
+    skip();
+    if (xml.substr(p, 5) == "<?xml") {
+        p = xml.find("?>", p + 5);
+        if (p == std::string_view::npos) return result;
+        p += 2; skip();
+    }
+    if (xml.substr(p, 5) != "<root") return result;
+    p += 5;
+    if (p >= xml.size() || (!space(xml[p]) && xml[p] != '>')) return result;
+    bool found_code = false, found_message = false;
+    while (p < xml.size()) {
+        skip();
+        if (p == xml.size()) return {};
+        if (xml[p] == '>' || xml.substr(p, 2) == "/>") {
+            result.valid = found_code;
+            return result;
+        }
+        const size_t name_start = p;
+        while (p < xml.size() && !space(xml[p]) && xml[p] != '=') ++p;
+        const auto name = xml.substr(name_start, p - name_start);
+        skip();
+        if (name.empty() || p >= xml.size() || xml[p++] != '=') return {};
+        skip();
+        if (p >= xml.size() || (xml[p] != '\'' && xml[p] != '"')) return {};
+        const char quote = xml[p++];
+        const size_t start = p;
+        p = xml.find(quote, p);
+        if (p == std::string_view::npos) return {};
+        const auto value = xml.substr(start, p++ - start);
+        if (name == "status_code") {
+            if (found_code || value.size() != 3) return {};
+            found_code = true;
+            for (const char c : value) {
+                if (c < '0' || c > '9') return {};
+                result.code = result.code * 10 + c - '0';
+            }
+            if (result.code < 100) return {};
+        } else if (name == "status_message") {
+            if (found_message || value.size() > 1024) return {};
+            found_message = true;
+            result.message.assign(value);
+        }
+        if (p < xml.size() && !space(xml[p]) && xml[p] != '>' && xml[p] != '/') return {};
+    }
+    return {};
+}
+} // namespace nightfall
diff --git a/addons/nightfall-stream/src/config/pc_pointer_input_gate.h b/addons/nightfall-stream/src/config/pc_pointer_input_gate.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/config/pc_pointer_input_gate.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <set>
+#include <string>
+#include <utility>
+
+namespace nightfall {
+// Local opt-in only. The host still validates immutable frame/source/owner/TTL.
+// No persistence: a new manager or host switch starts with actual input disabled.
+class PcPointerInputGate {
+    int enabled_host_ = -1;
+    std::set<std::pair<int, std::string>> uncertain_;
+public:
+    void set(int host, bool enabled) { enabled_host_ = enabled && host >= 0 ? host : -1; }
+    void mark_uncertain(int host, const std::string &epoch) {
+        if (host >= 0 && !epoch.empty()) uncertain_.emplace(host, epoch);
+        enabled_host_ = -1;
+    }
+    bool permits(int host, bool dry_run, const std::string &epoch = {}) const {
+        return host >= 0 && (dry_run || (host == enabled_host_ && !epoch.empty() &&
+            uncertain_.find({host, epoch}) == uncertain_.end()));
+    }
+};
+}
diff --git a/addons/nightfall-stream/src/video/codec_retirement.h b/addons/nightfall-stream/src/video/codec_retirement.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/video/codec_retirement.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <atomic>
+
+namespace godot {
+class AndroidMediaCodec;
+
+// Process-local identity. The transport owner must bind this to its authenticated
+// session before stopping; it is neither a wire receipt nor a reset permission.
+struct CodecLifetime {
+    uint64_t instance = 0;
+    uint64_t generation = 0;
+    bool operator==(const CodecLifetime &other) const {
+        return instance == other.instance && generation == other.generation;
+    }
+};
+
+class CodecRetirement final {
+public:
+    CodecLifetime lifetime() const { return lifetime_; }
+    bool initialized() const { return initialized_; }
+    int32_t callback_status() const { return callback_status_; }
+    int32_t image_listener_status() const { return image_listener_status_; }
+    int32_t buffer_listener_status() const { return buffer_listener_status_; }
+    int32_t stop_status() const { return stop_status_; }
+    int32_t delete_status() const { return delete_status_; }
+    int32_t prior_delete_error() const { return prior_delete_error_; }
+    uint64_t outstanding_images() const { return outstanding_images_; }
+    bool resources_released() const {
+        return callback_status_ == 0 && image_listener_status_ == 0 &&
+            buffer_listener_status_ == 0 && stop_status_ == 0 &&
+            delete_status_ == 0 && prior_delete_error_ == 0 &&
+            outstanding_images_ == 0 && callback_barrier_returned_ &&
+            reader_delete_returned_ && window_release_returned_ && queues_cleared_;
+    }
+    bool initialized_codec_retired() const { return initialized_ && resources_released(); }
+
+private:
+    friend class AndroidMediaCodec;
+    CodecRetirement() = default;
+    CodecLifetime lifetime_;
+    bool initialized_ = false;
+    int32_t callback_status_ = 0;
+    int32_t image_listener_status_ = 0;
+    int32_t buffer_listener_status_ = 0;
+    int32_t stop_status_ = 0;
+    int32_t delete_status_ = 0;
+    int32_t prior_delete_error_ = 0;
+    uint64_t outstanding_images_ = 0;
+    bool callback_barrier_returned_ = false;
+    bool reader_delete_returned_ = false;
+    bool window_release_returned_ = false;
+    bool queues_cleared_ = false;
+};
+
+// The owner can retain this before releasing its codec pointer. Destruction
+// publishes the same immutable result, so deferred shared_ptr destruction on
+// the joined decode thread cannot make the evidence disappear.
+class CodecRetirementWatch final {
+public:
+    CodecLifetime lifetime() const { return lifetime_; }
+    std::shared_ptr<const CodecRetirement> snapshot() const {
+        return std::atomic_load(&result_);
+    }
+private:
+    friend class AndroidMediaCodec;
+    explicit CodecRetirementWatch(CodecLifetime lifetime) : lifetime_(lifetime) {}
+    CodecLifetime lifetime_;
+    std::shared_ptr<const CodecRetirement> result_;
+};
+} // namespace godot
diff --git a/addons/nightfall-stream/src/video/frame_identity.h b/addons/nightfall-stream/src/video/frame_identity.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/video/frame_identity.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <optional>
+#include <string>
+
+namespace quest3d {
+inline constexpr int kSurfaceSyncError = -5501;
+
+inline bool valid_transport_epoch(const std::string &value) {
+    return value.size() == 32 && std::all_of(value.begin(), value.end(), [](char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+    });
+}
+
+struct FrameToken {
+    std::string transport_epoch;
+    uint64_t decoder_epoch = 0;
+    uint32_t frame_index = 0;
+    int64_t codec_pts_us = 0;
+    int64_t enqueue_us = 0;
+    bool valid = false;
+};
+
+// Synchronization is owned by TextureUploader. No Android/GL dependency, so
+// timestamp selection and invalidation are tested with the production helper.
+class FrameIdentityMap {
+public:
+    static constexpr size_t capacity = 256;
+    static constexpr int64_t max_age_us = 2'000'000;
+
+    void set_transport(std::string value) {
+        transport_ = valid_transport_epoch(value) ? std::move(value) : std::string();
+        entries_.clear();
+    }
+
+    void begin_decoder(uint64_t epoch) {
+        decoder_epoch_ = epoch;
+        entries_.clear();
+        // Never reuse PTS across flush/restart, even for equal enqueue times.
+    }
+
+    int64_t reserve_pts(int64_t enqueue_us) {
+        constexpr int64_t limit = std::numeric_limits<int64_t>::max() / 1000;
+        if (enqueue_us <= 0 || enqueue_us >= limit || last_pts_ >= limit - 1) return 0;
+        last_pts_ = std::max(enqueue_us, last_pts_ + 1);
+        return last_pts_;
+    }
+
+    bool submitted(int64_t pts, int64_t enqueue, uint32_t index, uint64_t epoch) {
+        if (pts <= 0 || pts > last_pts_ || enqueue <= 0 || epoch != decoder_epoch_) {
+            return false;
+        }
+        auto previous = entries_.find(pts);
+        if (previous != entries_.end()) {
+            // Retain a bounded tombstone: a third duplicate cannot rehabilitate
+            // an ambiguous PTS after the second invalidated its first identity.
+            previous->second.codec_pts_us = 0;
+            previous->second.valid = false;
+            return false;
+        }
+        entries_.emplace(pts, FrameToken{transport_, epoch, index, pts, enqueue, !transport_.empty()});
+        while (!entries_.empty() && (entries_.size() > capacity || pts - entries_.begin()->first > max_age_us)) {
+            entries_.erase(entries_.begin());
+        }
+        return true;
+    }
+
+    std::optional<FrameToken> exact_pts(int64_t pts) const {
+        const auto found = entries_.find(pts);
+        if (found == entries_.end() || found->second.decoder_epoch != decoder_epoch_ || found->second.codec_pts_us <= 0) return std::nullopt;
+        return found->second;
+    }
+
+    std::optional<FrameToken> surface_timestamp(int64_t ns) const {
+        if (ns <= 0 || ns % 1000 != 0) return std::nullopt;
+        return exact_pts(ns / 1000);
+    }
+
+    bool current(const std::string &transport, uint64_t epoch) const {
+        return !transport_.empty() && transport == transport_ && epoch == decoder_epoch_;
+    }
+    uint64_t decoder_epoch() const { return decoder_epoch_; }
+    size_t size() const { return entries_.size(); }
+
+private:
+    std::string transport_;
+    uint64_t decoder_epoch_ = 0;
+    int64_t last_pts_ = 0;
+    std::map<int64_t, FrameToken> entries_;
+};
+
+// A descriptor may be read only while the underlying OES content is leased.
+// GPU completion is an additional condition supplied by the GL owner.
+class OesLeaseState {
+public:
+    uint64_t publish() { if (held_ || failed_) return 0; published_ = true; return ++serial_; }
+    uint64_t acquire() {
+        if (!published_ || held_ || failed_) return 0;
+        held_ = true;
+        return serial_;
+    }
+    bool release(uint64_t serial) {
+        if (!held_ || serial != serial_) return false;
+        held_ = false;
+        return true;
+    }
+    bool can_update(bool gpu_complete) const { return !failed_ && !held_ && gpu_complete; }
+    void invalidate() { published_ = false; }
+    void fail() { failed_ = true; published_ = false; }
+    bool held() const { return held_; }
+    uint64_t serial() const { return serial_; }
+private:
+    uint64_t serial_ = 0;
+    bool held_ = false;
+    bool published_ = false;
+    bool failed_ = false;
+};
+} // namespace quest3d
diff --git a/addons/nightfall-stream/src/video/gles_surface_retirement.h b/addons/nightfall-stream/src/video/gles_surface_retirement.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/video/gles_surface_retirement.h
@@ -0,0 +1,298 @@
+#pragma once
+
+// Internal GLES resource owner. No Godot, transport, timer or mock completion
+// can manufacture a successful retirement: only retire() publishes it after
+// the real GL/JNI/ANativeWindow operations below return on the owning context.
+#include <EGL/egl.h>
+#include <GLES3/gl32.h>
+#include <android/native_window.h>
+#include <jni.h>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace godot {
+class TextureUploader;
+class GlesSurfaceRetirementOwner;
+
+struct GlesSurfaceLifetime {
+    uint64_t instance = 0;
+    uint64_t generation = 0;
+    std::string transport;
+    bool operator==(const GlesSurfaceLifetime &other) const {
+        return instance == other.instance && generation == other.generation && transport == other.transport;
+    }
+};
+
+enum class GlesRetirementStatus {
+    Queued, LeaseHeld, FencePending, JniUnavailable, RenderServerUnavailable,
+    LegacyConsumerUnconfirmed, Released, FenceFailed, JniReleaseFailed,
+    GlFailed, WrongContext, OwnerDestroyed
+};
+
+class GlesSurfaceRetirement final {
+public:
+    GlesSurfaceLifetime lifetime() const { return lifetime_; }
+    GlesRetirementStatus status() const { return status_; }
+    uint64_t attempts() const { return attempts_; }
+    uint32_t gl_error() const { return gl_error_; }
+    bool initialized() const { return initialized_; }
+    bool legacy_output_used() const { return legacy_output_used_; }
+    // Ordinary reconnect may remove storage without proving that a legacy
+    // viewport retired. This fact alone is explicitly NOT reset completion.
+    bool storage_cleanup_returned() const { return storage_cleanup_returned_; }
+    bool resources_released() const { return status_ == GlesRetirementStatus::Released; }
+    bool initialized_surface_retired() const { return initialized_ && resources_released(); }
+    bool terminal_failure() const {
+        return status_ == GlesRetirementStatus::FenceFailed || status_ == GlesRetirementStatus::JniReleaseFailed ||
+            status_ == GlesRetirementStatus::GlFailed || status_ == GlesRetirementStatus::WrongContext ||
+            status_ == GlesRetirementStatus::OwnerDestroyed;
+    }
+private:
+    friend class GlesSurfaceRetirementOwner;
+    GlesSurfaceRetirement() = default;
+    GlesSurfaceLifetime lifetime_;
+    GlesRetirementStatus status_ = GlesRetirementStatus::Queued;
+    uint64_t attempts_ = 0;
+    uint32_t gl_error_ = 0;
+    bool initialized_ = false;
+    bool legacy_output_used_ = false;
+    bool storage_cleanup_returned_ = false;
+};
+
+class GlesSurfaceRetirementWatch final {
+public:
+    GlesSurfaceLifetime lifetime() const { return lifetime_; }
+    std::shared_ptr<const GlesSurfaceRetirement> snapshot() const { return std::atomic_load(&result_); }
+private:
+    friend class GlesSurfaceRetirementOwner;
+    explicit GlesSurfaceRetirementWatch(GlesSurfaceLifetime value) : lifetime_(std::move(value)) {}
+    GlesSurfaceLifetime lifetime_;
+    std::shared_ptr<const GlesSurfaceRetirement> result_;
+};
+
+class GlesSurfaceRetirementOwner final {
+private:
+    friend class TextureUploader;
+    inline static std::atomic<uint64_t> next_instance_{1};
+    const uint64_t instance_ = next_instance_.fetch_add(1);
+    uint64_t generation_ = 0;
+    std::shared_ptr<GlesSurfaceRetirementWatch> watch_;
+    EGLContext context_ = EGL_NO_CONTEXT;
+    bool requested_ = false;
+    bool strict_required_ = false;
+    bool ordinary_disposed_ = false;
+    bool initialized_ = false;
+    bool legacy_output_used_ = false;
+    uint64_t attempts_ = 0;
+    GLsync retirement_fence_ = nullptr;
+    // Resource handles stay nonzero until the corresponding production delete
+    // succeeds. A failed operation leaves this lifetime blocked, never fresh.
+    ANativeWindow *window = nullptr;
+    void *surface = nullptr;
+    void *matrix = nullptr;
+    void *release_method = nullptr;
+    void *ready_fence = nullptr;
+    void *consumer_fence = nullptr;
+    unsigned oes_texture = 0, output_texture = 0, fbo = 0, program = 0;
+    unsigned depth_texture = 0, depth_fbo = 0, pbos[3]{};
+    void *depth_fences[3]{};
+
+    GlesSurfaceRetirementOwner() = default;
+    GlesSurfaceRetirementOwner(const GlesSurfaceRetirementOwner &) = delete;
+    GlesSurfaceRetirementOwner &operator=(const GlesSurfaceRetirementOwner &) = delete;
+    ~GlesSurfaceRetirementOwner() {
+        // Never enqueue a raw-this callback or resurrect a dying RefCounted.
+        // A retained watch reports missing explicit teardown instead.
+        if (watch_ && !finished() && !ordinary_disposed_) publish(GlesRetirementStatus::OwnerDestroyed);
+    }
+    bool finished() const {
+        const auto result = watch_ ? watch_->snapshot() : nullptr;
+        return result && result->resources_released();
+    }
+    bool terminal() const {
+        const auto result = watch_ ? watch_->snapshot() : nullptr;
+        return result && result->terminal_failure();
+    }
+    bool begin(const std::string &transport) {
+        if (watch_ && !finished() && !(ordinary_disposed_ && !strict_required_ && !terminal())) return false;
+        watch_.reset(new GlesSurfaceRetirementWatch({instance_, ++generation_, transport}));
+        context_ = EGL_NO_CONTEXT;
+        requested_ = initialized_ = legacy_output_used_ = strict_required_ = ordinary_disposed_ = false;
+        attempts_ = 0;
+        return true;
+    }
+    bool matches(const GlesSurfaceLifetime &expected) const { return watch_ && watch_->lifetime() == expected; }
+    bool accepts_create(uint64_t generation) const { return generation == generation_ && !requested_; }
+    bool accepts_update(uint64_t generation) const { return accepts_create(generation) && initialized_; }
+    bool accepts_failure(const GlesSurfaceLifetime &expected, const std::string &current_transport) const {
+        return matches(expected) && !requested_ && !finished() && expected.transport == current_transport;
+    }
+    bool request(const GlesSurfaceLifetime &expected, bool strict = true) {
+        if (!matches(expected)) return false;
+        requested_ = true;
+        strict_required_ = strict_required_ || strict;
+        if (!finished() && !terminal()) publish(GlesRetirementStatus::Queued);
+        return true;
+    }
+    void publish(GlesRetirementStatus status, GLenum error = GL_NO_ERROR) {
+        if (!watch_) return;
+        const auto old = watch_->snapshot();
+        // Success is idempotent; real failures cannot disappear on a retry,
+        // missing RenderingServer, destructor, transport change or next query.
+        if (old && (old->resources_released() || old->terminal_failure())) return;
+        auto result = std::shared_ptr<GlesSurfaceRetirement>(new GlesSurfaceRetirement());
+        result->lifetime_ = watch_->lifetime();
+        result->status_ = status;
+        result->attempts_ = attempts_;
+        result->gl_error_ = error;
+        result->initialized_ = initialized_;
+        result->legacy_output_used_ = legacy_output_used_;
+        result->storage_cleanup_returned_ = ordinary_disposed_ || status == GlesRetirementStatus::Released;
+        std::atomic_store(&watch_->result_, std::shared_ptr<const GlesSurfaceRetirement>(std::move(result)));
+    }
+    bool has_gl_resources() const {
+        if (retirement_fence_ || ready_fence || consumer_fence || oes_texture || output_texture || fbo ||
+            program || depth_texture || depth_fbo) return true;
+        for (int i = 0; i < 3; ++i) if (pbos[i] || depth_fences[i]) return true;
+        return false;
+    }
+    bool check_error() {
+        const GLenum error = glGetError();
+        if (error == GL_NO_ERROR) return true;
+        publish(GlesRetirementStatus::GlFailed, error);
+        return false;
+    }
+    bool wait_fence(GLsync fence) {
+        // Preserve the existing bounded wait on ordinary reconnect. Strict
+        // reset observation is nonblocking and requires an explicit retry.
+        const GLenum wait = glClientWaitSync(fence, 0, strict_required_ ? 0 : 1000000000ULL);
+        if (wait == GL_WAIT_FAILED) {
+            publish(GlesRetirementStatus::FenceFailed, glGetError());
+            return false;
+        }
+        if (!check_error()) return false;
+        if (wait != GL_ALREADY_SIGNALED && wait != GL_CONDITION_SATISFIED) {
+            publish(GlesRetirementStatus::FencePending);
+            return false;
+        }
+        return true;
+    }
+    bool delete_sync(void *&value) {
+        if (!value) return true;
+        glDeleteSync(reinterpret_cast<GLsync>(value));
+        if (!check_error()) return false;
+        value = nullptr;
+        return true;
+    }
+    bool delete_texture(unsigned &value) {
+        if (!value) return true;
+        const unsigned old = value;
+        glDeleteTextures(1, &value);
+        if (!check_error()) return false;
+        const bool gone = glIsTexture(old) == GL_FALSE;
+        if (!check_error()) return false;
+        if (!gone) { publish(GlesRetirementStatus::GlFailed); return false; }
+        value = 0;
+        return true;
+    }
+    bool delete_fbo(unsigned &value) {
+        if (!value) return true;
+        const unsigned old = value;
+        glDeleteFramebuffers(1, &value);
+        if (!check_error()) return false;
+        const bool gone = glIsFramebuffer(old) == GL_FALSE;
+        if (!check_error()) return false;
+        if (!gone) { publish(GlesRetirementStatus::GlFailed); return false; }
+        value = 0;
+        return true;
+    }
+    bool delete_depth_resources() {
+        for (int i = 0; i < 3; ++i) if (!delete_sync(depth_fences[i])) return false;
+        for (int i = 0; i < 3; ++i) if (pbos[i]) {
+            const unsigned old = pbos[i];
+            glDeleteBuffers(1, &pbos[i]);
+            if (!check_error()) return false;
+            const bool gone = glIsBuffer(old) == GL_FALSE;
+            if (!check_error()) return false;
+            if (!gone) { publish(GlesRetirementStatus::GlFailed); return false; }
+            pbos[i] = 0;
+        }
+        return delete_fbo(depth_fbo) && delete_texture(depth_texture);
+    }
+    // Called only by TextureUploader on its render thread with the surface
+    // mutex held and the exact queued generation checked. Producer/decode
+    // threads must already have stopped; this is not a MediaCodec stop API.
+    void retire(bool lease_held, JNIEnv *env) {
+        if (!watch_ || !requested_ || finished() || terminal()) return;
+        ++attempts_;
+        if (lease_held) { publish(GlesRetirementStatus::LeaseHeld); return; }
+        if (legacy_output_used_ && strict_required_) { publish(GlesRetirementStatus::LegacyConsumerUnconfirmed); return; }
+        if (has_gl_resources()) {
+            if (context_ == EGL_NO_CONTEXT || eglGetCurrentContext() != context_) {
+                publish(GlesRetirementStatus::WrongContext); return;
+            }
+            if (!check_error()) return;
+            if (consumer_fence && !wait_fence(reinterpret_cast<GLsync>(consumer_fence))) return;
+            // An actual GPU barrier covers the final producer/depth commands;
+            // elapsed time is never a substitute for a signaled fence.
+            if (!retirement_fence_) {
+                retirement_fence_ = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+                glFlush();
+                if (!check_error()) return;
+                if (!retirement_fence_) { publish(GlesRetirementStatus::GlFailed); return; }
+            }
+            if (!wait_fence(retirement_fence_)) return;
+        }
+        if ((surface || matrix) && !env) { publish(GlesRetirementStatus::JniUnavailable); return; }
+        if (env && env->ExceptionCheck()) {
+            env->ExceptionClear(); publish(GlesRetirementStatus::JniReleaseFailed); return;
+        }
+        if (surface) {
+            if (!release_method) { publish(GlesRetirementStatus::JniReleaseFailed); return; }
+            env->CallVoidMethod(reinterpret_cast<jobject>(surface), reinterpret_cast<jmethodID>(release_method));
+            if (env->ExceptionCheck()) {
+                env->ExceptionClear(); publish(GlesRetirementStatus::JniReleaseFailed); return;
+            }
+            env->DeleteGlobalRef(reinterpret_cast<jobject>(surface));
+            if (env->ExceptionCheck()) {
+                env->ExceptionClear(); publish(GlesRetirementStatus::JniReleaseFailed); return;
+            }
+            surface = nullptr;
+            release_method = nullptr;
+        }
+        if (matrix) {
+            env->DeleteGlobalRef(reinterpret_cast<jobject>(matrix));
+            if (env->ExceptionCheck()) {
+                env->ExceptionClear(); publish(GlesRetirementStatus::JniReleaseFailed); return;
+            }
+            matrix = nullptr;
+        }
+        if (window) { ANativeWindow_release(window); window = nullptr; }
+        if (has_gl_resources()) {
+            if (!delete_sync(consumer_fence) || !delete_sync(ready_fence)) return;
+            if (!delete_depth_resources() || !delete_fbo(fbo) ||
+                !delete_texture(output_texture) || !delete_texture(oes_texture)) return;
+            if (program) {
+                GLint bound = 0;
+                glGetIntegerv(GL_CURRENT_PROGRAM, &bound);
+                if (static_cast<unsigned>(bound) == program) glUseProgram(0);
+                glDeleteProgram(program);
+                if (!check_error()) return;
+                const bool gone = glIsProgram(program) == GL_FALSE;
+                if (!check_error()) return;
+                if (!gone) { publish(GlesRetirementStatus::GlFailed); return; }
+                program = 0;
+            }
+            if (retirement_fence_) {
+                glDeleteSync(retirement_fence_);
+                if (!check_error()) return;
+                retirement_fence_ = nullptr;
+            }
+        }
+        ordinary_disposed_ = true;
+        publish(legacy_output_used_ ? GlesRetirementStatus::LegacyConsumerUnconfirmed : GlesRetirementStatus::Released);
+    }
+};
+} // namespace godot
diff --git a/addons/nightfall-stream/src/video/stream_retirement.h b/addons/nightfall-stream/src/video/stream_retirement.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/video/stream_retirement.h
@@ -0,0 +1,113 @@
+#pragma once
+
+#include "audio/audio_cleanup.h"
+#include "video/codec_retirement.h"
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace godot {
+class StreamConnection;
+
+// Process-local owner plus the exact transport nonce supplied to this start.
+// It is not an authenticated network receipt or a reset authorization.
+struct StreamLifetime {
+    uint64_t instance = 0;
+    uint64_t generation = 0;
+    std::string transport_nonce;
+    bool operator==(const StreamLifetime &other) const {
+        return instance == other.instance && generation == other.generation &&
+            transport_nonce == other.transport_nonce;
+    }
+    bool valid() const {
+        if (!instance || !generation || transport_nonce.size() != 32) return false;
+        for (char c : transport_nonce) {
+            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+        }
+        return true;
+    }
+};
+
+class StreamRetirement final {
+public:
+    const StreamLifetime &lifetime() const { return lifetime_; }
+    bool interrupt_returned() const { return interrupt_returned_; }
+    bool connection_joined() const { return connection_joined_; }
+    bool moonlight_stop_returned() const { return moonlight_stop_returned_; }
+    bool decode_joined() const { return decode_joined_; }
+    bool packet_queue_cleared() const { return packet_queue_cleared_; }
+    bool callback_barrier_returned() const { return callback_barrier_returned_; }
+    bool termination_thread_drained() const { return termination_thread_drained_; }
+    bool connection_started() const { return connection_started_; }
+    int start_result() const { return start_result_; }
+    bool audio_attempted() const { return audio_lifetime_.valid(); }
+    nightfall::AudioLifetime audio_lifetime() const { return audio_lifetime_; }
+    const nightfall::AudioCleanupCompletion &audio_completion() const { return audio_; }
+    const std::vector<std::shared_ptr<const CodecRetirementWatch>> &codecs() const { return codecs_; }
+    const std::vector<std::shared_ptr<const CodecRetirement>> &codec_results() const { return codec_results_; }
+    bool native_resources_released() const {
+        if (audio_attempted() && (!(audio_.facts().lifetime == audio_lifetime_) || !audio_.resources_released())) return false;
+        if (codecs_.size() != codec_results_.size()) return false;
+        for (size_t i = 0; i < codecs_.size(); ++i) {
+            const auto &watch = codecs_[i];
+            const auto &result = codec_results_[i];
+            if (!watch || !result || !(result->lifetime() == watch->lifetime()) || !result->resources_released()) return false;
+        }
+        return true;
+    }
+    bool resources_released() const {
+        if (!lifetime_.valid() || !interrupt_returned_ || !connection_joined_ ||
+            !moonlight_stop_returned_ || !decode_joined_ || !packet_queue_cleared_ ||
+            !callback_barrier_returned_ || !termination_thread_drained_) return false;
+        return native_resources_released();
+    }
+    bool clean_active_cpu_shutdown() const {
+        if (!resources_released() || !connection_started_ || start_result_ != 0) return false;
+        if (audio_expected_ && (!audio_attempted() || !audio_.clean_active_shutdown())) return false;
+        if (native_codec_expected_) {
+            if (codecs_.empty()) return false;
+            bool initialized = false;
+            for (const auto &result : codec_results_) {
+                if (result && result->initialized_codec_retired()) initialized = true;
+            }
+            if (!initialized) return false;
+        }
+        return true;
+    }
+    // TextureUploader/OES/AHB fences and XR teardown are outside this result.
+    bool quest_native_closed() const { return false; }
+
+private:
+    friend class StreamConnection;
+    StreamRetirement() = default;
+    StreamLifetime lifetime_;
