+	// Called only after the existing native codec was configured successfully.
+	// Do not create a second codec, change its configuration, or infer real-time
+	// performance from these platform-reported limits. Each bounded line gets its
+	// own log record so a long all-codecs report cannot truncate the useful data.
+	public static void logSelectedCodecCapabilities(String decoderName, String mime, int width, int height, int rate) {
+		final String tag = "Quest3DCodecCaps";
+		try {
+			android.media.MediaCodecInfo[] infos = new android.media.MediaCodecList(android.media.MediaCodecList.ALL_CODECS).getCodecInfos();
+			android.media.MediaCodecInfo selected = null;
+			String match = "none";
+			for (android.media.MediaCodecInfo info : infos) {
+				if (!info.isEncoder() && info.getName().equals(decoderName)) { selected = info; match = "exact_name"; break; }
+			}
+			if (selected == null && android.os.Build.VERSION.SDK_INT >= 29) {
+				for (android.media.MediaCodecInfo info : infos) {
+					if (!info.isEncoder() && info.getCanonicalName().equals(decoderName)) { selected = info; match = "canonical_alias"; break; }
+				}
+			}
+			Log.i(tag, "actual_decoder=" + decoderName + " mime=" + mime + " configured=" + width + "x" + height
+					+ "@" + rate + " match=" + match + " evidence=platform_reported_not_measured");
+			if (selected == null) return;
+			android.media.MediaCodecInfo.VideoCapabilities caps = selected.getCapabilitiesForType(mime).getVideoCapabilities();
+			if (caps == null) { Log.i(tag, "video_capabilities=UNAVAILABLE"); return; }
+			Log.i(tag, "listed_decoder=" + selected.getName() + " hardware=" + selected.isHardwareAccelerated()
+					+ " width_alignment=" + caps.getWidthAlignment() + " height_alignment=" + caps.getHeightAlignment()
+					+ " bitrate_range=" + caps.getBitrateRange());
+			CodecCapabilityDiagnostics.VideoProbe probe = videoProbe(caps);
+			Log.i(tag, "configured " + CodecCapabilityDiagnostics.describeSize(probe, width, height, rate));
+			for (int[] size : new int[][] { {2560, 720}, {3200, 900}, {3840, 1080} }) {
+				Log.i(tag, "candidate " + CodecCapabilityDiagnostics.describeSize(probe, size[0], size[1], 30));
+			}
+		} catch (Exception e) {
+			// Diagnostics must not make a working stream fail or leak device data.
+			Log.w(tag, "capabilities=UNAVAILABLE(" + e.getClass().getSimpleName() + ")");
+		}
+	}
