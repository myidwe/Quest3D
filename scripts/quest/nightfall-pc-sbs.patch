+extends SceneTree
+
+class QuietMain extends "res://main.gd":
+	var cleanup_count := 0
+	func _ready(): pass
+	func _process(_delta): pass
+	func _full_disconnect_cleanup(message: String, welcome: String = "welcome"):
+		var before: bool = _disconnect_cleanup_done
+		super._full_disconnect_cleanup(message, welcome)
+		if not before and _disconnect_cleanup_done: cleanup_count += 1
+
+class NoDiskState extends StateManager:
+	var saves := 0
+	func save_state(): saves += 1
+	func save_host_state(): pass
+
+class NoDeviceSettings extends SettingsController:
+	func apply_passthrough(_enabled): pass
+
+func _init(): _run.call_deferred()
+
+func _make_app():
+	var app = load("res://main.tscn").instantiate()
+	app.set_script(QuietMain)
+	root.add_child(app)
+	app._init_modules()
+	app.state_manager = NoDiskState.new(app)
+	app.settings_controller = NoDeviceSettings.new(app)
+	app.stream_backend = StreamBackend.new(null) # Real unsupported/headless adapter.
+	app.screen_mesh.material_override = ShaderMaterial.new()
+	app.screen_mesh.material_override.shader = load("res://src/shaders/yuv_display.gdshader")
+	app._init_ui()
+	app.comp = CompositionLayerManager.new(app)
+	app.comp.available = false # No XR runtime in CPU headless verification.
+	app.video_presentation.set_legacy_renderer(app.comp)
+	app.primary_screen.comp_shader_mat = app.screen_mesh.material_override
+	app.primary_screen.comp_viewport = SubViewport.new()
+	app.add_child(app.primary_screen.comp_viewport)
+	app.depth_estimator.setup() # Actual PC build: no local depth resources.
+	assert(app.PC_SBS_BUILD and app.depth_estimator.depth_viewport == null)
+	return app
+
+func _run():
+	var app = _make_app()
+	await process_frame
+	app.session_lifecycle.stream_started()
+	app.settings.host.pc_profile_resolution = Vector2i(2560, 720)
+	app._on_stream_terminated("Disconnected", 0)
+	assert(app.cleanup_count == 1 and not app.session_lifecycle.media_active)
+	assert(app.settings.host.pc_profile_resolution == Vector2i.ZERO)
+	assert(app.welcome_viewport.render_target_update_mode == SubViewport.UPDATE_ALWAYS)
+	app._on_stream_terminated("Disconnected duplicate", 0)
+	assert(app.cleanup_count == 1)
+	app.start_connect_timeout()
+	app.session_lifecycle.stream_started()
+	app.disconnect_stream()
+	assert(app.cleanup_count == 2)
+	# A live connection error still reaches the reconnect UI. A user's pending
+	# disconnect must never turn the same error into a reconnect intent.
+	app.start_connect_timeout()
+	app.session_lifecycle.stream_started()
+	app.settings.auto_reconnect_enabled = true
+	app._on_stream_terminated("Network lost", 42)
+	assert(app.session_lifecycle.is_reconnecting() and app.cleanup_count == 2)
+	app.session_lifecycle.request_disconnect()
+	app._on_stream_terminated("Cancelled connection", 42)
+	assert(not app.session_lifecycle.is_reconnecting() and app.cleanup_count == 3)
+	app.disconnect_stream()
+	assert(app.cleanup_count == 3)
+	# Actual disabled PC DepthEstimatorModule + real StreamBackend; no fake
+	# get_texture_uploader method is added to hide the recorded failure.
+	var base_node := Node.new()
+	app.add_child(base_node)
+	app.stream_backend = StreamBackend.new(base_node)
+	assert(not base_node.has_method("get_texture_uploader"))
+	var generation: int = app.session_lifecycle.connection_generation
+	app._begin_shutdown(false)
+	assert(app._shutdown_started and app.session_lifecycle.connection_generation > generation)
+	app._on_stream_terminated("Late destructor signal", 0)
+	app._on_stream_started()
+	app._full_disconnect_cleanup("Late failure")
+	assert(app.cleanup_count == 3 and not app.session_lifecycle.media_active)
+	assert(app.native_xr_renderer._shutdown_complete)
+	app._begin_shutdown(false)
+	app.free()
+	# Explicit shutdown happens before quit while children are still valid.
+	app = _make_app()
+	await process_frame
+	app.session_lifecycle.stream_started()
+	app._begin_shutdown(true)
+	assert(app.state_manager.saves == 1)
+	app._begin_shutdown(true)
+	assert(app.state_manager.saves == 1)
+	app._on_stream_terminated("Late stop signal", 0)
+	assert(app.cleanup_count == 0)
+	app.free()
+	# Real tree removal invokes main._exit_tree before child destruction; no
+	# state/UI/uploader calls are allowed after the children leave the tree.
+	app = _make_app()
+	await process_frame
+	app.session_lifecycle.stream_started()
+	root.remove_child(app)
+	assert(app._shutdown_started and app.native_xr_renderer._shutdown_complete)
+	app._on_stream_terminated("Post tree exit", 0)
+	assert(app.cleanup_count == 0 and app.state_manager.saves == 0)
+	app.free()
+	# Synchronous native start refusal must terminate initial connect, native
+	# auto-reconnect (without connect timeout), and settings restart equally.
+	for code in range(-5605, -5600):
+		app = _make_app()
+		await process_frame
+		app.settings.auto_reconnect_enabled = true
+		var phase_index := (code + 5605) % 3
+		if phase_index == 0:
+			app.start_connect_timeout()
+		else:
+			app.session_lifecycle.stream_started()
+			if phase_index == 1:
+				app.session_lifecycle.reconnect_scheduled()
+			else:
+				app.session_lifecycle.request_restart()
+		var refusal := "Native start refused %d: restart or disconnect the other stream" % code
+		app._on_stream_terminated(refusal, code)
+		assert(app.cleanup_count == 1 and app.session_lifecycle.phase == SessionLifecycle.Phase.FAILED)
+		assert(not app.session_lifecycle.media_active and not app.session_lifecycle.connect_timeout_pending)
+		assert(app._ui_status_label.tooltip_text == "Connection failed: " + refusal)
+		app._on_stream_terminated("Duplicate refusal", code)
+		assert(app.cleanup_count == 1)
+		app.free()
+	print("Stream teardown PASS: real PC depth/headless backend, normal disconnect UI, duplicate cleanup, invalid base Node, explicit shutdown, tree exit, late callback fence and all terminal start refusals across connect/retry/restart")
+	quit()
