-                    wf.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
-                    wf.nChannels  = (WORD)channels;
-                    wf.dwChannelMask     = ma_channel_map_to_channel_mask__win32(defaultChannelMap, channels);
