+func start_pair(ip: String):
+	main.get_node("%IPInput").text = ip
+	var parsed = main.parse_ip_port(ip)
+	var host_ip: String = parsed[0]
+	var host_port: int = parsed[1]
+	main._log("[PAIR] Starting pair with %s:%d..." % [host_ip, host_port])
+	var pin = main.stream_manager.begin_pair(host_ip, host_port)
+	main._log("[PAIR] Pair request created; show PIN only in the headset UI")
+	if str(pin) == "" or str(pin) == "0":
+		main._log("[PAIR] FAILED - no pin returned")
+		return
+	main._pair_pin = str(pin)
+	show_welcome_screen("pin")
+
+func update_pairing_wait():
+	if not main.welcome_viewport:
+		return
+	var label = main.welcome_viewport.get_node_or_null("WelcomeRoot/Screens/PINScreen/PairingWait")
+	if label:
+		var seconds := maxi(0, ceili((main.session_lifecycle.pairing_deadline_ms - Time.get_ticks_msec()) / 1000.0))
+		label.text = "Waiting for host PIN approval: %d seconds left.\nIf expired, start a new pairing and use its new PIN." % seconds
+
+func cycle_app():
+	if main._available_apps.is_empty():
+		query_app_list()
+		return
+	if main._selected_app_scope != AppSelection.host_scope(main.stream_backend, main.current_host_id):
+		query_app_list()
+		return
+	main._selected_app_idx = (main._selected_app_idx + 1) % main._available_apps.size()
+	var app: Dictionary = main._available_apps[main._selected_app_idx]
+	if main.app_selection.choose(main._selected_app_scope, app.id):
+		main._selected_app_id = app.id
+		_update_app_button("App: " + str(app.name))
+
+func _update_app_button(text: String):
+	if not main.welcome_viewport:
+		return
+	var app_btn = main.welcome_viewport.get_node_or_null("WelcomeRoot/Screens/WelcomeScreen/WelcomeAppBtn")
+	if app_btn:
+		app_btn.text = text
+		app_btn.visible = true
