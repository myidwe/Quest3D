-static int ma_device__jack_process_callback(ma_jack_nframes_t frameCount, void* pUserData)
-{
-    ma_device* pDevice;
-    ma_context* pContext;
-    ma_uint32 iChannel;
-
-    pDevice = (ma_device*)pUserData;
