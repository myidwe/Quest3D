-MA_API ma_uint32 ma_calculate_buffer_size_in_frames_from_milliseconds(ma_uint32 bufferSizeInMilliseconds, ma_uint32 sampleRate)
-{
-    /* Prevent a division by zero. */
-    if (sampleRate == 0) {
-        return 0;
-    }
-
-    return bufferSizeInMilliseconds*sampleRate / 1000;
