-        } else if (bitsPerSample == 24) {
-            pDeviceInfo->nativeDataFormats[0].format = ma_format_s24;
-        } else if (bitsPerSample == 32) {
-            pDeviceInfo->nativeDataFormats[0].format = ma_format_s32;
-        } else {
