@@ -0,0 +1,24 @@
+"""Replace the arm64 runtime inside Godot's official source-template AAR."""
+from pathlib import Path
+import sys
+from zipfile import ZipFile
+
+aar, runtime, cpp_runtime = map(Path, sys.argv[1:])
+replacements = {
+    'jni/arm64-v8a/libgodot_android.so': runtime,
+    'jni/arm64-v8a/libc++_shared.so': cpp_runtime,
+}
+for path in (aar, *replacements.values()):
+    if not path.is_file():
+        raise SystemExit(f'Required runtime input missing: {path}')
+temporary = aar.with_suffix('.patched.aar')
+with ZipFile(aar) as source, ZipFile(temporary, 'w') as target:
+    names = set(source.namelist())
+    missing = set(replacements) - names
+    if missing:
+        raise SystemExit(f'Unexpected source-template AAR; missing {missing}')
+    for entry in source.infolist():
+        data = replacements[entry.filename].read_bytes() if entry.filename in replacements else source.read(entry)
+        target.writestr(entry, data)
+temporary.replace(aar)
+print(f'Injected patched arm64 Godot and matching libc++ into {aar}')
