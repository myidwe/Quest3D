-        MA_DSCAPS caps;
-        WORD channels;
-
-        result = ma_context_create_IDirectSound__dsound(pContext, ma_share_mode_shared, pDeviceID, &pDirectSound);
-        if (result != MA_SUCCESS) {
-            return result;
-        }
