-    /* These checks differ from the standard implementation. It's not important, but I prefer it just for sanity. */
-    if (str1 == NULL) return -1;
-    if (str2 == NULL) return  1;
-
-    for (;;) {
-        if (str1[0] == L'\0') {
-            break;
-        }
-        if (str1[0] != str2[0]) {
-            break;
-        }
-
-        str1 += 1;
-        str2 += 1;
-    }
-
-    return ((unsigned short*)str1)[0] - ((unsigned short*)str2)[0];
