+
+class FakeApp extends Node3D:
+	const PC_SBS_BUILD := true
+	var settings := AppSettings.new()
+	var comp := RecordedComp.new()
+	var settings_controller = null
+	var is_streaming := true
+	var logs: Array[String] = []
+	func _log(value: String):
+		logs.append(value)
+
+func _init():
+	_run.call_deferred()
+
+func _pixels(r: int, g: int, b: int) -> PackedByteArray:
+	var data := PackedByteArray()
+	data.resize(32 * 32 * 4)
+	for pixel in range(32 * 32):
+		data[pixel * 4] = r
+		data[pixel * 4 + 1] = g
+		data[pixel * 4 + 2] = b
+		data[pixel * 4 + 3] = 255
+	return data
+
+func _run():
+	for disabled in [Probe.new(false, true, []), Probe.new(true, false, []),
+			Probe.new(true, true, ["--nf-no-color-probe"])]:
+		assert(disabled.tick(1000, true).is_empty())
+	var probe = Probe.new(true, true, [])
+	assert(probe.tick(0, false).is_empty() and not probe.started)
+	assert(probe.tick(1000, true).request)
+	assert(probe.tick(1999, true).is_empty(), "Never issue overlapping or faster requests")
+	assert(probe.observe(PackedByteArray(), 1999, {}).is_empty())
+	var pixels := _pixels(192, 192, 192)
+	# A bright coloured border is excluded from the fixed central ROI.
+	for x in range(32):
+		pixels[x * 4] = 255
+		pixels[x * 4 + 1] = 0
+	var result: Dictionary = probe.observe(pixels, 2000, {"streaming": true,
+		"stream_width": 2560, "source_name": "DO_NOT_LOG", "frame_index": 99,
+		"picture_temperature": -8, "picture_tint": 2})
+	assert(result.mean_rgb == [192.0, 192.0, 192.0])
+	assert(result.min_rgb == [192, 192, 192] and result.max_rgb == [192, 192, 192])
+	assert(result.mean_r_minus_g == 0.0 and result.mean_b_minus_g == 0.0)
+	assert(result.max_abs_channel_delta == 0 and not result.frame_token_bound and not result.photon_verified)
+	assert(result.stage == "left_eye_ambient_blit" and result.sample_sequence == 1)
+	assert(result.state_at_observation == {"streaming": true, "stream_width": 2560,
+		"picture_temperature": -8, "picture_tint": 2})
+	assert(not JSON.stringify(result).contains("DO_NOT_LOG"))
+	assert(probe.observe(pixels, 2001, {}).is_empty(), "One log per pending request")
+	assert(probe.tick(2001, true).request)
+	assert(probe.observe(pixels, 2999, {}).is_empty(), "Logs also cannot exceed one per second")
+	result = probe.observe(_pixels(194, 192, 184), 3000, {})
+	assert(result.mean_r_minus_g == 2 and result.mean_b_minus_g == -8 and result.max_abs_channel_delta == 8)
+	assert(probe.tick(3001, false).event == "temporarily_not_ready")
+	assert(not probe.finished and probe.tick(3002, false).is_empty())
+	assert(probe.tick(4001, true).event == "ready_again")
+	assert(probe.tick(4002, false, false).reason == "transport_disconnected")
+	assert(probe.tick(4001, true).is_empty(), "Reconnect cannot restart this budget")
+	probe = Probe.new(true, true, [])
+	for index in range(120):
+		var time_ms := index * 1000
+		assert(probe.tick(time_ms, true).request)
+		assert(probe.observe(pixels, time_ms, {}).sample_sequence == index + 1)
+	assert(probe.tick(120000, true).reason == "budget")
+	assert(probe.samples == 120 and probe.requests == 120)
+	assert(probe.observe(pixels, 121000, {}).is_empty())
+	probe = Probe.new(true, true, [])
+	assert(probe.tick(0, true).request)
+	assert(probe.tick(2999, true).is_empty())
+	assert(probe.tick(3000, true).request, "Missing readbacks may retry after a bounded wait")
+	assert(probe.tick(150000, true).reason == "timeout")
+	assert(probe.tick(200000, true).is_empty())
+	var request := {"version": 1, "action": "arm", "nonce": "0123456789abcdef0123456789abcdef",
+		"instance_nonce": probe.instance_nonce, "pid": 123, "expires_unix_ms": 1020000}
+	assert(probe.rearm(request, 1000000, 200000, 123).event == "armed")
+	assert(not probe.started and not probe.finished and probe.samples == 0)
+	assert(probe.tick(200000, false).is_empty(), "Arm does not spend the stream budget while waiting")
+	assert(probe.tick(201000, true).event == "started")
+	assert(probe.observe(pixels, 201000, {}).run_nonce == request.nonce)
+	assert(probe.rearm(request, 1000001, 201001, 123).event == "arm_duplicate")
+	assert(probe.samples == 1 and probe.requests == 1, "Duplicate nonce cannot reset counters")
+	var wrong := request.duplicate()
+	wrong.nonce = "fedcba9876543210fedcba9876543210"
+	wrong.instance_nonce = "00000000000000000000000000000000"
+	assert(probe.rearm(wrong, 1000001, 201001, 123).event == "arm_refused")
+	wrong = request.duplicate()
+	wrong.pid = 124
+	assert(probe.rearm(wrong, 1000001, 201001, 123).event == "arm_refused")
+	wrong = request.duplicate()
+	wrong.unexpected = "no"
+	assert(probe.rearm(wrong, 1000001, 201001, 123).event == "arm_refused")
+	wrong = request.duplicate()
+	wrong.expires_unix_ms = 1000000
+	assert(probe.rearm(wrong, 1000001, 201001, 123).event == "arm_refused")
+	wrong.expires_unix_ms = 1030002
+	assert(probe.rearm(wrong, 1000001, 201001, 123).event == "arm_refused")
+	for index in range(1, 4):
+		request.nonce = ("rearm%d" % index).sha256_text().substr(0, 32)
+		assert(probe.rearm(request, 1000001, 201001, 123).event == "armed")
+	request.nonce = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
+	assert(probe.rearm(request, 1000001, 201001, 123).reason == "process_rearm_budget")
+	assert(probe.tick(222000, true).reason == "arm_expired")
+	assert(probe.status(123).rearms_used == 4)
+	assert(probe.status(123).end_reason == "arm_expired", "A later status read preserves why sampling ended")
+	# Exercise the actual manager hook: no first-frame means no budget, and
+	# a diagnostic never steals or duplicates the ordinary ambient delivery.
+	var app := FakeApp.new()
+	app.settings.host.pc_profile_resolution = Vector2i(2560, 720)
+	var manager := NativeXrRendererManager.new(app)
+	var renderer := RecordedAmbient.new()
+	manager.renderer = renderer
+	manager.active = true
+	manager.stream_started = true
+	manager._last_size = Vector2i(2560, 720)
+	manager._process_ambient_sample()
+	assert(not manager._color_probe.started and renderer.requests == 0)
+	renderer.ready = true
+	manager._process_ambient_sample()
+	assert(manager._color_probe.started and renderer.requests == 1)
+	assert(app.logs.size() == 1 and app.logs[0].contains('"event":"started"'))
+	renderer.pixels = pixels
+	var before: int = renderer.consumes
+	manager._process_ambient_sample()
+	assert(renderer.consumes == before + 1 and app.comp.received == [pixels])
+	assert(app.logs.size() == 2 and app.logs[1].contains('"sample_sequence":1'))
+	assert(app.logs[1].begins_with("[Quest3DColorProbe] "))
+	renderer.ready = false
+	manager._process_ambient_sample()
+	assert(not manager._color_probe.finished, "Temporary native readiness is not a disconnect")
+	renderer.ready = true
+	manager._process_ambient_sample()
+	app.is_streaming = false
+	manager._process_ambient_sample()
+	assert(manager._color_probe.finished)
+	app.is_streaming = true
+	manager._process_ambient_sample()
+	assert(renderer.requests == 1)
+	# A tiny app-private request can rearm without reconnecting or touching UI.
+	var status_text := FileAccess.get_file_as_string(manager.COLOR_PROBE_STATUS)
+	var status: Dictionary = JSON.parse_string(status_text)
+	assert(status.instance_nonce == manager._color_probe.instance_nonce)
+	var file := FileAccess.open(manager.COLOR_PROBE_REQUEST, FileAccess.WRITE)
+	file.store_string(JSON.stringify({"version": 1, "action": "arm", "nonce": "abababababababababababababababab",
+		"instance_nonce": status.instance_nonce, "pid": OS.get_process_id(),
+		"expires_unix_ms": int(Time.get_unix_time_from_system() * 1000.0) + 20000}))
+	file.close()
+	manager._color_probe_poll_ms = -1000
+	manager._process_ambient_sample()
+	assert(not manager._color_probe.finished and manager._color_probe.run_nonce == "abababababababababababababababab")
+	assert(not FileAccess.file_exists(manager.COLOR_PROBE_REQUEST))
+	assert(app.logs[-1].contains('"event":"armed"'))
+	file = FileAccess.open(manager.COLOR_PROBE_REQUEST, FileAccess.WRITE)
+	file.store_string("x".repeat(513))
+	file.close()
+	manager._color_probe_poll_ms = -1000
+	manager._process_ambient_sample()
+	assert(app.logs[-1].contains('"event":"arm_refused"'))
+	assert(not FileAccess.file_exists(manager.COLOR_PROBE_REQUEST))
+	app.free()
+	print("PC colour probe PASS: debug/PC gates, 1Hz, 120 budget, timeout, first-stream scope, central RGB and no frame claim")
+	quit()
diff --git a/test/test_pc_control.gd b/test/test_pc_control.gd
new file mode 100644
--- /dev/null
+++ b/test/test_pc_control.gd
@@ -0,0 +1,80 @@
+extends SceneTree
+
+class FakeComputerManager extends RefCounted:
+	var requests: Array = []
+	func request_pc_control(host: int, body: Dictionary, _callback: Callable):
+		requests.append({"host": host, "body": body.duplicate(true)})
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	var sample := {"version": 1, "session_id": "test-session", "revision": 0,
+		"last_seq": 0, "requested_mode": "2d", "effective_mode": "2d", "disparity": 12.0,
+		"eye_width": 1280, "publisher_age_ms": 1.0, "applied_request": "", "rejected_request": "",
+		"stream_epoch": "18446744073709551615"}
+	assert(PcControl.valid_status(sample))
+	# The real producer returns JSON null for these fields until there is an
+	# acknowledgement or fallback. String(null) is not a valid Godot constructor.
+	var nullable := sample.duplicate()
+	for field in ["applied_request", "rejected_request", "fallback_reason"]:
+		nullable[field] = null
+		for value in [false, 123, {}, []]:
+			var bad := sample.duplicate()
+			bad[field] = value
+			assert(not PcControl.valid_status(bad), "Malformed optional text must not be interpreted as an acknowledgement")
+	assert(PcControl.valid_status(nullable))
+	for value in ["3", {}, true, NAN, -1, 4294967296, 0.5]:
+		var bad := sample.duplicate()
+		bad.revision = value
+		assert(not PcControl.valid_status(bad), "Reject malformed revision without interpreting it")
+	for value in ["nan", {}, true, NAN, -1, 52]:
+		var bad := sample.duplicate()
+		bad.disparity = value
+		assert(not PcControl.valid_status(bad), "Reject malformed or excessive disparity")
+	var app = load("res://main.gd").new()
+	var cm := FakeComputerManager.new()
+	app.stream_backend = StreamBackend.new(null)
+	app.stream_backend.set_computer_manager(cm)
+	var control := PcControl.new(app)
+	control._host = 1
+	control._generation = 2
+	control._busy = true
+	control._on_status(200, sample, "", 1)
+	assert(control.status.is_empty() and control._busy, "Ignore old host callbacks")
+	control._on_status(200, sample, "", 2)
+	assert(control.available())
+	control._on_status(200, nullable, "", 2)
+	assert(control.available() and control.message.is_empty(), "Normal JSON null does not break status polling")
+	control.set_mode("3d")
+	assert(cm.requests.size() == 1)
+	var first: Dictionary = cm.requests[0].body
+	assert(String(first.request_id).length() == 32 and first.seq == 1)
+	control._on_status(200, nullable, "", 2)
+	assert(not control.pending.is_empty(), "Null acknowledgement must keep the real request pending")
+	control._on_command(-1, {}, "timeout", 2)
+	assert(not control.pending.is_empty() and control._can_retry)
+	control._on_status(200, sample, "", 2)
+	control.set_mode("3d")
+	assert(cm.requests.size() == 2 and cm.requests[1].body == first, "Retry unknown result with identical request ID and body")
+	control._on_command(202, {"outcome": "pending"}, "", 2)
+	assert(not control.pending.is_empty(), "HTTP accepted does not mean applied")
+	control._on_status(200, sample, "", 2)
+	control.set_mode("2d")
+	assert(cm.requests.size() == 3)
+	assert(cm.requests[2].body.seq == 2 and cm.requests[2].body.mode == "2d", "2D supersedes waiting 3D with a higher sequence")
+	control._on_command(202, {}, "", 2)
+	var applied := sample.duplicate()
+	applied.applied_request = cm.requests[2].body.request_id
+	applied.revision = 1
+	applied.last_seq = 2
+	control._on_status(200, applied, "", 2)
+	assert(control.pending.is_empty(), "Only PC frame acknowledgement clears pending")
+	assert(control.status.stream_epoch == "18446744073709551615", "Keep 64-bit metadata as a decimal string")
+	control._on_command(400, {}, "", 2)
+	assert(control.message == "PC control: 400", "An HTTP error with no text payload is displayed without String(number)")
+	control._status_at = Time.get_ticks_msec() - 3000
+	assert(not control.available(), "Stale publisher state disables controls")
+	app.free()
+	print("PC control tests passed: validation, stale callback, unknown retry, 2D supersede, actual acknowledgement")
+	quit()
diff --git a/test/test_pc_full_sbs.gd b/test/test_pc_full_sbs.gd
new file mode 100644
--- /dev/null
+++ b/test/test_pc_full_sbs.gd
@@ -0,0 +1,92 @@
+extends SceneTree
+
+class ProfileStream extends StreamManager:
+	var resized := Vector2i.ZERO
+	func resize_stream_viewport(w: int, h: int):
+		resized = Vector2i(w, h)
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	assert(int(ProjectSettings.get_setting("rendering/driver/threads/thread_model")) == 1,
+		"The submission observer requires one Safe-model Godot process/render loop")
+	_test_startup_before_composition()
+	_test_authenticated_profile()
+	var app = load("res://main.gd").new()
+	var controller := SettingsController.new(app)
+	app.settings_controller = controller
+	app.device_is_quest2 = true
+	assert(controller.get_stereo_mode() == 0)
+	assert(app.settings.host.stream_fps == 30)
+	assert(app.settings.codec_preference == 0, "Start with the H.264 SDR measurement baseline")
+	assert(controller.requested_display_refresh_rate() == 72.0)
+	assert(app.compute_requested_resolution() == Vector2i(1920, 1080))
+	app.settings.host.sbs_mode = 3
+	assert(controller.get_stereo_mode() == 1, "Full-SBS must use eye splitting, never an AI warp mode")
+	assert(app.compute_requested_resolution() == Vector2i(2560, 720), "Quest 2 cap must preserve this combined format")
+	var saved := ConfigFile.new()
+	SettingsPersistence.write_host(saved, "host", app.settings.host)
+	var restored := HostSettings.new()
+	SettingsPersistence.read_host(saved, "host", restored, [30, 60], [100], 7, 5)
+	assert(restored.sbs_mode == 3, "Full-SBS must survive restart and host switching")
+	saved.set_value("host", "fps", 60)
+	SettingsPersistence.read_host(saved, "host", restored, [30, 60], [100], 7, 5)
+	assert(restored.stream_fps == 60, "Keep the user's saved stream rate during update")
+	app.settings.host.sbs_mode = 0
+	app.settings.host.ai_3d_speed = 3
+	assert(controller.get_stereo_mode() == 0, "Old saved AI settings must not reactivate headset inference")
+	app.free()
+	print("PC Full-SBS session format tests passed")
+	quit()
+
+func _test_authenticated_profile():
+	var app = load("res://main.gd").new()
+	app.stream_backend = StreamBackend.new(null)
+	app.settings_controller = SettingsController.new(app)
+	app.ui_controller = UIController.new(app)
+	var manager := ProfileStream.new(app)
+	var profile := {"quest3d_profile_version": 1, "quest3d_layout": "full_sbs", "width": 3200, "height": 900}
+	assert(manager._apply_pc_profile(profile))
+	assert(app.stream_backend._pc_frame_input_required, "PC profile blocks all legacy untagged input")
+	assert(manager.resized == Vector2i(3200, 900), "Use the authenticated canvas size, not a fixed preset")
+	assert(app.settings.host.sbs_mode == 0, "Auto profile must not overwrite saved manual format")
+	assert(app.settings.host.effective_sbs_mode() == 3)
+	assert(app.settings_controller.get_stereo_mode() == 1)
+	assert(app.compute_requested_resolution() == Vector2i(3200, 900))
+	var saved := ConfigFile.new()
+	SettingsPersistence.write_host(saved, "ordinary-host", app.settings.host)
+	var restored := HostSettings.new()
+	SettingsPersistence.read_host(saved, "ordinary-host", restored, [30, 60], [100], 7, 5)
+	assert(restored.sbs_mode == 0 and restored.pc_profile_resolution == Vector2i.ZERO)
+	assert(manager._apply_pc_profile({}), "Ordinary Sunshine needs no capability")
+	assert(not app.stream_backend._pc_frame_input_required)
+	assert(app.settings.host.effective_sbs_mode() == 0)
+	assert(app.compute_requested_resolution() == Vector2i(1920, 1080))
+	profile.width = 8192
+	assert(not manager._apply_pc_profile(profile), "Reject an oversized H.264 canvas instead of scaling SBS incorrectly")
+	profile.width = 2561
+	assert(not manager._apply_pc_profile(profile))
+	app.free()
+
+func _test_startup_before_composition():
+	# Reproduce welcome layout and per-frame cursor calls before delayed XR setup.
+	var app = load("res://main.gd").new()
+	var screen = load("res://src/vr_screen.tscn").instantiate()
+	root.add_child(screen)
+	screen.curvature = 0
+	screen.setup(app)
+	screen.create_corner_handles()
+	app.screen_registry.initialize(screen)
+	app.screen_manager = ScreenManager.new(app)
+	app.ui_controller = UIController.new(app)
+	app.settings_controller = SettingsController.new(app)
+	assert(app.comp == null)
+	app.settings_controller.apply_screen_layout(ScreenLayout.single(Vector2i(1920, 1080)))
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, 16.0 / 9.0))
+	app._update_cursor_layer()
+	app.settings.host.sbs_mode = 3
+	app.screen_manager.resize_screen_to_aspect(2560, 720)
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, 16.0 / 9.0))
+	screen.free()
+	app.free()
diff --git a/test/test_pc_pointer.gd b/test/test_pc_pointer.gd
new file mode 100644
--- /dev/null
+++ b/test/test_pc_pointer.gd
@@ -0,0 +1,31 @@
+extends SceneTree
+
+var calls := 0
+
+func _query() -> Dictionary:
+	calls += 1
+	return {"valid": true, "u": 0.125, "v": 0.75, "frame_index": 4294967295,
+		"panel_generation": 7, "input_enabled": true, "network_enabled": true}
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	for role in [&"panel", &"grab_bar", &"corner", &"unknown"]:
+		assert(not PcPointerProbe.sample(true, false, false, false, role, false, _query).valid)
+	assert(not PcPointerProbe.sample(true, false, false, false, &"screen", false, _query).valid)
+	assert(not PcPointerProbe.sample(false, false, false, false, &"screen", true, _query).valid)
+	assert(not PcPointerProbe.sample(true, true, false, false, &"screen", true, _query).valid)
+	assert(not PcPointerProbe.sample(true, false, true, false, &"screen", true, _query).valid)
+	assert(not PcPointerProbe.sample(true, false, false, true, &"screen", true, _query).valid)
+	assert(calls == 0, "Local UI/occluders/manipulation never even query remote geometry")
+	for role in [&"screen", &"none"]:
+		var result := PcPointerProbe.sample(true, false, false, false, role, true, _query)
+		assert(result.valid and result.u == 0.125 and result.v == 0.75)
+		assert(result.frame_index == 4294967295 and result.panel_generation == 7)
+		assert(not result.input_enabled and not result.network_enabled and not result.photon_verified)
+	assert(calls == 2)
+	var stale := func(): return PcPointerProbe.rejected("geometry_changed")
+	assert(not PcPointerProbe.sample(true, false, false, false, &"none", false, stale).valid)
+	print("PC pointer routing: local UI gates, exact candidate, no input/network PASS")
+	quit(0)
diff --git a/test/test_pc_pointer_control.gd b/test/test_pc_pointer_control.gd
new file mode 100644
--- /dev/null
+++ b/test/test_pc_pointer_control.gd
@@ -0,0 +1,302 @@
+extends SceneTree
+
+var now := 1000000
+var fetches: Array = []
+var posts: Array = []
+var candidate: Dictionary
+var lookup: Dictionary
+var take_valid := true
+var take_calls := 0
+var issued := 0
+var arms: Array = []
+var uncertain: Array = []
+
+class FakeInput extends RefCounted:
+	var calls := 0
+	func send_mouse_position(_x, _y, _w, _h): calls += 1
+	func send_mouse_move(_x, _y): calls += 1
+	func send_mouse_button_pressed(_b): calls += 1
+	func send_mouse_button_released(_b): calls += 1
+	func send_keyboard_event(_k, _a, _m): calls += 1
+	func send_scroll(_c): calls += 1
+	func send_multi_controller_event(_d, _m, _b, _lt, _rt, _lx, _ly, _rx, _ry): calls += 1
+	func send_controller_arrival(_d, _m, _t, _b, _c): calls += 1
+class FakeV2 extends Node:
+	var bridge := FakeInput.new()
+	func get_input_bridge(): return bridge
+
+func _init(): _run.call_deferred()
+func _clock(): return now
+func _fetch(host, epoch, frame, callback): fetches.append([host, epoch, frame, callback])
+func _post(host, body, callback): posts.append([host, body.duplicate(true), callback])
+func _arm(host, value): arms.append([host, value])
+func _uncertain(host, epoch): uncertain.append([host, epoch])
+func _take(_ticket):
+	take_calls += 1
+	return candidate.duplicate(true) if take_valid else {"valid": false}
+func _issue():
+	issued += 1
+	return candidate.duplicate(true)
+func _controller() -> PcPointerControl:
+	var control := PcPointerControl.new()
+	control.now_us = _clock
+	control.configure(4, _fetch, _post, _take, _arm, _uncertain)
+	control.set_enabled(true)
+	control.route(false, _issue, false, false)
+	return control
+
+func _run():
+	var epoch := "a".repeat(32)
+	candidate = {"valid": true, "ticket": 1, "u": 0.125, "v": 0.75, "encoded_eye": 1,
+		"submission": {"transport_epoch": epoch, "frame_index": 4294967295,
+		"decoder_epoch": 9007199254740993, "lease_serial": 8, "submission_cycle": 9,
+		"panel_generation": 10, "mapping_generation": 11, "pixel_latch_age_us": 120000,
+		"submission_age_us": 12000, "eye_width": 1280, "eye_height": 720}}
+	lookup = {"version": 1, "transport_epoch": epoch, "frame_index": 4294967295,
+		"frame_geometry_token": "b".repeat(32), "source_id": "c".repeat(32), "layout_id": "d".repeat(32),
+		"source_generation": "18446744073709551615", "geometry_revision": "42", "publisher_epoch": "55", "publisher_frame_id": "66",
+		"layout": "full_sbs", "mode": "2d", "flags": 1, "host_remaining_ttl_ms": 400, "input_enabled": false, "last_input_seq": 99,
+		"source_name": "Bridge v2 source", "source_kind": "unspecified_v2", "host_name": "PC", "paired_client_name": "Quest",
+		"source_rect": {"left": -1920, "top": 0, "width": 1920, "height": 1080},
+		"content_rect": {"left": 0, "top": 0, "width": 1280, "height": 720}, "eye_size": {"width": 1280, "height": 720}}
+	assert(PcPointerWire.valid_frame(lookup, candidate))
+	for value in ["18446744073709551616", "01", "-1", "1e2", 42, true, ""]:
+		assert(not PcPointerWire.decimal64(value))
+	for key in ["frame_index", "transport_epoch", "eye_size", "content_rect", "source_generation", "host_remaining_ttl_ms"]:
+		var bad := lookup.duplicate(true)
+		bad[key] = null
+		assert(not PcPointerWire.valid_frame(bad, candidate))
+	var body := PcPointerWire.payload(candidate, lookup, "e".repeat(32), 100, "click", "left")
+	assert(body.u == 0.125 and body.v == 0.75 and body.frame_index == 4294967295)
+	assert(body.decoder_epoch == "9007199254740993" and body.source_generation == "18446744073709551615")
+	assert(body.dry_run and body.button == "left")
+	for value in [NAN, INF, -0.01, 1.01, true, "0.5"]:
+		var bad := candidate.duplicate(true)
+		bad.u = value
+		assert(PcPointerWire.payload(bad, lookup, "e".repeat(32), 100, "move", "").is_empty())
+	var control := _controller()
+	control.route(false, _issue, true, false)
+	control.route(true, _issue, true, false)
+	assert(issued == 0, "Holding trigger while leaving UI cannot create a new desktop click")
+	control.route(true, _issue, false, true)
+	assert(fetches.size() == 1 and posts.is_empty())
+	assert(fetches[-1][2] == 4294967295)
+	now += 50000
+	fetches[-1][3].call(200, lookup, "")
+	assert(posts.size() == 1 and posts[-1][1].button == "right" and posts[-1][1].input_seq == 100)
+	assert(posts[-1][1].frame_index == 4294967295 and posts[-1][1].u == 0.125)
+	var sent: Dictionary = posts[-1][1]
+	posts[-1][2].call(200, {"outcome": "validated_dry_run", "request_id": sent.request_id,
+		"input_seq": sent.input_seq, "applied": false, "input_enabled": false}, "")
+	assert(not control.last_result.is_empty())
+	control.request(candidate, "click", "left")
+	var old_callback: Callable = fetches[-1][3]
+	control.configure(-1, Callable(), Callable(), Callable())
+	old_callback.call(200, lookup, "")
+	assert(posts.size() == 1, "Host switch cancels the old lookup")
+	control = _controller()
+	control.request(candidate, "click", "left")
+	take_valid = false
+	fetches[-1][3].call(200, lookup, "")
+	assert(posts.size() == 1, "Native display invalidation rejects request before POST")
+	take_valid = true
+	control.request(candidate, "click", "left")
+	now += 400001
+	fetches[-1][3].call(200, lookup, "")
+	assert(posts.size() == 1, "Lookup roundtrip cannot extend host TTL")
+	control.request(candidate, "click", "left")
+	var swapped := lookup.duplicate(true)
+	swapped.frame_index = 0
+	fetches[-1][3].call(200, swapped, "")
+	assert(posts.size() == 1, "Never join a newer frame's metadata to old UV")
+	control.request(candidate, "click", "left")
+	var exhausted := lookup.duplicate(true)
+	exhausted.last_input_seq = 4294967295
+	fetches[-1][3].call(200, exhausted, "")
+	assert(posts.size() == 1, "Sequence wrap requires new transport")
+	control.request(candidate, "move", "")
+	fetches[-1][3].call(200, lookup, "")
+	assert(posts.size() == 2 and not posts[-1][1].has("button"))
+	var wrong: Dictionary = posts[-1][1]
+	posts[-1][2].call(200, {"outcome": "validated_dry_run", "request_id": "f".repeat(32),
+		"input_seq": wrong.input_seq, "applied": false, "input_enabled": false}, "")
+	assert(control.last_result.is_empty(), "Another request's acknowledgement cannot complete this action")
+	control.request(candidate, "click", "left")
+	var timed_out_callback: Callable = fetches[-1][3]
+	now += 500001
+	control.configure(4, _fetch, _post, _take, _arm, _uncertain)
+	timed_out_callback.call(200, lookup, "")
+	assert(posts.size() == 2, "Expired pending request is not automatically replayed")
+	_test_actual()
+	_test_legacy_gate()
+	print("PC pointer control: immutable frame join, uint64, expiry, native invalidation, UI edges, legacy gate PASS")
+	quit(0)
+
+func _receipt(body: Dictionary, outcome := "applied", count := 3) -> Dictionary:
+	return {"request_id": body.request_id, "input_seq": body.input_seq, "outcome": outcome,
+		"applied": outcome == "applied", "input_enabled": outcome == "applied",
+		"ack_scope": "win32_input_inserted", "events_expected": 3, "events_inserted": count,
+		"release_attempted": false, "release_inserted": 0, "button_state_unknown": false,
+		"retry_allowed": false, "win32_error": 0}
+
+func _actual() -> PcPointerControl:
+	var control := _controller()
+	control.set_actual_input(true)
+	control.route(false, _issue, false, false)
+	return control
+
+func _test_actual():
+	var allowed := lookup.duplicate(true)
+	allowed.input_enabled = true
+	allowed.source_kind = "monitor"
+	allowed.flags = 15
+	assert(PcPointerWire.valid_frame(allowed, candidate) and PcPointerWire.actual_allowed(allowed))
+	assert(PcPointerWire.actual_request_id("a".repeat(32), 100) == ("a".repeat(32) + ":100").sha256_text().left(32))
+	for change in [{"input_enabled": false}, {"input_enabled": 1}, {"source_kind": "window"},
+		{"source_kind": "video"}, {"source_kind": "unspecified_v2"}, {"mode": "3d"}, {"flags": 3}, {"flags": 9}]:
+		var denied := allowed.duplicate(true)
+		denied.merge(change, true)
+		assert(not PcPointerWire.actual_allowed(denied))
+		var blocked := _actual()
+		var count := posts.size()
+		blocked.request(candidate, "click", "left")
+		fetches[-1][3].call(200, denied, "")
+		assert(posts.size() == count, "Actual source gate must fail before POST")
+	var control := _actual()
+	control.set_actual_input(true)
+	var before := fetches.size()
+	control.route(true, _issue, true, false)
+	control.route(true, _issue, true, false)
+	assert(fetches.size() == before, "Opt-in while held requires a new release and press")
+	control.route(true, _issue, false, false)
+	control.route(true, _issue, true, false)
+	fetches[-1][3].call(200, allowed, "")
+	var body: Dictionary = posts[-1][1]
+	assert(not body.dry_run and body.request_id == PcPointerWire.actual_request_id(body.transport_epoch, body.input_seq))
+	assert(body.u == candidate.u and body.frame_index == candidate.submission.frame_index)
+	var receipt := _receipt(body)
+	for key in ["events_inserted", "events_expected", "retry_allowed", "ack_scope", "button_state_unknown", "request_id"]:
+		var bad := receipt.duplicate(true)
+		bad[key] = null
+		assert(PcPointerWire.actual_result(200, bad, body) == "unknown")
+	posts[-1][2].call(200, receipt, "")
+	assert(control.actual_input and control.last_result.response.applied)
+	# OFF during GET cannot send, and an actual sent request cannot become an OFF-success.
+	control.request(candidate, "click", "left")
+	var callback: Callable = fetches[-1][3]
+	var count := posts.size()
+	control.set_actual_input(false)
+	callback.call(200, allowed, "")
+	assert(posts.size() == count and not arms[-1][1])
+	control = _actual()
+	control.request(candidate, "click", "left")
+	fetches[-1][3].call(200, allowed, "")
+	callback = posts[-1][2]
+	body = posts[-1][1]
+	control.set_actual_input(false)
+	callback.call(200, _receipt(body), "")
+	assert(not control.actual_input and control.message.contains("unknown"))
+	# Source/mode changes and native geometry changes invalidate the same pending ticket.
+	for geometry in [false, true]:
+		control = _actual()
+		control.observe_context("original", false)
+		control.request(candidate, "click", "left")
+		callback = fetches[-1][3]
+		count = posts.size()
+		if geometry:
+			var changed := candidate.duplicate(true)
+			changed.submission.mapping_generation += 1
+			control.observe_submission(changed)
+		else:
+			control.observe_context("changed-source-mode-session", false)
+		callback.call(200, allowed, "")
+		assert(posts.size() == count)
+	# A newer ordinary frame is not a new click; retain original UV + metadata.
+	control = _actual()
+	control.request(candidate, "click", "left")
+	var newer := candidate.duplicate(true)
+	newer.submission.frame_index = 7
+	control.observe_submission(newer)
+	fetches[-1][3].call(200, allowed, "")
+	body = posts[-1][1]
+	assert(body.frame_index == candidate.submission.frame_index)
+	posts[-1][2].call(200, _receipt(body, "partial", 2), "")
+	assert(not control.actual_input and control.message.contains("partial"))
+	count = posts.size()
+	control.set_actual_input(true)
+	assert(not control.actual_input, "Uncertain transport requires reconnect, not another whole click")
+	control.route(true, _issue, true, false)
+	assert(posts.size() == count)
+	assert(PcPointerWire.actual_result(200, _receipt(body, "not_applied", 0), body) == "not_applied")
+	assert(PcPointerWire.actual_result(409, {"error": "stale_scope", "applied": false, "input_enabled": false}, body) == "refused")
+	assert(PcPointerWire.actual_result(-1, {}, body) == "unknown")
+	assert(PcPointerWire.actual_result(423, {"error": "input_disabled", "applied": false, "input_enabled": false}, body) == "refused")
+	assert(PcPointerWire.actual_result(422, {"error": "outside_content", "applied": false, "input_enabled": false}, body) == "refused")
+	# Reconfiguring callbacks/host must not turn an unknown old nonce into a valid one.
+	control.configure(-1, Callable(), Callable(), Callable())
+	control.configure(4, _fetch, _post, _take, _arm, _uncertain)
+	control.set_actual_input(true) # No known current nonce until the candidate arrives.
+	count = fetches.size()
+	control.request(candidate, "click", "left")
+	assert(not control.actual_input and fetches.size() == count and not uncertain.is_empty())
+	control = _actual()
+	control.observe_submission(candidate)
+	var restarted := candidate.duplicate(true)
+	restarted.submission.transport_epoch = "f".repeat(32)
+	count = fetches.size()
+	control.request(restarted, "click", "left")
+	assert(not control.actual_input and fetches.size() == count, "Restart between probe and issue requires a new opt-in")
+	control.observe_submission(restarted)
+	control.set_actual_input(true)
+	assert(control.actual_input)
+	_test_move_click_retention(allowed)
+	print("PC actual input: explicit opt-in, exact source gate, deterministic ID, terminal receipts, no gesture replay PASS")
+
+func _test_move_click_retention(allowed: Dictionary):
+	var control := _actual()
+	control.request(candidate, "move", "")
+	var old_get: Callable = fetches[-1][3]
+	control.route(true, _issue, true, false)
+	var clicked_get: Callable = fetches[-1][3]
+	var before := posts.size()
+	old_get.call(200, allowed, "")
+	assert(posts.size() == before, "Click edge cancels a GET-only move")
+	clicked_get.call(200, allowed, "")
+	assert(posts[-1][1].operation == "click")
+	for expire in [false, true]:
+		control = _actual()
+		control.request(candidate, "move", "")
+		fetches[-1][3].call(200, allowed, "")
+		var move: Dictionary = posts[-1][1]
+		var done: Callable = posts[-1][2]
+		before = fetches.size()
+		control.route(true, _issue, true, false)
+		assert(fetches.size() == before, "An edge during sent move retains one immutable ticket")
+		if expire: now += 250001
+		var receipt := _receipt(move)
+		receipt.events_expected = 1
+		receipt.events_inserted = 1
+		done.call(200, receipt, "")
+		if expire:
+			assert(fetches.size() == before and control.message.contains("expired"))
+		else:
+			assert(fetches.size() == before + 1)
+			fetches[-1][3].call(200, allowed, "")
+			assert(posts[-1][1].operation == "click" and posts[-1][1].frame_index == candidate.submission.frame_index)
+	print("Move/click overlap: cancel unsent move or retain original click with expiry PASS")
+
+func _test_legacy_gate():
+	var v2 := FakeV2.new()
+	var backend := StreamBackend.new(v2)
+	for blocked in [true, false]:
+		backend.set_pc_frame_input_required(blocked)
+		backend.send_mouse_position_event(1, 2, 1280, 720)
+		backend.send_mouse_move_event(1, 2)
+		backend.send_mouse_button_event(7, 1)
+		backend.send_mouse_button_event(8, 1)
+		backend.send_keyboard_event(1, 1, 0)
+		backend.send_scroll_event(1)
+		backend.send_multi_controller_event(0, 0, 0, 0, 0, 0, 0, 0, 0)
+		backend.send_controller_arrival(0, 0, 0, 0, 0)
+		assert(v2.bridge.calls == (0 if blocked else 8))
+	v2.free()
diff --git a/test/test_pc_profile_bitrate.gd b/test/test_pc_profile_bitrate.gd
new file mode 100644
--- /dev/null
+++ b/test/test_pc_profile_bitrate.gd
@@ -0,0 +1,81 @@
+extends SceneTree
+
+class RecordedBackend extends StreamBackend:
+	var starts: Array[Dictionary] = []
+	func start_stream_v2(_host: String, _server: Dictionary, config: Dictionary, _disable_hw: bool = false):
+		starts.append(config.duplicate(true))
+
+class ProfileStream extends StreamManager:
+	var resized := Vector2i.ZERO
+	func resize_stream_viewport(w: int, h: int):
+		resized = Vector2i(w, h)
+
+func _init():
+	_run.call_deferred()
+
+func _response(width: int, height: int, fps: int, bitrate: int, pc: bool = true) -> Dictionary:
+	var reply := {"status": "success", "width": width, "height": height,
+		"fps": fps, "bitrate": bitrate, "server_codec_mode_support": 1,
+		"session_url": "rtsp://fixture.invalid", "ip": "fixture.invalid"}
+	if pc:
+		reply["quest3d_profile_version"] = 1
+		reply["quest3d_layout"] = "full_sbs"
+	return reply
+
+func _run():
+	var app = load("res://main.gd").new()
+	var backend := RecordedBackend.new(null)
+	app.stream_backend = backend
+	app.settings_controller = SettingsController.new(app)
+	app.ui_controller = UIController.new(app)
+	app.settings.host.bitrate_idx = -1
+	app.settings.host.sbs_mode = 0
+	app.settings.host.stream_fps = 30
+	app.display_refresh_rate = 72.0
+	var manager := ProfileStream.new(app)
+	var generation: int = app.session_lifecycle.arm_connect_timeout()
+	# Reproduce the real source ordering: no PC profile -> provisional saved
+	# 1920x1080 Auto -> native returns the authenticated 2560x720 profile.
+	assert(app.settings.host.pc_profile_resolution == Vector2i.ZERO)
+	assert(app.compute_requested_resolution(false) == Vector2i(1920, 1080))
+	var provisional: int = manager._auto_bitrate(1920, 1080)
+	assert(provisional == 10000)
+	manager._on_v2_launch_response(_response(2560, 720, 30, provisional), generation)
+	assert(backend.starts.size() == 1)
+	var config: Dictionary = backend.starts[-1]
+	assert(config.width == 2560 and config.height == 720)
+	assert(config.bitrate == 9000, "Auto must use the final combined canvas, not the saved 1920x1080 preset")
+	assert(config.fps == 30 and config.client_refresh_rate_x100 == 7200)
+	assert(manager.bitrate == config.bitrate)
+	# A later settings value must not replace the FPS already in launch options.
+	app.settings.host.stream_fps = 60
+	manager._on_v2_launch_response(_response(2560, 720, 30, provisional), generation)
+	assert(backend.starts[-1].fps == 30 and backend.starts[-1].bitrate == 9000)
+	manager._on_v2_launch_response(_response(2560, 720, 60, provisional), generation)
+	assert(backend.starts[-1].fps == 60 and backend.starts[-1].bitrate == 18000)
+	manager._on_v2_launch_response(_response(3840, 1080, 60, provisional), generation)
+	assert(backend.starts[-1].bitrate == 44000, "Other authenticated PC canvas dimensions use the same table")
+	# Manual bitrate retains the launch's already selected value.
+	app.settings.host.bitrate_idx = 3
+	manager._on_v2_launch_response(_response(2560, 720, 30, 20000), generation)
+	assert(backend.starts[-1].bitrate == 20000)
+	# Ordinary hosts preserve the existing uncapped/MiDaS Auto policy.
+	app.settings.host.bitrate_idx = -1
+	manager._on_v2_launch_response(_response(1280, 720, 30, 40000, false), generation)
+	assert(app.settings.host.pc_profile_resolution == Vector2i.ZERO)
+	assert(backend.starts[-1].bitrate == 40000)
+	# The localhost transport remains its existing dummy 5fps/500kbps stream.
+	manager.local_capture_mode = true
+	manager._on_v2_launch_response(_response(2560, 720, 60, 20000), generation)
+	assert(backend.starts[-1].fps == 5 and backend.starts[-1].bitrate == 500)
+	manager.local_capture_mode = false
+	# An old callback cannot resize, recalculate, or start a new transport.
+	var before: int = backend.starts.size()
+	app.session_lifecycle.cancel_connect_timeout()
+	manager._on_v2_launch_response(_response(3200, 900, 60, 10000), generation)
+	assert(backend.starts.size() == before and manager.resized == Vector2i(2560, 720))
+	assert(manager._auto_bitrate(640, 360, 30) == 1000)
+	assert(manager._auto_bitrate(8192, 8192, 207) == 120000, "Existing Auto bounds remain unchanged")
+	app.free()
+	print("PC Auto bitrate PASS: real launch callback, final canvas/FPS, XR separation, manual/local/ordinary preservation and retired callback")
+	quit()
diff --git a/test/test_picture_color.gd b/test/test_picture_color.gd
new file mode 100644
--- /dev/null
+++ b/test/test_picture_color.gd
@@ -0,0 +1,133 @@
+extends SceneTree
+
+class RecordedState extends StateManager:
+	var saves := 0
+	func save_host_state():
+		saves += 1
+
+class RecordedRenderer extends RefCounted:
+	var gains: Array[Vector3] = []
+	var grade: Vector3
+	func submit_frame(_fresh, _oes, _depth, _guide, _matrix, _distance, _width,
+			_locked, _separation, _swap, _passthrough, _fence, _mode, _revision,
+			_transfer, _convergence, brightness, contrast, gamma, _source, gain):
+		gains.append(gain)
+		grade = Vector3(brightness, contrast, gamma)
+
+class FrameBackend extends StreamBackend:
+	var source: RefCounted = RefCounted.new()
+	func get_oes_frame_source():
+		return source
+
+class FrameManager extends NativeXrRendererManager:
+	func refresh() -> void:
+		pass
+	func _process_stats_upload() -> void:
+		pass
+	func _process_ambient_sample() -> void:
+		pass
+	func _mode() -> int:
+		return 1
+
+func _init():
+	_run.call_deferred()
+
+func _read(config: ConfigFile, host: HostSettings, section: String):
+	SettingsPersistence.read_host(config, section, host, [30, 60], [100], 4, 8)
+
+func _run():
+	var config := ConfigFile.new()
+	var host := HostSettings.new()
+	# Old host config and an entirely new host must not inherit another tint.
+	host.picture_temperature = 20
+	host.picture_tint = -20
+	_read(config, host, "legacy")
+	assert(host.picture_temperature == 0 and host.picture_tint == 0)
+	assert(PictureColor.gain(0, 0) == Vector3.ONE)
+	host.picture_temperature = -12
+	host.picture_tint = 6
+	SettingsPersistence.write_host(config, "pc1", host)
+	host.picture_temperature = 8
+	host.picture_tint = -10
+	SettingsPersistence.write_host(config, "pc2", host)
+	var serialized := config.encode_to_text()
+	config = ConfigFile.new()
+	assert(config.parse(serialized) == OK)
+	_read(config, host, "pc1")
+	assert(host.picture_temperature == -12 and host.picture_tint == 6)
+	_read(config, host, "pc2")
+	assert(host.picture_temperature == 8 and host.picture_tint == -10)
+	for malformed in [null, "blue", true, [], {}, NAN, INF, -INF]:
+		config.set_value("bad", "picture_temperature", malformed)
+		config.set_value("bad", "picture_tint", malformed)
+		_read(config, host, "bad")
+		assert(host.picture_temperature == 0 and host.picture_tint == 0)
+	config.set_value("bad", "picture_temperature", 1e30)
+	config.set_value("bad", "picture_tint", -1e30)
+	_read(config, host, "bad")
+	assert(host.picture_temperature == 20 and host.picture_tint == -20)
+	for temperature in range(-20, 21):
+		for tint in range(-20, 21):
+			var gain := PictureColor.gain(temperature, tint)
+			for channel in range(3):
+				assert(gain[channel] >= 0.5 and gain[channel] <= 1.0)
+	var cooler := PictureColor.gain(-20, 0)
+	var warmer := PictureColor.gain(20, 0)
+	assert(cooler.z > cooler.x and warmer.x > warmer.z)
+	var greener := PictureColor.gain(0, -20)
+	var magenta := PictureColor.gain(0, 20)
+	assert(greener.y > greener.x and magenta.x > magenta.y and magenta.z > magenta.y)
+	var app = load("res://main.gd").new()
+	app.settings.brightness_pct = 10
+	app.settings.contrast_pct = 100
+	app.settings.gamma_pct = 100
+	app.settings_controller = SettingsController.new(app)
+	app.state_manager = RecordedState.new(app)
+	# Real controller and signal-bound UI. No XR calls while XR is inactive.
+	var tab := VBoxContainer.new()
+	var row := HBoxContainer.new()
+	row.name = "PictureRow2"
+	tab.add_child(row)
+	app.settings_controller.install_color_balance_controls(tab)
+	row.get_node("ColorCooler").pressed.emit()
+	assert(app.settings.host.picture_temperature == -2)
+	for repeat in range(30):
+		app.settings_controller.adjust_color_balance(-2, 2)
+	assert(app.settings.host.picture_temperature == -20 and app.settings.host.picture_tint == 20)
+	assert(row.get_node("ColorCooler").disabled)
+	assert(tab.get_node("PictureColorRow/ColorMagenta").disabled)
+	tab.get_node("PictureColorRow/ColorReset").pressed.emit()
+	assert(app.settings.host.picture_temperature == 0 and app.settings.host.picture_tint == 0)
+	assert(app.settings.brightness_pct == 10 and app.settings.contrast_pct == 100 and app.settings.gamma_pct == 100)
+	assert(tab.get_node("PictureColorRow/ColorReset").disabled)
+	assert(not row.get_node("ColorCooler").disabled)
+	assert(app.state_manager.saves == 32)
+	# A paused decoder emits no new frame. A color change still submits the
+	# retained source once with the actual controller values and existing B/C/G.
+	app.screen_registry.initialize(VRScreen.new())
+	app.stream_backend = FrameBackend.new(app)
+	var manager := FrameManager.new(app)
+	var renderer := RecordedRenderer.new()
+	manager.renderer = renderer
+	manager.active = true
