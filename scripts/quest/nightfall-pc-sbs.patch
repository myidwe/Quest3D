-
-    MA_ASSERT(pChannelMap != NULL);
-    MA_ASSERT(channels > 0);
-
-    for (iChannel = 0; iChannel < channels; ++iChannel) {
-        if (ma_is_spatial_channel_position(ma_channel_map_get_channel(pChannelMap, channels, iChannel))) {
