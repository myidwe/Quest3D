+TextureUploader::~TextureUploader() {
+    // cleanup() must be explicitly requested while a strong reference exists.
+    // The queued callable retains that reference. Never resurrect this object
+    // or enqueue raw this from its destructor; the GLES owner records an
+    // unconfirmed retirement if an owner violates that lifetime contract.
+}
