+        gles_timing_sum_transform_ms_ = 0.0;
+        gles_timing_sum_blit_ms_ = 0.0;
+        gles_timing_sum_fence_ms_ = 0.0;
+        gles_timing_sum_total_ms_ = 0.0;
+        gles_timing_count_ = 0;
+        gles_timing_blit_count_ = 0;
+    }
