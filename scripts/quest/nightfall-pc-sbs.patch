+void AudioRenderer::play_local_pcm(const float *data, size_t frames) {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (audio_backend_ && running_.load()) {
+        audio_backend_->write_pcm(data, frames);
+    }
+}
