--- /dev/null
+++ b/addons/nightfall-stream/vcpkg-overlay/moonlight-common-c/quest3d/AudioStartup.h
@@ -0,0 +1,142 @@
+// Pinned Quest3D audio startup observations. No detached notification tasks.
+// Owner calls are serialized by the Connection lifecycle; workers join before End.
+#pragma once
+
+#if defined(LC_WINDOWS)
+typedef SRWLOCK QA_MUTEX;
+#define QA_MUTEX_INIT SRWLOCK_INIT
+static void QaLock(QA_MUTEX* mutex) { AcquireSRWLockExclusive(mutex); }
+static void QaUnlock(QA_MUTEX* mutex) { ReleaseSRWLockExclusive(mutex); }
+#elif defined(LC_POSIX) && !defined(__WIIU__) && !defined(__3DS__)
+typedef pthread_mutex_t QA_MUTEX;
+#define QA_MUTEX_INIT PTHREAD_MUTEX_INITIALIZER
+static void QaLock(QA_MUTEX* mutex) { pthread_mutex_lock(mutex); }
+static void QaUnlock(QA_MUTEX* mutex) { pthread_mutex_unlock(mutex); }
+#else
+#error Quest3D startup observations require Windows or POSIX threads
+#endif
+
+typedef struct _QA_STARTUP {
+    QA_MUTEX stateMutex;
+    QA_MUTEX dispatchMutex;
+    uint64_t serial;
+    void* context;
+    AudioRendererStartupState callback;
+    uint32_t bits;
+    uint16_t localPort;
+    int firstError;
+    bool active;
+    bool fresh;
+} QA_STARTUP;
+
+static QA_STARTUP qaStartup = { .stateMutex = QA_MUTEX_INIT, .dispatchMutex = QA_MUTEX_INIT };
+
+// Notification dispatch is serialized separately from state access. Client code
+// never runs under stateMutex. The callback must not enter start/stop/join; it may
+// copy the observation into its independently scoped watch and return promptly.
+static bool QaReport(uint32_t added, int error, uint16_t port) {
+    AudioRendererStartupState callback;
+    void* context;
+    uint64_t serial;
+    uint32_t bits;
+    int firstError;
+    bool live;
+    QaLock(&qaStartup.dispatchMutex);
+    QaLock(&qaStartup.stateMutex);
+    if (!qaStartup.active) {
+        QaUnlock(&qaStartup.stateMutex);
+        QaUnlock(&qaStartup.dispatchMutex);
+        return false;
+    }
+    if (error && !qaStartup.firstError) qaStartup.firstError = error;
+    if (error) added |= LI_AUDIO_STARTUP_FAILED;
+    if ((qaStartup.bits | added) & LI_AUDIO_STARTUP_TERMINAL_MASK) {
+        qaStartup.bits &= ~LI_AUDIO_STARTUP_PROGRESS_MASK;
+        added &= ~LI_AUDIO_STARTUP_PROGRESS_MASK;
+    }
+    qaStartup.bits |= added;
+    if (port) qaStartup.localPort = port;
+    callback = qaStartup.callback;
+    context = qaStartup.context;
+    serial = qaStartup.serial;
+    bits = qaStartup.bits;
+    firstError = qaStartup.firstError;
+    port = qaStartup.localPort;
+    live = !(bits & LI_AUDIO_STARTUP_TERMINAL_MASK);
+    QaUnlock(&qaStartup.stateMutex);
+    if (callback) callback(context, serial, bits, port, firstError);
+    QaUnlock(&qaStartup.dispatchMutex);
+    return live;
+}
+
+static void QaEnd(void) {
+    // Called only after all real producer workers are joined (or before any were
+    // created). Taking dispatchMutex drains an already executing notification.
+    QaLock(&qaStartup.dispatchMutex);
+    QaLock(&qaStartup.stateMutex);
+    qaStartup.active = false;
+    qaStartup.callback = NULL;
+    qaStartup.context = NULL;
+    QaUnlock(&qaStartup.stateMutex);
+    QaUnlock(&qaStartup.dispatchMutex);
+}
+
+static int QaBegin(void* context) {
+    int error = 0;
+    bool fresh = (AudioCallbacks.capabilities & CAPABILITY_QUEST3D_FILE_PCM_FRESH_START) != 0;
+    QaLock(&qaStartup.dispatchMutex);
+    QaLock(&qaStartup.stateMutex);
+    if (qaStartup.active || qaStartup.serial == UINT64_MAX) {
+        QaUnlock(&qaStartup.stateMutex);
+        QaUnlock(&qaStartup.dispatchMutex);
+        return LI_AUDIO_STARTUP_INVALID_LIFETIME;
+    }
+    qaStartup.serial++;
+    qaStartup.context = context;
+    qaStartup.callback = AudioCallbacks.startupState;
+    qaStartup.bits = LI_AUDIO_STARTUP_ENDPOINT_UNCONFIRMED;
+    qaStartup.localPort = 0;
+    qaStartup.firstError = 0;
+    qaStartup.active = true;
+    qaStartup.fresh = fresh;
+    QaUnlock(&qaStartup.stateMutex);
+    QaUnlock(&qaStartup.dispatchMutex);
+    if (fresh && (!AudioCallbacks.startupState ||
+                  (AudioCallbacks.capabilities & CAPABILITY_DIRECT_SUBMIT))) {
+        error = LI_AUDIO_STARTUP_UNSUPPORTED_COMBINATION;
+    }
+    // There is deliberately no runtime switch, environment variable, exported
+    // grant API or UI path around this denial. A future authenticated native
+    // coordinator must supply the complete endpoint contract, not a bool.
+#ifndef QUEST3D_AUDIO_STARTUP_FIXTURE
+    else if (fresh) error = LI_AUDIO_STARTUP_ENDPOINT_POLICY_REQUIRED;
+#endif
+    QaReport(0, error, 0);
+    if (error) QaEnd();
+    return error;
+}
+
+static int QaObserveSocket(SOCKET socket) {
+    struct sockaddr_storage local;
+    SOCKADDR_LEN length = sizeof(local);
+    if (getsockname(socket, (struct sockaddr*)&local, &length) != 0) return LastSocketFail();
+    uint16_t port = local.ss_family == AF_INET ? ntohs(((struct sockaddr_in*)&local)->sin_port) :
+                    local.ss_family == AF_INET6 ? ntohs(((struct sockaddr_in6*)&local)->sin6_port) : 0;
+    if (!port) return LI_AUDIO_STARTUP_INVALID_ENDPOINT;
+    if (qaStartup.fresh) {
+#ifdef QUEST3D_AUDIO_STARTUP_FIXTURE
+        // Only the standalone fixture translation unit defines this macro. The
+        // production port does not compile any policy implementation or grant.
+        if (!Quest3dFixtureAuthorizeEndpoint(qaStartup.context, qaStartup.serial, socket, port))
+            return LI_AUDIO_STARTUP_ENDPOINT_POLICY_REQUIRED;
+        LC_SOCKADDR peer;
+        memcpy(&peer, &RemoteAddr, sizeof(peer));
+        SET_PORT(&peer, AudioPortNumber);
+        if (connect(socket, (struct sockaddr*)&peer, AddrLen) != 0) return LastSocketFail();
+#else
+        return LI_AUDIO_STARTUP_ENDPOINT_POLICY_REQUIRED;
+#endif
+    }
+    QaReport(LI_AUDIO_STARTUP_LOCAL_SOCKET_BOUND, 0, port);
+    return 0;
+}
diff --git a/addons/nightfall-stream/vcpkg-overlay/moonlight-common-c/quest3d/ConnectionCallbackDrain.h b/addons/nightfall-stream/vcpkg-overlay/moonlight-common-c/quest3d/ConnectionCallbackDrain.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/vcpkg-overlay/moonlight-common-c/quest3d/ConnectionCallbackDrain.h
@@ -0,0 +1,180 @@
+// Quest3D local extension for the pinned Moonlight client. This dispatcher is
+// independent of Platform.c: a client termination callback may call LiStopConnection
+// (which cleans up that platform) before the lifecycle owner joins this thread.
+#pragma once
+
+#if defined(LC_WINDOWS)
+#include <windows.h>
+#elif defined(LC_POSIX) && !defined(__WIIU__) && !defined(__3DS__)
+#include <pthread.h>
+#else
+#error Quest3D callback drain requires Windows or POSIX threads
+#endif
+
+enum {
+    CL_DRAIN_BUSY = -5701,
+    CL_DRAIN_SELF = -5702,
+    CL_DRAIN_CREATE_FAILED = -5703,
+    CL_DRAIN_JOIN_FAILED = -5704
+};
+
+typedef struct _CL_DRAIN_STATE {
+#if defined(LC_WINDOWS)
+    SRWLOCK mutex;
+    HANDLE thread;
+#else
+    pthread_mutex_t mutex;
+    pthread_t thread;
+#endif
+    bool enabled;
+    bool joinable;
+    bool joining;
+    int failure;
+    ConnListenerConnectionTerminated callback;
+    int error;
+} CL_DRAIN_STATE;
+
+#if defined(LC_WINDOWS)
+static CL_DRAIN_STATE callbackDrain = { .mutex = SRWLOCK_INIT };
+#else
+static CL_DRAIN_STATE callbackDrain = { .mutex = PTHREAD_MUTEX_INITIALIZER };
+#endif
+
+static void ClDrainLock(void) {
+#if defined(LC_WINDOWS)
+    AcquireSRWLockExclusive(&callbackDrain.mutex);
+#else
+    pthread_mutex_lock(&callbackDrain.mutex);
+#endif
+}
+
+static void ClDrainUnlock(void) {
+#if defined(LC_WINDOWS)
+    ReleaseSRWLockExclusive(&callbackDrain.mutex);
+#else
+    pthread_mutex_unlock(&callbackDrain.mutex);
+#endif
+}
+
+// The lifecycle owner serializes begin/stop/drain. Internal producers may issue
+// concurrently; they cannot mutate the captured callback once one task exists.
+static int ClDrainCanBegin(void) {
+    int result;
+    ClDrainLock();
+    result = callbackDrain.failure ? callbackDrain.failure :
+        ((callbackDrain.enabled || callbackDrain.joinable || callbackDrain.joining) ? CL_DRAIN_BUSY : 0);
+    ClDrainUnlock();
+    return result;
+}
+
+static void ClDrainEnable(ConnListenerConnectionTerminated callback) {
+    ClDrainLock();
+    callbackDrain.callback = callback;
+    callbackDrain.enabled = true;
+    ClDrainUnlock();
+}
+
+static void ClDrainDisable(void) {
+    ClDrainLock();
+    callbackDrain.enabled = false;
+    ClDrainUnlock();
+}
+
+#if defined(LC_WINDOWS)
+static DWORD WINAPI ClDrainThread(void* context)
+#else
+static void* ClDrainThread(void* context)
+#endif
+{
+    ConnListenerConnectionTerminated callback;
+    int error;
+    (void)context;
+    // Creation holds the mutex until its joinable handle is published. Capture
+    // these values before user code; no globals are consulted after the call.
+    ClDrainLock();
+    callback = callbackDrain.callback;
+    error = callbackDrain.error;
+    ClDrainUnlock();
+    callback(error);
+#if defined(LC_WINDOWS)
+    return 0;
+#else
+    return NULL;
+#endif
+}
+
+static int ClDrainIssue(int error) {
+    int result = 0;
+    ClDrainLock();
+    if (!callbackDrain.enabled || callbackDrain.joinable || callbackDrain.failure) {
+        ClDrainUnlock();
+        return 0;
+    }
+    callbackDrain.enabled = false;
+    callbackDrain.error = error;
+#if defined(LC_WINDOWS)
+    callbackDrain.thread = CreateThread(NULL, 0, ClDrainThread, NULL, 0, NULL);
+    if (callbackDrain.thread == NULL) {
+#else
+    if (pthread_create(&callbackDrain.thread, NULL, ClDrainThread, NULL) != 0) {
+#endif
+        // Lost delivery is not a successful drain. Preserve this failure for the
+        // current library lifetime rather than approving a replacement owner.
+        result = callbackDrain.failure = CL_DRAIN_CREATE_FAILED;
+    }
+    else {
+        callbackDrain.joinable = true;
+    }
+    ClDrainUnlock();
+    return result;
+}
+
+static int ClDrainWait(void) {
+    int result = 0;
+    ClDrainLock();
+    // Check self before joining/busy: a callback must never wait for its own
+    // return even when another lifecycle thread has already begun the join.
+    if (callbackDrain.joinable &&
+#if defined(LC_WINDOWS)
+            GetThreadId(callbackDrain.thread) == GetCurrentThreadId()
+#else
+            pthread_equal(callbackDrain.thread, pthread_self())
+#endif
+    ) {
+        result = CL_DRAIN_SELF;
+    }
+    else if (callbackDrain.failure) {
+        result = callbackDrain.failure;
+    }
+    else if (callbackDrain.enabled || callbackDrain.joining) {
+        result = CL_DRAIN_BUSY;
+    }
+    if (result || !callbackDrain.joinable) {
+        ClDrainUnlock();
+        return result;
+    }
+    callbackDrain.joining = true;
+    ClDrainUnlock();
+
+#if defined(LC_WINDOWS)
+    if (WaitForSingleObject(callbackDrain.thread, INFINITE) != WAIT_OBJECT_0 ||
+            !CloseHandle(callbackDrain.thread)) {
+        result = CL_DRAIN_JOIN_FAILED;
+    }
+#else
+    if (pthread_join(callbackDrain.thread, NULL) != 0) {
+        result = CL_DRAIN_JOIN_FAILED;
+    }
+#endif
+    ClDrainLock();
+    callbackDrain.joining = false;
+    if (result) {
+        callbackDrain.failure = result;
+    }
+    else {
+        callbackDrain.joinable = false;
+        callbackDrain.callback = NULL;
+    }
+    ClDrainUnlock();
+    return result;
+}
diff --git a/android/src/main/java/com/godot/game/CodecCapabilityDiagnostics.java b/android/src/main/java/com/godot/game/CodecCapabilityDiagnostics.java
new file mode 100644
--- /dev/null
+++ b/android/src/main/java/com/godot/game/CodecCapabilityDiagnostics.java
@@ -0,0 +1,38 @@
+package com.godot.game;
+
+/** Read-only capability formatting. Reported support is not a throughput measurement. */
+final class CodecCapabilityDiagnostics {
+    interface VideoProbe {
+        boolean isSizeSupported(int width, int height);
+        boolean areSizeAndRateSupported(int width, int height, double rate);
+        String getSupportedFrameRatesFor(int width, int height);
+    }
+
+    static String describeSize(VideoProbe probe, int width, int height, int rate) {
+        if (probe == null || width <= 0 || height <= 0 || rate <= 0) {
+            throw new IllegalArgumentException("Positive video dimensions and rate are required");
+        }
+        String size;
+        String sizeAndRate;
+        String fps;
+        // A platform can throw for an unsupported size. Keep the other answers,
+        // especially the explicit false from areSizeAndRateSupported, observable.
+        try { size = Boolean.toString(probe.isSizeSupported(width, height)); }
+        catch (Exception e) { size = unavailable(e); }
+        try { sizeAndRate = Boolean.toString(probe.areSizeAndRateSupported(width, height, rate)); }
+        catch (Exception e) { sizeAndRate = unavailable(e); }
+        try {
+            fps = probe.getSupportedFrameRatesFor(width, height);
+            if (fps == null) fps = "UNAVAILABLE(null)";
+        } catch (Exception e) { fps = unavailable(e); }
+        return "combined=" + width + "x" + height + " rate=" + rate
+                + " size_supported=" + size + " size_rate_supported=" + sizeAndRate
+                + " supported_fps=" + fps;
+    }
+
+    private static String unavailable(Exception e) {
+        return "UNAVAILABLE(" + e.getClass().getSimpleName() + ")";
+    }
+
+    private CodecCapabilityDiagnostics() {}
+}
diff --git a/extensions/nightfall-xr/include/pointer_geometry.h b/extensions/nightfall-xr/include/pointer_geometry.h
new file mode 100644
--- /dev/null
+++ b/extensions/nightfall-xr/include/pointer_geometry.h
@@ -0,0 +1,115 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace quest3d {
+// Pure production math. Coordinates are in the submitted layer's local space;
+// distance is along the normalized ray, never the caller's direction magnitude.
+struct PointerVec { double x = 0, y = 0, z = 0; };
+inline bool finite(PointerVec v) { return std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z); }
+struct PointerPanel {
+    bool cylinder = false;
+    double width = 0, height = 0, radius = 0, angle = 0, aspect = 0;
+    int image_width = 0, image_height = 0;
+    int viewport_x = 0, viewport_y = 0, viewport_width = 0, viewport_height = 0;
+    int encoded_eye = 0;
+};
+struct PointerHit {
+    bool valid = false;
+    const char *reason = "ray_miss";
+    double u = 0, v = 0, distance = 0, packed_u = 0, packed_v = 0;
+    PointerVec local;
+};
+struct PointerSample { bool valid = false; double u = 0, v = 0; };
+inline PointerSample pointer_sample(const float *matrix, int count, double u, double v) {
+    PointerSample out;
+    if (!matrix || count != 16 || !std::isfinite(u) || !std::isfinite(v)) return out;
+    for (int i = 0; i < count; ++i) if (!std::isfinite(matrix[i])) return out;
+    out.u = matrix[0]*u + matrix[4]*v + matrix[12];
+    out.v = matrix[1]*u + matrix[5]*v + matrix[13];
+    out.valid = std::isfinite(out.u) && std::isfinite(out.v) && out.u >= 0 && out.u <= 1 && out.v >= 0 && out.v <= 1;
+    return out;
+}
+
+// External renderer mutex owns these counters. Overflow permanently closes the
+// gate instead of recycling an old generation. A mapping edit requires redraw.
+class PointerGeneration {
+public:
+    uint64_t panel = 1, mapping = 1;
+    bool redraw = true;
+    void change(bool pixels) {
+        advance(panel);
+        if (pixels) { advance(mapping); redraw = true; }
+    }
+    bool current(uint64_t p, uint64_t m) const { return panel && mapping && p == panel && m == mapping && !redraw; }
+private:
+    static void advance(uint64_t &v) { if (v) v = v == uint64_t(INT64_MAX) ? 0 : v + 1; }
+};
+
+inline PointerHit pointer_hit(const PointerPanel &p, PointerVec o, PointerVec d, double max_distance) {
+    PointerHit out;
+    if (!finite(o) || !finite(d) || !std::isfinite(max_distance) || max_distance <= 0) {
+        out.reason = "invalid_ray"; return out;
+    }
+    const double length = std::hypot(d.x, d.y, d.z);
+    if (!std::isfinite(length) || length <= 1e-12) { out.reason = "invalid_ray"; return out; }
+    d = {d.x / length, d.y / length, d.z / length};
+    if (p.image_width <= 0 || p.image_height <= 0 || p.viewport_x < 0 || p.viewport_y < 0
+            || p.viewport_width <= 0 || p.viewport_height <= 0
+            || int64_t(p.viewport_x) + p.viewport_width > p.image_width
+            || int64_t(p.viewport_y) + p.viewport_height > p.image_height
+            || p.encoded_eye < 0 || p.encoded_eye > 1) { out.reason = "invalid_viewport"; return out; }
+    double su = 0, sv = 0, t = 0;
+    if (!p.cylinder) {
+        if (!std::isfinite(p.width) || !std::isfinite(p.height) || p.width <= 0 || p.height <= 0) {
+            out.reason = "invalid_shape"; return out;
+        }
+        // OpenXR quad front normal is +Z. A ray lying in the surface is invalid.
+        if (d.z >= -1e-12 || o.z <= 0) { out.reason = "backface_or_parallel"; return out; }
+        t = -o.z / d.z;
+        const double x = o.x + t * d.x, y = o.y + t * d.y;
+        if (std::abs(x) > p.width / 2 || std::abs(y) > p.height / 2) return out;
+        su = x / p.width + 0.5;
+        sv = 0.5 - y / p.height;
+    } else {
+        constexpr double tau = 6.283185307179586476925286766559;
+        if (!std::isfinite(p.radius) || !std::isfinite(p.angle) || !std::isfinite(p.aspect)
+                || p.radius <= 0 || p.angle <= 0 || p.angle >= tau || p.aspect <= 0) {
+            out.reason = "invalid_shape"; return out;
+        }
+        const double height = p.radius * p.angle / p.aspect;
+        if (!std::isfinite(height) || height <= 0) { out.reason = "invalid_shape"; return out; }
+        const double a = d.x*d.x + d.z*d.z;
+        const double b = o.x*d.x + o.z*d.z;
+        const double c = o.x*o.x + o.z*o.z - p.radius*p.radius;
+        const double disc = b*b - a*c;
+        if (!std::isfinite(disc) || a <= 1e-24 || disc <= 0) return out; // no tangential hit
+        // The + root is the exit intersection: only the interior-facing side
+        // is visible. The - root is the invisible exterior, never a valid hit.
+        t = (-b + std::sqrt(disc)) / a;
+        const double x = o.x + t*d.x, y = o.y + t*d.y, z = o.z + t*d.z;
+        if (!std::isfinite(t) || x*d.x + z*d.z <= 1e-12) return out;
+        const double theta = std::atan2(x, -z);
+        if (std::abs(theta) > p.angle / 2 || std::abs(y) > height / 2) return out;
+        su = theta / p.angle + 0.5;
+        sv = 0.5 - y / height;
+    }
+    if (!std::isfinite(t) || t <= 0 || t > max_distance) { out.reason = "distance"; return out; }
+    // Our surface sv is top-left. OpenXR GLES imageRect and glViewport both
+    // have bottom-left origin (XR_KHR_opengl_es_enable); convert exactly once.
+    // The shader interpolates its COMPLETE [0,1] image into this viewport; the
+    // bezel is padding, not a crop. No clamp and no PC letterbox removal here.
+    const double px = su * p.image_width, py = (1 - sv) * p.image_height;
+    const double u = (px - p.viewport_x) / p.viewport_width;
+    const double gl_v = (py - p.viewport_y) / p.viewport_height;
+    if (!std::isfinite(u) || !std::isfinite(gl_v) || u < 0 || u > 1 || gl_v < 0 || gl_v > 1) {
+        out.reason = "bezel_or_outside"; return out;
+    }
+    out.valid = true; out.reason = "candidate_only";
+    out.u = u; out.v = 1 - gl_v; out.distance = t;
+    out.packed_u = 0.5 * (u + p.encoded_eye); out.packed_v = gl_v;
+    out.local = {o.x + t*d.x, o.y + t*d.y, o.z + t*d.z};
+    return out;
+}
+} // namespace quest3d
diff --git a/extensions/nightfall-xr/include/pointer_ticket.h b/extensions/nightfall-xr/include/pointer_ticket.h
new file mode 100644
--- /dev/null
+++ b/extensions/nightfall-xr/include/pointer_ticket.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "submission_identity.h"
+#include <limits>
+
+namespace quest3d {
+// A short-lived click snapshot can survive newer *successful* video frames,
+// but never a skipped/failed submission, lifecycle change or decoder restart.
+// External renderer mutex protects this and the corresponding Dictionary.
+class PointerTicket {
+public:
+    uint64_t issue(const SubmissionToken &token, uint64_t lifecycle, uint64_t panel,
+            uint64_t mapping, int64_t submitted, int64_t pixel) {
+        invalidate();
+        if (!token.valid() || !lifecycle || !panel || !mapping || submitted <= 0 || pixel <= 0
+                || serial_ == uint64_t(std::numeric_limits<int64_t>::max())) return 0;
+        token_ = token; lifecycle_ = lifecycle; panel_ = panel; mapping_ = mapping;
+        submitted_ = submitted; pixel_ = pixel; active_ = ++serial_; return active_;
+    }
+    void invalidate() { active_ = 0; }
+    void begin(bool allowed, bool previous_cycle_open) {
+        if (!allowed || previous_cycle_open) invalidate();
+    }
+    void finish(bool success) { if (!success) invalidate(); }
+    bool current(uint64_t id, int64_t now, uint64_t lifecycle, uint64_t panel,
+            uint64_t mapping, const SubmissionToken &current, bool current_submission) const {
+        return id && id == active_ && current_submission && current.valid()
+            && lifecycle == lifecycle_ && panel == panel_ && mapping == mapping_
+            && current.transport == token_.transport && current.decoder == token_.decoder
+            && now >= submitted_ && now - submitted_ <= SubmissionIdentity::max_submission_age_us
+            && now >= pixel_ && now - pixel_ <= SubmissionIdentity::max_pixel_age_us;
+    }
+private:
+    uint64_t serial_ = 0, active_ = 0, lifecycle_ = 0, panel_ = 0, mapping_ = 0;
+    int64_t submitted_ = 0, pixel_ = 0;
+    SubmissionToken token_;
+};
+}
diff --git a/extensions/nightfall-xr/include/submission_identity.h b/extensions/nightfall-xr/include/submission_identity.h
new file mode 100644
--- /dev/null
+++ b/extensions/nightfall-xr/include/submission_identity.h
@@ -0,0 +1,93 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace quest3d {
+// Retains a timed-out acquired image independently of new decoder callbacks.
+// A later submit_frame(false) must not cancel the pending xrWaitSwapchainImage.
+class SwapchainImageState {
+public:
+    bool needs_render(bool new_frame) const { return new_frame || acquired_; }
+    bool acquired() const { return acquired_; }
+    uint32_t index() const { return index_; }
+    void acquired(uint32_t index) { index_ = index; acquired_ = true; }
+    void released() { acquired_ = false; }
+private:
+    bool acquired_ = false;
+    uint32_t index_ = 0;
+};
+
+struct SubmissionToken {
+    std::string transport;
+    uint64_t decoder = 0;
+    uint32_t frame = 0;
+    uint64_t lease = 0;
+    bool operator==(const SubmissionToken &other) const {
+        return transport == other.transport && decoder == other.decoder && frame == other.frame && lease == other.lease;
+    }
+    bool valid() const {
+        return transport.size() == 32 && decoder != 0 && lease != 0
+            && std::all_of(transport.begin(), transport.end(), [](char c) {
+                return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+            });
+    }
+};
+
+// Production predicate for one actual Godot layer-collection / xrEndFrame cycle.
+// External renderer mutex owns synchronization. Pointers are compared only in
+// finish(), while the engine still owns the borrowed layer list; never dereferenced.
+class SubmissionIdentity {
+public:
+    static constexpr int64_t max_submission_age_us = 250'000;
+    static constexpr int64_t max_pixel_age_us = 500'000;
+    void invalidate() { active_ = false; valid_ = false; eyes_ = {}; }
+    void begin(uint64_t cycle, uint64_t session, uint64_t state, uint64_t lifecycle, bool allowed) {
+        invalidate();
+        cycle_ = cycle; session_ = session; state_ = state; lifecycle_ = lifecycle;
+        active_ = allowed && cycle != 0 && session != 0 && (state & 15) == 5; // FOCUSED
+    }
+    bool observe_eye(int eye, uintptr_t pointer, const SubmissionToken &token, int64_t pixel_at) {
+        if (!active_ || eye < 0 || eye > 1 || !pointer || !token.valid() || pixel_at <= 0) return false;
+        auto &slot = eyes_[eye];
+        if (slot.pointer && (slot.pointer != pointer || !(slot.token == token) || slot.pixel_at != pixel_at)) {
+            invalidate(); return false;
+        }
+        slot = {pointer, token, pixel_at};
+        return true;
+    }
+    bool finish(uint64_t cycle, uint64_t session, uint64_t state, uint64_t lifecycle,
+            int64_t result, const std::vector<uintptr_t> &actual_layers, int64_t now, bool source_current) {
+        const bool candidate = active_ && result == 0 && cycle == cycle_ && session == session_
+            && state == state_ && lifecycle == lifecycle_ && source_current
+            && eyes_[0].pointer && eyes_[1].pointer && eyes_[0].pointer != eyes_[1].pointer
+            && eyes_[0].token == eyes_[1].token && eyes_[0].pixel_at == eyes_[1].pixel_at;
+        active_ = false; valid_ = false;
+        if (!candidate) return false;
+        std::array<unsigned, 2> counts{};
+        for (auto pointer : actual_layers) {
+            for (int eye = 0; eye < 2; ++eye) if (pointer == eyes_[eye].pointer) ++counts[eye];
+        }
+        if (counts[0] != 1 || counts[1] != 1 || now < eyes_[0].pixel_at
+                || now - eyes_[0].pixel_at > max_pixel_age_us) return false;
+        token_ = eyes_[0].token; pixel_at_ = eyes_[0].pixel_at; submitted_at_ = now;
+        valid_ = true; return true;
+    }
+    bool current(int64_t now, uint64_t lifecycle, bool source_current) const {
+        return valid_ && !active_ && lifecycle == lifecycle_ && source_current
+            && now >= submitted_at_ && now - submitted_at_ <= max_submission_age_us
+            && now >= pixel_at_ && now - pixel_at_ <= max_pixel_age_us;
+    }
+    const SubmissionToken &token() const { return token_; }
+    uint64_t cycle() const { return cycle_; }
+private:
+    struct Eye { uintptr_t pointer = 0; SubmissionToken token; int64_t pixel_at = 0; };
+    std::array<Eye, 2> eyes_{};
+    SubmissionToken token_;
+    uint64_t cycle_ = 0, session_ = 0, state_ = 0, lifecycle_ = 0;
+    int64_t submitted_at_ = 0, pixel_at_ = 0;
+    bool active_ = false, valid_ = false;
+};
+} // namespace quest3d
diff --git a/extensions/nightfall-xr/include/xr_retirement.h b/extensions/nightfall-xr/include/xr_retirement.h
new file mode 100644
--- /dev/null
+++ b/extensions/nightfall-xr/include/xr_retirement.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace godot {
+class NightfallXrRenderer;
+
+struct XrLifetime {
+    uint64_t instance = 0;
+    uint64_t generation = 0;
+    bool operator==(const XrLifetime &other) const {
+        return instance == other.instance && generation == other.generation;
+    }
+};
+
+enum class XrRetirementFailure {
+    none,
+    borrowed_end_unconfirmed,
+    cleanup_context_unavailable,
+    gpu_error,
+    swapchain_destroy_failed,
+    egl_restore_failed,
+    egl_destroy_failed,
+    oes_lease_unreturned,
+};
+
+// Application-owned stream resources only. Even xrDestroySwapchain success
+// permits the runtime to keep using its images; this is not compositor drain,
+// xrEndSession/xrDestroySession, photon evidence, or TextureUploader retirement.
+class XrRetirement final {
+public:
+    XrLifetime lifetime() const { return lifetime_; }
+    const std::string &last_submitted_transport() const { return last_submitted_transport_; }
+    bool initialized() const { return initialized_; }
+    XrRetirementFailure failure() const { return failure_; }
+    bool borrowed_layers_returned() const { return borrowed_layers_returned_; }
+    bool consumer_leases_returned() const { return consumer_leases_returned_; }
+    bool gpu_commands_completed() const { return gpu_commands_completed_; }
+    bool owned_resources_absent() const { return owned_resources_absent_; }
+    int64_t last_end_frame_result() const { return last_end_frame_result_; }
+    int32_t video_destroy_status() const { return video_destroy_status_; }
+    int32_t overlay_destroy_status() const { return overlay_destroy_status_; }
+    uint32_t gl_error() const { return gl_error_; }
+    int32_t egl_error() const { return egl_error_; }
+    bool application_resources_retired() const {
+        return lifetime_.generation != 0 && failure_ == XrRetirementFailure::none &&
+            borrowed_layers_returned_ && consumer_leases_returned_ &&
+            gpu_commands_completed_ && owned_resources_absent_;
+    }
+private:
+    friend class NightfallXrRenderer;
+    XrRetirement() = default;
+    XrLifetime lifetime_;
+    std::string last_submitted_transport_;
+    bool initialized_ = false;
+    XrRetirementFailure failure_ = XrRetirementFailure::none;
+    bool borrowed_layers_returned_ = false;
+    bool consumer_leases_returned_ = false;
+    bool gpu_commands_completed_ = false;
+    bool owned_resources_absent_ = false;
+    int64_t last_end_frame_result_ = 0;
+    int32_t video_destroy_status_ = 0;
+    int32_t overlay_destroy_status_ = 0;
+    uint32_t gl_error_ = 0;
+    int32_t egl_error_ = 0;
+};
+
+class XrRetirementWatch final {
+public:
+    XrLifetime lifetime() const { return lifetime_; }
+    // Null until an owner-thread stop actually completes or reports failure.
+    // Thread scheduling and a missing engine end notice never produce success.
+    std::shared_ptr<const XrRetirement> snapshot() const { return std::atomic_load(&result_); }
+private:
+    friend class NightfallXrRenderer;
+    explicit XrRetirementWatch(XrLifetime lifetime) : lifetime_(lifetime) {}
+    XrLifetime lifetime_;
+    std::shared_ptr<const XrRetirement> result_;
+};
+
+// stop_stream intentionally leaves the composition provider registered. Its
+// later shutdown has a separate observation because Godot's unregister API is
+// void: a returned call is observable, an engine/runtime ACK is not available.
+class XrProviderShutdown final {
+public:
+    XrLifetime lifetime() const { return lifetime_; }
+    bool owner_thread() const { return owner_thread_; }
+    bool borrowed_layers_returned() const { return borrowed_layers_returned_; }
+    bool unregister_call_returned() const { return unregister_call_returned_; }
+    bool api_available() const { return api_available_; }
+private:
+    friend class NightfallXrRenderer;
+    XrProviderShutdown() = default;
+    XrLifetime lifetime_;
+    bool owner_thread_ = false;
+    bool borrowed_layers_returned_ = false;
+    bool unregister_call_returned_ = false;
+    bool api_available_ = false;
+};
+} // namespace godot
diff --git a/extensions/nightfall-xr/src/fast_xr_renderer_pointer.cpp b/extensions/nightfall-xr/src/fast_xr_renderer_pointer.cpp
new file mode 100644
--- /dev/null
+++ b/extensions/nightfall-xr/src/fast_xr_renderer_pointer.cpp
@@ -0,0 +1,164 @@
+#include "fast_xr_renderer.h"
+#include <cmath>
+#include <chrono>
+#ifdef __ANDROID__
+#include <godot_cpp/classes/xr_server.hpp>
+#endif
+
+using namespace godot;
+
+Dictionary NightfallXrRenderer::query_pointer_candidate(const Vector3 &origin_world,
+        const Vector3 &direction_world, double max_distance, int eye) {
+    std::lock_guard<std::recursive_mutex> lock(frame_mutex);
+    Dictionary out;
+    out["valid"] = false;
+    out["input_enabled"] = false;
+    out["network_enabled"] = false;
+    out["photon_verified"] = false;
+    out["reason"] = "no_current_submission";
+#ifdef __ANDROID__
+    if (owner_thread != std::this_thread::get_id()) { out["reason"] = "wrong_thread"; return out; }
+    if (eye < 0 || eye > 1) { out["reason"] = "invalid_eye"; return out; }
+    // Recursive mutex remains held across current-token validation, geometry
+    // selection, intersection and descriptor copy; never join separate getters.
+    const Dictionary frame = get_last_successful_submission();
+    if (frame.is_empty()) return out;
+    if (!pointer_generation.current(int64_t(frame.get("panel_generation", 0)),
+            int64_t(frame.get("mapping_generation", 0)))) { out["reason"] = "geometry_changed"; return out; }
+    if (!bool(frame.get("pointer_mapping_supported", false))) { out["reason"] = "unsupported_pixel_mapping"; return out; }
+    XRServer *server = XRServer::get_singleton();
+    const Transform3D reference = frame.get("reference_frame", Transform3D());
+    if (!server || server->get_reference_frame() != reference
+            || server->get_world_scale() != 1.0 || double(frame.get("world_scale", 0.0)) != 1.0) {
+        out["reason"] = "reference_space_changed_or_scaled"; return out;
+    }
+    const Transform3D to_play = frame["world_to_play"];
+    // Current product operates in metres with rigid XR transforms. A scaled or
+    // sheared reference would change ray distance; reject instead of guessing.
+    if (!to_play.is_finite() || !(to_play.basis.transposed() * to_play.basis).is_equal_approx(Basis())
+            || std::abs(to_play.basis.determinant() - 1.0) > 1e-5) {
+        out["reason"] = "non_rigid_reference"; return out;
+    }
+    const Array eyes = frame.get("eyes", Array());
+    if (eyes.size() != 2) return out;
+    const Dictionary geometry = eyes[eye];
+    const Ref<OpenXRAPIExtension> api = get_openxr_api();
+    if (api.is_null() || int64_t(geometry.get("space", 0)) != int64_t(api->get_play_space())) {
+        out["reason"] = "reference_space_changed"; return out;
+    }
+    const Quaternion rotation = geometry["orientation"];
+    const Vector3 position = geometry["position"];
+    if (!rotation.is_finite() || !position.is_finite() || std::abs(rotation.length_squared() - 1) > 1e-5) {
+        out["reason"] = "invalid_pose"; return out;
+    }
+    const Transform3D layer(Basis(rotation), position);
+    const Transform3D to_local = layer.inverse() * to_play;
+    const Vector3 origin = to_local.xform(origin_world);
+    const Vector3 direction = to_local.basis.xform(direction_world);
+    quest3d::PointerPanel panel;
+    const String shape = geometry.get("shape", "");
+    if (shape == "quad") {
+        const Vector2 size = geometry["size"];
+        panel.width = size.x; panel.height = size.y;
+    } else if (shape == "cylinder") {
+        panel.cylinder = true;
+        panel.radius = geometry["radius"]; panel.angle = geometry["central_angle"]; panel.aspect = geometry["aspect_ratio"];
+    } else { out["reason"] = "unsupported_shape"; return out; }
+    const Rect2i image = geometry["image_rect"];
+    const Rect2i content = geometry["content_rect_in_image"];
+    panel.image_width = image.size.x; panel.image_height = image.size.y;
+    panel.viewport_x = content.position.x - image.position.x;
+    panel.viewport_y = content.position.y - image.position.y;
+    panel.viewport_width = content.size.x; panel.viewport_height = content.size.y;
+    panel.encoded_eye = geometry["encoded_eye"];
+    const auto hit = quest3d::pointer_hit(panel, {origin.x, origin.y, origin.z},
+            {direction.x, direction.y, direction.z}, max_distance);
+    out["reason"] = hit.reason;
+    if (!hit.valid) return out;
+    // Android's SurfaceTexture matrix converts the logical GL coordinate to
+    // decoder storage/crop/orientation coordinates. Return both for diagnostics,
+    // but host source mapping uses top-left logical one-eye u/v, before storage.
+    const PackedFloat32Array matrix = frame.get("matrix", PackedFloat32Array());
+    const auto sample = quest3d::pointer_sample(matrix.ptr(), int(matrix.size()), hit.packed_u, hit.packed_v);
+    if (!sample.valid) { out["reason"] = "invalid_or_outside_decoder_image"; return out; }
+    out["valid"] = true;
+    out["eye"] = eye;
+    out["encoded_eye"] = panel.encoded_eye;
+    out["u"] = hit.u; out["v"] = hit.v;
+    out["distance"] = hit.distance;
+    out["hit_world"] = to_play.inverse().xform(layer.xform(Vector3(hit.local.x, hit.local.y, hit.local.z)));
+    out["packed_shader_uv"] = Vector2(hit.packed_u, hit.packed_v);
+    out["oes_sample_uv"] = Vector2(sample.u, sample.v);
+    // Immutable deep copy includes both eye geometries, matrix, all epochs,
+    // uint32 frame index, panel generation and submission/pixel ages together.
+    out["submission"] = frame;
+    for (const char *key : {"submission_cycle", "transport_epoch", "decoder_epoch", "frame_index", "lease_serial", "panel_generation"})
+        out[key] = frame[key];
+#else
+    (void)origin_world; (void)direction_world; (void)max_distance; (void)eye;
+    out["reason"] = "native_android_required";
+#endif
+    return out;
+}
+
+namespace {
+quest3d::SubmissionToken pointer_token(const Dictionary &frame) {
+    const String transport = frame.get("transport_epoch", "");
+    return {transport.utf8().get_data(), uint64_t(int64_t(frame.get("decoder_epoch", 0))),
+        uint32_t(int64_t(frame.get("frame_index", 0))), uint64_t(int64_t(frame.get("lease_serial", 0)))};
+}
+}
+
+Dictionary NightfallXrRenderer::issue_pointer_ticket(const Vector3 &origin_world,
+        const Vector3 &direction_world, double max_distance, int eye) {
+    std::lock_guard<std::recursive_mutex> lock(frame_mutex);
+    pointer_ticket.invalidate(); pointer_ticket_descriptor.clear();
+    Dictionary candidate = query_pointer_candidate(origin_world, direction_world, max_distance, eye);
+    if (!bool(candidate.get("valid", false))) return candidate;
+    const Dictionary frame = candidate["submission"];
+    const uint64_t id = pointer_ticket.issue(pointer_token(frame), submission_lifecycle,
+        pointer_generation.panel, pointer_generation.mapping, frame["submitted_at_us"], frame["pixel_latched_at_us"]);
+    if (!id) { candidate["valid"] = false; candidate["reason"] = "ticket_exhausted"; return candidate; }
+    candidate["ticket"] = int64_t(id);
+    pointer_ticket_descriptor = candidate.duplicate(true);
+    return candidate;
+}
+
+Dictionary NightfallXrRenderer::take_pointer_ticket(int64_t ticket) {
+    std::lock_guard<std::recursive_mutex> lock(frame_mutex);
+    Dictionary rejected;
+    rejected["valid"] = false; rejected["reason"] = "expired_or_invalidated_ticket";
+    rejected["input_enabled"] = false; rejected["network_enabled"] = false;
+    rejected["photon_verified"] = false;
+#ifdef __ANDROID__
+    if (owner_thread != std::this_thread::get_id() || ticket <= 0 || pointer_ticket_descriptor.is_empty()) return rejected;
+    const Dictionary current = get_last_successful_submission();
+    const Dictionary original = pointer_ticket_descriptor["submission"];
+    const int64_t now = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    XRServer *server = XRServer::get_singleton();
+    const Ref<OpenXRAPIExtension> api = get_openxr_api();
+    const Array eyes = original.get("eyes", Array());
+    const Dictionary geometry = eyes.size() == 2 ? Dictionary(eyes[0]) : Dictionary();
+    const bool unchanged = !current.is_empty() && frame_source_current(original)
+        && pointer_generation.current(int64_t(original.get("panel_generation", 0)), int64_t(original.get("mapping_generation", 0)))
+        && server && server->get_reference_frame() == Transform3D(original["reference_frame"])
+        && server->get_world_scale() == 1.0 && api.is_valid()
+        && int64_t(geometry.get("space", 0)) == int64_t(api->get_play_space());
+    const bool accepted = pointer_ticket.current(uint64_t(ticket), now, submission_lifecycle,
+        pointer_generation.panel, pointer_generation.mapping, pointer_token(current), unchanged);
+    // A ticket is single-use, including an expired attempt. No UV regeneration,
+    // newer status/frame join or implicit retry can replace the clicked image.
+    pointer_ticket.invalidate();
+    Dictionary result = pointer_ticket_descriptor.duplicate(true); pointer_ticket_descriptor.clear();
+    if (!accepted) return rejected;
+    Dictionary frame = result["submission"];
+    frame["submission_age_us"] = now - int64_t(frame["submitted_at_us"]);
+    frame["pixel_latch_age_us"] = now - int64_t(frame["pixel_latched_at_us"]);
+    result["submission"] = frame;
+    return result;
+#else
+    (void)ticket;
+    return rejected;
+#endif
+}
