+Dictionary TextureUploader::acquire_oes_frame() {
+    std::lock_guard<std::mutex> lock(gles_surface_mutex_);
+    Dictionary frame;
+    if (!gles_surface_ready_ || !gles_retirement_.oes_texture) return frame;
+    // Also retire consumer fences here: a static decoder frame may never
+    // trigger another producer update, but a timed-out XR image must retry.
+    if (!poll_consumer_fence_locked()) return frame;
+    const uint64_t lease = oes_lease_.acquire();
+    if (!lease) return frame;
+    PackedFloat32Array matrix;
+    matrix.resize(16);
+    std::memcpy(matrix.ptrw(), gles_last_transform_matrix_, sizeof(gles_last_transform_matrix_));
+    frame["lease_serial"] = lease;
+    frame["texture_id"] = static_cast<int64_t>(gles_retirement_.oes_texture);
+    frame["matrix"] = matrix;
+    frame["producer_fence"] = reinterpret_cast<uint64_t>(gles_retirement_.ready_fence);
+    gles_retirement_.ready_fence = nullptr;
+    frame["surface_timestamp_ns"] = latched_timestamp_ns_;
+    frame["pixel_latched_at_us"] = pixel_latched_at_us_;
+    frame["token_valid"] = latched_token_.valid;
+    frame["transport_epoch"] = String(latched_token_.transport_epoch.c_str());
+    frame["decoder_epoch"] = latched_token_.decoder_epoch;
+    frame["frame_index"] = static_cast<int64_t>(latched_token_.frame_index);
+    frame["codec_pts_us"] = latched_token_.codec_pts_us;
+    frame["color_transfer"] = current_color_transfer_type_.load();
+    return frame;
+}
+
+bool TextureUploader::release_oes_frame(uint64_t serial, uint64_t consumer_fence) {
+    std::shared_ptr<const GlesSurfaceRetirementWatch> retry;
+    {
+        std::lock_guard<std::mutex> lock(gles_surface_mutex_);
+        if (!oes_lease_.release(serial)) return false;
+        // No GL operation here: this runs in the consumer's shared EGL context.
+        // Next producer poll waits for CPU-observable completion before releasing
+        // the SurfaceTexture buffer through updateTexImage().
+        gles_retirement_.consumer_fence = reinterpret_cast<void *>(consumer_fence);
+        if (gles_retirement_.requested_) retry = gles_retirement_.watch_;
+    }
+    // A real lease return can resume a pending cleanup. An earlier strict
+    // request remains strict; this does not turn pending into completion.
+    if (retry) request_gles_retirement_impl(retry->lifetime(), false);
+    return true;
+}
+
+void TextureUploader::retry_oes_update() {
+    bool retry;
+    {
+        std::lock_guard<std::mutex> lock(gles_surface_mutex_);
+        retry = gles_update_deferred_ && gles_surface_ready_;
+    }
+    if (retry) update_android_gles_external_texture();
+}
