+func apply_app_catalog(catalog: Dictionary):
+	main._available_apps = catalog.get("apps", []).duplicate(true)
+	main._selected_app_scope = catalog.get("scope", "")
+	main._selected_app_id = -1
+	main._selected_app_idx = -1
+	if catalog.get("ok", false):
+		main._selected_app_id = catalog.app.id
