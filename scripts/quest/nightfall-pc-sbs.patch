-        for (iChannel = 0; iChannel < channels; ++iChannel) {
-            ma_uint32 jChannel;
-            for (jChannel = iChannel + 1; jChannel < channels; ++jChannel) {
-                if (pChannelMap[iChannel] == pChannelMap[jChannel]) {
-                    return MA_FALSE;
-                }
-            }
-        }
-    }
-
-    return MA_TRUE;
-}
