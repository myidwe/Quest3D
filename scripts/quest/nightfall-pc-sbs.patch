+ANativeWindow *TextureUploader::create_android_gles_decoder_surface(int width, int height) {
+    RenderingServer *rs = RenderingServer::get_singleton();
+    if (!rs || width <= 0 || height <= 0) return nullptr;
+    uint64_t generation = 0;
+    {
+        std::lock_guard<std::mutex> lock(gles_surface_mutex_);
+        // Identical ready surface reuse is valid only inside its fixed
+        // transport. Decoder epoch changes do not change resource identity.
+        if (gles_retirement_.window && gles_surface_ready_ && !gles_surface_failed_ &&
+            !gles_retirement_.requested_ && gles_retirement_.watch_->lifetime().transport == gles_transport_ &&
+            gles_surface_width_ == width && gles_surface_height_ == height) {
+            return gles_retirement_.window;
+        }
+        if (!gles_retirement_.begin(gles_transport_)) {
+            NF_LOGE("TextureUploader", "Previous GLES surface retirement is unconfirmed; refusing fresh creation");
+            return nullptr;
+        }
+        generation = gles_retirement_.generation_;
+        gles_wrapper_detached_ = false;
+        gles_surface_width_ = width;
+        gles_surface_height_ = height;
+        gles_surface_ready_ = false;
+        gles_surface_failed_ = false;
+    }
+    rs->call_on_render_thread(callable_mp(this, &TextureUploader::_render_thread_create_android_gles_surface)
+        .bind(Ref<TextureUploader>(this), static_cast<int64_t>(generation)));
+    std::unique_lock<std::mutex> lock(gles_surface_mutex_);
+    if (!gles_surface_cv_.wait_for(lock, std::chrono::seconds(5), [this, generation] {
+            return generation != gles_retirement_.generation_ || gles_surface_ready_ ||
+                gles_surface_failed_ || gles_retirement_.requested_;
+        })) {
+        // Invalidate the already queued create as well. Only exact-generation
+        // cleanup/retry can retire this attempt; a later create cannot replace it.
+        gles_surface_failed_ = true;
+        gles_retirement_.request(gles_retirement_.watch_->lifetime());
+        NF_LOGE("TextureUploader", "Timed out creating GLES decoder SurfaceTexture; generation retained");
+        return nullptr;
+    }
+    return generation == gles_retirement_.generation_ && !gles_retirement_.requested_ && gles_surface_ready_
+        ? gles_retirement_.window : nullptr;
+}
+
+void TextureUploader::_render_thread_create_android_gles_surface(Ref<TextureUploader> keep_alive, int64_t generation) {
+    std::unique_lock<std::mutex> surface_lock(gles_surface_mutex_);
+    if (!gles_retirement_.accepts_create(static_cast<uint64_t>(generation))) return;
+    gles_retirement_.context_ = eglGetCurrentContext();
+    const int width = gles_surface_width_;
+    const int height = gles_surface_height_;
+    auto fail = [this] {
+        gles_surface_failed_ = true;
+        gles_surface_cv_.notify_all();
+    };
+    if (gles_retirement_.window || width <= 0 || height <= 0 || gles_retirement_.context_ == EGL_NO_CONTEXT) {
+        NF_LOGE("TextureUploader", "GLES decoder surface requested with invalid state/context");
+        fail();
+        return;
+    }
+
+    JavaVM *vm = nullptr;
+    JNIEnv *env = get_gles_jni_env(vm);
+    if (!env) {
+        NF_LOGE("TextureUploader", "Unable to get JNIEnv on Godot GLES render thread");
+        fail();
+        return;
+    }
+
+    // Bound render-thread JNI local references on every partial-init return.
+    if (env->PushLocalFrame(24) != JNI_OK) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        fail();
+        return;
+    }
+    struct LocalFrame {
+        JNIEnv *env;
+        ~LocalFrame() { env->PopLocalFrame(nullptr); }
+    } local_frame{env};
+
+    GLuint vertex = compile_gles_shader(GL_VERTEX_SHADER, GLES_EXTERNAL_VERTEX_SHADER);
+    GLuint fragment = compile_gles_shader(GL_FRAGMENT_SHADER, GLES_EXTERNAL_FRAGMENT_SHADER);
+    if (!vertex || !fragment) {
+        if (vertex) glDeleteShader(vertex);
+        if (fragment) glDeleteShader(fragment);
+        fail();
+        return;
+    }
+    gles_retirement_.program = glCreateProgram();
+    glAttachShader(gles_retirement_.program, vertex);
+    glAttachShader(gles_retirement_.program, fragment);
+    glLinkProgram(gles_retirement_.program);
+    glDeleteShader(vertex);
+    glDeleteShader(fragment);
+    GLint linked = GL_FALSE;
+    glGetProgramiv(gles_retirement_.program, GL_LINK_STATUS, &linked);
+    if (linked != GL_TRUE) {
+        char log[512]{};
+        glGetProgramInfoLog(gles_retirement_.program, sizeof(log), nullptr, log);
+        NF_LOGE("TextureUploader", "GLES external blit link failed: %s", log);
+        glDeleteProgram(gles_retirement_.program);
+        gles_retirement_.program = 0;
+        fail();
+        return;
+    }
+
+    glGenTextures(1, &gles_retirement_.oes_texture);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, gles_retirement_.oes_texture);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    jclass surface_texture_class = env->FindClass("android/graphics/SurfaceTexture");
+    jmethodID constructor = surface_texture_class ? env->GetMethodID(surface_texture_class, "<init>", "(I)V") : nullptr;
+    jmethodID set_size = surface_texture_class ? env->GetMethodID(surface_texture_class, "setDefaultBufferSize", "(II)V") : nullptr;
+    jmethodID update_method = surface_texture_class ? env->GetMethodID(surface_texture_class, "updateTexImage", "()V") : nullptr;
+    jmethodID transform_method = surface_texture_class ? env->GetMethodID(surface_texture_class, "getTransformMatrix", "([F)V") : nullptr;
+    jmethodID timestamp_method = surface_texture_class ? env->GetMethodID(surface_texture_class, "getTimestamp", "()J") : nullptr;
+    jmethodID release_method = surface_texture_class ? env->GetMethodID(surface_texture_class, "release", "()V") : nullptr;
+    if (!surface_texture_class || !constructor || !set_size || !update_method || !transform_method || !timestamp_method || !release_method) {
+        NF_LOGE("TextureUploader", "SurfaceTexture JNI methods unavailable");
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        fail();
+        return;
+    }
+    jobject local_surface_texture = env->NewObject(surface_texture_class, constructor, (jint)gles_retirement_.oes_texture);
+    if (!local_surface_texture || env->ExceptionCheck()) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        NF_LOGE("TextureUploader", "SurfaceTexture construction failed");
+        fail();
+        return;
+    }
+    // Retain the release-capable object before any later initialization can
+    // fail. Cleanup must not lose this reference on partial success.
+    gles_retirement_.release_method = reinterpret_cast<void *>(release_method);
+    gles_retirement_.surface = env->NewGlobalRef(local_surface_texture);
+    if (!gles_retirement_.surface || env->ExceptionCheck()) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        env->CallVoidMethod(local_surface_texture, release_method);
+        if (env->ExceptionCheck()) {
+            env->ExceptionClear();
+            gles_retirement_.publish(GlesRetirementStatus::JniReleaseFailed);
+        }
+        fail();
+        return;
+    }
+    env->CallVoidMethod(local_surface_texture, set_size, width, height);
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        NF_LOGE("TextureUploader", "SurfaceTexture setDefaultBufferSize failed");
+        env->DeleteLocalRef(local_surface_texture);
+        fail();
+        return;
+    }
+    jclass surface_class = env->FindClass("android/view/Surface");
+    jmethodID surface_constructor = surface_class
+        ? env->GetMethodID(surface_class, "<init>", "(Landroid/graphics/SurfaceTexture;)V") : nullptr;
+    jobject local_surface = surface_constructor
+        ? env->NewObject(surface_class, surface_constructor, local_surface_texture) : nullptr;
+    if (!local_surface || env->ExceptionCheck()) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        NF_LOGE("TextureUploader", "Surface construction failed");
+        env->DeleteLocalRef(local_surface_texture);
+        fail();
+        return;
+    }
+    gles_retirement_.window = ANativeWindow_fromSurface(env, local_surface);
+    // ANativeWindow_fromSurface has its own native reference. Release this
+    // temporary Java Surface explicitly instead of depending on later GC.
+    jmethodID surface_release = env->GetMethodID(surface_class, "release", "()V");
+    if (surface_release) env->CallVoidMethod(local_surface, surface_release);
+    if (!surface_release || env->ExceptionCheck()) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        gles_retirement_.publish(GlesRetirementStatus::JniReleaseFailed);
+        fail();
+        return;
+    }
+    env->DeleteLocalRef(local_surface);
+    jfloatArray local_matrix = env->NewFloatArray(16);
+    gles_retirement_.matrix = local_matrix ? env->NewGlobalRef(local_matrix) : nullptr;
+    if (local_matrix) env->DeleteLocalRef(local_matrix);
+    gles_update_method_ = reinterpret_cast<void *>(update_method);
+    gles_transform_method_ = reinterpret_cast<void *>(transform_method);
+    gles_timestamp_method_ = reinterpret_cast<void *>(timestamp_method);
+    gles_retirement_.release_method = reinterpret_cast<void *>(release_method);
+    env->DeleteLocalRef(local_surface_texture);
+    env->DeleteLocalRef(surface_texture_class);
+    if (!gles_retirement_.surface || !gles_retirement_.matrix || env->ExceptionCheck()) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        NF_LOGE("TextureUploader", "Failed to cache GLES SurfaceTexture JNI state");
+        fail();
+        return;
+    }
+    if (!gles_retirement_.window) {
+        NF_LOGE("TextureUploader", "ANativeWindow_fromSurface failed");
+        fail();
+        return;
+    }
+
+    glGenTextures(1, &gles_retirement_.output_texture);
+    glBindTexture(GL_TEXTURE_2D, gles_retirement_.output_texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glGenFramebuffers(1, &gles_retirement_.fbo);
+    gles_video_uniform_ = glGetUniformLocation(gles_retirement_.program, "u_video");
+    gles_matrix_uniform_ = glGetUniformLocation(gles_retirement_.program, "u_tex_matrix");
+
+    RenderingServer *rs = RenderingServer::get_singleton();
+    PackedByteArray placeholder_data;
+    placeholder_data.resize(width * height * 4);
+    placeholder_data.fill(0);
+    Ref<Image> placeholder = Image::create_from_data(width, height, false, Image::FORMAT_RGBA8, placeholder_data);
+    plane_textures[0] = ImageTexture::create_from_image(placeholder);
+    RID native_texture = rs->texture_create_from_native_handle(
+        RenderingServer::TEXTURE_TYPE_2D, Image::FORMAT_RGBA8,
+        (uint64_t)gles_retirement_.output_texture, width, height, 1);
+    if (native_texture.is_valid()) gles_retirement_.legacy_output_used_ = true;
+    if (!native_texture.is_valid() || plane_textures[0].is_null()) {
+        NF_LOGE("TextureUploader", "Godot refused GLES native output texture");
+        fail();
+        return;
+    }
+    rs->texture_replace(plane_textures[0]->get_rid(), native_texture);
+    // Export itself creates a possible Godot viewport consumer, including a
+    // blank initial frame. A later native-direct flag cannot erase this fact.
+    gles_retirement_.legacy_output_used_ = true;
+    use_shader_conversion = true;
+    is_nv12 = false;
+    current_width = width;
+    current_height = height;
+    ensure_shader_material();
+    shader_material->set_shader_parameter("tex_y", plane_textures[0]);
+    shader_material->set_shader_parameter("is_semi_planar", false);
+    shader_material->set_shader_parameter("is_nv12_rd", false);
+    shader_material->set_shader_parameter("color_matrix_type", 3);
+    shader_material->set_shader_parameter("color_range", 1);
+    shader_material->set_shader_parameter("swap_uv", false);
+
+    NF_LOG("TextureUploader", "GLES external decoder surface ready: %dx%d", width, height);
+    gles_retirement_.initialized_ = true;
+    gles_surface_ready_ = true;
+    gles_surface_cv_.notify_all();
+}
+
+void TextureUploader::update_android_gles_external_texture() {
+    RenderingServer *rs = RenderingServer::get_singleton();
+    if (!rs) return;
+    std::unique_lock<std::mutex> lock(gles_surface_mutex_);
+    ++gles_decode_call_count_;
+    if (!gles_surface_ready_ || gles_update_queued_) {
+        if (gles_surface_ready_) ++gles_decode_coalesced_count_;
+        if (gles_decode_call_count_ >= 120) {
+            NF_LOG("TextureUploader", "Decode-thread GLES request rate: %d calls, %d coalesced (render thread busy)",
+                    gles_decode_call_count_, gles_decode_coalesced_count_);
+            gles_decode_call_count_ = 0;
+            gles_decode_coalesced_count_ = 0;
+        }
+        return;
+    }
+    gles_update_queued_ = true;
+    static int queued_updates = 0;
+    if (++queued_updates <= 3) {
+        NF_LOG("TextureUploader", "Queued GLES external frame #%d", queued_updates);
+    }
+    if (gles_decode_call_count_ >= 120) {
+        NF_LOG("TextureUploader", "Decode-thread GLES request rate: %d calls, %d coalesced (render thread busy)",
+                gles_decode_call_count_, gles_decode_coalesced_count_);
+        gles_decode_call_count_ = 0;
+        gles_decode_coalesced_count_ = 0;
+    }
+    const auto queued = callable_mp(this, &TextureUploader::_render_thread_update_android_gles_texture)
+        .bind(Ref<TextureUploader>(this), static_cast<int64_t>(gles_retirement_.generation_));
+    // Godot executes immediately when already on the render thread.
+    lock.unlock();
+    rs->call_on_render_thread(queued);
+}
+
+bool TextureUploader::_render_thread_ensure_depth_capture(int width, int height) {
+    if (width <= 0 || height <= 0 || !gles_surface_ready_) return false;
+    if (gles_depth_capture_width_ == width && gles_depth_capture_height_ == height &&
+        gles_retirement_.depth_texture && gles_retirement_.depth_fbo &&
+        gles_retirement_.pbos[0]) {
+        return true;
+    }
+
+    if (!gles_retirement_.delete_depth_resources()) {
+        gles_surface_ready_ = false;
+        gles_surface_failed_ = true;
+        return false;
+    }
+    gles_depth_capture_width_ = 0;
+    gles_depth_capture_height_ = 0;
+    gles_depth_next_pbo_ = 0;
+    {
+        std::lock_guard<std::mutex> lock(gles_depth_result_mutex_);
+        gles_depth_result_.clear();
+        gles_depth_result_ready_ = false;
+    }
+
+    GLint old_fbo = 0;
+    GLint old_texture = 0;
+    GLint old_pack_buffer = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &old_fbo);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &old_texture);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &old_pack_buffer);
+
+    glGenTextures(1, &gles_retirement_.depth_texture);
+    glBindTexture(GL_TEXTURE_2D, gles_retirement_.depth_texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+
+    glGenFramebuffers(1, &gles_retirement_.depth_fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, gles_retirement_.depth_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                           gles_retirement_.depth_texture, 0);
+    const bool framebuffer_ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+
+    glGenBuffers(GLES_DEPTH_PBO_COUNT, gles_retirement_.pbos);
+    const GLsizeiptr byte_count = static_cast<GLsizeiptr>(width) * height * 4;
+    for (int i = 0; i < GLES_DEPTH_PBO_COUNT; ++i) {
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, gles_retirement_.pbos[i]);
+        glBufferData(GL_PIXEL_PACK_BUFFER, byte_count, nullptr, GL_STREAM_READ);
+    }
+
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, old_pack_buffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, old_fbo);
+    glBindTexture(GL_TEXTURE_2D, old_texture);
+
+    if (!framebuffer_ok || glGetError() != GL_NO_ERROR) {
+        NF_LOGE("TextureUploader", "Unable to initialize async GLES depth capture at %dx%d", width, height);
+        if (!gles_retirement_.delete_depth_resources()) {
+            gles_surface_ready_ = false;
+            gles_surface_failed_ = true;
+        }
+        return false;
+    }
+
+    gles_depth_capture_width_ = width;
+    gles_depth_capture_height_ = height;
+    NF_LOG("TextureUploader", "Async GLES depth capture ready: %dx%d (%d PBOs)",
+           width, height, GLES_DEPTH_PBO_COUNT);
+    return true;
+}
+
+void TextureUploader::_render_thread_poll_depth_capture() {
+    if (gles_depth_capture_width_ <= 0 || gles_depth_capture_height_ <= 0) return;
+    const size_t row_bytes = static_cast<size_t>(gles_depth_capture_width_) * 4;
+    const size_t byte_count = row_bytes * gles_depth_capture_height_;
+    GLint old_pack_buffer = 0;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &old_pack_buffer);
+
+    for (int i = 0; i < GLES_DEPTH_PBO_COUNT; ++i) {
+        if (!gles_retirement_.depth_fences[i]) continue;
+        GLsync fence = reinterpret_cast<GLsync>(gles_retirement_.depth_fences[i]);
+        GLenum wait = glClientWaitSync(fence, 0, 0);
+        if (wait != GL_ALREADY_SIGNALED && wait != GL_CONDITION_SATISFIED) {
+            if (wait == GL_WAIT_FAILED) {
+                gles_retirement_.publish(GlesRetirementStatus::FenceFailed, glGetError());
+                gles_surface_ready_ = false;
+                gles_surface_failed_ = true;
+                break; // keep the failed fence and its resource generation
+            }
+            continue;
+        }
+
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, gles_retirement_.pbos[i]);
+        const uint8_t *mapped = static_cast<const uint8_t *>(
+            glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, byte_count, GL_MAP_READ_BIT));
+        if (mapped) {
+            // glReadPixels returns the framebuffer bottom row first; keep the
+            // same top-down byte layout previously returned by Image::get_data().
+            std::vector<uint8_t> pixels(byte_count);
+            for (int y = 0; y < gles_depth_capture_height_; ++y) {
+                std::memcpy(pixels.data() + static_cast<size_t>(y) * row_bytes,
+                            mapped + static_cast<size_t>(gles_depth_capture_height_ - 1 - y) * row_bytes,
+                            row_bytes);
+            }
+            glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+            {
+                std::lock_guard<std::mutex> lock(gles_depth_result_mutex_);
+                gles_depth_result_ = std::move(pixels);
+                gles_depth_result_ready_ = true;
+            }
+        }
+        if (!gles_retirement_.delete_sync(gles_retirement_.depth_fences[i])) {
+            gles_surface_ready_ = false;
+            gles_surface_failed_ = true;
+            break;
+        }
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, old_pack_buffer);
+}
+
+void TextureUploader::_render_thread_issue_depth_capture(const float *matrix, int width, int height) {
+    if (!_render_thread_ensure_depth_capture(width, height)) return;
+
+    int slot = -1;
+    for (int offset = 0; offset < GLES_DEPTH_PBO_COUNT; ++offset) {
+        int candidate = (gles_depth_next_pbo_ + offset) % GLES_DEPTH_PBO_COUNT;
+        if (!gles_retirement_.depth_fences[candidate]) {
+            slot = candidate;
+            break;
+        }
+    }
+    if (slot < 0) {
+        static int busy_drops = 0;
+        if (++busy_drops <= 3) {
+            NF_LOG("TextureUploader", "Async GLES depth capture skipped: all PBOs busy");
+        }
+        return;
+    }
+
+    glBindFramebuffer(GL_FRAMEBUFFER, gles_retirement_.depth_fbo);
+    glViewport(0, 0, width, height);
+    glUseProgram(gles_retirement_.program);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, gles_retirement_.oes_texture);
+    glUniform1i(gles_video_uniform_, 0);
+    glUniformMatrix4fv(gles_matrix_uniform_, 1, GL_FALSE, matrix);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, gles_retirement_.pbos[slot]);
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    gles_retirement_.depth_fences[slot] = reinterpret_cast<void *>(glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0));
+    gles_depth_next_pbo_ = (slot + 1) % GLES_DEPTH_PBO_COUNT;
+}
+
+namespace {
+inline double ms_between(std::chrono::steady_clock::time_point a, std::chrono::steady_clock::time_point b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+}
+} // namespace
+
+bool TextureUploader::poll_consumer_fence_locked() {
+    bool consumer_done = true;
+    if (gles_retirement_.consumer_fence) {
+        const GLenum status = glClientWaitSync(reinterpret_cast<GLsync>(gles_retirement_.consumer_fence), 0, 0);
+        if (status == GL_WAIT_FAILED) {
+            gles_retirement_.publish(GlesRetirementStatus::FenceFailed, glGetError());
+            // A broken fence/context will never become ready by polling it.
+            // Do not reuse/free potentially live pixels, or silently freeze.
+            oes_lease_.fail();
+            latched_token_ = {};
+            gles_update_deferred_ = false;
+            gles_surface_ready_ = false;
+            gles_surface_failed_ = true;
+            NF_LOGE("Quest3DFrame", "OES consumer fence failed; stopping stream, resources retained for safe teardown");
+            _queue_gles_surface_failed_locked();
+            return false;
+        }
+        consumer_done = status == GL_ALREADY_SIGNALED || status == GL_CONDITION_SATISFIED;
+        if (consumer_done) {
+            if (!gles_retirement_.delete_sync(gles_retirement_.consumer_fence)) {
+                oes_lease_.fail();
+                gles_surface_ready_ = false;
+                gles_surface_failed_ = true;
+                _queue_gles_surface_failed_locked();
+                return false;
+            }
+        }
+    }
+    return consumer_done;
+}
+
+void TextureUploader::_render_thread_update_android_gles_texture(Ref<TextureUploader> keep_alive, int64_t generation) {
+    const auto t_frame_start = std::chrono::steady_clock::now();
+    std::unique_lock<std::mutex> frame_lock(gles_surface_mutex_);
+    if (static_cast<uint64_t>(generation) != gles_retirement_.generation_) return;
+    gles_update_queued_ = false;
+    if (!gles_retirement_.accepts_update(static_cast<uint64_t>(generation))) return;
+    if (!gles_surface_ready_) return;
+    const bool consumer_done = poll_consumer_fence_locked();
+    if (!gles_surface_ready_) return;
+    if (!oes_lease_.can_update(consumer_done)) {
+        gles_update_deferred_ = true;
+        call_deferred("retry_oes_update");
+        return;
+    }
+    gles_update_deferred_ = false;
+    // A failed JNI/GL update cannot leave a previously trusted descriptor
+    // attached to pixels whose contents might already have changed.
+    oes_lease_.invalidate();
+    latched_token_ = {};
+    if (!gles_retirement_.surface || !gles_retirement_.matrix || !gles_retirement_.fbo || !gles_retirement_.program) return;
+    JavaVM *vm = nullptr;
+    JNIEnv *env = get_gles_jni_env(vm);
+    if (!env || !gles_update_method_ || !gles_transform_method_ || !gles_timestamp_method_) return;
+    auto update = reinterpret_cast<jmethodID>(gles_update_method_);
+    auto transform = reinterpret_cast<jmethodID>(gles_transform_method_);
+    auto java_matrix = reinterpret_cast<jfloatArray>(gles_retirement_.matrix);
+    const auto t_update_start = std::chrono::steady_clock::now();
+    env->CallVoidMethod((jobject)gles_retirement_.surface, update);
+    const auto t_update_end = std::chrono::steady_clock::now();
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        static int update_failures = 0;
+        if (++update_failures <= 3) NF_LOGE("TextureUploader", "SurfaceTexture updateTexImage failed");
+        return;
+    }
+    float matrix[16]{};
+    const auto t_transform_start = std::chrono::steady_clock::now();
+    env->CallVoidMethod((jobject)gles_retirement_.surface, transform, java_matrix);
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        return;
+    }
+    env->GetFloatArrayRegion(java_matrix, 0, 16, matrix);
+    const int64_t timestamp_ns = env->CallLongMethod((jobject)gles_retirement_.surface,
+        reinterpret_cast<jmethodID>(gles_timestamp_method_));
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+        latched_token_ = {};
+        oes_lease_.invalidate();
+        return;
+    }
+    const auto t_transform_end = std::chrono::steady_clock::now();
+    memcpy(gles_last_transform_matrix_, matrix, sizeof(matrix));
+    // Repeated submissions of the same pixels must not renew their age.
+    if (timestamp_ns != latched_timestamp_ns_ || pixel_latched_at_us_ == 0) {
+        pixel_latched_at_us_ = std::chrono::duration_cast<std::chrono::microseconds>(
