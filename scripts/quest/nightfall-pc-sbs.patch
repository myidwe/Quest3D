+void NightfallStream::_retire_for_teardown() {
+    if (retiring_) return;
+    retiring_ = true; // Before stop: it can dispatch synchronous callbacks.
+    set_process(false);
+    set_block_signals(true); // Only terminal retirement; normal stop still emits.
+    stop_stream();
+    _reset_reconnect();
+}
