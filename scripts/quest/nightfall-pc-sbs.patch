+		for control in [app._ui_exit_btn, app._ui_close_btn, app._ui_disconnect_btn, app._ui_status_label, pc._pointer_button, pc._actual_pointer_button, pc._label, pc._pointer_label] + pc._buttons:
+			assert(viewport_rect.encloses(control.get_global_rect()), "Critical control outside viewport: " + control.name)
