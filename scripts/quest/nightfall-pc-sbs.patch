-
-        if (FAILED(hr)) {
-            ma_log_post(ma_device_get_log(pDevice), MA_LOG_LEVEL_ERROR, "[WASAPI] Failed to reset internal playback device.");
-            return ma_result_from_HRESULT(hr);
-        }
-
-        ma_atomic_bool32_set(&pDevice->wasapi.isStartedPlayback, MA_FALSE);
