+void AndroidMediaCodec::_delete_failed_attempt() {
+    // Codec deletion unregisters callbacks as well. Preserve a failed result
+    // across tuning retries and the final shutdown; a later success cannot
+    // prove this earlier decoder was released.
+    const media_status_t status = AMediaCodec_delete(codec_);
+    if (status != AMEDIA_OK && prior_delete_error_ == AMEDIA_OK) {
+        prior_delete_error_ = status;
+        NF_LOGE("AndroidMediaCodec", "failed-attempt delete failed: %d", status);
+    }
+    codec_ = nullptr;
+    codec_callback_registered_ = false;
+}
+
+void AndroidMediaCodec::_shutdown_locked() {
+    if (retirement_ || lifetime_.generation == 0) return;
+    std::shared_ptr<CodecRetirement> result(new CodecRetirement);
+    result->lifetime_ = lifetime_;
+    result->initialized_ = initialized_successfully_;
+    result->prior_delete_error_ = prior_delete_error_;
+    result->outstanding_images_ = outstanding_images_.load();
+    const bool was_started = started_.exchange(false);
+    buffer_cache_supported_.store(false);
+    {
+        std::lock_guard<std::mutex> lock(event_mutex_);
+        stopping_ = true;
+    }
+    event_cv_.notify_all();
+    _notify_event();
+
+    // Unregister native callbacks before destroying their context. The NDK
+    // guarantees codec callbacks are not delivered after unregistration.
+    if (codec_ && codec_callback_registered_) {
+        AMediaCodecOnAsyncNotifyCallback callbacks{};
+        result->callback_status_ = AMediaCodec_setAsyncNotifyCallback(codec_, callbacks, nullptr);
+    }
+    if (reader_) {
+        if (image_listener_registered_)
+            result->image_listener_status_ = AImageReader_setImageListener(reader_, nullptr);
+        if (buffer_listener_registered_)
+            result->buffer_listener_status_ = AImageReader_setBufferRemovedListener(reader_, nullptr);
+    }
+
+    // Wait for a callback that entered immediately before unregistration.
+    {
+        std::lock_guard<std::mutex> callback_lock(callback_mutex_);
+    }
+    result->callback_barrier_returned_ = true;
+
+    if (codec_) {
+        if (was_started) {
+            result->stop_status_ = AMediaCodec_stop(codec_);
+        }
+        result->delete_status_ = AMediaCodec_delete(codec_);
+        codec_ = nullptr;
+    }
+    codec_name_.clear();
+
+    if (owns_external_window_ && window_) {
+        ANativeWindow_release(window_);
+    }
+    window_ = nullptr;
+    owns_external_window_ = false;
+    external_surface_output_ = false;
+    result->window_release_returned_ = true;
+    if (reader_) {
+        AImageReader_delete(reader_);
+        reader_ = nullptr;
+    }
+    result->reader_delete_returned_ = true;
+    codec_callback_registered_ = false;
+    image_listener_registered_ = false;
+    buffer_listener_registered_ = false;
+
+    {
+        std::lock_guard<std::mutex> lock(event_mutex_);
+        available_input_indices_.clear();
+        available_output_events_.clear();
+        pending_output_ = OutputEvent{};
+        pending_output_valid_ = false;
