+extends SceneTree
+
+# The production _try_auto_connect(), StreamManager.start_stream(), app-list
+# selection, UI signal handlers, lifecycle, cancel, and shutdown code run intact.
+# Only native/network operations and the post-validation media startup boundary
+# are replaced. The one-second auto-connect timer is the production timer.
+class QuietMain extends "res://main.gd":
+	func _ready(): pass
+	func _process(_delta): pass
+
+class NoDiskState extends StateManager:
+	func save_state(): pass
+	func save_host_state(): pass
+	func load_host_state(_ip: String): pass
+
+class NoDeviceSettings extends SettingsController:
+	func apply_passthrough(_enabled): pass
+	func detect_polaris_host(_ip: String, _host_id: int): pass
+
+class FixtureConfig extends RefCounted:
+	var hosts: Array = [
+		{"id": 17, "localaddress": "192.0.2.17", "hostname": "Fixture A", "server_unique_id": "fixture-A", "server_cert_verified": true, "srvcert": "test-cert-A"},
+		{"id": 28, "localaddress": "192.0.2.28", "hostname": "Fixture B", "server_unique_id": "fixture-B", "server_cert_verified": true, "srvcert": "test-cert-B"},
+	]
+	func get_hosts() -> Array: return hosts
+	func get_apps(_host_id: int) -> Array: return []
+	func load_config(): pass
+
+class HeldBackend extends StreamBackend:
+	var start_entries := 0
+	var pending: Array[Callable] = []
+	var fetches: Array[int] = []
+	func _init():
+		super(null)
+		set_config_manager(FixtureConfig.new())
+	func set_pc_frame_input_required(required: bool):
+		super(required)
+		if required: start_entries += 1
+	func fetch_app_list_snapshot(host_id: int, callback: Callable):
+		fetches.append(host_id)
+		pending.append(callback)
+	func start_pair(_ip: String, _port: int = 47989) -> String: return "4321"
+	func release_all():
+		var callbacks := pending.duplicate()
+		pending.clear()
+		for callback in callbacks:
+			callback.call({"success": true, "pc_profile": true, "xml": '<root status_code="200"><App><ID>1</ID><AppTitle>Quest3D Desktop</AppTitle></App></root>'})
+
+class ObservedStreamManager extends StreamManager:
+	var validated: Array = []
+	# Intercept only AFTER the real start_stream authorization and generation check.
+	func _start_validated_stream(host_id: int, app_id: int, forced: Vector2i, generation: int):
+		validated.append({"host": host_id, "app": app_id, "generation": generation, "forced_resolution": str(forced)})
+
+var failures: Array[String] = []
+var results: Array = []
+
+func _init(): _run.call_deferred()
+
+func _make_app():
+	var app = load("res://main.tscn").instantiate()
+	app.set_script(QuietMain)
+	root.add_child(app)
+	app._init_modules()
+	app.state_manager = NoDiskState.new(app)
+	app.settings_controller = NoDeviceSettings.new(app)
+	app.stream_backend = HeldBackend.new()
+	app.stream_manager = ObservedStreamManager.new(app)
+	app.screen_mesh.material_override = ShaderMaterial.new()
+	app.screen_mesh.material_override.shader = load("res://src/shaders/yuv_display.gdshader")
+	app._init_ui()
+	app.comp = CompositionLayerManager.new(app)
+	app.comp.available = false
+	app.video_presentation.set_legacy_renderer(app.comp)
+	app.primary_screen.comp_shader_mat = app.screen_mesh.material_override
+	app.primary_screen.comp_viewport = SubViewport.new()
+	app.add_child(app.primary_screen.comp_viewport)
+	app.depth_estimator.setup()
+	app.current_host_id = 17
+	app.get_node("%IPInput").text = "192.0.2.17"
+	app.settings.quick_start_enabled = true
+	app.session_lifecycle.show_server_selection()
+	# Keep the production config read deterministic across independent cases.
+	var saved := ConfigFile.new()
+	saved.set_value("connection", "ip", "192.0.2.17")
+	saved.set_value("connection", "server_unique_id", "fixture-A")
+	saved.save("user://last_connection.cfg")
+	app.welcome_screen.show_welcome_screen("welcome")
+	return app
+
+func _check(ok: bool, message: String):
+	if not ok: failures.append(message)
+	print(("PASS " if ok else "FAIL ") + message)
+
+func _scenario(name: String):
+	var app = _make_app()
+	await process_frame
+	var backend: HeldBackend = app.stream_backend
+	var manager: ObservedStreamManager = app.stream_manager
+	# Complete the welcome screen's own catalog refresh before measuring starts.
+	backend.release_all()
+	await create_timer(0.06).timeout
+	backend.fetches.clear()
+	app._try_auto_connect()
+	await create_timer(0.15).timeout
+	var expected_entries := 0
+	match name:
+		"auto_allowed": expected_entries = 1
+		"manual_connect":
+			var button: Button = app.welcome_viewport.get_node("WelcomeRoot/Screens/WelcomeScreen/WelcomeConnect")
+			button.pressed.emit()
+			expected_entries = 1
+		"cancel": app.disconnect_stream()
+		"host_changed":
+			app.welcome_screen.populate_server_list()
+			var list = app.welcome_viewport.get_node("WelcomeRoot/Screens/ServerScreen/ServerList")
+			for button in list.get_children():
+				if button is Button and "192.0.2.28" in button.text:
+					button.pressed.emit()
+					break
+		"pairing": app.welcome_screen.start_pair("192.0.2.99")
+		"shutdown": app._begin_shutdown(true)
+		"quick_start_off": app.settings_controller.cycle_quick_start()
+		"tree_exit": root.remove_child(app)
+	var event_generation: int = app.session_lifecycle.connection_generation
+	var event_phase: String = app.session_lifecycle.phase_name()
+	await create_timer(1.1).timeout
+	var observed := {"case": name, "start_entries": backend.start_entries, "expected_start_entries": expected_entries, "fetch_hosts": backend.fetches.duplicate(), "event_generation": event_generation, "after_generation": app.session_lifecycle.connection_generation, "event_phase": event_phase, "after_phase": app.session_lifecycle.phase_name(), "current_host": app.current_host_id, "shutdown": app._shutdown_started, "quick_start": app.settings.quick_start_enabled}
+	_check(backend.start_entries == expected_entries, name + ": start_entries=%d expected=%d" % [backend.start_entries, expected_entries])
+	if name != "auto_allowed":
+		_check(app.session_lifecycle.connection_generation == event_generation, name + ": delayed auto must preserve post-event generation %d; observed=%d" % [event_generation, app.session_lifecycle.connection_generation])
+	backend.release_all()
+	await create_timer(0.06).timeout
+	if name == "manual_connect":
+		_check(manager.validated.size() == 1 and manager.validated[0].generation == event_generation, "manual_connect: delayed auto must not supersede the accepted manual intent")
+	elif name != "auto_allowed":
+		_check(manager.validated.is_empty(), name + ": stale auto must not reach validated media startup")
+	observed["validated"] = manager.validated.duplicate(true)
+	results.append(observed)
+	print("OBSERVATION " + JSON.stringify(observed))
+	app.free()
+	await process_frame
+
+func _duplicate_start():
+	var app = _make_app()
+	await process_frame
+	var backend: HeldBackend = app.stream_backend
+	var manager: ObservedStreamManager = app.stream_manager
+	backend.release_all()
+	await create_timer(0.06).timeout
+	backend.fetches.clear()
+	manager.start_stream(17, 1)
+	var first_generation: int = app.session_lifecycle.connection_generation
+	manager.start_stream(17, 1)
+	var second_generation: int = app.session_lifecycle.connection_generation
+	_check(backend.fetches.size() == 1, "duplicate_start: pending authenticated fetches=%d expected=1" % backend.fetches.size())
+	_check(first_generation == second_generation, "duplicate_start: first generation=%d must stay current; observed=%d" % [first_generation, second_generation])
+	backend.release_all()
+	await create_timer(0.08).timeout
+	_check(manager.validated.size() == 1 and manager.validated[0].generation == first_generation, "duplicate_start: original accepted intent must reach validation")
+	var observed := {"case": "duplicate_start", "fetch_hosts": backend.fetches.duplicate(), "first_generation": first_generation, "second_generation": second_generation, "validated": manager.validated.duplicate(true)}
+	results.append(observed)
+	print("OBSERVATION " + JSON.stringify(observed))
+	app.free()
+	await process_frame
+
+func _followup_start(name: String):
+	var app = _make_app()
+	await process_frame
+	var backend: HeldBackend = app.stream_backend
+	var manager: ObservedStreamManager = app.stream_manager
+	backend.release_all()
+	await create_timer(0.06).timeout
+	backend.fetches.clear()
+	manager.start_stream(17, 1)
+	backend.release_all()
+	await create_timer(0.06).timeout
+	_check(manager.validated.size() == 1, name + ": first request reaches validated startup")
+	var first_generation: int = app.session_lifecycle.connection_generation
+	match name:
+		"after_stream_started": app.session_lifecycle.stream_started()
+		"after_fail": app.restore_after_failed_connect("Fixture failure")
+		"after_cancel": app.disconnect_stream()
+		"settings_restart":
+			app.session_lifecycle.stream_started()
+			# Invoke the real settings restart coroutine through its timer and
+			# native teardown boundary, with the no-native backend installed.
+			app.settings_controller._schedule_stream_restart()
+			await create_timer(1.45).timeout
+		"resolution_retry":
+			# Exact lifecycle and argument state of main._on_stream_started's
+			# correction retry; native frame ingestion is outside this fixture.
+			app.session_lifecycle.stream_started()
+			app.session_lifecycle.request_restart()
+			manager._resolution_retry_done = true
+			manager.start_stream(17, 1, Vector2i(2560, 1440))
+	if name in ["after_stream_started", "after_fail", "after_cancel"]:
+		# Settle UI catalog refreshes caused by fail/disconnect cleanup first.
+		backend.release_all()
+		await create_timer(0.06).timeout
+		manager.start_stream(17, 1)
+	_check(backend.start_entries == 2, name + ": later request remains available after pending is cleared")
+	backend.release_all()
+	await create_timer(0.08).timeout
+	_check(manager.validated.size() == 2 and manager.validated[-1].generation > first_generation, name + ": later accepted intent reaches validated startup")
+	if name == "resolution_retry":
+		_check(manager.validated.size() == 2 and manager.validated[-1].forced_resolution == "(2560, 1440)", "resolution_retry: forced resolution is preserved")
+	var observed := {"case": name, "start_entries": backend.start_entries, "first_generation": first_generation, "validated": manager.validated.duplicate(true)}
+	results.append(observed)
+	print("OBSERVATION " + JSON.stringify(observed))
+	app.free()
+	await process_frame
+
+func _run():
+	var cases := ["auto_allowed", "manual_connect", "cancel", "host_changed", "pairing", "shutdown", "quick_start_off", "tree_exit"]
+	var only_case := OS.get_environment("AUTOCONNECT_RACE_CASE")
+	if not only_case.is_empty(): cases = [only_case]
+	for name in cases:
+		await _scenario(name)
+	if only_case.is_empty():
+		await _duplicate_start()
+		for name in ["after_stream_started", "after_fail", "after_cancel", "settings_restart", "resolution_retry"]:
+			await _followup_start(name)
+	var output := FileAccess.open("user://results.json", FileAccess.WRITE)
+	output.store_string(JSON.stringify({"failures": failures, "results": results}, "  "))
+	output.close()
+	print("AUTOCONNECT_RACE_RESULT failures=%d cases=%d" % [failures.size(), results.size()])
+	quit(1 if not failures.is_empty() else 0)
diff --git a/test/test_reconnect_terminal_order.gd b/test/test_reconnect_terminal_order.gd
new file mode 100644
index 0000000..bf57560
--- /dev/null
+++ b/test/test_reconnect_terminal_order.gd
@@ -0,0 +1,131 @@
+extends "res://test/test_stream_teardown.gd"
+
+# The producer below models only the native signal ordering. All lifecycle,
+# status, cleanup, and reconnect handlers under test are production main.gd.
+# This does not execute Moonlight or establish a real Quest transport.
+class ReconnectEvents extends Node:
+	signal reconnect_scheduled(attempt: int, maximum: int, delay_ms: int)
+	signal reconnect_failed
+	var native_state := 4 # NightfallStream::STATE_RECONNECTING.
+
+	func get_state() -> int:
+		return native_state
+
+	func schedule_then_fail():
+		# Native stage_failed schedules this through call_deferred. A following
+		# stream_terminated can exhaust the budget and fail synchronously first.
+		call_deferred("emit_signal", "reconnect_scheduled", 5, 5, 30000)
+		native_state = 3 # STATE_DISCONNECTED after the failed attempt.
+		emit_signal("reconnect_failed")
+
+	func schedule():
+		call_deferred("emit_signal", "reconnect_scheduled", 1, 5, 2000)
+
+var checks_failed := 0
+
+func _check(value: bool, message: String):
+	if not value:
+		checks_failed += 1
+		printerr("REGRESSION FAIL: " + message)
+
+func _make_connected_app():
+	var app = _make_app()
+	app.get_node("%IPInput").text = "192.0.2.1"
+	app.settings.auto_reconnect_enabled = true
+	app.start_connect_timeout()
+	app.session_lifecycle.stream_started()
+	return app
+
+func _events(app):
+	var events := ReconnectEvents.new()
+	app.add_child(events)
+	events.reconnect_scheduled.connect(func(attempt: int, maximum: int, delay_ms: int):
+		# Supply only the real native get_state contract while the scheduled
+		# handler executes; cleanup keeps using the actual headless adapter.
+		var previous_native: Node = app.stream_backend._v2
+		app.stream_backend._v2 = events
+		app._on_reconnect_scheduled(attempt, maximum, delay_ms)
+		app.stream_backend._v2 = previous_native)
+	events.reconnect_failed.connect(app._on_reconnect_failed)
+	return events
+
+func _run():
+	# Keep a real current retry working, with the existing countdown and no
+	# cleanup. A blanket reconnect suppression would fail this control case.
+	var app = _make_connected_app()
+	var events = _events(app)
+	app._on_stream_terminated("Network lost", -92)
+	events.schedule()
+	await process_frame
+	_check(app.session_lifecycle.is_reconnecting(), "live retry must retain reconnect intent")
+	_check(app.cleanup_count == 0, "live retry must not clean up")
+	_check(app._ui_status_label.tooltip_text == "Reconnecting 1/5 in 2s...", "live retry must retain its countdown")
+	app.free()
+
+	# This is the bad FIFO ordering: a deferred scheduled callback arrives
+	# after the synchronous exhausted-budget callback already cleaned up.
+	for initial_phase in ["connecting", "streaming"]:
+		app = _make_connected_app()
+		if initial_phase == "connecting":
+			app.session_lifecycle.show_server_selection()
+			app.start_connect_timeout()
+		events = _events(app)
+		app._on_stream_terminated("RTSP handshake failed", -92)
+		events.schedule_then_fail()
+		_check(app.session_lifecycle.phase == SessionLifecycle.Phase.FAILED, initial_phase + " must fail before deferred delivery")
+		await process_frame
+		await process_frame
+		print("RECONNECT_TERMINAL_RESULT initial=%s phase=%s pending=%s cleanup=%d status=%s" % [
+			initial_phase, app.session_lifecycle.phase_name(), app.session_lifecycle.connect_timeout_pending,
+			app.cleanup_count, app._ui_status_label.tooltip_text])
+		_check(app.session_lifecycle.phase == SessionLifecycle.Phase.FAILED, initial_phase + " delayed scheduled callback must not resurrect retry")
+		_check(not app.session_lifecycle.connect_timeout_pending, initial_phase + " must retain cancelled timeout")
+		_check(app.cleanup_count == 1, initial_phase + " must retain exactly one cleanup")
+		_check(app._ui_status_label.tooltip_text == "Reconnect failed", initial_phase + " must retain terminal status")
+		app.free()
+
+	# A late countdown must likewise respect user disconnect, terminal native
+	# refusal, and shutdown; none of them has a native retry to wait for.
+	for terminal in ["disconnect", "surface", "shutdown"]:
+		app = _make_connected_app()
+		events = _events(app)
+		app._on_stream_terminated("Network lost", -92)
+		events.schedule()
+		if terminal == "disconnect":
+			app.disconnect_stream()
+		elif terminal == "surface":
+			app._on_stream_terminated("Graphics synchronization failed", -5501)
+		else:
+			app._begin_shutdown(false)
+		var expected_phase: int = app.session_lifecycle.phase
+		var expected_status: String = app._ui_status_label.tooltip_text
+		await process_frame
+		await process_frame
+		_check(app.session_lifecycle.phase == expected_phase, terminal + " delayed countdown must preserve lifecycle")
+		_check(app._ui_status_label.tooltip_text == expected_status, terminal + " delayed countdown must preserve status")
+		_check(not app.session_lifecycle.is_reconnecting(), terminal + " must not return to retry")
+		app.free()
+
+	# An old deferred countdown also cannot relabel a newer manual attempt or
+	# a successful stream. These have not necessarily performed final cleanup.
+	for native_state in [1, 2, 3]:
+		app = _make_connected_app()
+		events = _events(app)
+		events.native_state = native_state
+		if native_state == 1:
+			app.session_lifecycle.show_server_selection()
+			app.start_connect_timeout()
+		elif native_state == 3:
+			app._on_stream_terminated("Network lost", -92)
+		var expected_phase: int = app.session_lifecycle.phase
+		var expected_status: String = app._ui_status_label.tooltip_text
+		events.schedule()
+		await process_frame
+		await process_frame
+		_check(app.session_lifecycle.phase == expected_phase, "native state %d must reject a stale countdown" % native_state)
+		_check(app._ui_status_label.tooltip_text == expected_status, "native state %d must retain current status" % native_state)
+		_check(app.cleanup_count == 0, "native state %d stale countdown must not clean up" % native_state)
+		app.free()
+
+	print("RECONNECT_TERMINAL_ORDER checks_failed=%d actual_main_handlers=true actual_moonlight=false actual_quest=false" % checks_failed)
+	quit(1 if checks_failed else 0)
diff --git a/test/test_surface_sync_terminal.gd b/test/test_surface_sync_terminal.gd
new file mode 100644
index 0000000..01068cc
--- /dev/null
+++ b/test/test_surface_sync_terminal.gd
@@ -0,0 +1,44 @@
+extends "res://test/test_stream_teardown.gd"
+
+var checks_failed := 0
+const SURFACE_ERROR := -5501
+const SURFACE_MESSAGE := "Graphics synchronization failed. Restart the Quest app before reconnecting."
+
+func _check(value: bool, message: String):
+	if not value:
+		checks_failed += 1
+		printerr("REGRESSION FAIL: " + message)
+
+func _run():
+	for reconnect_enabled in [false, true]:
+		for phase_name in ["connecting", "streaming", "reconnecting", "restarting"]:
+			var app = _make_app()
+			await process_frame
+			app.get_node("%IPInput").text = "192.0.2.1"
+			app.settings.auto_reconnect_enabled = reconnect_enabled
+			if phase_name == "connecting":
+				app.start_connect_timeout()
+			else:
+				app.session_lifecycle.stream_started()
+				if phase_name == "reconnecting":
+					app.session_lifecycle.reconnect_scheduled()
+				elif phase_name == "restarting":
+					app.session_lifecycle.request_restart()
+			var connect_button = app.welcome_viewport.get_node("WelcomeRoot/Screens/WelcomeScreen/WelcomeConnect")
+			connect_button.text = "Connecting..."
+			connect_button.disabled = true
+			app._on_stream_terminated(SURFACE_MESSAGE, SURFACE_ERROR)
+			var tag := "auto=%s initial=%s" % [reconnect_enabled, phase_name]
+			print("SURFACE_SYNC_RESULT %s phase=%s pending=%s cleanup=%d button=%s disabled=%s" % [
+				tag, app.session_lifecycle.phase_name(), app.session_lifecycle.connect_timeout_pending,
+				app.cleanup_count, connect_button.text, connect_button.disabled])
+			_check(app.session_lifecycle.phase == SessionLifecycle.Phase.FAILED, tag + " must be a terminal failure because native never retries this code")
+			_check(not app.session_lifecycle.connect_timeout_pending, tag + " must retire connection timeout")
+			_check(app.cleanup_count == 1, tag + " must restore welcome exactly once")
+			_check(not connect_button.disabled and connect_button.text != "Connecting...", tag + " must restore the Connect action")
+			_check(app._ui_status_label.tooltip_text.contains(SURFACE_MESSAGE), tag + " must retain the explicit restart instruction")
+			app._on_stream_terminated(SURFACE_MESSAGE, SURFACE_ERROR)
+			_check(app.cleanup_count == 1, tag + " duplicate error must not repeat cleanup")
+			app.free()
+	print("SURFACE_SYNC_TERMINAL checks_failed=%d" % checks_failed)
+	quit(1 if checks_failed else 0)
