-
-    /* The cooperative level must be set before doing anything else. */
-    hWnd = (HWND)pContext->dsound.hWnd;
-    if (hWnd == 0) {
-        hWnd = ((MA_PFN_GetForegroundWindow)pContext->win32.GetForegroundWindow)();
