-MA_API ma_uint32 ma_calculate_buffer_size_in_milliseconds_from_frames(ma_uint32 bufferSizeInFrames, ma_uint32 sampleRate)
-{
-    /* Prevent a division by zero. */
-    if (sampleRate == 0) {
-        return 0;
-    }
-
-    return (bufferSizeInFrames*1000 + (sampleRate - 1)) / sampleRate;
