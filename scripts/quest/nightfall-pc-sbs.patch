+extends SceneTree
+
+class NoRestartSettings extends SettingsController:
+	var restarts := 0
+	func _schedule_stream_restart():
+		restarts += 1
+	func _save_setting(_button: Button, _text: String):
+		pass
+
+class RecordedRenderer extends RefCounted:
+	var calls: Array = []
+	func set_geometry(transform: Transform3D, width: float, height: float, curvature: int,
+			radius: float, angle: float, sort_order: int, bezel: bool):
+		calls.append({"transform": transform, "width": width, "height": height,
+			"curvature": curvature, "radius": radius, "angle": angle,
+			"sort_order": sort_order, "bezel": bezel})
+	func set_compositor_sharpening(_value: int):
+		pass
+
+class RecordedState extends StateManager:
+	var saved := 0
+	func save_host_state():
+		saved += 1
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	var app = load("res://main.gd").new()
+	var screen: VRScreen = load("res://src/vr_screen.tscn").instantiate()
+	root.add_child(screen)
+	screen.setup(app)
+	screen.curvature = 0
+	screen.create_corner_handles()
+	screen.position = Vector3(0, 0, -3)
+	var camera := XRCamera3D.new()
+	root.add_child(camera)
+	app.xr_camera = camera
+	app.screen_registry.initialize(screen)
+	app.screen_manager = ScreenManager.new(app)
+	var settings := NoRestartSettings.new(app)
+	app.settings_controller = settings
+	var state := RecordedState.new(app)
+	app.state_manager = state
+	app.ui_controller = UIController.new(app)
+	app.pc_control = PcControl.new(app)
+	app._btn_style = StyleBoxFlat.new()
+	app._btn_hover = StyleBoxFlat.new()
+	app.settings.host.pc_profile_resolution = Vector2i(2560, 720)
+	var combined := ScreenLayout.single(Vector2i(2560, 720))
+	screen.apply_monitor(combined.monitors[0], combined.frame_size)
+	app.screen_manager.resize_screen_to_aspect(2560, 720)
+	assert(app.screen_manager.presentation_content_size(screen) == Vector2i(1280, 720))
+	assert(is_equal_approx(app.screen_manager.presentation_aspect(screen), 16.0 / 9.0))
+	var original_size := screen.mesh_size
+	var original_position := screen.global_position
+	var original_uv := screen.uv_region
+	var original_resolution: Vector2i = app.compute_requested_resolution()
+	var original_index: int = app.settings.host.resolution_idx
+	var pointer_generation: int = app.pc_control.pointer._generation
+	var panel := VBoxContainer.new()
+	root.add_child(panel)
+	var display: VBoxContainer = app.ui_controller._build_menu_tab(panel, MenuSchema.get_tab(&"display"))
+	app.ui_controller._tab_stream = app.ui_controller._build_menu_tab(panel, MenuSchema.get_tab(&"stream"))
+	app.ui_controller._build_presentation_controls(display)
+	await process_frame
+	await process_frame
+	var minimum: Vector2 = display.get_combined_minimum_size()
+	assert(minimum.x <= 1200 and minimum.y <= 444, "Display content fits the existing 1200x580 menu after its 136px header")
+	assert(app.ui_controller._stream_source_note.visible)
+	assert("content bars" in app.ui_controller._stream_source_note.text)
+	assert(app.ui_controller._presentation_buttons.size() == 4)
+	# Execute actual signal wiring, not a duplicate of the implementation.
+	app.ui_controller._presentation_buttons[1].button_down.emit()
+	assert(screen.mesh_size.x > original_size.x)
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, 16.0 / 9.0))
+	assert(screen.global_position == original_position and screen.uv_region == original_uv)
+	assert(app.pc_control.pointer._generation > pointer_generation)
+	app.ui_controller._presentation_buttons[0].button_down.emit()
+	assert(screen.mesh_size.is_equal_approx(original_size))
+	app.ui_controller._presentation_buttons[2].button_down.emit()
+	assert(is_equal_approx(screen.global_position.length(), 2.75))
+	assert(screen.mesh_size.is_equal_approx(original_size))
+	app.ui_controller._presentation_buttons[3].button_down.emit()
+	assert(screen.global_position.is_equal_approx(original_position))
+	assert("1280x720 per eye" in app.ui_controller._presentation_label.text)
+	assert(app.compute_requested_resolution() == original_resolution and settings.restarts == 0)
+	assert(app.settings.host.resolution_idx == original_index)
+	assert(state.saved == 4, "Each completed local panel edit persists the host screen placement")
+
+	# Real script-to-native bridge passes updated world size/pose without a start.
+	var renderer := RecordedRenderer.new()
+	var native := NativeXrRendererManager.new(app)
+	native.renderer = renderer
+	native.active = true
+	native._sync_geometry()
+	var first: Dictionary = renderer.calls[-1]
+	app.screen_manager.scale_primary_screen(1.1)
+	app.screen_manager.move_primary_screen(0.25)
+	native._sync_geometry()
+	var changed: Dictionary = renderer.calls[-1]
+	assert(changed.width > first.width and changed.transform.origin != first.transform.origin)
+	assert(is_equal_approx(changed.width / changed.height, 16.0 / 9.0))
+
+	# The stream-resolution preset is not a screen-aspect control under Full-SBS.
+	settings.refresh_resolution_btn_label()
+	assert(app._ui_res_btn.disabled and "1280x720 /eye" in app._ui_res_btn.text)
+	assert("Smaller/Larger" in app._ui_res_btn.tooltip_text)
+	settings.cycle_resolution()
+	assert(settings.restarts == 0 and app.settings.host.resolution_idx == original_index)
+	assert(app.compute_requested_resolution() == original_resolution)
+
+	# A generic saved monitor layout must not replace the pinned PC source aspect.
+	app.settings.host.pc_profile_resolution = Vector2i(3200, 900)
+	app.screen_manager.resize_screen_to_aspect(1920, 1080)
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, 16.0 / 9.0))
+	assert(app.screen_manager.presentation_content_size(screen) == Vector2i(1600, 900))
+	# Simulate a placement restored after the layout update. Exercise the actual
+	# geometry handoff: preserve the user's width, pose and UVs, correct height.
+	var restored_width := 2.7104
+	screen.mesh_size = Vector2(restored_width, 0.9)
+	var restored_pose := screen.global_transform
+	var saved_before: int = state.saved
+	var generation_before: int = app.pc_control.pointer._generation
+	native._sync_geometry()
+	var repaired: Dictionary = renderer.calls[-1]
+	assert(is_equal_approx(repaired.width, restored_width))
+	assert(is_equal_approx(repaired.width / repaired.height, 16.0 / 9.0))
+	assert(repaired.transform.is_equal_approx(restored_pose) and screen.uv_region == original_uv)
+	assert(app.pc_control.pointer._generation == generation_before + 1)
+	assert(state.saved == saved_before and settings.restarts == 0)
+	var repaired_generation: int = app.pc_control.pointer._generation
+	native._sync_geometry()
+	assert(app.pc_control.pointer._generation == repaired_generation,
+		"Stable geometry must not invalidate input or persist state every frame")
+	assert(state.saved == saved_before and settings.restarts == 0)
+
+	# Future ultrawide input uses its own per-eye aspect, not a 16:9 constant.
+	app.settings.host.pc_profile_resolution = Vector2i(5120, 1080)
+	assert(app.screen_manager.presentation_content_size(screen) == Vector2i(2560, 1080))
+	app.screen_manager.scale_primary_screen(1.0)
+	var ultrawide_aspect := 2560.0 / 1080.0
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, ultrawide_aspect))
+	screen.mesh_size = Vector2(restored_width, 2.0)
+	native._sync_geometry()
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, ultrawide_aspect))
+	screen.begin_corner_resize()
+	screen.apply_corner_resize(Vector3(1, 0, 0), Vector3(0, 0, -1), 1, app.screen_manager.presentation_aspect(screen))
+	screen.apply_corner_resize(Vector3(1.2, 0, 0), Vector3(0, 0, -1), 1, app.screen_manager.presentation_aspect(screen))
+	assert(is_equal_approx(screen.mesh_size.x / screen.mesh_size.y, ultrawide_aspect))
+	assert(screen.uv_region == original_uv)
+	assert(app.screen_manager.content_size_for_screen(screen, Vector2i(2561, 720)) == Vector2i.ZERO)
+
+	# Bounds and bad values cannot distort geometry or produce an invalid cylinder.
+	assert(not app.screen_manager.scale_primary_screen(NAN))
+	assert(not app.screen_manager.move_primary_screen(INF))
+	app.screen_manager.scale_primary_screen(10000.0)
+	assert(screen.mesh_size.x <= 12.0)
+	app.screen_manager.scale_primary_screen(0.00001)
+	assert(screen.mesh_size.x >= 0.6 and screen.mesh_size.y >= 0.4)
+	app.screen_manager.move_primary_screen(-100)
+	assert(is_equal_approx(screen.global_position.length(), 0.5))
+	app.screen_manager.move_primary_screen(100)
+	assert(is_equal_approx(screen.global_position.length(), 10.0))
+	screen.curvature = 2
+	app.screen_manager.scale_primary_screen(10000.0)
+	assert(screen.mesh_size.x / screen.get_cylinder_radius() <= PI + 0.0001)
+	assert(settings.restarts == 0)
+
+	# Ordinary hosts retain the existing requested-resolution selector.
+	app.settings.host.pc_profile_resolution = Vector2i.ZERO
+	app.settings.host.sbs_mode = 0
+	var ordinary_size := screen.mesh_size
+	assert(not app.screen_manager.ensure_pc_source_aspect())
+	assert(screen.mesh_size == ordinary_size)
+	settings.refresh_resolution_btn_label()
+	assert(not app._ui_res_btn.disabled)
+	settings.cycle_resolution()
+	assert(settings.restarts == 1 and app.settings.host.resolution_idx != original_index)
+	panel.free()
+	screen.free()
+	camera.free()
+	app.free()
+	print("Screen presentation controls PASS: real UI actions/native geometry handoff, per-eye aspect/corners, bounds, source invariance, Full-SBS guard and ordinary-host selection")
+	quit()
