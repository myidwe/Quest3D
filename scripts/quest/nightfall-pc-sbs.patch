-    if (bytesToRead > 0) {
-        MA_COPY_MEMORY(pBufferOut, pDecoder->data.memory.pData + pDecoder->data.memory.currentReadPos, bytesToRead);
-        pDecoder->data.memory.currentReadPos += bytesToRead;
-    }
-
-    if (pBytesRead != NULL) {
