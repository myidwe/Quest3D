+        codec_, index, 0, size, (uint64_t)pts, 0);
+    if (status != AMEDIA_OK) {
+        static int fail_count = 0;
+        if (++fail_count <= 3) {
+            NF_LOGE("AndroidMediaCodec", "queueInputBuffer failed: %d", status);
+        }
+        return FeedResult::ERROR;
+    }
+    return FeedResult::QUEUED;
+}
