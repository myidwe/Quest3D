-    MA_ASSUME(channels > 0);
-    for (c = 0; c < channels; c += 1) {
-        float r1 = pLPF->pR1[c].f32;
-        float x  = pX[c];
-        float y;
-
-        y = b*x + a*r1;
-
-        pY[c]           = y;
