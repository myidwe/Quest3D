+++ b/test/test_app_selection.gd
@@ -0,0 +1,73 @@
+extends SceneTree
+const Catalog = preload("res://src/app_selection.gd")
+
+const DESKTOP := "<root status_code='200'><App><AppTitle>Quest3D Desktop</AppTitle><ID>1574503197</ID></App></root>"
+
+class FakeConfig extends RefCounted:
+	var hosts := [{"id": 1, "server_unique_id": "first", "localaddress": "192.168.0.2", "server_cert_verified": true, "srvcert": "fixture-certificate"}]
+	func get_hosts() -> Array:
+		return hosts
+
+class FakeNative extends RefCounted:
+	var calls: Array[Callable] = []
+	func fetch_app_list_snapshot(_host: int, callback: Callable):
+		calls.append(callback)
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	var catalog = Catalog.new()
+	var parsed: Dictionary = Catalog.parse_xml(DESKTOP)
+	assert(parsed.ok and parsed.apps[0].id == 1574503197)
+	assert(catalog.resolve("a", parsed.apps, true).app.id == 1574503197, "Use the registered ID, never a hardcoded Desktop ID")
+	assert(not catalog.resolve("b", parsed.apps, false).ok, "Product Desktop requires authenticated product capabilities")
+	var choices := [{"id": 7, "name": "Game"}, {"id": 8, "name": "Desktop"}]
+	assert(catalog.resolve("a", choices, false).app.id == 8, "Desktop need not be first in list")
+	assert(catalog.choose("a", 7))
+	assert(catalog.resolve("a", choices, false).app.id == 7, "Explicit choice survives list refresh")
+	assert(catalog.resolve("b", choices, false).app.id == 8, "A choice cannot leak to another paired host")
+	assert(not catalog.resolve("a", [{"id": 8, "name": "Desktop"}], false).ok, "Removed explicit app is not silently replaced")
+	for apps in [[], [{"id": 9, "name": "Game"}], [{"id": 9, "name": "My Desktop Game"}],
+			[{"id": 9, "name": "Desktop"}, {"id": 10, "name": "Quest3D Desktop"}]]:
+		assert(not catalog.resolve("new", apps, true).ok, "Empty, unknown or ambiguous apps require selection")
+	for xml in ["", "<root status_code='403'><App><ID>1</ID><AppTitle>Desktop</AppTitle></App></root>",
+			"<root status_code='200'><App><ID>1</ID><ID>2</ID><AppTitle>Desktop</AppTitle></App></root>",
+			"<root status_code='200'><App><ID>1x</ID><AppTitle>Desktop</AppTitle></App></root>",
+			"<root status_code='200'><App><ID>-1</ID><AppTitle>Desktop</AppTitle></App></root>",
+			"<root status_code='200'><App><ID>2147483648</ID><AppTitle>Desktop</AppTitle></App></root>",
+			"<root status_code='200'><App><ID>1</ID><AppTitle>Desktop</AppTitle></App>",
+			"<!DOCTYPE root><root status_code='200'/>", DESKTOP + "junk",
+			"<root status_code='200'><App><ID>1</ID><AppTitle><b>Desktop</b></AppTitle></App></root>"]:
+		assert(not Catalog.parse_xml(xml).ok, "Malformed/failed catalog must not authorize launch")
+	assert(Catalog.parse_xml("<?xml version='1.0'?><root status_code='200'><App><ID>1</ID><AppTitle>사진 &amp; 영상</AppTitle></App></root>").apps[0].name == "사진 & 영상")
+	assert(Catalog.parse_xml("<root status_code='200'/>").apps.is_empty())
+	assert(not Catalog.parse_xml(" ".repeat(1048577)).ok)
+	assert(not Catalog.parse_xml("<root status_code='200'>" + "<App><ID>1</ID><AppTitle>Desktop</AppTitle></App>".repeat(2) + "</root>").ok)
+	for i in range(33):
+		catalog.resolve("temporary-%d" % i, [{"id": 3, "name": "Desktop"}], false)
+	assert(catalog.resolve("a", choices, false).app.id == 7, "Catalog eviction must preserve an explicit app choice")
+	var backend := StreamBackend.new(null)
+	var config := FakeConfig.new()
+	var native := FakeNative.new()
+	backend.set_config_manager(config)
+	backend.set_computer_manager(native)
+	var original_scope: String = Catalog.host_scope(backend, 1)
+	var box := {}
+	_collect(catalog, backend, box)
+	assert(native.calls.size() == 1 and box.is_empty(), "Wait for authenticated data; do not use saved apps")
+	native.calls[0].call({"success": true, "xml": DESKTOP, "pc_profile": true})
+	await create_timer(0.04).timeout
+	assert(box.result.ok and box.result.app.id == 1574503197)
+	box.clear()
+	_collect(catalog, backend, box)
+	config.hosts[0].srvcert = "replacement-certificate"
+	assert(Catalog.host_scope(backend, 1) != original_scope)
+	native.calls[1].call({"success": true, "xml": DESKTOP, "pc_profile": true})
+	await create_timer(0.04).timeout
+	assert(not box.result.ok, "A reply authenticated against the old pin cannot select apps for the replacement host")
+	print("App selection PASS: exact fresh Desktop, explicit host scope, malformed XML, pending reply and pin change")
+	quit()
+
+func _collect(catalog, backend, box):
+	box.result = await catalog.refresh(1, backend, self)
