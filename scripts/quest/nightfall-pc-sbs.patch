+	await process_frame
+	print("Actual Stream menu PASS: observed/unknown/legacy/idle, bounded diagnostic line, 720/900/1080 and oversized values, unchanged 530px footer")
+	print("PC 3D settings navigation PASS: real button signal before/after connection, hidden-menu shortcut, stable label, unavailable fallback, unchanged PC mode/requests/packing/quality")
