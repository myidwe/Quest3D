+
+func _assert_content_above_handle(content: Control, handle: Rect2):
+	var minimum := content.get_combined_minimum_size()
+	assert(minimum.x <= 1200 and minimum.y <= handle.position.y, "Whole content must fit above the reserved footer")
+	assert(content.get_global_rect().end.y <= handle.position.y)
+	_assert_visible_control_bounds(content, Rect2(0, 0, 1200, handle.position.y))
+
+func _assert_visible_control_bounds(node: Node, content_bounds: Rect2):
+	for child in node.get_children():
+		if child is Control and child.is_visible_in_tree():
+			if child is Button or child is Label:
+				assert(content_bounds.encloses(child.get_global_rect()), "Visible content overlaps/footer clips: " + child.name)
+			_assert_visible_control_bounds(child, content_bounds)
