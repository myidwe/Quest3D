+bool CurlHttpClient::set_headers(const std::map<std::string, std::string>& headers) {
+    for (const auto& item : headers) {
+        if (item.first != "Content-Type" && item.first != "Accept" && item.first != "Connection") return false;
+        if (item.second.size() > 128 || item.second.find_first_of("\r\n") != std::string::npos ||
+            item.second.find('\0') != std::string::npos) return false;
+        if (item.first == "Connection" && item.second != "close") return false;
+    }
+    headers_ = headers;
+    return true;
+}
