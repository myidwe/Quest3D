-        }
-
-        pDeviceInfo->nativeDataFormats[0].channels   = channels;
-        pDeviceInfo->nativeDataFormats[0].sampleRate = sampleRate;
-        pDeviceInfo->nativeDataFormats[0].flags      = 0;
-        pDeviceInfo->nativeDataFormatCount = 1;
-    }
-
-    return MA_SUCCESS;
-}
