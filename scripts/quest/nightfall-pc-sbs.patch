+	var pc = app.pc_control
+	pc._host = 7
+	var live := {"version": 1, "session_id": "fixture-live", "requested_mode": "3d", "effective_mode": "3d", "revision": 12, "last_seq": 2, "eye_width": 1280, "disparity": 12.8, "publisher_age_ms": 10, "applied_request": null, "rejected_request": null, "fallback_reason": null}
+	pc._on_status(200, live, "", pc._generation)
+	assert(pc.available() and "PC applied: 3D" in pc._label.text)
+	var long_error := "PC source unavailable: capture producer did not acknowledge the pending geometry change before the requested deadline"
+	var pointer_messages := [
+		"PC action partial / button state uncertain; reconnect required · PC control OFF; no retry",
+		"Validated click: %s → %s / %s · Windows input OFF" % ["Q".repeat(256), "H".repeat(256), "S".repeat(256)],
+		"PC action refused: source_changed · PC control OFF; no retry",
+	]
+	for diagnostic in pointer_messages:
+		pc.pointer.message = diagnostic
