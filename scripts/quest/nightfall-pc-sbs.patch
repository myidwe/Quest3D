-static ma_result ma_default_vfs_info__win32(ma_vfs* pVFS, ma_vfs_file file, ma_file_info* pInfo)
-{
-    (void)pVFS;
-
-    #if !defined(MA_XBOX_NXDK)
-    {
-        BY_HANDLE_FILE_INFORMATION fi;
