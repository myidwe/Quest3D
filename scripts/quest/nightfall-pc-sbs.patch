diff --git a/addons/nightfall-stream/src/video/stream_start_gate.h b/addons/nightfall-stream/src/video/stream_start_gate.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/src/video/stream_start_gate.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+
+namespace godot {
+// Connection setup has its own cancellation predicate. A decoder must not wait
+// out the setup timeout after a failed/cancelled Moonlight connection. reset()
+// belongs to the lifecycle owner after all workers of the previous run joined.
+class StreamStartGate {
+public:
+    void reset() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stopped_ = false;
+        started_ = false;
+    }
+    bool mark_started() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (stopped_) return false;
+            started_ = true;
+        }
+        changed_.notify_all();
+        return true;
+    }
+    void stop() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stopped_ = true;
+        }
+        changed_.notify_all();
+    }
+    bool wait_for_start(std::chrono::milliseconds timeout) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        changed_.wait_for(lock, timeout, [this] { return started_ || stopped_; });
+        return started_ && !stopped_;
+    }
+private:
+    std::mutex mutex_;
+    std::condition_variable changed_;
+    bool stopped_ = true;
+    bool started_ = false;
+};
+} // namespace godot
