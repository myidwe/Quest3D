+BackendCleanupCompletion MiniaudioBackend::shutdown_observed(AudioLifetime expected) {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (expected != lifetime_) {
+        BackendCleanupFacts refused;
+        refused.lifetime = expected;
+        refused.state = AudioCleanupState::scope_mismatch;
+        return BackendCleanupCompletion(refused);
+    }
+    return shutdown_locked();
+}
+
+int MiniaudioBackend::stop_device(ma_device *device) { return ma_device_stop(device); }
+int MiniaudioBackend::start_device(ma_device *device) { return ma_device_start(device); }
+int MiniaudioBackend::init_device(ma_device *device, int sample_rate, int channels, int buffer_frames) {
+    ma_device_config config = ma_device_config_init(ma_device_type_playback);
+    config.playback.format = ma_format_f32;
+    config.playback.channels = (ma_uint32)channels;
+    config.sampleRate = (ma_uint32)sample_rate;
+    config.periodSizeInFrames = (ma_uint32)buffer_frames;
+    config.dataCallback = _ma_data_callback;
+    config.notificationCallback = [](const ma_device_notification *notification) {
+        if (notification) _ma_notification_callback(notification->pDevice, notification->type);
+    };
+    config.pUserData = callback_context_;
+    return ma_device_init(nullptr, &config, device);
+}
+
+BackendCleanupCompletion MiniaudioBackend::shutdown_locked() {
+    if (!lifetime_.valid() || generation_closed_) return BackendCleanupCompletion(cleanup_);
+    cleanup_.lifetime = lifetime_;
+    cleanup_.init_stage = init_stage_;
+    cleanup_.init_error = init_error_;
+    if (startup_) startup_->revoke(AudioStartupState::closed);
+    initialized_.store(false);
+    paused_.store(true, std::memory_order_release);
+
+    if (device_initialized_) {
+        cleanup_.device_stop_attempted = true;
+        cleanup_.final_stop_result = stop_device(device_);
+        if (cleanup_.final_stop_result != MA_SUCCESS && first_stop_error_ == 0) first_stop_error_ = cleanup_.final_stop_result;
+        if (cleanup_.final_stop_result != MA_SUCCESS) device_fault(callback_context_, AudioStartupState::failed, cleanup_.final_stop_result);
+        // ma_device_uninit is synchronous and has no status return. Record its
+        // return explicitly, never infer it from pause/ring emptiness/a timer.
+        ma_device_uninit(device_);
+        cleanup_.device_uninit_returned = true;
+        device_initialized_ = false;
+    }
+    cleanup_.first_stop_error = first_stop_error_;
+    cleanup_.callbacks_after_uninit = callbacks_active_.load(std::memory_order_acquire) +
+        (callback_context_ ? callback_context_->observers_active.load(std::memory_order_acquire) : 0);
+    cleanup_.callbacks_started = callbacks_started_.load();
+    cleanup_.callbacks_finished = callbacks_finished_.load();
+    if (cleanup_.callbacks_after_uninit != 0) {
+        cleanup_.state = AudioCleanupState::pending_callbacks;
+        return BackendCleanupCompletion(cleanup_); // Retain backing storage until a subsequent observed drain.
+    }
+    if (device_) { delete device_; device_ = nullptr; cleanup_.device_storage_deleted = true; }
+    delete callback_context_;
+    callback_context_ = nullptr;
+    startup_history_.clear();
+    if (ring_) {
+        delete ring_;
+        ring_ = nullptr;
+        cleanup_.pcm_ring_deleted = true;
+    }
+    cleanup_.state = AudioCleanupState::resources_released;
+    generation_closed_ = true;
+    return BackendCleanupCompletion(cleanup_);
+}
+
+bool MiniaudioBackend::write_pcm(const float *data, size_t frames) {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (!ring_ || !initialized_.load()) return false;
+    if (!data || frames > std::numeric_limits<size_t>::max() / size_t(channels_)) return false;
+
+    size_t max_buffered_samples = (size_t)(sample_rate_ * channels_ * 0.04);
+    size_t avail = ring_->read_available();
+    if (avail > max_buffered_samples) {
+        ring_->discard(avail - max_buffered_samples);
+    }
+
+    size_t samples = frames * (size_t)channels_;
+    size_t written = ring_->write(data, samples);
+    return written == samples;
+}
+
+void MiniaudioBackend::pause() {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    paused_.store(true);
+    if (startup_) startup_->revoke(AudioStartupState::paused);
+    if (device_initialized_) {
+        const int result = stop_device(device_);
+        if (result != MA_SUCCESS && first_stop_error_ == 0) first_stop_error_ = result;
+        if (result != MA_SUCCESS) device_fault(callback_context_, AudioStartupState::failed, result);
+    }
+}
+
+void MiniaudioBackend::resume() {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (device_initialized_ && initialized_.load()) {
+        const int result = start_observed_locked();
+        if (result != MA_SUCCESS) NF_LOGE("MiniaudioBackend", "Resume failed: %d", result);
+    }
+}
+
+int MiniaudioBackend::get_latency_ms() const {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (!ring_ || !initialized_.load()) return 0;
+    size_t avail = ring_->read_available();
+    int frames = (int)(avail / (size_t)channels_);
+    if (sample_rate_ > 0) {
+        return frames * 1000 / sample_rate_;
+    }
+    return 0;
+}
+
+std::string MiniaudioBackend::get_backend_name() const {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (device_ && device_->pContext) {
+        return ma_get_backend_name(device_->pContext->backend);
+    }
+    return "miniaudio";
+}
+
+} // namespace nightfall
