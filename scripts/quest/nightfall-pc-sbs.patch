diff --git a/addons/nightfall-stream/include/pairing_security.h b/addons/nightfall-stream/include/pairing_security.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/include/pairing_security.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace nightfall {
+using X509Ptr = std::unique_ptr<X509, decltype(&X509_free)>;
+inline X509Ptr parse_certificate(const std::string& pem) {
+    BIO* bio = BIO_new_mem_buf(pem.data(), static_cast<int>(pem.size()));
+    X509* cert = bio ? PEM_read_bio_X509(bio, nullptr, nullptr, nullptr) : nullptr;
+    BIO_free(bio);
+    return X509Ptr(cert, X509_free);
+}
+
+inline bool certificate_matches(X509* peer, const std::string& pinned_pem) {
+    auto pinned = parse_certificate(pinned_pem);
+    unsigned char actual[EVP_MAX_MD_SIZE], expected[EVP_MAX_MD_SIZE];
+    unsigned int actual_size = 0, expected_size = 0;
+    return peer && pinned &&
+        X509_digest(peer, EVP_sha256(), actual, &actual_size) == 1 &&
+        X509_digest(pinned.get(), EVP_sha256(), expected, &expected_size) == 1 &&
+        actual_size == 32 && expected_size == 32 &&
+        CRYPTO_memcmp(actual, expected, 32) == 0;
+}
+
+// GameStream generation 7 SHA256 PIN proof, before saving the host certificate.
+// Both the signed server secret and encrypted challenge response must match.
+inline bool verify_pairing_proof(const std::string& pem, const std::vector<uint8_t>& challenge,
+        const std::vector<uint8_t>& response_hash, const std::vector<uint8_t>& secret_and_signature) {
+    if (challenge.size() != 16 || response_hash.size() != 32 || secret_and_signature.size() <= 16)
+        return false;
+    auto cert = parse_certificate(pem);
+    if (!cert) return false;
+    std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)> key(X509_get_pubkey(cert.get()), EVP_PKEY_free);
+    std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> ctx(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+    if (!key || !ctx || EVP_DigestVerifyInit(ctx.get(), nullptr, EVP_sha256(), nullptr, key.get()) != 1 ||
+        EVP_DigestVerify(ctx.get(), secret_and_signature.data() + 16, secret_and_signature.size() - 16,
+            secret_and_signature.data(), 16) != 1) return false;
+    const ASN1_BIT_STRING* signature = nullptr;
+    X509_get0_signature(&signature, nullptr, cert.get());
+    if (!signature) return false;
+    std::vector<uint8_t> data(challenge);
+    const auto* signature_data = ASN1_STRING_get0_data(signature);
+    data.insert(data.end(), signature_data, signature_data + ASN1_STRING_length(signature));
+    data.insert(data.end(), secret_and_signature.begin(), secret_and_signature.begin() + 16);
+    unsigned char actual[EVP_MAX_MD_SIZE];
+    unsigned int size = 0;
+    return EVP_Digest(data.data(), data.size(), actual, &size, EVP_sha256(), nullptr) == 1 &&
+        size == 32 && CRYPTO_memcmp(actual, response_hash.data(), 32) == 0;
+}
+} // namespace nightfall
diff --git a/addons/nightfall-stream/include/pc_stream_profile.h b/addons/nightfall-stream/include/pc_stream_profile.h
new file mode 100644
--- /dev/null
+++ b/addons/nightfall-stream/include/pc_stream_profile.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <charconv>
+#include <string_view>
+
+namespace nightfall {
+// Parse an authenticated capability, without accepting truncated numeric text.
+inline bool parse_pc_dimension(std::string_view text, int& result) {
+    if (text.empty() || text.front() == '0') return false;
+    int value = 0;
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size() ||
+            value < 2 || value > 8192 || value % 2) return false;
+    result = value;
+    return true;
+}
+} // namespace nightfall
