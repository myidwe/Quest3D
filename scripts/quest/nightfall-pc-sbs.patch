-        if (pConfig->encodingFormat != ma_encoding_format_unknown) {
-            return MA_NO_BACKEND;
-        }
-
-    #ifdef MA_HAS_WAV
-        if (result != MA_SUCCESS) {
-            result = ma_decoder_init_wav__internal(pConfig, pDecoder);
-            if (result != MA_SUCCESS) {
-                onSeek(pDecoder, 0, ma_seek_origin_start);
