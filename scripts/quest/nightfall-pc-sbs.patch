+
+void NightfallComputerManager::fetch_pc_frame(int host_id, String transport_epoch, int64_t frame_index, Callable callback) {
+    bool valid = transport_epoch.length() == 32 && frame_index >= 0 && frame_index <= 4294967295LL;
+    for (int i = 0; i < transport_epoch.length(); ++i) {
+        const auto c = transport_epoch[i];
+        valid = valid && ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
+    }
+    if (!valid) { if (callback.is_valid()) callback.call_deferred(-1, Dictionary(), "Invalid frame identity"); return; }
+    _request_pc_api(host_id, Dictionary(), false, callback, "frame?transport_epoch=" + transport_epoch
+        + "&frame_index=" + String::num_int64(frame_index));
+}
+
+void NightfallComputerManager::request_pc_pointer(int host_id, Dictionary request, Callable callback) {
+    if (request.get("dry_run", Variant()).get_type() != Variant::BOOL ||
+            !pc_pointer_input_gate_.permits(host_id, bool(request.get("dry_run", false)),
+                String(request.get("transport_epoch", "")).utf8().get_data())) {
+        if (callback.is_valid()) callback.call_deferred(-1, Dictionary(), "Windows input is disabled");
+        return;
+    }
+    if (!bool(request["dry_run"])) {
+        // Stable identity prevents an evicted response from replaying a click
+        // under a new sequence. Never infer this opt-in from a server response.
+        if (request.get("input_seq", Variant()).get_type() != Variant::INT ||
+                int64_t(request["input_seq"]) < 1 || int64_t(request["input_seq"]) > 4294967295LL ||
+                request.get("transport_epoch", Variant()).get_type() != Variant::STRING ||
+                request.get("request_id", Variant()).get_type() != Variant::STRING ||
+                String(request["request_id"]) != (String(request["transport_epoch"]) + ":" +
+                    String::num_int64(int64_t(request["input_seq"]))).sha256_text().substr(0, 32)) {
+            if (callback.is_valid()) callback.call_deferred(-1, Dictionary(), "Invalid actual input identity");
+            return;
+        }
+    }
+    _request_pc_api(host_id, request, true, callback, "pointer");
+}
