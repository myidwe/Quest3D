+++ b/test/test_app_launch_selection.gd
@@ -0,0 +1,83 @@
+extends SceneTree
+const Catalog = preload("res://src/app_selection.gd")
+const DESKTOP := "<root status_code='200'><App><AppTitle>Quest3D Desktop</AppTitle><ID>1574503197</ID></App></root>"
+
+class FakeConfig extends RefCounted:
+	func get_hosts():
+		return [{"id": 1, "server_unique_id": "test", "localaddress": "192.168.0.2", "server_cert_verified": true, "srvcert": "test-certificate"}]
+
+class FakeNative extends RefCounted:
+	var callbacks: Array[Callable] = []
+	func fetch_app_list_snapshot(_host_id: int, callback: Callable):
+		callbacks.append(callback)
+
+class FakeWelcome extends RefCounted:
+	var latest: Dictionary
+	func apply_app_catalog(catalog: Dictionary):
+		latest = catalog.duplicate(true)
+
+class FakeApp extends Node3D:
+	var current_host_id := 1
+	var session_lifecycle := SessionLifecycle.new()
+	var stream_backend: StreamBackend
+	var _ui_status_label := Label.new()
+	var app_selection = Catalog.new()
+	var welcome_screen := FakeWelcome.new()
+	var failures: Array = []
+	func start_connect_timeout() -> int:
+		return session_lifecycle.arm_connect_timeout()
+	func _log(_message):
+		pass
+	func restore_after_failed_connect(message, screen):
+		failures.append([message, screen])
+		session_lifecycle.fail()
+	func _exit_tree():
+		_ui_status_label.free()
+
+class ProbeStreamManager extends StreamManager:
+	var launches: Array = []
+	func _start_validated_stream(host_id: int, app_id: int, _size: Vector2i, generation: int):
+		launches.append({"host": host_id, "app": app_id, "generation": generation})
+
+func _init():
+	_run.call_deferred()
+
+func _run():
+	var app := FakeApp.new()
+	root.add_child(app)
+	app.stream_backend = StreamBackend.new(null)
+	app.stream_backend.set_config_manager(FakeConfig.new())
+	var native := FakeNative.new()
+	app.stream_backend.set_computer_manager(native)
+	var manager := ProbeStreamManager.new(app)
+	# Exact production entry point, including the real awaited catalog callback.
+	manager.start_stream(1, 881448767)
+	assert(manager.launches.is_empty(), "No launch may precede authenticated app-list completion")
+	native.callbacks[0].call({"success": true, "xml": DESKTOP, "pc_profile": true})
+	await create_timer(0.04).timeout
+	assert(manager.launches.size() == 1 and manager.launches[0].app == 1574503197, "Replace guessed legacy ID with actual registered app ID")
+	app.session_lifecycle.stream_started() # Complete this accepted launch before the next independent attempt.
+	manager.start_stream(1, 999)
+	app.session_lifecycle.show_server_selection()
+	native.callbacks[1].call({"success": true, "xml": DESKTOP, "pc_profile": true})
+	await create_timer(0.04).timeout
+	assert(manager.launches.size() == 1, "Cancelled catalog completion cannot launch")
+	manager.start_stream(1, 999)
+	app.current_host_id = 2
+	native.callbacks[2].call({"success": true, "xml": DESKTOP, "pc_profile": true})
+	await create_timer(0.04).timeout
+	assert(manager.launches.size() == 1, "Selection changed to another PC cannot launch the old host")
+	app.session_lifecycle.fail() # Retire the pending attempt before testing a new app selection.
