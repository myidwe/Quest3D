+	var viewport_rect := Rect2(Vector2.ZERO, Vector2(1200, 580))
+	var initial_rect: Rect2 = bar.get_global_rect()
+	assert(viewport_rect.encloses(initial_rect), "Visible handle must fit the actual viewport")
+	assert(initial_rect == Rect2(300, 530, 600, 44), "Handle stays at the user's requested fixed bottom position")
+	var panel: Control = app.ui_viewport.find_child("Panel", true, false)
+	var content: Control = panel.get_node("MenuLayout/VBox")
+	print("Menu content minimum=", content.get_combined_minimum_size(), " move handle=", initial_rect)
+	_assert_content_above_handle(content, initial_rect)
+	for tab_index in [0, 1, 2, 3, 4, 5, 6]:
+		app.ui_controller.switch_tab(tab_index)
+		await process_frame
+		await process_frame
+		assert(bar.is_visible_in_tree() and bar.get_global_rect() == initial_rect)
+		assert(viewport_rect.encloses(bar.get_global_rect()))
+		print("Tab ", tab_index, " content minimum=", content.get_combined_minimum_size())
+		_assert_content_above_handle(content, initial_rect)
+	# The new Picture controls share this real menu, including their widest
+	# endpoint labels. Manual color preferences must not cover the move handle.
+	app.ui_controller.switch_tab(4)
+	for balance in [Vector2i.ZERO, Vector2i(-PictureColor.LIMIT, -PictureColor.LIMIT), Vector2i(PictureColor.LIMIT, PictureColor.LIMIT)]:
+		app.settings.host.picture_temperature = balance.x
+		app.settings.host.picture_tint = balance.y
+		app.settings_controller.refresh_color_balance_controls()
+		await process_frame
+		await process_frame
+		for button_name in ["ColorCooler", "ColorWarmer", "ColorGreener", "ColorMagenta", "ColorReset"]:
+			var color_button: Button = app.ui_controller._tab_picture.find_child(button_name, true, false)
+			assert(color_button != null and color_button.is_visible_in_tree())
+			assert(color_button.get_theme_font_size("font_size") >= 24 and color_button.size.y >= 76)
+		assert(panel.size == Vector2(1200, 580) and bar.get_global_rect() == initial_rect)
+		_assert_content_above_handle(content, initial_rect)
+	app.settings.host.picture_temperature = 0
+	app.settings.host.picture_tint = 0
+	app.settings_controller.refresh_color_balance_controls()
+	print("Picture color layout PASS: neutral and both endpoint labels fit above the footer")
+	# Exercise production status formatting with a connected 3D state and the
+	# real bounded wire-name limit. Long diagnostics must not resize XR geometry.
+	app.ui_controller.switch_tab(3)
+	app.is_streaming = true
+	app._last_hostname = "Workstation-" + "W".repeat(245)
+	app.ui_controller.update_host_label()
