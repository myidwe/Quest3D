diff --git a/src/app_selection.gd b/src/app_selection.gd
new file mode 100644
--- /dev/null
+++ b/src/app_selection.gd
@@ -0,0 +1,146 @@
+class_name AppSelection
+extends RefCounted
+
+const MAX_APPS := 512
+const MAX_XML_BYTES := 1048576
+var _choices: Dictionary = {}
+var _catalogs: Dictionary = {}
+var _request_serial := 0
+var _latest_requests: Dictionary = {}
+
+static func parse_xml(xml: String) -> Dictionary:
+	if xml.is_empty() or xml.to_utf8_buffer().size() > MAX_XML_BYTES or "<!DOCTYPE" in xml or "<!ENTITY" in xml:
+		return {"ok": false, "error": "Invalid or oversized app list"}
+	var parser := XMLParser.new()
+	if parser.open_buffer(xml.to_utf8_buffer()) != OK:
+		return {"ok": false, "error": "Invalid app-list XML"}
+	var stack: Array[String] = []
+	var apps: Array = []
+	var ids: Dictionary = {}
+	var app: Dictionary = {}
+	var root_seen := false
+	var root_closed := false
+	while true:
+		var err := parser.read()
+		if err == ERR_FILE_EOF:
+			break
+		if err != OK:
+			return {"ok": false, "error": "Truncated app-list XML"}
+		match parser.get_node_type():
+			XMLParser.NODE_ELEMENT:
+				var name := parser.get_node_name()
+				if stack.is_empty():
+					if root_seen or name != "root" or parser.get_named_attribute_value_safe("status_code") != "200":
+						return {"ok": false, "error": "Host did not return a successful app list"}
+					root_seen = true
+				elif stack.size() == 1 and name == "App":
+					app = {}
+				elif stack == ["root", "App"] and name in ["ID", "AppTitle"]:
+					if app.has(name):
+						return {"ok": false, "error": "Duplicate app-list field"}
+					app[name] = ""
+				elif stack.size() >= 3 and stack[2] in ["ID", "AppTitle"]:
+					return {"ok": false, "error": "Nested app-list field"}
+				stack.append(name)
+				if parser.is_empty():
+					if name == "root":
+						root_closed = true
+					elif stack == ["root", "App"]:
+						return {"ok": false, "error": "Empty app entry"}
+					stack.pop_back()
+			XMLParser.NODE_TEXT, XMLParser.NODE_CDATA:
+				if stack.is_empty() and not parser.get_node_data().strip_edges().is_empty():
+					return {"ok": false, "error": "Text outside the app-list root"}
+				if stack.size() == 3 and stack[0] == "root" and stack[1] == "App" and stack[2] in ["ID", "AppTitle"]:
+					app[stack[2]] += parser.get_node_data()
+					if String(app[stack[2]]).length() > 512:
+						return {"ok": false, "error": "Oversized app field"}
+			XMLParser.NODE_ELEMENT_END:
+				if stack.is_empty() or stack[-1] != parser.get_node_name():
+					return {"ok": false, "error": "Mismatched app-list XML"}
+				if stack == ["root", "App"]:
+					var id_text := String(app.get("ID", "")).strip_edges()
+					var title := String(app.get("AppTitle", "")).strip_edges()
+					if id_text.is_empty() or title.is_empty() or id_text.length() > 10:
+						return {"ok": false, "error": "Missing app ID or title"}
+					for c in id_text:
+						if c < "0" or c > "9":
+							return {"ok": false, "error": "Invalid app ID"}
+					var id := id_text.to_int()
+					if id <= 0 or id > 2147483647 or ids.has(id) or apps.size() >= MAX_APPS:
+						return {"ok": false, "error": "Invalid or duplicate app ID"}
+					ids[id] = true
+					apps.append({"id": id, "name": title})
+				if stack == ["root"]:
+					root_closed = true
+				stack.pop_back()
+	if not root_seen or not root_closed or not stack.is_empty():
+		return {"ok": false, "error": "Incomplete app list"}
+	return {"ok": true, "apps": apps}
+
+static func host_scope(backend: StreamBackend, host_id: int) -> String:
+	for h in backend.get_hosts():
+		if h.get("id", -1) == host_id and h.get("server_cert_verified", false) and not String(h.get("srvcert", "")).is_empty():
+			# An ID reused after unpairing must not inherit another host's choice.
+			return (str(h.get("server_unique_id", "")) + "|" + str(h.get("localaddress", "")) + ":" +
+				str(h.get("https_port", 47984)) + "|" + String(h.srvcert).sha256_text()).sha256_text()
+	return ""
+
+func choose(scope: String, app_id: int) -> bool:
+	for app in _catalogs.get(scope, []):
+		if app.id == app_id:
+			_choices[scope] = app_id
+			return true
+	return false
+
+func resolve(scope: String, apps: Array, pc_profile: bool) -> Dictionary:
+	_catalogs[scope] = apps.duplicate(true)
+	if _catalogs.size() > 32:
+		var oldest = _catalogs.keys()[0]
+		_catalogs.erase(oldest)
+	if _choices.has(scope):
+		for app in apps:
+			if app.id == _choices[scope]:
+				return {"ok": true, "app": app.duplicate(), "explicit": true}
+		return {"ok": false, "error": "Selected app is no longer registered. Choose an app."}
+	var desktops := apps.filter(func(app): return app.name == "Desktop" or (pc_profile and app.name == "Quest3D Desktop"))
+	if desktops.size() == 1:
+		return {"ok": true, "app": desktops[0].duplicate(), "explicit": false}
+	return {"ok": false, "error": "Choose an app on the welcome screen." if not apps.is_empty() else "No apps are registered on this PC."}
+
+func refresh(host_id: int, backend: StreamBackend, tree: SceneTree) -> Dictionary:
+	var scope := host_scope(backend, host_id)
+	if scope.is_empty():
+		return {"ok": false, "error": "Pair this PC before loading apps", "apps": []}
+	_request_serial += 1
+	var serial := _request_serial
+	_latest_requests[scope] = serial
+	if _latest_requests.size() > 32:
+		_latest_requests.erase(_latest_requests.keys()[0])
+	var reply := {"done": false, "body": {}}
+	backend.fetch_app_list_snapshot(host_id, func(body: Dictionary):
+		if not reply.done:
+			reply.body = body.duplicate(true)
+			reply.done = true
+	)
+	var deadline := Time.get_ticks_msec() + 9000
+	while not reply.done and Time.get_ticks_msec() < deadline:
+		await tree.create_timer(0.02).timeout
+	if not reply.done:
+		reply.done = true
+		return {"ok": false, "error": "Loading the authenticated PC app list timed out", "apps": []}
+	if host_scope(backend, host_id) != scope:
+		return {"ok": false, "error": "PC pairing changed while loading apps", "apps": []}
+	if _latest_requests.get(scope, -1) != serial:
+		return {"ok": false, "error": "A newer app-list request replaced this result", "apps": []}
+	var body: Dictionary = reply.body
+	if not body.get("success", false):
+		return {"ok": false, "error": body.get("error", "Cannot load authenticated PC apps"), "apps": []}
+	var parsed := parse_xml(body.get("xml", ""))
+	if not parsed.ok:
+		parsed.apps = []
+		return parsed
+	var result := resolve(scope, parsed.apps, body.get("pc_profile", false))
+	result.apps = parsed.apps
+	result.scope = scope
+	return result
diff --git a/src/pc_color_probe.gd b/src/pc_color_probe.gd
new file mode 100644
--- /dev/null
+++ b/src/pc_color_probe.gd
@@ -0,0 +1,170 @@
+extends RefCounted
+
+# Temporary debug instrumentation of the existing LEFT-eye ambient readback.
+# It deliberately has no frame identity: observation-time state is not a PBO tag.
+const MAX_SAMPLES := 120
+const INTERVAL_MS := 1000
+const TIMEOUT_MS := 150000
+const REQUEST_TIMEOUT_MS := 3000
+const MAX_REARMS := 4
+const MAX_TRIGGER_TTL_MS := 30000
+
+var enabled := false
+var started := false
+var finished := false
+var pending := false
+var requests := 0
+var samples := 0
+var start_ms := 0
+var last_request_ms := -INTERVAL_MS
+var last_sample_ms := -INTERVAL_MS
+var not_ready := false
+var instance_nonce := Crypto.new().generate_random_bytes(16).hex_encode()
+var run_nonce := "auto"
+var seen_nonces: Dictionary = {}
+var armed_deadline_ms := -1
+var end_reason := ""
+
+func _init(debug_build: bool, pc_build: bool, args: PackedStringArray) -> void:
+	enabled = debug_build and pc_build and not "--nf-no-color-probe" in args
+
+func tick(now_ms: int, eligible: bool, transport_connected: bool = true) -> Dictionary:
+	if not enabled or finished:
+		return {}
+	var just_started := false
+	if not started:
+		if armed_deadline_ms >= 0 and now_ms >= armed_deadline_ms:
+			return _finish("arm_expired")
+		if not eligible:
+			return {}
+		if now_ms - last_request_ms < INTERVAL_MS:
+			return {}
+		started = true
+		just_started = true
+		start_ms = now_ms
+	if not transport_connected:
+		return _finish("transport_disconnected")
+	if now_ms - start_ms >= TIMEOUT_MS:
+		return _finish("timeout")
+	if not eligible:
+		pending = false
+		if not not_ready:
+			not_ready = true
+			return {"event": "temporarily_not_ready", "run_nonce": run_nonce, "samples": samples}
+		return {}
+	var resumed := not_ready
+	not_ready = false
+	if pending and now_ms - last_request_ms >= REQUEST_TIMEOUT_MS:
+		pending = false
+	if requests >= MAX_SAMPLES and not pending:
+		return _finish("budget")
+	if pending or now_ms - last_request_ms < INTERVAL_MS:
+		return {"event": "ready_again", "run_nonce": run_nonce, "samples": samples} if resumed else {}
+	pending = true
+	requests += 1
+	last_request_ms = now_ms
+	var action := {"request": true, "request_sequence": requests}
+	if just_started:
+		action.merge({"event": "started", "max_requests": MAX_SAMPLES, "max_samples": MAX_SAMPLES,
+			"interval_ms": INTERVAL_MS, "timeout_ms": TIMEOUT_MS, "frame_token_bound": false,
+			"run_nonce": run_nonce})
+	elif resumed:
+		action.merge({"event": "ready_again", "run_nonce": run_nonce, "samples": samples})
+	return action
+
+func _finish(reason: String) -> Dictionary:
+	finished = true
+	pending = false
+	end_reason = reason
+	return {"event": "finished", "reason": reason, "requests": requests, "samples": samples,
+		"run_nonce": run_nonce}
+
+static func _hex_nonce(value: Variant) -> bool:
+	if not value is String or value.length() != 32:
+		return false
+	for character in value:
+		if not character in "0123456789abcdef":
+			return false
+	return true
+
+static func _integer(value: Variant) -> bool:
+	return (value is int or value is float) and is_finite(float(value)) and float(value) == floor(float(value))
+
+func rearm(request: Variant, now_unix_ms: int, now_ms: int, process_id: int) -> Dictionary:
+	var refused := {"event": "arm_refused", "reason": "invalid_request"}
+	if not enabled or not request is Dictionary or request.size() != 6:
+		return refused
+	for key in ["version", "action", "nonce", "instance_nonce", "pid", "expires_unix_ms"]:
+		if not request.has(key):
+			return refused
+	if not _integer(request.version) or request.version != 1 or request.action != "arm" \
+			or not _hex_nonce(request.nonce) or request.instance_nonce != instance_nonce \
+			or not _integer(request.pid) or request.pid != process_id \
+			or not _integer(request.expires_unix_ms):
+		return refused
+	var remaining := int(request.expires_unix_ms) - now_unix_ms
+	if remaining <= 0 or remaining > MAX_TRIGGER_TTL_MS:
+		return {"event": "arm_refused", "reason": "expired_or_excessive_ttl"}
+	if seen_nonces.has(request.nonce):
+		return {"event": "arm_duplicate", "run_nonce": request.nonce}
+	if seen_nonces.size() >= MAX_REARMS:
+		return {"event": "arm_refused", "reason": "process_rearm_budget"}
+	seen_nonces[request.nonce] = true
+	run_nonce = request.nonce
+	started = false
+	finished = false
+	pending = false
+	not_ready = false
+	requests = 0
+	samples = 0
+	start_ms = 0
+	end_reason = ""
+	# Preserve cross-run 1Hz limits as well as each run's budget.
+	armed_deadline_ms = now_ms + remaining
+	return {"event": "armed", "run_nonce": run_nonce, "arm_wait_ms": remaining,
+		"rearms_remaining": MAX_REARMS - seen_nonces.size(), "frame_token_bound": false}
+
+func status(process_id: int) -> Dictionary:
+	return {"version": 1, "pid": process_id, "instance_nonce": instance_nonce, "run_nonce": run_nonce,
+		"enabled": enabled, "started": started, "finished": finished, "not_ready": not_ready,
+		"end_reason": end_reason,
+		"requests": requests, "samples": samples, "max_rearms": MAX_REARMS,
+		"rearms_used": seen_nonces.size(), "frame_token_bound": false}
+
+func observe(pixels: PackedByteArray, now_ms: int, observed_state: Dictionary) -> Dictionary:
+	if not enabled or finished or not pending or pixels.size() != 32 * 32 * 4 \
+			or now_ms - last_sample_ms < INTERVAL_MS or now_ms - start_ms >= TIMEOUT_MS:
+		return {}
+	var sums := [0, 0, 0]
+	var minimum := [255, 255, 255]
+	var maximum := [0, 0, 0]
+	var max_channel_delta := 0
+	# Central 16x16 excludes sampled edges; this is not a source-pixel crop.
+	for y in range(8, 24):
+		for x in range(8, 24):
+			var offset := (y * 32 + x) * 4
+			for channel in range(3):
+				var value := int(pixels[offset + channel])
+				sums[channel] += value
+				minimum[channel] = mini(minimum[channel], value)
+				maximum[channel] = maxi(maximum[channel], value)
+			max_channel_delta = maxi(max_channel_delta, maxi(
+				absi(int(pixels[offset]) - int(pixels[offset + 1])),
+				absi(int(pixels[offset + 2]) - int(pixels[offset + 1]))))
+	pending = false
+	samples += 1
+	last_sample_ms = now_ms
+	var mean := [sums[0] / 256.0, sums[1] / 256.0, sums[2] / 256.0]
+	# Whitelist state fields: never log source names, URLs, pixels or identities.
+	var state := {}
+	for key in ["streaming", "native_active", "native_started", "stream_width", "stream_height",
+			"pc_width", "pc_height", "stereo_mode", "brightness_pct", "contrast_pct", "gamma_pct",
+			"picture_temperature", "picture_tint"]:
+		if observed_state.has(key):
+			state[key] = observed_state[key]
+	return {"event": "sample", "sample_sequence": samples, "requests": requests, "run_nonce": run_nonce,
+		"elapsed_ms": now_ms - start_ms, "stage": "left_eye_ambient_blit",
+		"frame_token_bound": false, "photon_verified": false, "roi": "central_16x16_of_32x32",
+		"mean_rgb": mean, "min_rgb": minimum, "max_rgb": maximum,
+		"mean_r_minus_g": mean[0] - mean[1], "mean_b_minus_g": mean[2] - mean[1],
+		"max_abs_channel_delta": max_channel_delta, "state_at_observation": state}
diff --git a/src/pc_control.gd b/src/pc_control.gd
new file mode 100644
--- /dev/null
+++ b/src/pc_control.gd
@@ -0,0 +1,273 @@
+class_name PcControl
+extends RefCounted
+
+var main: Node3D
+var status: Dictionary = {}
+var pending: Dictionary = {}
+var message := "Connect the PC Full-SBS source"
+var _host := -1
+var _generation := 0
+var _busy := false
+var _poll_elapsed := 0.0
+var _status_at := 0
+var _can_retry := false
+var _buttons: Array[Button] = []
+var _label: Label
+var pointer := PcPointerControl.new()
+var _pointer_label: Label
+var _pointer_button: Button
+var _actual_pointer_button: Button
+
+func _init(owner: Node3D):
+	main = owner
+
+func build_tab(tab: Control):
+	for child in tab.get_children():
+		child.visible = false
+	var row := HBoxContainer.new()
+	row.alignment = BoxContainer.ALIGNMENT_CENTER
+	row.add_theme_constant_override("separation", 12)
+	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	tab.add_child(row)
+	for name in ["PC 2D", "PC 3D", "Depth -", "Depth +"]:
+		var button: Button = main.ui_controller.make_option_btn(name, "--")
+		row.add_child(button)
+		_buttons.append(button)
+	_buttons[0].button_down.connect(func(): set_mode("2d"))
+	_buttons[1].button_down.connect(func(): set_mode("3d"))
+	_buttons[2].button_down.connect(func(): change_depth(-0.0025))
+	_buttons[3].button_down.connect(func(): change_depth(0.0025))
+	_label = Label.new()
+	_label.add_theme_font_size_override("font_size", 24)
+	_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_bound_status_label(_label, 2, 70)
+	tab.add_child(_label)
+	var hint := Label.new()
+	hint.text = "PC 2D returns to flat viewing. The eye packing stays automatic."
+	hint.add_theme_font_size_override("font_size", 20)
+	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	tab.add_child(hint)
+	# These are alternative pointer modes, so share a row. Two separate
+	# full-width rows pushed the status/footer outside the 580px menu.
+	var pointer_row := HBoxContainer.new()
+	pointer_row.name = "PointerControls"
+	pointer_row.alignment = BoxContainer.ALIGNMENT_CENTER
+	pointer_row.add_theme_constant_override("separation", 12)
+	pointer_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	tab.add_child(pointer_row)
+	_pointer_button = main.ui_controller.make_option_btn("Pointer test", "OFF")
+	_pointer_button.button_down.connect(func(): pointer.set_enabled(not (pointer.enabled and not pointer.actual_input)))
+	pointer_row.add_child(_pointer_button)
+	_actual_pointer_button = main.ui_controller.make_option_btn("PC control", "OFF")
+	_actual_pointer_button.button_down.connect(func(): pointer.set_actual_input(not pointer.actual_input))
+	pointer_row.add_child(_actual_pointer_button)
+	_pointer_label = Label.new()
+	_pointer_label.add_theme_font_size_override("font_size", 18)
+	_pointer_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	_pointer_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_bound_status_label(_pointer_label, 1, 26)
+	tab.add_child(_pointer_label)
+	refresh_ui()
+
+func process(delta: float):
+	var host_id: int = main.current_host_id if main.is_streaming and main.settings.host.effective_sbs_mode() == 3 else -1
+	var pointer_cm = main.stream_backend.get_computer_manager()
+	var manager = main.native_xr_renderer
+	var pointer_ready: bool = host_id >= 0 and main.settings.host.pc_profile_resolution != Vector2i.ZERO \
+		and pointer_cm != null and pointer_cm.has_method("fetch_pc_frame") and pointer_cm.has_method("request_pc_pointer") \
+		and pointer_cm.has_method("set_pc_pointer_input_enabled") \
+		and pointer_cm.has_method("mark_pc_pointer_uncertain") \
+		and manager != null
+	pointer.configure(host_id if pointer_ready else -1,
+		pointer_cm.fetch_pc_frame if pointer_ready else Callable(), pointer_cm.request_pc_pointer if pointer_ready else Callable(),
+		manager.take_pointer_ticket if pointer_ready else Callable(),
+		pointer_cm.set_pc_pointer_input_enabled if pointer_ready else Callable(),
+		pointer_cm.mark_pc_pointer_uncertain if pointer_ready else Callable())
+	# Negative invalidation only. These status fields are NEVER copied into the
+	# immutable displayed-frame request or used to enable an OS operation.
+	var context := JSON.stringify([status.get("session_id"), status.get("stream_epoch"),
+		status.get("revision"), status.get("requested_mode"), status.get("effective_mode")])
+	pointer.observe_context(context, not pending.is_empty() or not available())
+	_refresh_pointer_ui(pointer_ready)
+	if host_id != _host:
+		_host = host_id
+		_generation += 1
+		_busy = false
+		status.clear()
+		pending.clear()
+		_can_retry = false
+		_status_at = 0
+		message = "Connect the PC Full-SBS source" if host_id < 0 else "Checking paired PC"
+		_poll_elapsed = 1.0
+	_poll_elapsed += delta
+	if _host >= 0 and not _busy and _poll_elapsed >= 0.5:
+		_poll_elapsed = 0.0
+		var cm = main.stream_backend.get_computer_manager()
+		if cm and cm.has_method("fetch_pc_status"):
+			_busy = true
+			cm.fetch_pc_status(_host, _on_status.bind(_generation))
+	refresh_ui()
+
+func _refresh_pointer_ui(pointer_ready: bool):
+	if _pointer_label:
+		_pointer_label.text = pointer.message
+		_pointer_label.tooltip_text = pointer.message
+	if _pointer_button:
+		_pointer_button.disabled = not pointer_ready
+		_pointer_button.text = "Pointer test: ON (no PC input)" if pointer.enabled and not pointer.actual_input else "Pointer test: OFF"
+	if _actual_pointer_button:
+		_actual_pointer_button.disabled = not pointer_ready
+		_actual_pointer_button.text = "PC control: ON" if pointer.actual_input else "PC control: OFF"
+
+static func valid_status(data: Dictionary) -> bool:
+	return data.get("version", 0) == 1 and data.get("session_id", "") is String \
+		and String(data.get("session_id", "")).length() > 0 and String(data.get("session_id", "")).length() <= 128 \
+		and data.get("requested_mode", "") in ["2d", "3d"] \
+		and data.get("effective_mode", "") in ["2d", "3d"] \
+		and _uint32(data.get("revision")) and _uint32(data.get("last_seq")) \
+		and int(data.last_seq) < 4294967295 \
+		and _uint32(data.get("eye_width")) and int(data.eye_width) > 0 and int(data.eye_width) <= 8192 \
+		and _number(data.get("disparity")) and float(data.disparity) >= 0.0 \
+		and float(data.disparity) <= float(data.eye_width) * 0.04 \
+		and _number(data.get("publisher_age_ms")) and float(data.publisher_age_ms) >= 0.0 \
+		and _nullable_text(data.get("applied_request"), 128) \
+		and _nullable_text(data.get("rejected_request"), 128) \
+		and _nullable_text(data.get("fallback_reason"), 1024)
+
+static func _nullable_text(value: Variant, limit: int) -> bool:
+	return value == null or (value is String and value.length() <= limit)
+
+static func _text_or_empty(value: Variant) -> String:
+	return value if value is String else ""
+
+static func _number(value: Variant) -> bool:
+	return (value is int or value is float) and is_finite(float(value))
+
+static func _uint32(value: Variant) -> bool:
+	return _number(value) and float(value) >= 0.0 and float(value) <= 4294967295.0 and float(value) == floorf(float(value))
+
+func _on_status(code: int, data: Dictionary, error: String, generation: int):
+	if generation != _generation:
+		return
+	_busy = false
+	if code != 200 or not valid_status(data):
+		_status_at = 0
+		message = error if not error.is_empty() else "PC control unavailable (%d)" % code
+		refresh_ui()
+		return
+	if not status.is_empty() and status.get("session_id") != data.get("session_id"):
+		pending.clear()
+	status = data
+	_status_at = Time.get_ticks_msec()
+	var result_message := ""
+	if not pending.is_empty():
+		var request_id: String = pending.request_id
+		if _text_or_empty(data.get("applied_request")) == request_id:
+			pending.clear()
+		elif _text_or_empty(data.get("rejected_request")) == request_id:
+			pending.clear()
+			result_message = "PC rejected the change"
+		elif data.get("last_request", {}) is Dictionary:
+			var last: Dictionary = data.get("last_request", {})
+			if last.get("request_id", "") == request_id and last.get("outcome", "") in ["unknown_timeout", "ai_unavailable", "rejected", "superseded"]:
+				result_message = "PC result: " + String(last.outcome)
+				pending.clear()
+	if pending.is_empty():
+		_can_retry = false
+		message = result_message if not result_message.is_empty() else _text_or_empty(data.get("fallback_reason"))
+	else:
+		message = "Result unknown; press the same mode to retry" if _can_retry else "Change pending; waiting for PC frame"
+	refresh_ui()
+
+func available() -> bool:
+	return _host >= 0 and valid_status(status) and _status_at > 0 \
+		and Time.get_ticks_msec() - _status_at < 2500 \
+		and int(status.get("publisher_age_ms", 99999)) < 2000
+
+func toggle_mode():
+	set_mode("2d" if status.get("requested_mode", "2d") == "3d" else "3d")
+
+func set_mode(mode: String):
+	_send(mode, float(status.get("disparity", 0.0)))
+
+func change_depth(fraction: float):
+	var width := float(status.get("eye_width", 1280))
+	_send(String(status.get("requested_mode", "2d")), clampf(float(status.get("disparity", 0.0)) + width * fraction, 0.0, width * 0.04))
+
+func _send(mode: String, disparity: float):
+	if not available() or _busy:
+		return
+	var cm = main.stream_backend.get_computer_manager()
+	if not cm or not cm.has_method("request_pc_control"):
+		return
+	pointer.invalidate("PC mode change requested")
+	if not pending.is_empty():
+		if _can_retry and pending.get("mode") == mode:
+			_busy = true
+			_can_retry = false
+			cm.request_pc_control(_host, pending, _on_command.bind(_generation))
+			return
+		if mode != "2d" or pending.get("mode") == "2d":
+			return
+	var next_seq := maxi(int(status.last_seq), int(pending.get("seq", 0))) + 1
+	if next_seq > 4294967295:
+		message = "Reconnect the PC source"
+		return
+	pending = {"version": 1, "session_id": status.session_id,
+		"request_id": Crypto.new().generate_random_bytes(16).hex_encode(),
+		"seq": next_seq, "expected_revision": int(status.revision),
+		"mode": mode, "disparity": disparity}
+	_busy = true
+	_can_retry = false
+	message = "Sending change to paired PC"
+	cm.request_pc_control(_host, pending, _on_command.bind(_generation))
+	refresh_ui()
+
+func _on_command(code: int, data: Dictionary, error: String, generation: int):
+	if generation != _generation:
+		return
+	_busy = false
+	_poll_elapsed = 1.0
+	if code != 202:
+		# A failed transport may still have reached the PC. Poll before another edit.
+		_status_at = 0
+		message = error if not error.is_empty() else "PC control: " + str(data.get("error", code))
+		if code > 0:
+			pending.clear()
+		else:
+			_can_retry = true
+	else:
+		message = "Change accepted; waiting for PC frame"
+	refresh_ui()
+
+func refresh_ui():
+	var ready := available() and not _busy
+	var effect := String(status.get("effective_mode", "--")).to_upper()
+	if main._ui_3d_speed_btn:
+		main._ui_3d_speed_btn.text = "PC Mode\n" + effect
+		main._ui_3d_speed_btn.disabled = not ready
+		main._ui_3d_speed_btn.modulate.a = 1.0 if ready else 0.3
+	for i in _buttons.size():
+		var enabled := ready and (pending.is_empty() or i == 0 or (i == 1 and _can_retry))
+		_buttons[i].disabled = not enabled
+		_buttons[i].modulate.a = 1.0 if enabled else 0.3
+		main.ui_controller.update_option_btn(_buttons[i], effect if i < 2 else "%.2f%%" % (100.0 * float(status.get("disparity", 0.0)) / maxf(1.0, float(status.get("eye_width", 1280)))))
+	if _label:
+		var text := "PC applied: %s   Requested: %s\n%s" % [effect, String(status.get("requested_mode", "--")).to_upper(), message]
+		_label.text = text
+		_label.tooltip_text = text
+
+static func _bound_status_label(label: Label, lines: int, height: int):
+	# Text is diagnostic data, not a request to grow the fixed XR viewport.
+	# Keep its complete value/tooltip while bounding visible lines and width.
+	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	label.max_lines_visible = lines
+	# Autowrap+clip_text removes the minimum height as well as width. Reserve
+	# the actual 24px two-line /18px one-line font budget so text stays visible.
+	label.custom_minimum_size.y = height
+	label.clip_text = true
+	label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
+	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	label.mouse_filter = Control.MOUSE_FILTER_PASS
diff --git a/src/pc_pointer_control.gd b/src/pc_pointer_control.gd
new file mode 100644
--- /dev/null
+++ b/src/pc_pointer_control.gd
@@ -0,0 +1,271 @@
+class_name PcPointerControl
+extends RefCounted
+
+## Every action owns one original native ticket. Status may revoke a pending
+## action, but never supplies its source geometry or grants actual permission.
+var enabled := false
+var actual_input := false
+var message := "Pointer test OFF · Windows input OFF"
+var last_result: Dictionary = {}
+var now_us: Callable = Time.get_ticks_usec
+var _host := -1
+var _generation := 0
+var _fetch: Callable
+var _post: Callable
+var _take: Callable
+var _pending: Dictionary = {}
+var _last_seq := 0
+var _transport := ""
+var _left := false
+var _right := false
+var _last_move_us := 0
+var _arm: Callable
+var _mark_uncertain: Callable
+var _queued_click: Dictionary = {}
+var _needs_release := false
+var _blocked := false
+var _context := ""
+var _uncertain_transports: Dictionary = {}
+
+func configure(host: int, fetch: Callable, post: Callable, take: Callable, arm: Callable = Callable(), mark_uncertain: Callable = Callable()):
+	if host != _host or fetch != _fetch or post != _post or take != _take or arm != _arm or mark_uncertain != _mark_uncertain:
+		if not _pending.is_empty(): invalidate("PC connection changed")
+		if _arm.is_valid(): _arm.call(_host, false)
+		actual_input = false
+		enabled = false
+		_needs_release = true
+		_generation += 1
+		_pending.clear()
+		last_result.clear()
+		_last_seq = 0
+		_transport = ""
+		_host = host
+		_fetch = fetch
+		_post = post
+		_take = take
+		_arm = arm
+		_mark_uncertain = mark_uncertain
+		_queued_click.clear()
+		_context = ""
+	if not _pending.is_empty() and int(now_us.call()) - int(_pending.started_us) > 500000:
+		invalidate("Pointer result expired; no automatic retry")
+
+func set_enabled(value: bool):
+	var was_sent: bool = _pending.has("body") and not bool(_pending.body.get("dry_run", true))
+	if _arm.is_valid(): _arm.call(_host, false)
+	actual_input = false
+	invalidate("Pointer test changed")
+	enabled = value
+	if not was_sent:
+		message = "Point at PC 2D: trigger left / grip right · Windows input OFF" if enabled else "Pointer test OFF · Windows input OFF"
+
+func set_actual_input(value: bool):
+	var was_sent: bool = _pending.has("body") and not bool(_pending.body.get("dry_run", true))
+	invalidate("PC control changed")
+	actual_input = value and _host >= 0 and _arm.is_valid() and not _uncertain_transports.has(_transport)
+	enabled = actual_input
+	_needs_release = true
+	if _arm.is_valid(): _arm.call(_host, actual_input)
+	if not was_sent:
+		message = "PC control ON · release trigger/grip, then point at PC 2D" if actual_input else "PC control OFF"
+		if value and _uncertain_transports.has(_transport):
+			message = "Previous action uncertain · reconnect the PC stream before enabling control"
+
+func invalidate(reason: String):
+	var sent_actual: bool = _pending.has("body") and not bool(_pending.body.get("dry_run", true))
+	var cancelled := _pending.duplicate(true)
+	_generation += 1
+	_pending.clear()
+	_queued_click.clear()
+	_needs_release = true
+	if sent_actual:
+		# A sent request cannot be cancelled by hiding its response. Keep uncertainty
+		# explicit and require a new opt-in rather than replaying the gesture.
+		actual_input = false
+		_remember_uncertain()
+		enabled = false
+		if _arm.is_valid(): _arm.call(_host, false)
+		message = reason + " · sent action result unknown; PC control OFF; no retry"
+		last_result = {"request": cancelled.body, "source": cancelled.get("source", {}),
+			"result_state": "unknown_after_invalidation", "reason": reason}
+		print("Quest3DPointer " + message)
+		print("Quest3DPointerResult " + JSON.stringify(last_result))
+	else:
+		message = reason
+
+func observe_context(context: String, blocked: bool):
+	if (_context != "" and context != _context) or (blocked and not _blocked):
+		invalidate("PC source/mode/session changed")
+	_context = context
+	_blocked = blocked
+
+func observe_submission(current: Dictionary):
+	var observed: Dictionary = current.get("submission", {})
+	if current.get("valid", false) and PcPointerWire.hex32(observed.get("transport_epoch")) \
+		and observed.transport_epoch != _transport:
+		if not _transport.is_empty():
+			invalidate("Displayed transport changed")
+			actual_input = false
+			enabled = false
+			if _arm.is_valid(): _arm.call(_host, false)
+		_transport = observed.transport_epoch
+		_last_seq = 0
+	if _pending.is_empty(): return
+	var before: Dictionary = _pending.candidate.get("submission", {})
+	var after: Dictionary = current.get("submission", {})
+	if not current.get("valid", false):
+		invalidate("Display or pointer routing unavailable")
+		return
+	for key in ["transport_epoch", "decoder_epoch", "panel_generation", "mapping_generation", "eye_width", "eye_height"]:
+		if after.get(key) != before.get(key):
+			invalidate("Displayed geometry changed")
+			return
+	if not _queued_click.is_empty():
+		var queued: Dictionary = _queued_click.candidate.get("submission", {})
+		for key in ["transport_epoch", "decoder_epoch", "panel_generation", "mapping_generation", "eye_width", "eye_height"]:
+			if queued.get(key) != after.get(key):
+				invalidate("Queued click geometry changed")
+				return
+
+func route(eligible: bool, issue: Callable, left: bool, right: bool):
+	var left_edge := left and not _left
+	var right_edge := right and not _right
+	_left = left
+	_right = right
+	if _needs_release:
+		if not left and not right: _needs_release = false
+		return
+	if not enabled or _blocked or not eligible or not issue.is_valid():
+		return # Held actions begun on local UI are never replayed on the desktop.
+	if left_edge != right_edge:
+		if not _pending.is_empty():
+			if _pending.operation != "move" or not _queued_click.is_empty():
+				message = "Click already pending; new press not queued"
+				return
+			var clicked: Dictionary = issue.call() # Retain this edge's exact frame/UV once.
+			if _pending.has("body"):
+				_queued_click = {"candidate": clicked.duplicate(true), "button": "left" if left_edge else "right", "started_us": int(now_us.call())}
+				message = "Click retained while move result is pending"
+				return
+			_generation += 1 # GET-only move is cancellable; no OS request was sent.
+			_pending.clear()
+			request(clicked, "click", "left" if left_edge else "right")
+		else:
+			request(issue.call(), "click", "left" if left_edge else "right")
+	elif not left and not right and int(now_us.call()) - _last_move_us >= (50000 if actual_input else 500000):
+		if not _pending.is_empty(): return
+		_last_move_us = now_us.call()
+		request(issue.call(), "move", "") # 20 Hz actual / 2 Hz diagnostic cap, never queue moves.
+
+func request(candidate: Dictionary, operation: String, button: String, issued_at_us: int = -1):
+	if not enabled or _blocked or _host < 0 or not _pending.is_empty() or not _fetch.is_valid() or not _post.is_valid() or not _take.is_valid():
+		return
+	if not candidate.get("valid", false) or not candidate.get("ticket") is int or candidate.ticket <= 0:
+		message = "Pointer unavailable: " + String(candidate.get("reason", "no submitted frame"))
+		return
+	var frame: Dictionary = candidate.get("submission", {})
+	if not PcPointerWire.hex32(frame.get("transport_epoch")) or not PcPointerWire.uint32(frame.get("frame_index")):
+		return
+	if actual_input and _uncertain_transports.has(frame.transport_epoch):
+		actual_input = false
+		enabled = false
+		if _arm.is_valid(): _arm.call(_host, false)
+		message = "Uncertain transport cannot send input; reconnect required"
+		return
+	if actual_input and not _transport.is_empty() and _transport != frame.transport_epoch:
+		invalidate("Transport changed at click; enable control again after observing the new stream")
+		actual_input = false
+		enabled = false
+		if _arm.is_valid(): _arm.call(_host, false)
+		return
+	if _transport != frame.transport_epoch:
+		_transport = frame.transport_epoch
+		_last_seq = 0
+	_generation += 1
+	_pending = {"candidate": candidate.duplicate(true), "operation": operation, "button": button,
+		"started_us": int(now_us.call()) if issued_at_us < 0 else issued_at_us, "dry_run": not actual_input}
+	message = "Validating displayed PC frame" if actual_input else "Validating clicked frame · Windows input OFF"
+	_fetch.call(_host, frame.transport_epoch, int(frame.frame_index), _on_frame.bind(_generation))
+
+func _on_frame(code: int, data: Dictionary, error: String, generation: int):
+	if generation != _generation or _pending.is_empty():
+		return
+	var pending := _pending.duplicate(true)
+	if code != 200 or not PcPointerWire.valid_frame(data, pending.candidate):
+		_finish("Frame lookup rejected: " + String(data.get("error", error)), {})
+		return
+	if not pending.dry_run and (not actual_input or not PcPointerWire.actual_allowed(data)):
+		_finish("PC control refused: displayed source is not enabled monitor 2D", {})
+		return
+	# Subtract the whole lookup RTT conservatively. Server rechecks its own clock
+	# on POST; this remaining TTL is never converted to a client-issued extension.
+	var elapsed: int = int(now_us.call()) - int(pending.started_us)
+	if elapsed < 0 or elapsed >= int(data.host_remaining_ttl_ms) * 1000:
+		_finish("Clicked frame expired before send", {})
+		return
+	var original: Dictionary = _take.call(int(pending.candidate.ticket))
+	if not original.get("valid", false):
+		_finish("Clicked display changed or expired", {})
+		return
+	var seq: int = maxi(_last_seq, int(data.last_input_seq)) + 1
+	var request_id := Crypto.new().generate_random_bytes(16).hex_encode() if pending.dry_run else PcPointerWire.actual_request_id(data.transport_epoch, seq)
+	var body := PcPointerWire.payload(original, data, request_id, seq, pending.operation, pending.button, pending.dry_run)
+	if body.is_empty():
+		_finish("Pointer identity or geometry mismatch", {})
+		return
+	_last_seq = seq
+	_pending.body = body.duplicate(true)
+	_pending.source = data.duplicate(true)
+	_post.call(_host, body, _on_pointer.bind(generation))
+
+func _on_pointer(code: int, data: Dictionary, error: String, generation: int):
+	if generation != _generation or _pending.is_empty() or not _pending.has("body"):
+		return
+	var body: Dictionary = _pending.body
+	var exact: bool = data.get("request_id") == body.request_id and data.get("input_seq") == body.input_seq
+	var valid: bool = code == 200 and exact and data.get("outcome") == "validated_dry_run" \
+		and body.dry_run and data.get("applied") is bool and not data.applied \
+		and data.get("input_enabled") is bool and not data.input_enabled
+	if valid:
+		var source: Dictionary = _pending.source
+		_finish("Validated %s: %s → %s / %s · Windows input OFF" % [body.operation,
+			source.paired_client_name, source.host_name, source.source_name], {"response": data, "source": source, "request": body})
+	elif not body.dry_run and PcPointerWire.actual_result(code, data, body) == "applied":
+		_finish("PC %s inserted · app response not confirmed" % body.operation,
+			{"response": data, "source": _pending.source, "request": body})
+	elif not body.dry_run:
+		var state := PcPointerWire.actual_result(code, data, body)
+		var detail := "result unknown"
+		if state == "unknown_partial": detail = "partial / button state uncertain; reconnect required"
+		elif state == "not_applied": detail = "not inserted"
+		elif state == "refused": detail = "refused: " + data.error
+		var result := {"response": data, "source": _pending.source, "request": body, "result_state": detail}
+		actual_input = false
+		if state in ["unknown", "unknown_partial"]: _remember_uncertain()
+		enabled = false
+		_needs_release = true
+		if _arm.is_valid(): _arm.call(_host, false)
+		_queued_click.clear()
+		_finish("PC action " + detail + " · PC control OFF; no retry", result)
+	else:
+		_finish("Pointer rejected / result unknown: " + String(data.get("error", error)) + " · Windows input OFF", {})
+
+func _finish(text: String, result: Dictionary):
+	_pending.clear()
+	message = text
+	last_result = result.duplicate(true)
+	print("Quest3DPointer " + text)
+	if not last_result.is_empty():
+		print("Quest3DPointerResult " + JSON.stringify(last_result))
+	if not _queued_click.is_empty():
+		var click := _queued_click.duplicate(true)
+		_queued_click.clear()
+		var age: int = int(now_us.call()) - int(click.started_us)
+		if not enabled or _blocked or age < 0 or age > 250000:
+			message = "Retained click expired or unavailable; press again"
+			return
+		request(click.candidate, "click", click.button, int(click.started_us))
+
+func _remember_uncertain():
+	_uncertain_transports[_transport] = true
+	if _mark_uncertain.is_valid(): _mark_uncertain.call(_host, _transport)
diff --git a/src/pc_pointer_probe.gd b/src/pc_pointer_probe.gd
new file mode 100644
--- /dev/null
+++ b/src/pc_pointer_probe.gd
@@ -0,0 +1,27 @@
+class_name PcPointerProbe
+extends RefCounted
+
+## Diagnostic routing only. No InputBridge, StreamBackend or HTTP dependency.
+static func rejected(reason: String) -> Dictionary:
+	return {"valid": false, "reason": reason, "input_enabled": false,
+		"network_enabled": false, "photon_verified": false}
+
+static func sample(eligible: bool, ui_blocked: bool, captured: bool,
+		manipulating: bool, target_role: StringName, target_primary: bool,
+		native_query: Callable) -> Dictionary:
+	if not eligible:
+		return rejected("pc_native_unavailable")
+	if ui_blocked or captured or manipulating:
+		return rejected("local_interaction")
+	# Physics is only a conservative occlusion/routing gate; NEVER use its hit
+	# point, UV, clamp or fallback centre to generate an input coordinate.
+	if target_role != &"none" and not (target_role == &"screen" and target_primary):
+		return rejected("other_target")
+	if not native_query.is_valid():
+		return rejected("no_native_query")
+	var candidate: Dictionary = native_query.call()
+	# Even a future native change cannot accidentally enable this probe.
+	candidate.input_enabled = false
+	candidate.network_enabled = false
+	candidate.photon_verified = false
+	return candidate
diff --git a/src/pc_pointer_wire.gd b/src/pc_pointer_wire.gd
new file mode 100644
--- /dev/null
+++ b/src/pc_pointer_wire.gd
@@ -0,0 +1,130 @@
+class_name PcPointerWire
+extends RefCounted
+
+static func hex32(value: Variant) -> bool:
+	if not value is String or value.length() != 32:
+		return false
+	for c in value:
+		if not c in "0123456789abcdef":
+			return false
+	return true
+
+static func decimal64(value: Variant) -> bool:
+	if not value is String or value.is_empty() or value.length() > 20:
+		return false
+	if value.length() > 1 and value[0] == "0":
+		return false
+	for c in value:
+		if not c in "0123456789":
+			return false
+	return value.length() < 20 or value <= "18446744073709551615"
+
+static func integer(value: Variant, low: int, high: int) -> bool:
+	return number(value) and value >= low and value <= high and value == floor(value)
+
+static func number(value: Variant) -> bool:
+	return (value is int or value is float) and is_finite(float(value))
+
+static func uint32(value: Variant) -> bool:
+	return integer(value, 0, 4294967295)
+
+static func rect(value: Variant, signed_origin: bool) -> bool:
+	return value is Dictionary and integer(value.get("left"), -2147483648 if signed_origin else 0, 2147483647) \
+		and integer(value.get("top"), -2147483648 if signed_origin else 0, 2147483647) \
+		and integer(value.get("width"), 1, 2147483647) and integer(value.get("height"), 1, 2147483647)
+
+static func valid_frame(data: Dictionary, candidate: Dictionary) -> bool:
+	if not candidate.get("submission") is Dictionary:
+		return false
+	var frame: Dictionary = candidate.submission
+	if not integer(data.get("version"), 1, 1) or data.get("transport_epoch") != frame.get("transport_epoch") \
+		or not uint32(data.get("frame_index")) or data.frame_index != frame.get("frame_index"):
+		return false
+	for key in ["transport_epoch", "frame_geometry_token", "source_id", "layout_id"]:
+		if not hex32(data.get(key)):
+			return false
+	for key in ["source_generation", "geometry_revision", "publisher_epoch", "publisher_frame_id"]:
+		if not decimal64(data.get(key)):
+			return false
+	for key in ["source_name", "source_kind", "host_name", "paired_client_name"]:
+		if not data.get(key) is String or data[key].length() > 256:
+			return false
+	if data.get("layout") != "full_sbs" or data.get("mode") not in ["2d", "3d"] \
+		or not data.get("input_enabled") is bool \
+		or not integer(data.get("host_remaining_ttl_ms"), 1, 500) \
+		or not uint32(data.get("last_input_seq")) or not uint32(data.get("flags")):
+		return false
+	if not rect(data.get("source_rect"), true) or not rect(data.get("content_rect"), false) \
+		or not data.get("eye_size") is Dictionary:
+		return false
+	var eye: Dictionary = data.eye_size
+	var content: Dictionary = data.content_rect
+	return integer(eye.get("width"), 1, 8192) and integer(eye.get("height"), 1, 8192) \
+		and eye.width == frame.get("eye_width") and eye.height == frame.get("eye_height") \
+		and content.left + content.width <= eye.width and content.top + content.height <= eye.height
+
+static func actual_allowed(lookup: Dictionary) -> bool:
+	# Only immutable GET fields authorize an action; current /status can revoke,
+	# but cannot grant permission to a previously displayed frame.
+	return lookup.get("input_enabled") is bool and lookup.input_enabled \
+		and lookup.get("source_kind") == "monitor" and lookup.get("mode") == "2d" \
+		and lookup.get("layout") == "full_sbs" and uint32(lookup.get("flags")) \
+		and (int(lookup.flags) & 11) == 11 # FULL_SBS | ORIGINAL_2D | INPUT_ENABLED
+
+static func actual_request_id(transport_epoch: String, seq: int) -> String:
+	return (transport_epoch + ":" + str(seq)).sha256_text().substr(0, 32)
+
+static func actual_result(code: int, data: Dictionary, body: Dictionary) -> String:
+	if code in [400, 403, 409, 410, 413, 415, 422, 423, 503] and data.get("error") is String \
+		and data.get("applied") is bool and not data.applied \
+		and data.get("input_enabled") is bool and not data.input_enabled:
+		return "refused"
+	if code != 200 or data.get("request_id") != body.get("request_id") or data.get("input_seq") != body.get("input_seq") \
+		or data.get("ack_scope") != "win32_input_inserted" or data.get("retry_allowed") != false \
+		or not data.get("retry_allowed") is bool or not data.get("applied") is bool \
+		or not data.get("input_enabled") is bool or not data.get("release_attempted") is bool \
+		or not data.get("button_state_unknown") is bool or not uint32(data.get("win32_error")):
+		return "unknown"
+	var expected := 1 if body.get("operation") == "move" else 3
+	if not integer(data.get("events_expected"), expected, expected) \
+		or not integer(data.get("events_inserted"), 0, expected) or not integer(data.get("release_inserted"), 0, 1):
+		return "unknown"
+	if data.get("outcome") == "applied" and data.applied and data.input_enabled \
+		and data.events_inserted == expected and not data.button_state_unknown \
+		and not data.release_attempted and data.release_inserted == 0:
+		return "applied"
+	if data.get("outcome") == "partial" and not data.applied and data.events_inserted > 0 and data.events_inserted < expected:
+		return "unknown_partial"
+	if data.get("outcome") == "not_applied" and not data.applied and data.events_inserted == 0:
+		return "unknown_partial" if data.button_state_unknown else "not_applied"
+	return "unknown"
+
+static func payload(candidate: Dictionary, lookup: Dictionary, request_id: String, seq: int,
+		operation: String, button: String, dry_run: bool = true) -> Dictionary:
+	if not candidate.get("valid", false) or not valid_frame(lookup, candidate) or not hex32(request_id) \
+		or not integer(seq, 1, 4294967295) or operation not in ["move", "click"] \
+		or (operation == "click" and button not in ["left", "right"]):
+		return {}
+	if not dry_run and (not actual_allowed(lookup) or request_id != actual_request_id(lookup.transport_epoch, seq)):
+		return {}
+	if not number(candidate.get("u")) or not number(candidate.get("v")) \
+		or candidate.u < 0 or candidate.u > 1 or candidate.v < 0 or candidate.v > 1 \
+		or not integer(candidate.get("encoded_eye"), 0, 1):
+		return {}
+	var frame: Dictionary = candidate.submission
+	var out := {"version": 1, "request_id": request_id, "input_seq": seq,
+		"operation": operation, "u": candidate.u, "v": candidate.v,
+		"encoded_eye": candidate.encoded_eye, "frame_index": int(frame.frame_index), "dry_run": dry_run}
+	for key in ["transport_epoch", "frame_geometry_token", "source_id", "source_generation", "geometry_revision", "layout_id"]:
+		out[key] = lookup[key]
+	for key in ["decoder_epoch", "lease_serial", "submission_cycle", "panel_generation", "mapping_generation"]:
+		if not frame.get(key) is int or frame[key] <= 0:
+			return {}
+		out[key] = str(frame[key]) # Never route uint64 identity through a JSON double.
+	for key in ["pixel_latch_age_us", "submission_age_us"]:
+		if not integer(frame.get(key), 0, 500000 if key == "pixel_latch_age_us" else 250000):
+			return {}
+		out[key] = int(frame[key])
+	if operation == "click":
+		out.button = button
+	return out
diff --git a/src/picture_color.gd b/src/picture_color.gd
new file mode 100644
--- /dev/null
+++ b/src/picture_color.gd
@@ -0,0 +1,22 @@
+class_name PictureColor
+extends RefCounted
+
+## Relative display preference, not measured white point or Kelvin calibration.
+const LIMIT := 20
+const STEP := 2
+
+static func sanitize(value: Variant) -> int:
+	if not (value is int or value is float) or not is_finite(float(value)):
+		return 0
+	return clampi(int(clampf(float(value), -LIMIT, LIMIT)), -LIMIT, LIMIT)
+
+static func gain(temperature: int, tint: int) -> Vector3:
+	var t := float(sanitize(temperature)) * 0.01
+	var m := float(sanitize(tint)) * 0.01
+	# Positive temperature warms; positive tint moves toward magenta.
+	# Normalize to attenuation only, so these controls cannot clip highlights.
+	var g := Vector3(1.0 + t + m * 0.5, 1.0 - m, 1.0 - t + m * 0.5)
+	return g / maxf(g.x, maxf(g.y, g.z))
+
+static func adjusted(host: HostSettings) -> bool:
+	return host.picture_temperature != 0 or host.picture_tint != 0
