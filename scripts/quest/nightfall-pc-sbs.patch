+            latched_token_.valid, (unsigned long long)latched_token_.decoder_epoch,
+            latched_token_.frame_index, (long long)latched_token_.codec_pts_us,
+            (long long)latched_timestamp_ns_, (unsigned long long)oes_lease_.serial());
+    }
+    static int completed_updates = 0;
+    if (++completed_updates <= 3) {
+        NF_LOG("TextureUploader", "Completed GLES external update #%d (%s)", completed_updates,
+            native_direct_mode_.load() ? "native-direct" : "legacy-blit");
+    }
