@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Verify the recorded patch prefix before extending it; never reset a checkout."""
+import hashlib
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+source, commit, stamp, *patches = sys.argv[1:]
+source, stamp = Path(source), Path(stamp)
+patches = [Path(p).resolve() for p in patches]
+expected = [f'Godot {commit}'] + [f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.name}' for p in patches]
+recorded = stamp.read_text().splitlines() if stamp.exists() else expected[:1]
+if recorded != expected[:len(recorded)]:
+    raise SystemExit('Recorded Godot patches differ from the pinned prefix; preserve and inspect the checkout.')
+applied = len(recorded) - 1
+names = sorted({line[6:] for p in patches for line in p.read_text().splitlines() if line.startswith('+++ b/')})
+scratch = Path(tempfile.mkdtemp(prefix='godot-patch-check-', dir=source.parent))
+for name in names:
+    original = subprocess.run(['git', '-C', str(source), 'show', f'{commit}:{name}'], capture_output=True)
+    if original.returncode == 0:
+        path = scratch / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(original.stdout)
+for p in patches[:applied]:
+    subprocess.run(['git', 'apply', str(p)], cwd=scratch, check=True)
+modified = set(subprocess.check_output(['git', '-C', str(source), 'diff', '--name-only', 'HEAD'], text=True).splitlines())
+if modified - set(names):
+    raise SystemExit(f'Unrelated Godot changes preserved; inspect: {sorted(modified - set(names))}')
+for name in names:
+    actual, wanted = source / name, scratch / name
+    if actual.exists() != wanted.exists() or (actual.exists() and actual.read_bytes() != wanted.read_bytes()):
+        raise SystemExit(f'Godot patch-prefix content differs at {name}; checkout preserved.')
+# Preflight the complete extension on the copy before mutating the real source.
+for p in patches[applied:]:
+    subprocess.run(['git', 'apply', '--check', str(p)], cwd=scratch, check=True)
+    subprocess.run(['git', 'apply', str(p)], cwd=scratch, check=True)
+for index, p in enumerate(patches[applied:], start=applied + 1):
+    subprocess.run(['git', 'apply', '--check', str(p)], cwd=source, check=True)
+    subprocess.run(['git', 'apply', str(p)], cwd=source, check=True)
+    # Each successful patch records a recoverable prefix if a later one fails.
+    stamp.write_text('\n'.join(expected[:index + 1]) + '\n')
+print(f'Verified Godot patch stack: {len(patches)} patches / {len(names)} files; evidence {scratch}')
