+void NightfallComputerManager::_request_pc_api(int host_id, Dictionary body, bool write, Callable callback, String endpoint) {
+    if (!config_manager.is_valid() || !http_requester || !callback.is_valid()) return;
+    String ip;
+    int port = 47984;
+    Array hosts = config_manager->get_hosts();
+    for (int i = 0; i < hosts.size(); ++i) {
+        Dictionary host = hosts[i];
+        if (int(host["id"]) == host_id) {
+            ip = host.get("localaddress", "");
+            port = host.get("https_port", 47984);
+            break;
+        }
+    }
+    if (ip.is_empty()) { callback.call_deferred(-1, Dictionary(), "Paired host not found"); return; }
+    PackedByteArray payload;
+    if (write) payload = JSON::stringify(body).to_utf8_buffer();
+    if (payload.size() > 4096) { callback.call_deferred(-1, Dictionary(), "Command too large"); return; }
+    Dictionary headers;
+    headers["Accept"] = "application/json";
+    headers["Connection"] = "close";
+    if (write) headers["Content-Type"] = "application/json";
+    String url = "https://" + ip + ":" + String::num_int64(port) + "/quest3d/v1/" + endpoint;
+    http_requester->request(url, write ? "POST" : "GET", payload, headers, _get_ssl_options(ip, port),
+        callable_mp(this, &NightfallComputerManager::_on_pc_api_completed).bind(callback), 3000);
+}
+
+void NightfallComputerManager::_on_pc_api_completed(int code, PackedByteArray body, Dictionary headers, String error, Callable callback) {
+    if (!callback.is_valid()) return;
+    Dictionary data;
+    if (body.size() > 65536) { callback.call(-1, data, "Control response too large"); return; }
+    if (body.size() > 0) {
+        Variant parsed = JSON::parse_string(body.get_string_from_utf8());
+        if (parsed.get_type() != Variant::DICTIONARY) { callback.call(-1, data, "Invalid control response"); return; }
+        data = parsed;
+    }
+    callback.call(code, data, error);
+}
