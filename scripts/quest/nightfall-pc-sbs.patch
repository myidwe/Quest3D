+class_name PictureColorControls
+extends RefCounted
+
+var _controller_ref: WeakRef
+var _controller: SettingsController:
+	get:
+		return _controller_ref.get_ref() if _controller_ref else null
+var _buttons: Dictionary = {}
+
+func _init(controller: SettingsController):
+	_controller_ref = weakref(controller)
+
+func install(tab: Control) -> void:
+	var row: HBoxContainer = tab.get_node("PictureRow2")
+	_button(row, "ColorCooler", "Cooler", -PictureColor.STEP, 0)
+	_button(row, "ColorWarmer", "Warmer", PictureColor.STEP, 0)
+	var gap := Control.new()
+	gap.custom_minimum_size.y = 12
+	gap.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	tab.add_child(gap)
+	var tint_row := HBoxContainer.new()
+	tint_row.name = "PictureColorRow"
+	tint_row.alignment = BoxContainer.ALIGNMENT_CENTER
+	tint_row.add_theme_constant_override("separation", 12)
+	tint_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	tab.add_child(tint_row)
+	_button(tint_row, "ColorGreener", "Greener", 0, -PictureColor.STEP)
+	_button(tint_row, "ColorMagenta", "Magenta", 0, PictureColor.STEP)
+	var reset := _make_button("ColorReset", "Reset color")
+	reset.pressed.connect(_controller.reset_color_balance)
+	tint_row.add_child(reset)
+	_buttons["ColorReset"] = reset
+	refresh()
+
+func _make_button(node_name: String, label: String) -> Button:
+	var button := Button.new()
+	button.name = node_name
+	button.text = label
+	button.custom_minimum_size = Vector2(220, 76)
+	button.add_theme_font_size_override("font_size", 24)
+	button.focus_mode = Control.FOCUS_NONE
+	return button
+
+func _button(row: HBoxContainer, node_name: String, label: String, dt: int, dm: int):
+	var button := _make_button(node_name, label)
+	button.pressed.connect(_controller.adjust_color_balance.bind(dt, dm))
+	row.add_child(button)
+	_buttons[node_name] = button
+
+func refresh() -> void:
+	if _buttons.is_empty():
+		return
+	var host: HostSettings = _controller.main.settings.host
+	_buttons.ColorCooler.text = "Cooler\nTemp %+d" % host.picture_temperature
+	_buttons.ColorWarmer.text = "Warmer\nTemp %+d" % host.picture_temperature
+	_buttons.ColorGreener.text = "Greener\nTint %+d" % host.picture_tint
+	_buttons.ColorMagenta.text = "Magenta\nTint %+d" % host.picture_tint
+	_buttons.ColorCooler.disabled = host.picture_temperature <= -PictureColor.LIMIT
+	_buttons.ColorWarmer.disabled = host.picture_temperature >= PictureColor.LIMIT
+	_buttons.ColorGreener.disabled = host.picture_tint <= -PictureColor.LIMIT
+	_buttons.ColorMagenta.disabled = host.picture_tint >= PictureColor.LIMIT
+	_buttons.ColorReset.disabled = not PictureColor.adjusted(host)
+	_buttons.ColorReset.tooltip_text = "Reset temperature and tint only. Brightness, contrast and gamma stay unchanged."
diff --git a/src/shaders/picture_color.gdshaderinc b/src/shaders/picture_color.gdshaderinc
new file mode 100644
--- /dev/null
+++ b/src/shaders/picture_color.gdshaderinc
@@ -0,0 +1,11 @@
+// Relative balance in linear light. Identity is exact and avoids extra transfer work.
+vec3 picture_color_to_linear(vec3 c) {
+	return mix(c / 12.92, pow((max(c, vec3(0.0)) + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
+}
+vec3 picture_color_to_srgb(vec3 c) {
+	return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
+}
+vec3 picture_color_encoded(vec3 c, vec3 gain) {
+	if (all(equal(gain, vec3(1.0)))) { return c; }
+	return picture_color_to_srgb(picture_color_to_linear(c) * gain);
+}
diff --git a/test/CodecCapabilityDiagnosticsTest.java b/test/CodecCapabilityDiagnosticsTest.java
new file mode 100644
--- /dev/null
+++ b/test/CodecCapabilityDiagnosticsTest.java
@@ -0,0 +1,37 @@
+package com.godot.game;
+
+public final class CodecCapabilityDiagnosticsTest {
+    private static void require(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+
+    public static void main(String[] args) {
+        CodecCapabilityDiagnostics.VideoProbe probe = new CodecCapabilityDiagnostics.VideoProbe() {
+            public boolean isSizeSupported(int w, int h) { return w <= 3840 && h <= 1080; }
+            public boolean areSizeAndRateSupported(int w, int h, double fps) { return w <= 3200 && h <= 900 && fps <= 30; }
+            public String getSupportedFrameRatesFor(int w, int h) {
+                if (!isSizeSupported(w, h)) throw new IllegalArgumentException("unsupported");
+                return w == 3840 ? "[1.0, 24.0]" : "[1.0, 30.0]";
+            }
+        };
+        String supported = CodecCapabilityDiagnostics.describeSize(probe, 3200, 900, 30);
+        require(supported.equals("combined=3200x900 rate=30 size_supported=true size_rate_supported=true supported_fps=[1.0, 30.0]"), "900p combined profile");
+        String limited = CodecCapabilityDiagnostics.describeSize(probe, 3840, 1080, 30);
+        require(limited.contains("size_supported=true size_rate_supported=false supported_fps=[1.0, 24.0]"), "Size alone must not claim 30fps support");
+        String unsupported = CodecCapabilityDiagnostics.describeSize(probe, 4096, 2160, 30);
+        require(unsupported.contains("size_supported=false size_rate_supported=false supported_fps=UNAVAILABLE(IllegalArgumentException)"), "Unsupported FPS range preserves explicit false");
+        CodecCapabilityDiagnostics.VideoProbe independent = new CodecCapabilityDiagnostics.VideoProbe() {
+            public boolean isSizeSupported(int w, int h) { throw new IllegalStateException(); }
+            public boolean areSizeAndRateSupported(int w, int h, double fps) { return false; }
+            public String getSupportedFrameRatesFor(int w, int h) { return null; }
+        };
+        require(CodecCapabilityDiagnostics.describeSize(independent, 2560, 720, 30).contains("size_supported=UNAVAILABLE(IllegalStateException) size_rate_supported=false supported_fps=UNAVAILABLE(null)"), "Each capability query is independent");
+        for (int[] invalid : new int[][] { {0, 720, 30}, {2560, -1, 30}, {2560, 720, 0} }) {
+            boolean rejected = false;
+            try { CodecCapabilityDiagnostics.describeSize(probe, invalid[0], invalid[1], invalid[2]); }
+            catch (IllegalArgumentException expected) { rejected = true; }
+            require(rejected, "Invalid diagnostic request rejected");
+        }
+        System.out.println("PASS CodecCapabilityDiagnosticsTest (capability formatting; no device throughput measured)");
+    }
+}
diff --git a/test/pairing_protocol_test.cpp b/test/pairing_protocol_test.cpp
new file mode 100644
--- /dev/null
+++ b/test/pairing_protocol_test.cpp
@@ -0,0 +1,38 @@
+#include "config/pairing_protocol.h"
+#include <cassert>
+#include <iostream>
+
+int main() {
+    using nightfall::pairing_status;
+    const auto duplicate = pairing_status("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<root status_code=\"409\" status_message=\"A pairing session with this uniqueid already exists\"><paired>0</paired></root>");
+    assert(duplicate.valid && duplicate.code == 409);
+    assert(duplicate.message == "A pairing session with this uniqueid already exists");
+    const auto full = pairing_status("<root status_message='Too many pending pairing sessions' status_code = '503'><paired>0</paired></root>");
+    assert(full.valid && full.code == 503);
+    const auto expired = pairing_status("<root status_code=\"408\" status_message=\"Pairing session expired\"/>");
+    assert(expired.valid && expired.code == 408);
+    const auto success = pairing_status("<root status_code=\"200\"><paired>1</paired><plaincert>not-read-as-status</plaincert></root>");
+    assert(success.valid && success.code == 200 && success.message.empty());
+    const auto entities = pairing_status("<root status_code='400' status_message='A &amp; B'/>");
+    assert(entities.valid && entities.message == "A &amp; B"); // Godot decodes for display.
+    for (const auto* bad : {"", "<root ", "<root", "<root status_code=", "<root status_code='20x'>",
+          "<root status_code='200' status_code='409'>", "<root><inner status_code='200'/></root>",
+          "<rooted status_code='200'>", "<root status_code='200'status_message='bad'>",
+          "<root status_code='200' status_message='x' status_message='y'>", "<root status_code='200",
+          "<?xml version='1.0'<root status_code='200'>"}) assert(!pairing_status(bad).valid);
+    const std::string valid = "<root status_code='409' status_message='message'><paired>0</paired></root>";
+    for (size_t i = 0; i < valid.find('>'); ++i) assert(!pairing_status(std::string_view(valid).substr(0, i)).valid);
+    assert(!pairing_status(std::string(1024 * 1024 + 1, ' ')).valid);
+    nightfall::PairingAttempt attempt;
+    attempt.retire();
+    const auto old = attempt.generation;
+    assert(attempt.accepts(old, 1, 1, true));
+    assert(!attempt.accepts(old, 1, 2, true));
+    attempt.retire(); // Back, timeout, failure cleanup or new attempt.
+    assert(!attempt.accepts(old, 1, 1, true));
+    const auto fresh = attempt.generation;
+    assert(attempt.accepts(fresh, 1, 1, true));
+    assert(!attempt.accepts(fresh, 5, 5, false));
+    assert(!attempt.accepts(old, 5, 5, true)); // Old success cannot persist new certificate.
+    std::cout << "Pairing protocol PASS: XML status, truncation bounds, retired/duplicate stage callbacks\n";
+}
diff --git a/test/test_app_launch_selection.gd b/test/test_app_launch_selection.gd
new file mode 100644
index 0000000..5ef3f2c
