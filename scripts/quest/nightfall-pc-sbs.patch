+void AndroidMediaCodec::_on_async_format_changed(AMediaCodec *codec, void *userdata,
+                                                  AMediaFormat *format) {
+    auto *self = static_cast<AndroidMediaCodec *>(userdata);
+    if (!self || !format) return;
+
+    int32_t width = 0;
+    int32_t height = 0;
+    std::lock_guard<std::mutex> callback_lock(self->callback_mutex_);
+    if (!self->started_.load() || codec != self->codec_) return;
+    const bool has_width = AMediaFormat_getInt32(format, AMEDIAFORMAT_KEY_WIDTH, &width);
+    const bool has_height = AMediaFormat_getInt32(format, AMEDIAFORMAT_KEY_HEIGHT, &height);
+    CodecOutputFormat observed;
+    observed.lifetime = self->lifetime_;
+    observed.observed = true;
+    observed.width = width;
+    observed.height = height;
+    // Native MediaFormat retains the AMessage rectangle as "crop". Java's
+    // individual crop-* keys are only a fallback if an implementation exposes
+    // them instead. getRect is available since API 28.
+    const bool rectangle = AMediaFormat_getRect(format, "crop", &observed.crop_left,
+        &observed.crop_top, &observed.crop_right, &observed.crop_bottom);
+    const bool left = rectangle || AMediaFormat_getInt32(format, "crop-left", &observed.crop_left);
+    const bool top = rectangle || AMediaFormat_getInt32(format, "crop-top", &observed.crop_top);
+    const bool right = rectangle || AMediaFormat_getInt32(format, "crop-right", &observed.crop_right);
+    const bool bottom = rectangle || AMediaFormat_getInt32(format, "crop-bottom", &observed.crop_bottom);
+    observed.crop_present = left || top || right || bottom;
+    observed.valid = has_width && has_height && width > 0 && height > 0;
+    if (observed.crop_present) {
+        observed.valid = observed.valid && left && top && right && bottom &&
+            observed.crop_left >= 0 && observed.crop_top >= 0 &&
+            observed.crop_right >= observed.crop_left && observed.crop_right < width &&
+            observed.crop_bottom >= observed.crop_top && observed.crop_bottom < height;
+    } else if (observed.valid) {
+        observed.crop_right = width - 1;
+        observed.crop_bottom = height - 1;
+    }
+    // A malformed newer callback must not leave an older format displayed as
+    // current. Diagnostic rejection does not change the decoder's behavior.
+    self->output_format_ = observed;
+    if (width > 0) self->width_.store(width);
+    if (height > 0) self->height_.store(height);
+    NF_LOG("AndroidMediaCodec", "Output format changed: %dx%d",
+           self->width_.load(), self->height_.load());
+    self->_notify_event();
+}
