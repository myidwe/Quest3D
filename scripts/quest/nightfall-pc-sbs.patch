+Dictionary NightfallXrRenderer::describe_eye_layer(int32_t eye) const {
+	Dictionary value;
+	const auto *base = reinterpret_cast<const XrCompositionLayerBaseHeader *>(cycle_layer_pointers[eye]);
+	if (!base) return value;
+	XrSwapchainSubImage image{};
+	XrPosef pose{};
+	if (base->type == XR_TYPE_COMPOSITION_LAYER_QUAD) {
+		const auto *layer = reinterpret_cast<const XrCompositionLayerQuad *>(base);
+		image = layer->subImage; pose = layer->pose;
+		value["shape"] = "quad";
+		value["size"] = Vector2(layer->size.width, layer->size.height);
+		value["eye_visibility"] = int64_t(layer->eyeVisibility);
+	} else if (base->type == XR_TYPE_COMPOSITION_LAYER_CYLINDER_KHR) {
+		const auto *layer = reinterpret_cast<const XrCompositionLayerCylinderKHR *>(base);
+		image = layer->subImage; pose = layer->pose;
+		value["shape"] = "cylinder";
+		value["radius"] = layer->radius;
+		value["central_angle"] = layer->centralAngle;
+		value["aspect_ratio"] = layer->aspectRatio;
+		value["eye_visibility"] = int64_t(layer->eyeVisibility);
+	} else return Dictionary();
+	value["space"] = int64_t(uint64_t(base->space));
+	value["swapchain"] = int64_t(uint64_t(image.swapchain));
+	value["image_rect"] = Rect2i(image.imageRect.offset.x, image.imageRect.offset.y,
+			image.imageRect.extent.width, image.imageRect.extent.height);
+	value["image_array_index"] = int64_t(image.imageArrayIndex);
+	const int inset = int64_t(cycle_frame_descriptor.get("rendered_viewport_inset", -1));
+	value["encoded_eye"] = image.imageRect.offset.x / output_width;
+	value["content_rect_in_image"] = Rect2i(image.imageRect.offset.x + inset, inset,
+			output_width - inset * 2, output_height - inset * 2);
+	value["position"] = Vector3(pose.position.x, pose.position.y, pose.position.z);
+	value["orientation"] = Quaternion(pose.orientation.x, pose.orientation.y, pose.orientation.z, pose.orientation.w);
+	return value;
+}
