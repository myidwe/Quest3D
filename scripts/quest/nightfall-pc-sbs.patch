+	screen_mesh.global_position = cam_pos + cam_fwd * 2.16
+	screen_mesh.rotation = Vector3.ZERO
+	if use_cam_yaw:
+		screen_mesh.rotation.y = atan2(-cam_fwd.x, -cam_fwd.z)
