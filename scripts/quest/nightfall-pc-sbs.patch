+	await process_frame
+	assert(panel.size == Vector2(1200, 580))
+	_assert_content_above_handle(content, initial_rect)
+	print("Live status layout PASS: applied3D, partial/refused,256-character names,100+character errors,global two-line budget and full tooltip")
