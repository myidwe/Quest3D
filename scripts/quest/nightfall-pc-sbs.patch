+	manager.start_stream(1, 999)
+	native.callbacks[4].call({"success": true, "xml": "<root status_code='200'><App><ID>42</ID><AppTitle>Game</AppTitle></App></root>", "pc_profile": true})
+	await create_timer(0.04).timeout
