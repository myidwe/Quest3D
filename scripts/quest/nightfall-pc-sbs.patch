+bool TextureUploader::request_gles_retirement(const GlesSurfaceLifetime &expected) {
+    return request_gles_retirement_impl(expected, true);
+}
+
+bool TextureUploader::request_gles_retirement_impl(const GlesSurfaceLifetime &expected, bool strict) {
+    RenderingServer *rs = RenderingServer::get_singleton();
+    std::unique_lock<std::mutex> lock(gles_surface_mutex_);
+    if (!gles_retirement_.request(expected, strict)) return false;
+    gles_surface_ready_ = false;
+    gles_update_deferred_ = false;
+    oes_lease_.invalidate();
+    latched_token_ = {};
+    gles_surface_cv_.notify_all();
+    if (gles_retirement_.finished() || gles_retirement_.terminal() || gles_cleanup_queued_) return true;
+    if (!rs) {
+        gles_retirement_.publish(GlesRetirementStatus::RenderServerUnavailable);
+        return true;
+    }
+    gles_cleanup_queued_ = true;
+    const auto queued = callable_mp(this, &TextureUploader::_render_thread_cleanup_gles)
+        .bind(Ref<TextureUploader>(this), static_cast<int64_t>(expected.generation));
+    // call_on_render_thread is synchronous on the render thread: never hold
+    // a mutex which the callback itself must acquire while dispatching it.
+    lock.unlock();
+    rs->call_on_render_thread(queued);
+    return true;
+}
+
+void TextureUploader::_render_thread_cleanup_gles(Ref<TextureUploader> keep_alive, int64_t generation) {
+    std::lock_guard<godot::Mutex> texture_lock(*(texture_mutex.ptr()));
+    std::lock_guard<std::mutex> surface_lock(gles_surface_mutex_);
+    if (static_cast<uint64_t>(generation) != gles_retirement_.generation_) return;
+    gles_cleanup_queued_ = false;
+    if (!gles_retirement_.requested_) return;
+    if (!gles_wrapper_detached_) {
+        // Detach the uploader's own material before the real GL fence. Keep a
+        // strong reference through that boundary; other viewport references
+        // may still exist, so strict legacy completion remains unconfirmed.
+        gles_retiring_wrapper_ = plane_textures[0];
+        if (shader_material.is_valid()) shader_material->set_shader_parameter("tex_y", Variant());
+        plane_textures[0].unref();
+        plane_images[0].unref();
+        gles_wrapper_detached_ = true;
+    }
+    if (!_render_thread_destroy_android_gles_surface()) return;
+    current_color_transfer_type_.store(0);
+    if (shader_material.is_valid()) {
+        shader_material->set_shader_parameter("color_transfer_type", 0);
+        shader_material->set_shader_parameter("tex_y", Variant());
+    }
+    gles_retiring_wrapper_.unref();
+    use_shader_conversion = false;
+    native_direct_mode_.store(false);
+}
+
+bool TextureUploader::_render_thread_destroy_android_gles_surface() {
+    // Both locks are held by the exact-generation render-thread callback.
+    JavaVM *vm = nullptr;
+    JNIEnv *env = get_gles_jni_env(vm);
+    gles_retirement_.retire(oes_lease_.held(), env);
+    if (!gles_retirement_.finished() && !gles_retirement_.ordinary_disposed_) return false;
+    gles_update_method_ = nullptr;
+    gles_transform_method_ = nullptr;
+    gles_timestamp_method_ = nullptr;
+    gles_video_uniform_ = -1;
+    gles_matrix_uniform_ = -1;
+    gles_depth_capture_width_ = 0;
+    gles_depth_capture_height_ = 0;
+    gles_depth_next_pbo_ = 0;
+    gles_depth_capture_requested_.store(false);
+    {
+        std::lock_guard<std::mutex> result_lock(gles_depth_result_mutex_);
+        gles_depth_result_.clear();
+        gles_depth_result_ready_ = false;
+    }
+    gles_surface_ready_ = false;
+    gles_surface_failed_ = false;
+    gles_update_queued_ = false;
+    return true;
+}
