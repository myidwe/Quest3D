+
+class NavigationComputerManager extends RefCounted:
+	var requests: Array = []
+	func request_pc_control(host: int, body: Dictionary, _callback: Callable):
+		requests.append({"host": host, "body": body.duplicate(true)})
+
+class ObservedBackend extends StreamBackend:
+	var output: Dictionary = {}
+	func get_video_output_info() -> Dictionary: return output.duplicate(true)
+
+class ObservedRenderer extends Object:
+	var submission: Dictionary = {}
+	func get_last_successful_submission() -> Dictionary: return submission.duplicate(true)
+
+func _init():
+	_run.call_deferred()
+
+func _output() -> Dictionary:
+	return {"observed": true, "valid": true, "codec_instance": 11, "codec_generation": 2,
+		"width": 3200, "height": 904, "crop_left": 0, "crop_top": 2, "crop_right": 3199, "crop_bottom": 901,
+		"transport_epoch": "a".repeat(32), "decoder_epoch": 7}
+
+func _submission() -> Dictionary:
+	return {"transport_epoch": "a".repeat(32), "decoder_epoch": 7,
+		"stage": "xr_end_frame_succeeded", "xr_end_frame_verified": true, "photon_verified": false,
+		"eyes": [{"image_rect": Rect2i(0, 0, 1616, 916), "content_rect_in_image": Rect2i(8, 8, 1600, 900)},
+			{"image_rect": Rect2i(1616, 0, 1616, 916), "content_rect_in_image": Rect2i(1624, 8, 1600, 900)}]}
+
+func _navigation_snapshot(app) -> Dictionary:
+	return {"profile": app.settings.host.pc_profile_resolution,
+		"sbs": app.settings.host.sbs_mode, "effective_sbs": app.settings.host.effective_sbs_mode(),
+		"resolution_scale": app.settings.host.resolution_scale_pct,
+		"resolution_idx": app.settings.host.resolution_idx, "native_resolution": app.settings.host.native_resolution,
+		"stream_fps": app.settings.host.stream_fps, "bitrate_idx": app.settings.host.bitrate_idx,
+		"auto_detect": app.auto_detect_enabled, "streaming": app.is_streaming,
+		"native_active": app.native_xr_renderer.active,
+		"output": app.stream_backend.get_video_output_info(),
+		"status": app.pc_control.status.duplicate(true), "pending": app.pc_control.pending.duplicate(true),
+		"mode_button": app._ui_3d_speed_btn.text}
+
+func _assert_pc_settings_navigation(app, cm):
+	var ui: UIController = app.ui_controller
+	ui.update_stereo_shader()
+	var before := _navigation_snapshot(app)
+	assert(app._ui_sbs_btn.text == "3D Settings\nOpen" and not app._ui_sbs_btn.disabled)
+	for iteration in range(3):
+		ui.switch_tab(0)
+		assert(app._ui_sbs_btn.is_visible_in_tree())
+		# Emit the actual product button's connected signal, not its handler.
+		app._ui_sbs_btn.button_down.emit()
+		assert(ui._current_tab == 3 and ui._tab_ai3d.is_visible_in_tree())
+		assert(not ui._tab_display.visible and not ui._tab_stream.visible)
+		ui.update_stereo_shader()
+		assert(app._ui_sbs_btn.text == "3D Settings\nOpen", "Periodic stereo refresh must retain the action label")
+		assert(_navigation_snapshot(app) == before, "Opening settings must not change PC mode, pending control, packing or video quality")
+		assert(cm.requests.is_empty(), "Opening settings must never send a PC mode command")
+	# The existing stereo shortcut uses SettingsController directly, including
+	# while the menu is hidden. It must show the same settings, not cycle format.
+	ui.switch_tab(0)
+	app.ui_visible = false
+	app.ui_panel_3d.visible = false
+	app.settings_controller.cycle_sbs_mode()
+	assert(app.ui_visible and ui._current_tab == 3 and ui._tab_ai3d.is_visible_in_tree())
+	assert(_navigation_snapshot(app) == before and cm.requests.is_empty())
+	assert("[PC UI] Opened PC 3D settings" in app.navigation_log)
+	ui.switch_tab(0)
+	var tab: Control = ui._tab_ai3d
+	ui._tab_ai3d = null
+	assert(not ui.open_pc_3d_settings())
+	assert("PC 3D settings are not ready" in app._ui_status_label.text)
+	assert(ui._current_tab == 0 and _navigation_snapshot(app) == before and cm.requests.is_empty())
+	ui._tab_ai3d = tab
+	assert(app._ui_sbs_btn.text == "3D Settings\nOpen")
+
+func _run():
+	var format := _output()
+	var submitted := _submission()
+	var status := PerformanceTelemetry.stream_resolution_status(format, submitted, true, true, true)
+	assert(status.text == "Eye 1600x900 · 16:9 · Native")
+	assert("3200x904" in status.tooltip and "1616x916" in status.tooltip and "1600x900" in status.tooltip)
+	assert("Received Full-SBS (both eyes): 3200x900" in status.tooltip)
+	for size in [Vector2i(1280, 720), Vector2i(1600, 900), Vector2i(1920, 1080)]:
+		assert(PerformanceTelemetry.aspect_ratio_label(size) == "16:9")
+	assert(PerformanceTelemetry.aspect_ratio_label(Vector2i(1600, 1200)) == "4:3")
+	assert(PerformanceTelemetry.aspect_ratio_label(Vector2i(2560, 1600)) == "8:5")
+	assert(PerformanceTelemetry.aspect_ratio_label(Vector2i.ZERO) == "Unknown")
+	assert(PerformanceTelemetry.aspect_ratio_label(Vector2i(-1, 900)) == "Unknown")
+	for bad in [{}, {"width": 3200, "height": 900}, {"observed": true, "valid": false}]:
+		assert("Eye Unknown" in PerformanceTelemetry.stream_resolution_status(bad, submitted, true, true, true).text)
+	for field in ["codec_instance", "codec_generation", "width", "height"]:
+		var bad := format.duplicate()
+		bad[field] = 0
+		assert("Eye Unknown" in PerformanceTelemetry.stream_resolution_status(bad, submitted, true, true, true).text)
+	for bad_crop in [Vector2i(-1, 3199), Vector2i(0, 3200), Vector2i(200, 100)]:
+		var bad := format.duplicate()
+		bad.crop_left = bad_crop.x
+		bad.crop_right = bad_crop.y
+		assert("Eye Unknown" in PerformanceTelemetry.stream_resolution_status(bad, submitted, true, true, true).text)
+	var odd := format.duplicate()
+	odd.crop_right = 3198
+	assert("Eye Unknown" in PerformanceTelemetry.stream_resolution_status(odd, submitted, true, true, true).text)
+	assert("Idle" in PerformanceTelemetry.stream_resolution_status(format, submitted, false, true, true).text)
+	for field in ["transport_epoch", "decoder_epoch", "stage", "xr_end_frame_verified"]:
+		var stale := submitted.duplicate(true)
+		stale.erase(field)
+		assert("imageRect: Unknown" in PerformanceTelemetry.stream_resolution_status(format, stale, true, true, true).tooltip)
+	assert("Legacy" in PerformanceTelemetry.stream_resolution_status(format, submitted, true, true, false).text)
+	assert(not "imageRect" in PerformanceTelemetry.stream_resolution_status(format, submitted, true, true, false).tooltip)
+	print("Resolution formatter PASS: callback-only dimensions, inclusive crop, missing/invalid/odd values, idle and stale transport/decoder geometry")
+
+	# Actual product menu and timer; backend/renderer observations are stand-ins.
+	# No native plugin, network, codec driver or OpenXR runtime is loaded here.
+	var app = load("res://main.tscn").instantiate()
