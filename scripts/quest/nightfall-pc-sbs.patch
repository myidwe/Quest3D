-/*
-Describes some basic details about a playback or capture device.
-*/
-typedef struct
-{
-    const ma_device_id* pDeviceID;
-    ma_share_mode shareMode;
-    ma_format format;
-    ma_uint32 channels;
-    ma_uint32 sampleRate;
-    ma_channel channelMap[MA_MAX_CHANNELS];
