+extends SceneTree
+
+class FakeRuntime extends RefCounted:
+	var rates: Array = [72.0, 90.0, 120.0]
+	var current := 72.0
+	var accept_requests := true
+	var corrupt_after_request := false
+	var requests: Array[float] = []
+	func get_available_display_refresh_rates() -> Array:
+		return rates.duplicate()
+	func get_display_refresh_rate() -> float:
+		return current
+	func set_display_refresh_rate(value: float):
+		requests.append(value)
+		if accept_requests:
+			current = value
+		if corrupt_after_request:
+			current = 0.0
+
+class FakeApp extends Node3D:
+	const PC_SBS_BUILD := true
+	var is_xr_active := true
+	var device_is_quest3 := false
+	var settings := AppSettings.new()
+	var display_refresh_rate := 72.0
+	var logs: Array[String] = []
+	func _log(value: String):
+		logs.append(value)
+
+class TestController extends SettingsController:
+	var runtime: FakeRuntime
+	func _openxr_interface():
+		return runtime
+
+func _init():
+	_run.call_deferred()
+
+func _record_apply(controller: TestController, results: Array):
+	results.append(await controller.apply_display_refresh_rate())
+
+func _run():
+	var saved_cap := Engine.max_fps
+	var app := FakeApp.new()
+	root.add_child(app)
+	var controller := TestController.new(app)
+	var runtime := FakeRuntime.new()
+	controller.runtime = runtime
+	app.settings.host.stream_fps = 30
+	Engine.max_fps = 30
+	assert(await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 72 and app.display_refresh_rate == 72.0)
+	assert(app.settings.host.stream_fps == 30 and runtime.requests.is_empty(),
+		"An already-active 72Hz runtime needs no display change; 30fps video remains 30")
+	app.settings.host.stream_fps = 60
+	assert(await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 72 and app.settings.host.stream_fps == 60)
+
+	# Negotiate an available fallback and use the measured outcome, not 72.
+	runtime.current = 120.0
+	runtime.rates = [90.0, 120.0]
+	assert(await controller.apply_display_refresh_rate())
+	assert(runtime.requests[-1] == 90.0 and Engine.max_fps == 90)
+	assert(app.display_refresh_rate == 90.0 and app.settings.host.stream_fps == 60)
+
+	# Runtime rejects a request: preserve its measured current rate and report failure.
+	runtime.rates = [72.0, 90.0]
+	runtime.current = 90.0
+	runtime.accept_requests = false
+	assert(not await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 90 and app.display_refresh_rate == 90.0)
+	assert("not confirmed" in app.logs[-1])
+
+	# No enumeration must not invent the requested rate or change the display.
+	runtime.rates = []
+	runtime.current = 80.0
+	var request_count := runtime.requests.size()
+	assert(not await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 80 and app.display_refresh_rate == 80.0)
+	assert(runtime.requests.size() == request_count)
+
+	# Invalid measurement never removes a known cap or claims successful negotiation.
+	for invalid in [0.0, -1.0, NAN, INF, 208.0]:
+		runtime.current = invalid
+		assert(not await controller.apply_display_refresh_rate())
+		assert(Engine.max_fps == 80 and app.display_refresh_rate == 80.0)
+	runtime.rates = [72.0, 90.0]
+	runtime.current = 90.0
+	runtime.accept_requests = true
+	runtime.corrupt_after_request = true
+	assert(not await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 80 and app.display_refresh_rate == 80.0)
+	runtime.corrupt_after_request = false
+
+	# A later request owns the result while the first request is settling.
+	runtime.current = 90.0
+	var retired_results: Array = []
+	_record_apply(controller, retired_results)
+	assert(retired_results.is_empty())
+	assert(await controller.apply_display_refresh_rate())
+	await create_timer(0.4).timeout
+	assert(retired_results == [false])
+	assert(Engine.max_fps == 72 and app.display_refresh_rate == 72.0)
+
+	# Non-XR and unavailable-interface paths retain the caller's ordinary cap.
+	Engine.max_fps = 123
+	app.is_xr_active = false
+	request_count = runtime.requests.size()
+	assert(not await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 123 and runtime.requests.size() == request_count)
+	app.is_xr_active = true
+	controller.runtime = null
+	assert(not await controller.apply_display_refresh_rate())
+	assert(Engine.max_fps == 123)
+	Engine.max_fps = saved_cap
+	app.free()
+	print("XR display cadence PASS: measured 72Hz/video30, fallback/rejection, invalid/unknown, stale request, non-XR preservation")
+	quit()
