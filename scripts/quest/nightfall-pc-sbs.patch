+nightfall::AudioCleanupCompletion AudioRenderer::cleanup_observed(nightfall::AudioLifetime expected) {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (expected != lifetime_) {
+        nightfall::AudioCleanupFacts refused;
+        refused.lifetime = expected;
+        refused.state = nightfall::AudioCleanupState::scope_mismatch;
+        return nightfall::AudioCleanupCompletion(refused);
+    }
+    return cleanup_locked();
+}
+
+nightfall::AudioCleanupCompletion AudioRenderer::cleanup_locked() {
+    if (!lifetime_.valid() || generation_closed_) return nightfall::AudioCleanupCompletion(cleanup_);
+    cleanup_.lifetime = lifetime_;
+    cleanup_.init_stage = init_stage_;
+    cleanup_.init_error = init_error_;
+    running_.store(false);
+    initialized_.store(false);
+    if (startup_) startup_->revoke(nightfall::AudioStartupState::closed);
+
+    if (audio_backend_) {
+        cleanup_.backend = audio_backend_->shutdown_observed(audio_backend_->lifetime());
+        if (!cleanup_.backend.resources_released()) {
+            cleanup_.state = nightfall::AudioCleanupState::pending_callbacks;
+            return nightfall::AudioCleanupCompletion(cleanup_);
+        }
+        audio_backend_.reset();
+        cleanup_.backend_storage_deleted = true;
+    }
+
+    if (opus_decoder_.is_valid()) {
+        const auto opus = opus_decoder_->cleanup_observed();
+        cleanup_.opus_destroy_returned = opus.destroy_returned;
+        cleanup_.opus_decoder_absent = opus.decoder_absent;
+        cleanup_.decoded_pcm_cleared = opus.pcm_cleared;
+    }
+    opus_data_buf_.clear();
+    cleanup_.compressed_opus_cleared = opus_data_buf_.is_empty();
+    cleanup_.state = nightfall::AudioCleanupState::resources_released;
+    generation_closed_ = true;
+    return nightfall::AudioCleanupCompletion(cleanup_);
+}
+
+void AudioRenderer::decode_and_play_sample(const char *sample_data, int sample_length) {
+    std::lock_guard<std::mutex> lock(lifecycle_mutex_);
+    if (!initialized_.load() || !running_.load()) return;
+    if (!sample_data || sample_length <= 0) return;
+
+    opus_data_buf_.resize(sample_length);
+    memcpy(opus_data_buf_.ptrw(), sample_data, sample_length);
+
+    int frames = opus_decoder_->decode(opus_data_buf_, samples_per_frame_);
+    if (frames <= 0) return;
+
+    if (!audio_backend_) return;
+
+    const PackedFloat32Array &pcm = opus_decoder_->get_last_pcm();
+    int total_samples = frames * channels_;
+    if (pcm.size() < total_samples) return;
+
+    const float *pcm_ptr = pcm.ptr();
+
+    if (channels_ == 2) {
+        audio_backend_->write_pcm(pcm_ptr, frames);
+    } else if (channels_ > 2) {
+        float stereo_buf[2048];
+        for (int i = 0; i < frames && i < 1024; i++) {
+            _downmix_to_stereo(pcm_ptr + i * channels_, stereo_buf + i * 2);
+        }
+        int out_frames = frames < 1024 ? frames : 1024;
+        audio_backend_->write_pcm(stereo_buf, out_frames);
+    } else {
+        float stereo_buf[2048];
+        for (int i = 0; i < frames && i < 1024; i++) {
+            stereo_buf[i * 2] = pcm_ptr[i];
+            stereo_buf[i * 2 + 1] = pcm_ptr[i];
+        }
+        int out_frames = frames < 1024 ? frames : 1024;
+        audio_backend_->write_pcm(stereo_buf, out_frames);
+    }
+}
+
+void AudioRenderer::_downmix_to_stereo(const float *multi, float *stereo) {
+    float left = 0.0f;
+    float right = 0.0f;
+
+    if (channels_ >= 1) left += multi[0];
+    if (channels_ >= 2) right += multi[1];
+
+    if (channels_ >= 3) {
+        float center = multi[2];
+        left += center * 0.7071f;
+        right += center * 0.7071f;
+    }
+    if (channels_ >= 4) {
+        float lfe = multi[3];
+        left += lfe * 0.5f;
+        right += lfe * 0.5f;
+    }
+    if (channels_ >= 5) left += multi[4] * 0.7071f;
+    if (channels_ >= 6) right += multi[5] * 0.7071f;
+    if (channels_ >= 7) left += multi[6] * 0.7071f;
+    if (channels_ >= 8) right += multi[7] * 0.7071f;
+
+    stereo[0] = left;
+    stereo[1] = right;
+}
+
+bool AudioRenderer::is_initialized() const {
