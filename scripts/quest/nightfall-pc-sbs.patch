-ma_device_config_init()
-ma_device_uninit()
-ma_device_start()
-ma_context_init()
-ma_context_get_devices()
-ma_context_enumerate_devices()
-*/
-MA_API ma_result ma_device_init(ma_context* pContext, const ma_device_config* pConfig, ma_device* pDevice);
