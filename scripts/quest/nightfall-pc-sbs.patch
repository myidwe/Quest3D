+	app.controller_mapper = ControllerMapper.new(app)
+	app.add_child(app.controller_mapper)
+	app.pc_control = PcControl.new(app)
+	app.ui_controller = UIController.new(app)
+	app.xr_interaction = XRInteraction.new(app)
+	var backend := ObservedBackend.new(null)
+	var cm := NavigationComputerManager.new()
+	backend.set_computer_manager(cm)
+	app.stream_backend = backend
+	app.native_xr_renderer = NativeXrRendererManager.new(app)
+	var renderer := ObservedRenderer.new()
+	app.native_xr_renderer.renderer = renderer
+	app.native_xr_renderer.active = true
+	app.settings.host.pc_profile_resolution = Vector2i.ZERO
+	app.ui_visible = true
+	app.ui_panel_3d.visible = true
+	app.ui_controller.build_ui()
+	app.auto_detect_enabled = true
+	_assert_pc_settings_navigation(app, cm)
+	app.settings.host.pc_profile_resolution = Vector2i(3200, 900)
+	app.ui_controller.switch_tab(1)
+	await process_frame
+	await process_frame
+	var label: Label = app.ui_viewport.find_child("StreamResolutionObservation", true, false)
+	var handle: Control = app.ui_viewport.find_child("CompGrabBar", true, false)
+	var panel: Control = app.ui_viewport.find_child("Panel", true, false)
+	assert(label != null and label.is_visible_in_tree() and "Idle" in label.text)
+	var handle_rect := Rect2(300, 530, 600, 44)
+	app.session_lifecycle.stream_started()
+	backend.output = format
+	renderer.submission = submitted
+	app.pc_control._host = 1
+	app.pc_control._status_at = Time.get_ticks_msec()
+	app.pc_control.status = {"version": 1, "session_id": "navigation-session", "revision": 1,
+		"last_seq": 1, "requested_mode": "3d", "effective_mode": "2d", "disparity": 12.0,
+		"eye_width": 1600, "publisher_age_ms": 1.0, "applied_request": null,
+		"rejected_request": null, "fallback_reason": null}
+	app.pc_control.pending = {"request_id": "existing-pending-control", "mode": "3d", "seq": 2}
+	assert(app.pc_control.available())
+	_assert_pc_settings_navigation(app, cm)
+	app.ui_controller.switch_tab(1)
+	app.ui_controller._poll_stream_resolution()
+	assert(label.text == status.text and label.tooltip_text == status.tooltip)
+	# A new codec without a format callback must clear the previous size.
+	backend.output = {}
+	await label.get_child(0).timeout
+	assert("Eye Unknown" in label.text)
+	for size in [Vector2i(2560, 720), Vector2i(3200, 900), Vector2i(3840, 1080), Vector2i(2147483646, 2147483647)]:
+		backend.output = format.duplicate()
+		backend.output.width = size.x
+		backend.output.height = size.y
+		backend.output.crop_left = 0
+		backend.output.crop_top = 0
+		backend.output.crop_right = size.x - 1
+		backend.output.crop_bottom = size.y - 1
+		app.ui_controller._poll_stream_resolution()
+		await process_frame
+		await process_frame
+		assert(panel.size == Vector2(1200, 580))
+		assert(handle.get_global_rect() == handle_rect)
+		assert(label.size.y == 44)
+		assert(label.get_global_rect().end.y <= app.ui_controller._tab_stream.get_node("StreamRow1").get_global_rect().position.y)
+		assert(Rect2(0, 0, 1200, 530).encloses(label.get_global_rect()))
+		assert(panel.get_node("MenuLayout/VBox").get_combined_minimum_size().y <= 530)
+	app.native_xr_renderer.active = false
+	app.ui_controller._poll_stream_resolution()
+	assert("Legacy" in label.text)
+	app.native_xr_renderer.active = true
