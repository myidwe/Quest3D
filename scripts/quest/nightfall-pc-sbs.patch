+		borrowed_end_result = int64_t(notice.get("result", -1));
+		bool exact_layers = true;
+		for (uint64_t pointer : borrowed_layer_pointers) {
+			if (std::count(actual.begin(), actual.end(), uintptr_t(pointer)) != 1) exact_layers = false;
+		}
