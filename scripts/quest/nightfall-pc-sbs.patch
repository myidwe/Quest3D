+	var consumes := 0
+	var pixels := PackedByteArray()
+	func has_rendered_frame() -> bool:
+		return ready
+	func request_ambient_sample():
+		requests += 1
+	func consume_ambient_sample() -> PackedByteArray:
+		consumes += 1
+		var result := pixels
+		pixels = PackedByteArray()
+		return result
+
+class RecordedComp extends RefCounted:
+	var received: Array[PackedByteArray] = []
+	func update_native_ambient_sample(pixels: PackedByteArray, width: int, height: int):
