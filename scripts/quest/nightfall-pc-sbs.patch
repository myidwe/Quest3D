+Dictionary NightfallComputerManager::_get_ssl_options(String ip, int port, bool pairing) {
+    Dictionary keys = config_manager->get_client_keys();
+    Dictionary opts;
+    opts["client_cert"] = keys["certificate"];
+    opts["client_key"] = keys["key"];
+    opts["verify_peer"] = true;
+    opts["require_server_pin"] = true;
+    String cert;
+    if (pairing && pair_state == PAIR_STAGE_5_HTTPS_CHALLENGE && server_proof_verified) {
+        cert = server_cert_pem;
+    } else if (!pairing) {
+        Array hosts = config_manager->get_hosts();
+        for (int i = 0; i < hosts.size(); ++i) {
+            Dictionary host = hosts[i];
+            if (String(host.get("localaddress", "")) != ip || int(host.get("https_port", 47984)) != port)
+                continue;
+            if (!bool(host.get("server_cert_verified", false))) continue;
+            String found = host.get("srvcert", "");
+            if (!cert.is_empty() && cert != found) {
+                cert = ""; // Ambiguous saved host identity: fail closed.
+                break;
+            }
+            cert = found;
+        }
+    }
+    opts["server_cert"] = cert;
+    return opts;
+}
