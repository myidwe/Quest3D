+    result["pc_profile"] = ctx.get("pc_profile", false);
+    if (bool(result["success"])) result["xml"] = body.get_string_from_utf8();
+    else result["error"] = "Authenticated PC app list failed (" + String::num_int64(code) + ")";
+    Callable callback = ctx["callback"];
+    if (callback.is_valid()) callback.call(result);
